		<type fullname="WinUIMusicPlayer.Model.UsbDeviceMusic" preserve="all"/>
		<type fullname="WinUIMusicPlayer.Model.MusicLyrics" preserve="all"/>
	</assembly>
	<!-- PlaybackHdrProbe subscribes to these existing events against the published controls assembly. -->
	<assembly fullname="AnimatedWin2dControls">
		<type fullname="AnimatedWin2dControls.Controls.NowPlayingCanvas">
			<method name="add_DrawHdrForeground" />
