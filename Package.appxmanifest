<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="SennpaiStudio.528762A6196EF"
    Publisher="CN=CF259542-70C0-4852-9523-066A80212473"
    Version="1.2.7.0" />

  <mp:PhoneIdentity PhoneProductId="4acbd93b-89da-420d-8e0b-8588586c1cc2"
    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>OriginalSound HI-FI Player</DisplayName>
    <PublisherDisplayName>Sennpai Studio</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
	<Description>OriginalSound HI-FI Player</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <!-- 崩溃诊断不在此声明清单扩展，原因（2026-09-18 实证）：
       desktop7:ErrorReporting 扩展要求 CompatMode=classic，而 classic 注册方式依赖
       classicAppCompat_8wekyb3d8bbwe 自定义能力——需要微软审批签发 .sccd，第三方应用
       实际无法获得（见 github.com/MicrosoftDocs/winrt-related/issues/394，补齐属性后
       部署仍失败于自定义能力校验 0x80073CF9）。
       WER 集成全部改为代码内完成（Services/CrashReportingService.cs）：
       已处理异常用 NonCritical 报告附带托管堆栈，真实崩溃用 createdump 转储 + 符号包。
       待 Windows App SDK 2.5.1 新增的 windows.diagnosticServiceModule 扩展随 SDK 服务更新
       落地后，可在此声明以获得真实崩溃的托管分桶，切换步骤见
       docs/wer-diagnostics-2026-09-18.md。 -->

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="ms-resource:AppMainTitle"
        Description="ms-resource:AppMainTitle"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="originalsoundhqplayer"/>
        </uap:Extension>
        <!-- 文件关联：扩展名与 Utils/ToolUtils.cs MusicExtensions 保持一致；
             声明后应用出现在系统"打开方式"候选，处理见 Services/OneShotPlaybackService.cs。 -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="audio">
            <uap:DisplayName>ms-resource:AppMainTitle</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.mp3</uap:FileType>
              <uap:FileType>.wav</uap:FileType>
              <uap:FileType>.flac</uap:FileType>
              <uap:FileType>.wma</uap:FileType>
              <uap:FileType>.aac</uap:FileType>
              <uap:FileType>.ogg</uap:FileType>
              <uap:FileType>.oga</uap:FileType>
              <uap:FileType>.aiff</uap:FileType>
              <uap:FileType>.aif</uap:FileType>
              <uap:FileType>.m4a</uap:FileType>
              <uap:FileType>.dsf</uap:FileType>
              <uap:FileType>.dff</uap:FileType>
              <uap:FileType>.ape</uap:FileType>
              <uap:FileType>.opus</uap:FileType>
              <uap:FileType>.wv</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap:Capability Name="musicLibrary" />
  </Capabilities>
</Package>