<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="WinUIMusicPlayer.DesktopLyrics.DesktopLyricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    mc:Ignorable="d"
    Title="DesktopLyrics">
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        Padding="8"
        PointerCanceled="RootGrid_PointerCanceled"
        PointerCaptureLost="RootGrid_PointerCaptureLost"
        PointerMoved="RootGrid_PointerMoved"
        PointerPressed="RootGrid_PointerPressed"
        PointerReleased="RootGrid_PointerReleased">
        <Grid.Resources>
            <!--  悬浮按钮覆写默认 Button 主题资源：悬停/按下用深色底 + 白色前景，
                  保证在白色歌词背景上的可见度（模板经 ThemeResource 解析，窗口树内生效）  -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#8E000000" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#CF000000" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D3000000" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
        </Grid.Resources>
        <ContentPresenter x:Name="RendererHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <StackPanel
            x:Name="ControlPanel"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Opacity="0"
            Orientation="Horizontal"
            Spacing="6">
            <Button Click="LockButton_Click">
                <FontIcon FontSize="14" Glyph="{x:Bind tools:BindUtils.LockGlyphConverter(ViewModel.IsLocked), Mode=OneWay}" />
            </Button>
            <Button Click="ResetButton_Click">
                <FontIcon FontSize="14" Glyph="&#xE7A7;" />
            </Button>
            <Button Click="CloseButton_Click">
                <FontIcon FontSize="14" Glyph="&#xE711;" />
            </Button>
        </StackPanel>
    </Grid>
</winex:WindowEx>
