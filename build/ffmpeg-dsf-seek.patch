+static int dsf_read_seek(AVFormatContext *s, int stream_index,
+                         int64_t timestamp, int flags)
+{
+    DSFContext *dsf = s->priv_data;
+    AVStream *st = s->streams[0];
+    int channels = st->codecpar->ch_layout.nb_channels;
+    int block = st->codecpar->block_align;
+    int64_t frames_per_block = block / channels;
+    int64_t offset, blocks, ret;
+    int64_t data_offset = ffformatcontext(s)->data_offset;
+
+    if (stream_index != 0 || (flags & AVSEEK_FLAG_BYTE) ||
+        dsf->data_end > INT64_MAX || dsf->audio_size > INT64_MAX ||
+        data_offset < 0 || frames_per_block <= 0)
+        return AVERROR(EINVAL);
+    timestamp = av_clip64(timestamp, 0, st->duration);
+    if (timestamp == st->duration) {
+        offset = dsf->data_size;
+    } else {
+        /* DSF stores fixed planar blocks. Generic index seeking would read
+         * every intervening packet, including over HTTP Range transports. */
+        blocks = timestamp / frames_per_block;
+        if (!(flags & AVSEEK_FLAG_BACKWARD) && timestamp % frames_per_block)
+            blocks++;
+        if (blocks > (INT64_MAX - data_offset) / block)
+            return AVERROR(EINVAL);
+        offset = FFMIN(blocks * block, dsf->data_size);
+    }
+    if ((ret = avio_seek(s->pb, data_offset + offset, SEEK_SET)) < 0)
+        return ret;
+    ffstream(st)->cur_dts = offset / channels;
     return 0;
 }
 
