	<!-- 独立播放进程（AOT 单文件，仓库内为发布产物暂存）：与应用主程序、ffmpeg DLL 同铺应用根，
	     AutoGen 默认按 exe 目录定位 DLL，无需任何路径适配 -->
	<None Remove="Player\AudioAnalysisWorker.exe" />
    <None Include="Player\AudioAnalysisWorker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="AudioAnalysisWorker.exe" />
