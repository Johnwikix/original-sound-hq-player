	<None Include="Player\*.dll" Exclude="Player\wavpackdll.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />

	<!-- FFmpeg 9.0.1 shared DLL（单套分发，全程序唯一样本）：主程序进程内转码与独立播放进程
	     AudioPlayer（应用根目录，紧邻 DLL）共用这一套。
	     仅拷贝音频管线实际依赖的四个库：avformat→avcodec→avutil、swresample→avutil；
	     avdevice/avfilter/swscale（设备采集/滤镜/视频缩放）未使用，不随包分发。
	     注意：目录通配符意味着升级 FFmpeg 解进新 DLL 会被静默带上包，需人工把关。 -->
	<None Include="Libraries\FFmpeg\x64\*.dll" Condition="'$(Platform)' == 'x64'" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
