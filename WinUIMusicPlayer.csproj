  <!-- Satori 的资产路径混用分隔符；统一为 FullPath，确保 MSIX 能按优化快照排除 R2R/裁剪前的输入。 -->
  <Target Name="NormalizeSatoriAssetPathsForMsix" AfterTargets="UseSatoriGC" Condition="'$(UseSatoriGC)' == 'true' and '$(PublishAot)' != 'true'">
    <ItemGroup>
      <_SatoriNormalizedRuntimeAsset Include="@(RuntimePackAsset->'%(FullPath)')" />
      <_SatoriNormalizedCopyLocal Include="@(ReferenceCopyLocalPaths->'%(FullPath)')" />

      <RuntimePackAsset Remove="@(RuntimePackAsset)" />
      <RuntimePackAsset Include="@(_SatoriNormalizedRuntimeAsset)" />

      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
      <ReferenceCopyLocalPaths Include="@(_SatoriNormalizedCopyLocal)" />

      <_SatoriNormalizedRuntimeAsset Remove="@(_SatoriNormalizedRuntimeAsset)" />
      <_SatoriNormalizedCopyLocal Remove="@(_SatoriNormalizedCopyLocal)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
