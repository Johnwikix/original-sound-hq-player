  <!-- AudioPlayer 输入含 IPC 共享源码 BassPlayerIpc.Shared 与内嵌的 dsp-tables.bin；递归 glob 必须排除
       obj/bin，否则发布自身生成的 .cs 会让哈希漂移导致无限重发布；pubxml 不经命令行使用，不纳入。 -->
  <ItemGroup>
    <AudioPlayerSources Include="External\AudioPlayer\**\*.cs;External\AudioPlayer\AudioPlayer.csproj;External\AudioPlayer\Assets\icon.ico;External\AudioPlayer\AudioEnhancement\Coefficients\Assets\dsp-tables.bin;External\BassPlayerIpc.Shared\*.cs;External\BassPlayerIpc.Shared\BassPlayerIpc.Shared.csproj"
                        Exclude="External\AudioPlayer\obj\**;External\AudioPlayer\bin\**" />
  </ItemGroup>
  <!-- Player\ 下暂存的两个独立进程 exe 均为 NativeAOT 产物，不可字节复现；时间戳增量会被 git 操作重置后
       触发无谓重发布并污染仓库。改用源码内容哈希门控：hash 文件与 exe 一起提交，pull 后哈希一致即跳过，
       源码真实变更才重新发布。 -->
  <UsingTask TaskName="HashSourceInputs" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Hash ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="C#">
        <![CDATA[
        var sb = new StringBuilder();
        using (var sha = SHA256.Create())
        {
            foreach (string path in Files.Select(f => f.ItemSpec).OrderBy(p => p, StringComparer.OrdinalIgnoreCase))
            {
                if (!File.Exists(path)) { Hash = "missing:" + path; return true; }
                byte[] fileHash;
                using (Stream stream = File.OpenRead(path)) fileHash = sha.ComputeHash(stream);
                foreach (byte b in fileHash) sb.Append(b.ToString("x2"));
                sb.Append('|');
            }
            byte[] final = sha.ComputeHash(Encoding.UTF8.GetBytes(sb.ToString()));
            sb.Clear();
            foreach (byte b in final) sb.Append(b.ToString("x2"));
        }
        Hash = sb.ToString();
        ]]>
      </Code>
    </Task>
  </UsingTask>
  <Target Name="PublishAudioAnalysisWorker" BeforeTargets="PrepareForBuild" Condition="'$(Platform)' == 'x64'">
    <HashSourceInputs Files="@(AnalysisWorkerSources->'%(FullPath)')">
      <Output TaskParameter="Hash" PropertyName="WorkerInputsHash" />
    </HashSourceInputs>
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\Player\AudioAnalysisWorker.hash" Condition="Exists('$(MSBuildProjectDirectory)\Player\AudioAnalysisWorker.hash')">
      <Output TaskParameter="Lines" PropertyName="WorkerKnownHash" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <SkipWorkerPublish Condition="Exists('$(MSBuildProjectDirectory)\Player\AudioAnalysisWorker.exe') and '$(WorkerKnownHash)' == '$(WorkerInputsHash)'">true</SkipWorkerPublish>
    </PropertyGroup>
    <Message Text="AudioAnalysisWorker 源码未变化，跳过重新发布" Importance="high" Condition="'$(SkipWorkerPublish)' == 'true'" />
    <Exec Condition="'$(SkipWorkerPublish)' != 'true'"
          Command="dotnet publish &quot;$(MSBuildProjectDirectory)\External\AudioAnalysisWorker\AudioAnalysisWorker.csproj&quot; -c Release -r win-x64 -p:UseSharedCompilation=false -o &quot;$(MSBuildProjectDirectory)\Player&quot;" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\Player\AudioAnalysisWorker.hash" Lines="$(WorkerInputsHash)" Overwrite="true" Condition="'$(SkipWorkerPublish)' != 'true'" />
  </Target>
  <Target Name="PublishAudioPlayer" BeforeTargets="PrepareForBuild" Condition="'$(Platform)' == 'x64'">
    <HashSourceInputs Files="@(AudioPlayerSources->'%(FullPath)')">
      <Output TaskParameter="Hash" PropertyName="AudioPlayerInputsHash" />
    </HashSourceInputs>
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\Player\AudioPlayer.hash" Condition="Exists('$(MSBuildProjectDirectory)\Player\AudioPlayer.hash')">
      <Output TaskParameter="Lines" PropertyName="AudioPlayerKnownHash" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <SkipAudioPlayerPublish Condition="Exists('$(MSBuildProjectDirectory)\Player\AudioPlayer.exe') and '$(AudioPlayerKnownHash)' == '$(AudioPlayerInputsHash)'">true</SkipAudioPlayerPublish>
    </PropertyGroup>
    <Message Text="AudioPlayer 源码未变化，跳过重新发布" Importance="high" Condition="'$(SkipAudioPlayerPublish)' == 'true'" />
    <Exec Condition="'$(SkipAudioPlayerPublish)' != 'true'"
          Command="dotnet publish &quot;$(MSBuildProjectDirectory)\External\AudioPlayer\AudioPlayer.csproj&quot; -c Release -r win-x64 -p:Platform=x64 -o &quot;$(MSBuildProjectDirectory)\Player&quot;" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\Player\AudioPlayer.hash" Lines="$(AudioPlayerInputsHash)" Overwrite="true" Condition="'$(SkipAudioPlayerPublish)' != 'true'" />
  </Target>
