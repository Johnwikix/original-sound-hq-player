<Window
    x:Class="UsbUiRegression.HostWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:WinUIMusicPlayer.Model">
    <Grid RowDefinitions="*,Auto" Padding="16" RowSpacing="12">
        <ListView x:Name="SongsList" ItemsSource="{x:Bind Songs}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Music">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind Title}" />
                        <TextBlock x:Name="StateText" Text="{x:Bind IsExistOnDevice, Mode=OneWay}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <InfoBar x:Name="ResultBar" Grid.Row="1" Title="{x:Bind State.Shell.InfoBarTitle, Mode=OneWay}"
                 Message="{x:Bind State.Shell.InfoBarMessage, Mode=OneWay}"
                 IsOpen="{x:Bind State.Shell.InfoBarIsOpen, Mode=OneWay}" />
    </Grid>
</Window>
