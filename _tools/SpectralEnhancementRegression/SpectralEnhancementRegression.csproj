<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net11.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../External/AudioPlayer/**/*.cs" Exclude="../../External/AudioPlayer/Program.cs;../../External/AudioPlayer/obj/**/*.cs;../../External/AudioPlayer/bin/**/*.cs" />
    <ProjectReference Include="../../External/BassPlayerIpc.Shared/BassPlayerIpc.Shared.csproj" />
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <EmbeddedResource Include="../../External/AudioPlayer/AudioEnhancement/Coefficients/Assets/dsp-tables.bin" LogicalName="AudioPlayer.AudioEnhancement.Coefficients.dsp-tables.bin" />
    <None Include="../../Libraries/FFmpeg/x64/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Libraries/WavPack/x64/wavpackdll.dll" Link="wavpackdll.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
