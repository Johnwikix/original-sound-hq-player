<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Features>$(Features);runtime-async=on</Features>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Page Include="../../View/SubView/Settings/LastFmSettingsControl.xaml" Link="LastFmSettingsControl.xaml" />
    <Compile Include="../../View/SubView/Settings/LastFmSettingsControl.xaml.cs" Link="LastFmSettingsControl.xaml.cs" />
    <Compile Include="../../ViewModel/Pages/LastFmSettingsViewModel.cs;../../Services/LastFm/*.cs;../../Services/AppLifecycle.cs;../../State/PlaybackState.cs" Exclude="../../Services/LastFm/SqliteLastFmHistorySource.cs" />
    <ProjectReference Include="../../External/BassPlayerIpc.Shared/BassPlayerIpc.Shared.csproj" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.2-prerelease.260804.1" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <None Include="../../Strings/zh-CN/Resources.resw" Link="Fixtures/Resources.resw" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
