<Page x:Class="WinUIMusicPlayer.View.FolderBrowsePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:WinUIMusicPlayer.View.Controls"
 xmlns:fixture="using:WinUIMusicPlayer.Utils" xmlns:model="using:WinUIMusicPlayer.Model">
 <Grid>
  <SemanticZoom x:Name="BrowseZoom" IsHitTestVisible="{x:Bind fixture:FixtureBinds.Not(ViewModel.IsInDetailMode), Mode=OneWay}"
   Opacity="{x:Bind fixture:FixtureBinds.Opacity(ViewModel.IsInDetailMode), Mode=OneWay}">
   <SemanticZoom.ZoomedInView>
    <GridView x:Name="FolderGridView" ItemsSource="{x:Bind ViewModel.AppViewModel.FolderPageSource.View, Mode=OneWay}"
     IsItemClickEnabled="True" ItemClick="FolderGridView_ItemClick">
     <GridView.ItemTemplate><DataTemplate><Border x:Name="CoverBorder" Width="120" Height="96" Background="SteelBlue" Margin="4"><TextBlock Text="{Binding Title}" /></Border></DataTemplate></GridView.ItemTemplate>
     <GridView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate x:DataType="model:MusicGroup"><TextBlock Text="{x:Bind Key}" Height="28" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></GridView.GroupStyle>
    </GridView>
   </SemanticZoom.ZoomedInView>
   <SemanticZoom.ZoomedOutView>
    <GridView x:Name="ZoomedOutGridView" Width="280" MaxHeight="240" HorizontalAlignment="Center" VerticalAlignment="Center"
     ItemsSource="{x:Bind ViewModel.AppViewModel.FolderPageSource.View.CollectionGroups, Mode=OneWay}">
     <GridView.ItemTemplate><DataTemplate x:DataType="ICollectionViewGroup"><Border Width="64" Height="56" Background="SlateBlue"><TextBlock Text="{x:Bind Group.(model:MusicGroup.Key)}" /></Border></DataTemplate></GridView.ItemTemplate>
    </GridView>
   </SemanticZoom.ZoomedOutView>
  </SemanticZoom>
  <controls:MusicGroupDetailControl x:Name="DetailView" Tag="folder" Visibility="{x:Bind fixture:FixtureBinds.Detail(ViewModel.IsInDetailMode), Mode=OneWay}" />
 </Grid>
</Page>
