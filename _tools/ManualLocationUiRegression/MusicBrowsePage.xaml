<Page x:Class="WinUIMusicPlayer.View.MusicBrowsePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:local="using:WinUIMusicPlayer.View">
    <!-- Only the shell chrome is substituted; the production code behind, selector binding,
         SwitchPresenter, child pages, child XAML and ViewModels are linked into this executable. -->
    <Grid>
    <ContentControl x:Name="MusicDetailsSource" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid RowDefinitions="Auto,*">
        <SelectorBar x:Name="selectPage" SelectionChanged="SelectPage_SelectionChanged"
                     SelectedItem="{x:Bind SelectorItem(ViewModel.SelectedPageTag), Mode=OneWay}">
            <SelectorBarItem Tag="song" Text="Songs" />
            <SelectorBarItem Tag="album" Text="Albums" />
            <SelectorBarItem Tag="artist" Text="Artists" />
            <SelectorBarItem Tag="favourite" Text="Favorites" />
        </SelectorBar>
        <controls:SwitchPresenter x:Name="TabPresenter" Grid.Row="1">
            <controls:SwitchPresenter.ContentTransitions>
                <TransitionCollection>
                    <PopupThemeTransition />
                </TransitionCollection>
            </controls:SwitchPresenter.ContentTransitions>
            <controls:Case x:Name="SongTab" Value="song" />
            <controls:Case x:Name="AlbumTab" Value="album" />
            <controls:Case x:Name="ArtistTab" Value="artist" />
            <controls:Case x:Name="FavouriteTab" Value="favourite" />
        </controls:SwitchPresenter>
        <Grid x:Name="EmptyLibraryGrid" Grid.Row="1"
              Visibility="{x:Bind local:MusicBrowsePage.GetEmptyVisibility(ViewModel.AppViewModel.LibraryEmptyVisibility, ViewModel.SelectedPageTag, ViewModel.AppViewModel.FavoriteSongs.Count), Mode=OneWay}" />
        <Grid x:Name="DropOverlay" Visibility="Collapsed" />
    </Grid>
    </ContentControl>
    <ContentControl x:Name="MusicDetailsOverlay" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" TabFocusNavigation="Cycle" />
    </Grid>
</Page>
