<Page x:Class="WinUIMusicPlayer.View.MusicBrowsePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Only the shell chrome is substituted; the production code behind, selector binding,
         Frame, child pages, child XAML and ViewModels are linked into this executable. -->
    <Grid RowDefinitions="Auto,*">
        <SelectorBar x:Name="selectPage" SelectionChanged="SelectPage_SelectionChanged"
                     SelectedItem="{x:Bind SelectorItem(ViewModel.SelectedPageTag), Mode=OneWay}">
            <SelectorBarItem Tag="song" Text="Songs" />
            <SelectorBarItem Tag="album" Text="Albums" />
            <SelectorBarItem Tag="artist" Text="Artists" />
            <SelectorBarItem Tag="folder" Text="Folders" />
            <SelectorBarItem Tag="favourite" Text="Favorites" />
        </SelectorBar>
        <Frame CacheSize="0" x:Name="ContentFrame" Grid.Row="1" IsNavigationStackEnabled="False" />
        <Grid x:Name="DropOverlay" Visibility="Collapsed" />
    </Grid>
</Page>
