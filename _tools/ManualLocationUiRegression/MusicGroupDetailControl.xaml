<UserControl x:Class="WinUIMusicPlayer.View.Controls.MusicGroupDetailControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowDefinitions="Auto,*">
  <Border x:Name="CoverBorder" Width="100" Height="100" Background="SteelBlue" />
  <ListView x:Name="MusicListView" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}">
   <ListView.ItemTemplate><DataTemplate><Border Height="48"><TextBlock Text="{Binding Title}" /></Border></DataTemplate></ListView.ItemTemplate>
  </ListView>
 </Grid>
</UserControl>
