<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.2-prerelease.261026.1-nogcpressure" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <Compile Include="../../Helper/PlaybackCoverImage.cs" />
    <Compile Include="../../Helper/PlaybackCoverCache.cs" />
    <Compile Include="../../Helper/ReadOnlyMappedStream.cs" />
    <Compile Include="../../Helper/DefaultCoverPaletteCache.cs" />
    <Compile Include="../../Services/CoverPresentationService.cs" />
    <Compile Include="../../Services/SystemMediaControlsService.cs" />
    <Compile Include="../../Services/ApplicationTasks.cs" />
    <Compile Include="../../Services/AppLifecycle.cs" />
    <Compile Include="../../External/AnimatedWin2dControls/AnimatedWin2dControls/Impressionist/*.cs" />
    <Compile Include="../../External/AnimatedWin2dControls/AnimatedWin2dControls/Enums/BackgroundShaderMode.cs" />
    <Compile Include="../../Helper/ImageHelper.cs" />
    <Compile Include="../../Helper/CoverLoadState.cs" />
    <Compile Include="../../Helper/TransitionCache.cs" />
    <Compile Include="../../Constants/Time.cs" />
    <Compile Include="../../Controls/ImageSwitcher.xaml.cs" />
    <Compile Include="../../Controls/ShadowImage.xaml.cs" />
    <Page Include="../../Controls/ImageSwitcher.xaml" Link="Controls/ImageSwitcher.xaml" />
    <Page Include="../../Controls/ShadowImage.xaml" Link="Controls/ShadowImage.xaml" />
    <Content Include="../../Assets/default_cover_*.png" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
