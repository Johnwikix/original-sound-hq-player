<UserControl x:Class="MusicMetadataUiRegression.MetadataPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Padding="20"><Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Visibility="{x:Bind BoolToVisibility(IsLoading), Mode=OneWay}" x:Name="LoadingOverlay">
            <ProgressRing Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="True" />
            <TextBlock Margin="0,180,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="正在处理保存，请稍候..." />
        </Grid>

        <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="EditorContent" Visibility="{x:Bind BoolToNVisibility(IsLoading), Mode=OneWay}"><StackPanel x:Name="OptionalTags"><Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,2" FontSize="12" Opacity="0.7" Text="专辑" />
                                <TextBox BorderThickness="0" IsEnabled="{x:Bind MusicDetail.CanEditFile, Mode=OneWay}" Text="{x:Bind MetadataEditor.Draft.Album, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Margin="0,0,0,2" FontSize="12" Opacity="0.7" Text="专辑艺术家" />
                                <TextBox IsReadOnly="{x:Bind MusicDetail.IsRemote, Mode=OneWay}" Text="{x:Bind MetadataEditor.Draft.AlbumArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="未提供（可选）" x:Name="AlbumArtistInput" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,2" FontSize="12" Opacity="0.7" Text="流派" />
                                <TextBox IsReadOnly="{x:Bind MusicDetail.IsRemote, Mode=OneWay}" Text="{x:Bind MetadataEditor.Draft.Genre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="未提供（可选）" x:Name="GenreInput" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="0,0,0,2" FontSize="12" Opacity="0.7" Text="作曲者" />
                                <TextBox IsReadOnly="{x:Bind MusicDetail.IsRemote, Mode=OneWay}" Text="{x:Bind MetadataEditor.Draft.Composer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="未提供（可选）" x:Name="ComposerInput" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Margin="0,0,0,2" FontSize="12" Opacity="0.7" Text="作词者" />
                                <TextBox IsReadOnly="{x:Bind MusicDetail.IsRemote, Mode=OneWay}" Text="{x:Bind MetadataEditor.Draft.Lyricist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="未提供（可选）" x:Name="LyricistInput" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,2" FontSize="12" Opacity="0.7" Text="指挥" />
                                <TextBox IsReadOnly="{x:Bind MusicDetail.IsRemote, Mode=OneWay}" Text="{x:Bind MetadataEditor.Draft.Conductor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="未提供（可选）" x:Name="ConductorInput" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Margin="0,0,0,2" FontSize="12" Opacity="0.7" Text="目录编号" />
                                <TextBox IsReadOnly="{x:Bind MusicDetail.IsRemote, Mode=OneWay}" Text="{x:Bind MetadataEditor.Draft.CatalogNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="未提供（可选）" x:Name="CatalogNumberInput" />
                            </StackPanel>
                        </Grid>
                    </StackPanel><Grid x:Name="FileInfoSection" Margin="12,0" ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="6">
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Margin="0,0,0,2" FontSize="12" Opacity="0.7" Text="最后目录" />
                            <TextBox x:Name="LastFolderInput" IsReadOnly="True" Text="{x:Bind MusicDetail.LastLevelFolderPath, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Margin="0,0,0,2" FontSize="12" Opacity="0.7" Text="路径" />
                            <TextBox x:Name="PathInput" IsReadOnly="True" Text="{x:Bind MusicDetail.Path, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Margin="0,0,0,2" FontSize="12" Opacity="0.7" Text="创建时间" />
                            <TextBox IsReadOnly="True" Text="{x:Bind ConvertTime(MusicDetail.CreateTime), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Margin="0,0,0,2" FontSize="12" Opacity="0.7" Text="修改时间" />
                            <TextBox IsReadOnly="True" Text="{x:Bind ConvertTime(MusicDetail.UpdateTime), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    </StackPanel></Grid></UserControl>