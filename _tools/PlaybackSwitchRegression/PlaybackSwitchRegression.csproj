<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Reader/AudioCoverReader.cs" />
    <Compile Include="../../Services/WebDav/WebDavTransport.cs;../../Services/WebDav/WebDavCertificates.cs;../../Services/WebDav/HttpRangeReadStream.cs;../../Services/WebDav/WebDavReadFailure.cs;../../Services/WebDav/RemoteReadSession.cs;../../Services/WebDav/RemoteAudioCache.cs;../../Services/WebDav/WebDavCachePaths.cs;../../Services/WebDav/WebDavPlaybackBridge.cs" />
    <Compile Include="../../AudioConverters/FFmpegAudioConverter.cs" />
    <Compile Include="../../Model/ConversionMetadata.cs" />
    <None Include="Fixtures/eac3-5.1.m4a" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/flac-invalid-tail.flac" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../Model/EqualizerModel.cs" />
    <Compile Include="../../Utils/EqualizerHelper.cs" />
    <!-- Exercise the shipping engine/decoder/interop without starting IPC or a real device. -->
    <Compile Include="../../External/AudioPlayer/**/*.cs"
             Exclude="../../External/AudioPlayer/Program.cs;../../External/AudioPlayer/obj/**/*.cs;../../External/AudioPlayer/bin/**/*.cs" />
    <ProjectReference Include="../../External/BassPlayerIpc.Shared/BassPlayerIpc.Shared.csproj" />
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <None Include="../../Libraries/FFmpeg/x64/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Libraries/WavPack/x64/wavpackdll.dll" Link="wavpackdll.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Libraries/WavPack/LICENSE.txt" Link="Licenses/WavPack.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
