    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.2-prerelease.260804.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="../PlaybackNavigationRegression/Adapters.cs;../PlaybackNavigationRegression/Program.cs" />
    <Compile Include="../../Services/PlaybackCoordinator.cs;../../Services/PlaybackCommands.cs;../../Services/ApplicationTasks.cs;../../Services/AppLifecycle.cs;../../Services/ShutdownCoordinator.cs" />
    <Compile Include="../../ViewModel/Pages/WebDavSourcesViewModel.cs" />
  </ItemGroup>
</Project>
