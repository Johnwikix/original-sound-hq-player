<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationManifest>../../app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StatsViewModelSource Condition="'$(StatsViewModelSource)' == ''">../../ViewModel/StatsViewModel.cs</StatsViewModelSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.2-prerelease.261026.1-nogcpressure" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <Compile Include="$(StatsViewModelSource)" Link="StatsViewModel.cs" />
    <Compile Include="../../Model/Stats/*.cs;../../Services/PlaybackStatsService.cs;../../Services/ShutdownCoordinator.cs;../../Services/AppLifecycle.cs" />
    <Compile Include="../../Behaviors/AlbumCoverBehavior.cs;../../Utils/CoverLoadQueue.cs;../../View/StatsPage.xaml.cs;../../Controls/Charts/HourlyBarChartControl.xaml.cs" />
    <Page Include="../../View/StatsPage.xaml" Link="View/StatsPage.xaml" />
    <Page Include="../../Controls/Charts/HourlyBarChartControl.xaml" Link="Controls/Charts/HourlyBarChartControl.xaml" />
    <PRIResource Include="../../Strings/en/Resources.resw" Link="Strings/en/Resources.resw" />
  </ItemGroup>
  <Target Name="PublishFixtureXaml" AfterTargets="Publish">
    <ItemGroup>
      <FixtureXaml Include="$(OutputPath)**/*.xbf;$(OutputPath)StatsCoverUiRegression.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(FixtureXaml)" DestinationFiles="@(FixtureXaml->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup><Compile Include="../../Utils/LocalCoverSource.cs;../../Utils/ToolUtils.RemoteCovers.cs;../../Services/WebDav/WebDavCachePaths.cs" /></ItemGroup>
</Project>
