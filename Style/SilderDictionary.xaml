<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PlaybackTrackBrush" Color="#55FFFFFF" />
            <SolidColorBrush x:Key="PlaybackValueBrush" Color="#F4FFFFFF" />
            <SolidColorBrush x:Key="PlaybackThumbBrush" Color="#F4FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PlaybackTrackBrush" Color="#60000000" />
            <SolidColorBrush x:Key="PlaybackValueBrush" Color="#C0000000" />
            <SolidColorBrush x:Key="PlaybackThumbBrush" Color="#E0000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PlaybackTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="PlaybackValueBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PlaybackThumbBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="PlaybackSliderStyle" TargetType="Slider">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource PlaybackValueBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PlaybackThumbBrush}" />
        <Setter Property="ManipulationMode" Value="None" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Margin="{TemplateBinding Padding}">
                        <Grid x:Name="SliderContainer" Background="Transparent" Control.IsTemplateFocusTarget="True">
                            <Grid x:Name="HorizontalTemplate" MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                </Grid.RowDefinitions>
                                <Rectangle x:Name="HorizontalTrackRect" Grid.Row="1" Grid.ColumnSpan="3"
                                           Height="4" Margin="12,0" Fill="{ThemeResource PlaybackTrackBrush}"
                                           RadiusX="2" RadiusY="2" />
                                <Rectangle x:Name="HorizontalDecreaseRect" Grid.Row="1" Height="4"
                                           Margin="12,0" Fill="{TemplateBinding Foreground}" Opacity="0.75"
                                           RadiusX="2" RadiusY="2" />
                                <Thumb x:Name="HorizontalThumb" Grid.RowSpan="3" Grid.Column="1"
                                       Width="12" Height="12" Margin="-24,0,0,0"
                                       AutomationProperties.AccessibilityView="Raw"
                                       DataContext="{TemplateBinding Value}" FocusVisualMargin="0"
                                       Foreground="{TemplateBinding BorderBrush}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{TemplateBinding Foreground}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
