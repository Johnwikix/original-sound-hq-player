<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="FloatingCommandForeground" Color="{ThemeResource SystemAccentColorDark2}" />
            <SolidColorBrush x:Key="FloatingCommandHoverForeground" Color="{ThemeResource SystemAccentColorDark2}" />
            <SolidColorBrush x:Key="FloatingCommandBackground" Color="#FFFAFAFA" />
            <SolidColorBrush x:Key="FloatingCommandHover" Color="#FFF0F0F0" />
            <SolidColorBrush x:Key="FloatingCommandPressed" Color="#FFE3E3E3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="FloatingCommandForeground" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="FloatingCommandHoverForeground" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="FloatingCommandBackground" Color="#FF303038" />
            <SolidColorBrush x:Key="FloatingCommandHover" Color="#FF41414C" />
            <SolidColorBrush x:Key="FloatingCommandPressed" Color="#FF25252C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="FloatingCommandForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="FloatingCommandHoverForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="FloatingCommandBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="FloatingCommandHover" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FloatingCommandPressed" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <!-- 命中面独立于禁用的按钮，阻止指针穿到下层列表；保留原来的 44px 与 16px 边距。 -->
    <Style x:Key="FloatingLocateSurfaceStyle" TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Canvas.ZIndex" Value="10" />
    </Style>
    <Style x:Key="FloatingLocateButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Background" Value="{ThemeResource FloatingCommandBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource FloatingCommandForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Canvas.ZIndex" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource FloatingCommandHover}" />
                                        <Setter Target="GlyphPresenter.Foreground" Value="{ThemeResource FloatingCommandHoverForeground}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource FloatingCommandPressed}" />
                                        <Setter Target="GlyphPresenter.Foreground" Value="{ThemeResource FloatingCommandHoverForeground}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="GlyphPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="GlyphPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
