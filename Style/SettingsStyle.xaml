<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  设置页布局资源,与 BetterLyrics 的设置页排版保持一致  -->
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>

    <Style
        x:Key="SettingsSectionHeaderTextBlockStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Style.Setters>
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style.Setters>
    </Style>

    <Style x:Key="SettingsGridStyle" TargetType="Grid">
        <Setter Property="Padding" Value="0,0,0,36" />
    </Style>

    <Style x:Key="SettingsScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Padding" Value="36,0" />
    </Style>
</ResourceDictionary>
