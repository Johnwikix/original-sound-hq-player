<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <FontFamily x:Key="GlobalFontFamily">Segoe UI, sans-serif</FontFamily>

    <!--  单独指定常用控件  -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
    </Style>
    <Style TargetType="SelectorBarItem">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
    </Style>

    <Style TargetType="controls:SettingsExpander">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
    </Style>

    <Style TargetType="controls:SettingsCard">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
    </Style>

    <Style TargetType="HyperlinkButton">
        <Setter Property="FontFamily" Value="{StaticResource GlobalFontFamily}" />
    </Style>
</ResourceDictionary>
