<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:albumImg="using:AnimatedWin2dControls.Controls.AlbumImgControl"
    xmlns:animatedTextBlock="using:AnimatedWin2dControls.Controls.AnimatedTextBlock"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:AnimatedWin2dControls.Controls"
    xmlns:lyrics="using:AnimatedWin2dControls.Controls.AnimatedLyricsLineControl">

    <Style BasedOn="{StaticResource DefaultAnimatedTextBlockStyle}" TargetType="animatedTextBlock:AnimatedTextBlock" />
    <Style BasedOn="{StaticResource DefaultAlbumArtControlStyle}" TargetType="albumImg:AlbumArtControl" />
    <Style BasedOn="{StaticResource DefaultShaderBackgroundStyle}" TargetType="local:ShaderBackgroundControl" />

    <Style x:Key="DefaultAnimatedTextBlockStyle" TargetType="animatedTextBlock:AnimatedTextBlock">
        <Setter Property="FontFamily" Value="XamlAutoFontFamily" />
        <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="animatedTextBlock:AnimatedTextBlock">
                    <Border
                        x:Name="ContentBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <canvas:CanvasControl
                            x:Name="AnimatedCanvas"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultAlbumArtControlStyle" TargetType="albumImg:AlbumArtControl">

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="albumImg:AlbumArtControl">
                    <!--
                        CanvasControl 的名称必须与 C# 中 PartCanvas 常量保持一致："canvas"。
                        ClearColor 透明，让宿主背景透出。
                        HorizontalAlignment/VerticalAlignment=Stretch 保证充满父容器，
                        与原版 UserControl 的拉伸行为一致。
                    -->
                    <canvas:CanvasControl
                        x:Name="canvas"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ClearColor="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultShaderBackgroundStyle" TargetType="local:ShaderBackgroundControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ShaderBackgroundControl">
                    <canvas:CanvasAnimatedControl x:Name="PART_Canvas" ClearColor="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="lyrics:UnifiedLyricsCanvasControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="lyrics:UnifiedLyricsCanvasControl">
                    <canvas:CanvasControl
                        x:Name="PART_Canvas"
                        ClearColor="Transparent"
                        IsHitTestVisible="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
