<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.PlayListSongPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ListViewItemStyle" BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
            <Setter Property="ContextFlyout">
                <Setter.Value>
                    <MenuFlyout x:Name="menuFlyout">
                        <MenuFlyoutItem x:Uid="FlyoutPlayItem" Click="PlayMenuItem_Click" />
                        <MenuFlyoutItem x:Uid="FlyoutFavoriteItem" Click="SetAsFavoriteMenuItem_Click" />
                        <MenuFlyoutSubItem x:Uid="FlyoutConvertItem">
                            <MenuFlyoutItem x:Uid="FlyoutConvertWavItem" Click="ConvertAudio_Click" Tag="wav" />
                            <MenuFlyoutItem x:Uid="FlyoutConvertMp3Item" Click="ConvertAudio_Click" Tag="mp3" />
                            <MenuFlyoutItem x:Uid="FlyoutConvertFlacItem" Click="ConvertAudio_Click" Tag="flac" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem x:Uid="FlyoutOpenLocationItem" Click="OpenInExplorer_Click" />
                        <MenuFlyoutItem x:Uid="FlyoutPropertiesItem" Click="MusicDetail_Click" />
                        <MenuFlyoutItem x:Uid="FlyoutRemoveFromPlaylistItem" Click="DeleteMenuItem_Click" />
                    </MenuFlyout>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock
                x:Name="PlayListName"
                Margin="30,0,10,10"
                FontSize="18"
                Text="{Binding ViewModel.PlayListName, Mode=TwoWay}" />
        </Grid>
        <Grid Grid.Row="1">
            <ListView
                x:Name="MusicListView"
                AllowDrop="True"
                CanDragItems="True"
                CanReorderItems="True"
                DoubleTapped="MusicListView_DoubleTapped"
                ItemContainerStyle="{StaticResource ListViewItemStyle}"
                ItemsSource="{Binding ViewModel.MusicList, Mode=TwoWay}"
                RightTapped="MusicListView_RightTapped"
                SelectedItem="{Binding ViewModel.SelectedMusic, Mode=TwoWay}"
                SelectionMode="Extended">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Music">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="0.5*" />
                                <ColumnDefinition Width="0.5*" />
                                <ColumnDefinition Width="0.25*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="isFavouriteIconButton"
                                Grid.Column="0"
                                Margin="0,5,5,5"
                                Padding="3"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="IsFavouriteIconButton_Click"
                                Tag="{x:Bind}">
                                <FontIcon x:Name="IsFavouriteIcon" Foreground="Red" Glyph="{x:Bind IsFavorite, Mode=TwoWay, Converter={StaticResource FavouriteIconConverter}}" />
                            </Button>
                            <TextBlock
                                Grid.Column="1"
                                Margin="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Tapped="AuthorTextBlock_Tapped"
                                Text="{x:Bind Author, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="3"
                                Margin="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Tapped="AlbumTextBlock_Tapped"
                                Text="{x:Bind Album, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Image
                                Grid.Column="4"
                                Height="10"
                                Margin="5"
                                VerticalAlignment="Center"
                                Source="{x:Bind Converter={StaticResource MusicStatusToHRimgConverter}, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="5"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="{x:Bind Duration, Converter={StaticResource TimeSpanToStringConverter}}" />
                            <FontIcon
                                x:Name="IsExistOnDeviceIcon"
                                Grid.Column="6"
                                FontSize="14"
                                Glyph="{x:Bind IsExistOnDevice, Mode=OneWay, Converter={StaticResource IsExistOnDeviceConverter}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
