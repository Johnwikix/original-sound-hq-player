<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIMusicPlayer.View.PlayListSongPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:attached="using:WinUIMusicPlayer.AttachedProperties"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    >

    <Page.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <converters:SampleRateBitDepthConverter x:Key="SampleRateBitDepthConverter"/>
        <converters:FavouriteIconConverter x:Key="FavouriteIconConverter"/>
        <converters:FavouriteTextConverter x:Key="FavouriteTextConverter"/>
        <Style x:Key="ListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="ContextFlyout">
                <Setter.Value>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="播放" Click="PlayMenuItem_Click"/>
                        <MenuFlyoutItem Text="添加/取消最爱" Click="SetAsFavoriteMenuItem_Click"/>
                        <MenuFlyoutSubItem Text="转换为">
                            <MenuFlyoutItem Text="WAV" Tag="wav" Click="ConvertAudio_Click"></MenuFlyoutItem>
                            <MenuFlyoutItem Text="MP3" Tag="mp3" Click="ConvertAudio_Click"></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Flac" Tag="flac" Click="ConvertAudio_Click"></MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="发送到" Tag="usbDevices">
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem Text="打开文件位置" Click="OpenInExplorer_Click"/>
                        <MenuFlyoutItem Text="属性" Click="MusicDetail_Click"/>
                        <MenuFlyoutItem Text="从播放列表中移除" Click="DeleteMenuItem_Click"/>
                    </MenuFlyout>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock x:Name="PlayListName" FontSize="18" Margin="30 0 10 10"/>
        </Grid>
        <Grid Grid.Row="1">
            <ListView x:Name="MusicListView" 
            DoubleTapped="MusicListView_DoubleTapped" 
            ItemContainerStyle="{StaticResource ListViewItemStyle}" 
            RightTapped="MusicListView_RightTapped"
            SelectionMode="Extended"
            CanDragItems="True"
            CanReorderItems="True"
            AllowDrop="True">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Music">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="0.5*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="isFavouriteIconButton"  
                                Grid.Column="0"                            
                                Tag="{x:Bind}" 
                                Click="IsFavouriteIconButton_Click"
                                VerticalAlignment="Center" 
                                Margin="5" BorderThickness="0" 
                                BorderBrush="Transparent" 
                                Background="Transparent" >
                                <FontIcon x:Name="IsFavouriteIcon" Glyph="{x:Bind isFavorite,Mode=OneWay, Converter={StaticResource FavouriteIconConverter}}" Foreground="Red"/>
                            </Button>
                            <TextBlock Text="{x:Bind Title,Mode=OneWay}" Grid.Column="1" Margin="5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Author,Mode=OneWay}" 
                                Grid.Column="2" 
                                Margin="5" 
                                VerticalAlignment="Center" 
                                TextTrimming="CharacterEllipsis" 
                                Tapped="AuthorTextBlock_Tapped"/>
                            <TextBlock Text="{x:Bind Album,Mode=OneWay}" Grid.Column="3" Margin="5" VerticalAlignment="Center" 
                                TextTrimming="CharacterEllipsis"
                                Tapped="AlbumTextBlock_Tapped" />
                            <Image Source="ms-appx:///Assets/hr.png" Height="10" Grid.Column="4" Margin="5" VerticalAlignment="Center">
                                <attached:MultiValueBindingHelper.Bindings>
                                    <attached:MultiBindingInfo>
                                        <attached:MultiBindingInfo.Binding1>
                                            <Binding Path="SampleRate"/>
                                        </attached:MultiBindingInfo.Binding1>
                                        <attached:MultiBindingInfo.Binding2>
                                            <Binding Path="BitDepth"/>
                                        </attached:MultiBindingInfo.Binding2>
                                        <attached:MultiBindingInfo.Converter>
                                            <converters:SampleRateBitDepthConverter/>
                                        </attached:MultiBindingInfo.Converter>
                                    </attached:MultiBindingInfo>
                                </attached:MultiValueBindingHelper.Bindings>
                            </Image>
                            <TextBlock Text="{x:Bind Duration, Converter={StaticResource TimeSpanToStringConverter}}" Grid.Column="5" Margin="5" VerticalAlignment="Center"  />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
