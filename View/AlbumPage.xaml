<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.AlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:WinUIMusicPlayer.Extensions"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">
    <Grid Margin="0">
        <SemanticZoom>
            <!--  详细视图 (ZoomedInView)  -->
            <SemanticZoom.ZoomedInView>
                <GridView
                    x:Name="AlbumGridView"
                    Margin="10,0,0,0"
                    IsItemClickEnabled="True"
                    IsRightTapEnabled="True"
                    ItemClick="AlbumGridView_ItemClick"
                    ItemsSource="{x:Bind ViewModel.AppViewModel.AlbumPageSource.View, Mode=OneWay}"
                    RightTapped="Album_RightTapped"
                    SelectionMode="None">
                    <GridView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                            <Setter Property="ContextFlyout">
                                <Setter.Value>
                                    <MenuFlyout extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.AlbumMenuOptions, Mode=OneWay}" />
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="model:MusicGroup">
                                    <TextBlock
                                        Margin="10,0,5,5"
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Key}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.HeaderContainerStyle>
                                <StaticResource ResourceKey="NoBorderGridViewHeaderItemStyle" />
                            </GroupStyle.HeaderContainerStyle>
                        </GroupStyle>
                    </GridView.GroupStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="model:Music">
                            <Grid
                                Height="205"
                                Margin="5,10,5,10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Width="150"
                                    Height="150">
                                    <!--  图片在下层  -->
                                    <Border
                                        Width="150"
                                        Height="150"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="5">
                                        <Grid>
                                            <Image
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Canvas.ZIndex="1"
                                                Stretch="UniformToFill">
                                                <interactivity:Interaction.Behaviors>
                                                    <behaviors:AlbumCoverBehavior Music="{x:Bind Mode=OneWay}" />
                                                </interactivity:Interaction.Behaviors>
                                            </Image>
                                            <Grid
                                                Width="150"
                                                Height="150"
                                                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                                Canvas.ZIndex="0">
                                                <FontIcon
                                                    Canvas.ZIndex="0"
                                                    FontSize="50"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE93C;" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <!--  图标位于右下角  -->
                                    <FontIcon
                                        x:Name="IsExistOnDeviceIcon"
                                        Margin="0,0,5,5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        FontSize="16"
                                        Glyph="{x:Bind IsExistOnDevice, Mode=OneWay, Converter={StaticResource IsExistOnDeviceConverter}}" />
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Width="150"
                                    MaxHeight="40"
                                    Margin="0"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Album, Mode=OneWay}"
                                    TextAlignment="Left"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <Grid Grid.Row="3" Width="150">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Height="15"
                                        Margin="0"
                                        HorizontalAlignment="Stretch"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Author, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Height="15"
                                        Margin="0"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind tool:BindUtils.AlbumSongsConverter(Album)}" />
                                    <TextBlock
                                        x:Uid="AlbumSongs"
                                        Grid.Column="2"
                                        Height="15"
                                        Margin="0"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </SemanticZoom.ZoomedInView>

            <!--  概览视图 (ZoomedOutView)  -->
            <SemanticZoom.ZoomedOutView>
                <GridView
                    x:Name="ZoomedOutGridView"
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsItemClickEnabled="True"
                    ItemsSource="{x:Bind ViewModel.AppViewModel.AlbumPageSource.View.CollectionGroups, Mode=OneWay}"
                    ScrollViewer.IsHorizontalScrollChainingEnabled="False"
                    ScrollViewer.IsVerticalScrollChainingEnabled="False"
                    ScrollViewer.ZoomMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="ICollectionViewGroup">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="32"
                                Text="{x:Bind Group.(model:MusicGroup.Key), Mode=OneWay}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </SemanticZoom.ZoomedOutView>
        </SemanticZoom>
    </Grid>
</Page>
