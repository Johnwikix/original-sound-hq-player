<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.AlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">
    <Grid Margin="0">
        <GridView
            x:Name="AlbumGridView"
            IsItemClickEnabled="True"
            IsRightTapEnabled="True"
            ItemClick="AlbumGridView_ItemClick"
            ItemsSource="{Binding ViewModel.MusicList, Mode=TwoWay}"
            RightTapped="Album_RightTapped"
            VirtualizingStackPanel.VirtualizationMode="Recycling">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel
                        Height="205"
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Grid Width="150" Height="150">
                            <!--  图片在下层  -->
                            <Border
                                Width="150"
                                Height="150"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="5">
                                <Grid>
                                    <Image
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CacheMode="BitmapCache"
                                        Canvas.ZIndex="1"
                                        Source="{Binding Cover}"
                                        Stretch="UniformToFill" />
                                    <Grid
                                        Width="150"
                                        Height="150"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        Canvas.ZIndex="0"
                                        Visibility="{Binding Cover, Converter={StaticResource IsCoverExistToVisibleConverter}, Mode=OneWay}">
                                        <FontIcon
                                            Canvas.ZIndex="0"
                                            FontSize="50"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE93C;" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <!--  图标位于右下角  -->
                            <FontIcon
                                x:Name="IsExistOnDeviceIcon"
                                Margin="0,0,5,5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="16"
                                Glyph="{Binding IsExistOnDevice, Mode=OneWay, Converter={StaticResource IsExistOnDeviceConverter}}" />
                        </Grid>
                        <TextBlock
                            Width="150"
                            MaxHeight="40"
                            Margin="0"
                            FontWeight="SemiBold"
                            Text="{Binding Album, Mode=OneWay}"
                            TextAlignment="Left"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Width="150"
                            Height="15"
                            Margin="0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Author, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
