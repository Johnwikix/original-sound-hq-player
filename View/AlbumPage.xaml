<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIMusicPlayer.View.AlbumPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
>
    <Page.Resources>
        <converters:IsExistOnDeviceConverter x:Key="IsExistOnDeviceConverter"/>
    </Page.Resources>
    <Grid Margin="0">
        <GridView x:Name="AlbumGridView"   
                  IsItemClickEnabled="True"
                  ItemsSource="{Binding ViewModel.MusicList,Mode=TwoWay}"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ItemClick="AlbumGridView_ItemClick"
                  IsRightTapEnabled="True"
                  RightTapped="Album_RightTapped"
                  >
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                        <Grid Width="150" Height="150">
                            <!-- 图片在下层 -->
                            <Image x:Name="AlbumCoverImage" 
                                Width="150" Height="150" 
                                Stretch="Uniform" 
                                Source="{Binding Cover, FallbackValue='ms-appx:///Assets/Album.png'}" 
                                CacheMode="BitmapCache" />
                            <!-- 图标位于右下角 -->
                            <FontIcon 
                                x:Name="IsExistOnDeviceIcon" 
                                FontSize="16" 
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,5,5"
                                Glyph="{Binding IsExistOnDevice, Mode=OneWay, Converter={StaticResource IsExistOnDeviceConverter}}"/>
                        </Grid>
                        <TextBlock 
                             Height="60" 
                             HorizontalAlignment="Center" 
                             Width="150" 
                             TextWrapping="Wrap" 
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding Album,Mode=OneWay}" 
                             TextAlignment="Center" 
                             Margin="0"
                             VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView> 
    </Grid>
</Page>
