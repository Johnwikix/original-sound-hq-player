<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.AlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">
    <Grid Margin="0">
        <GridView
            x:Name="AlbumGridView"
            IsItemClickEnabled="True"
            IsRightTapEnabled="True"
            ItemClick="AlbumGridView_ItemClick"
            ItemsSource="{Binding ViewModel.MusicList, Mode=TwoWay}"
            RightTapped="Album_RightTapped"
            VirtualizingStackPanel.VirtualizationMode="Recycling">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="150" Height="150">
                            <!--  图片在下层  -->
                            <Image
                                x:Name="AlbumCoverImage"
                                Width="150"
                                Height="150"
                                CacheMode="BitmapCache"
                                Source="{Binding Cover, FallbackValue='ms-appx:///Assets/Album.png'}"
                                Stretch="Uniform" />
                            <!--  图标位于右下角  -->
                            <FontIcon
                                x:Name="IsExistOnDeviceIcon"
                                Margin="0,0,5,5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="16"
                                Glyph="{Binding IsExistOnDevice, Mode=OneWay, Converter={StaticResource IsExistOnDeviceConverter}}" />
                        </Grid>
                        <TextBlock
                            Width="150"
                            Height="60"
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Album, Mode=OneWay}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
