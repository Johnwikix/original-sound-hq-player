<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.SongCollectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    mc:Ignorable="d">
    <Page.Resources>
        <Style
            x:Key="ListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="ContextFlyout">
                <Setter.Value>
                    <MenuFlyout x:Name="menuFlyout">
                        <MenuFlyoutItem x:Uid="FlyoutPlayItem" Click="PlayMenuItem_Click" />
                        <MenuFlyoutItem x:Uid="FlyoutFavoriteItem" Click="SetAsFavoriteMenuItem_Click" />
                        <MenuFlyoutSubItem x:Uid="FlyoutAddToPlaylistItem" Tag="playList" />
                        <MenuFlyoutSubItem x:Uid="FlyoutConvertItem">
                            <MenuFlyoutItem
                                x:Uid="FlyoutConvertWavItem"
                                Click="ConvertAudio_Click"
                                Tag="wav" />
                            <MenuFlyoutItem
                                x:Uid="FlyoutConvertMp3Item"
                                Click="ConvertAudio_Click"
                                Tag="mp3" />
                            <MenuFlyoutItem
                                x:Uid="FlyoutConvertFlacItem"
                                Click="ConvertAudio_Click"
                                Tag="flac" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem x:Uid="FlyoutAddToCurrentPlayList" Click="FlyoutAddToCurrentPlayList_Click" />
                        <MenuFlyoutItem x:Uid="ReGetLyrics" Click="ReGetLyrics_Click" />
                        <MenuFlyoutItem x:Uid="FlyoutOpenLocationItem" Click="OpenInExplorer_Click" />
                        <MenuFlyoutItem x:Uid="FlyoutPropertiesItem" Click="MusicDetail_Click" />
                        <MenuFlyoutItem x:Uid="FlyoutDeleteItem" Click="DeleteMenuItem_Click" />
                    </MenuFlyout>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="DetailInfoBar"
            Grid.Row="0"
            Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{Binding ViewModel.CurrentPageType, Converter={StaticResource SongCollectionPageTypeToRadiusConverter}, Mode=OneWay}">
                <Grid>
                    <Grid
                        x:Name="AlbumCoverImage"
                        Width="150"
                        Height="150"
                        Canvas.ZIndex="1">
                        <Image
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CacheMode="BitmapCache"
                            Canvas.ZIndex="1"
                            Source="{Binding ViewModel.CurrentMusicObject, Converter={StaticResource AlbumArtConverter}, Mode=OneWay}"
                            Stretch="UniformToFill" />
                    </Grid>
                    <Grid
                        Width="150"
                        Height="150"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                        Canvas.ZIndex="0">
                        <FontIcon
                            Canvas.ZIndex="0"
                            FontSize="50"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{Binding ViewModel.CurrentPageType, Converter={StaticResource SongCollectionPageTypeToIconConverter}, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Width="Auto">
                <Grid.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                    </TransitionCollection>
                </Grid.Transitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="TitleTextBlock"
                    Grid.Row="0"
                    Margin="20,0,10,0"
                    FontSize="30"
                    FontWeight="Bold"
                    Text="{Binding ViewModel.FirstTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="SecondaryTitleTextBlock"
                    Grid.Row="1"
                    Margin="20,0,10,0"
                    VerticalAlignment="Bottom"
                    FontSize="20"
                    Text="{Binding ViewModel.SecondTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="ThirdTitleTextBlock"
                    Grid.Row="2"
                    Margin="20,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding ViewModel.ThirdTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Grid
                    Grid.Row="3"
                    Margin="10,0,10,0"
                    VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        Command="{Binding ViewModel.PlayAllCommand, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE768;" />
                                <TextBlock x:Uid="PlayAll" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="AddToPlayListBtn"
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        Click="AddToPlayListBtn_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE710;" />
                                <TextBlock x:Uid="AddTo" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button.Content>
                        <Button.Flyout>
                            <MenuFlyout x:Name="PlayList" />
                        </Button.Flyout>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Margin="10,0,10,0"
                        Command="{Binding ViewModel.AlbumInfoChangedCommand, Mode=OneWay}"
                        Visibility="{Binding ViewModel.CurrentPageType, Converter={StaticResource SongCollectionPageTypeToEditVisibleConverter}, Mode=OneWay}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE70F;" />
                                <TextBlock x:Uid="Edit" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
        <ListView
            x:Name="MusicListView"
            Grid.Row="1"
            DoubleTapped="MusicListView_DoubleTapped"
            ItemContainerStyle="{StaticResource ListViewItemStyle}"
            ItemsSource="{Binding ViewModel.MusicList, Mode=TwoWay}"
            RightTapped="MusicListView_RightTapped"
            SelectedItem="{Binding ViewModel.SelectedMusic, Mode=TwoWay}"
            SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Music">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="0.25*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="CoverThumbnail"
                            Grid.Column="0"
                            Margin="0,5,10,5"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{Binding ElementName=MusicListView, Path=DataContext.ViewModel.PlayMusicCommand}"
                            CommandParameter="{Binding}"
                            CornerRadius="5"
                            Style="{StaticResource PlayHoverButtonStyle}">
                            <Grid Width="40" Height="40">
                                <Image
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Canvas.ZIndex="1"
                                    Source="{Binding Converter={StaticResource AlbumArtConverter}}"
                                    Stretch="UniformToFill">
                                    <Image.Transitions>
                                        <TransitionCollection>
                                            <ContentThemeTransition />
                                        </TransitionCollection>
                                    </Image.Transitions>
                                </Image>
                                <Grid
                                    Width="40"
                                    Height="40"
                                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                    Canvas.ZIndex="0">
                                    <FontIcon
                                        Canvas.ZIndex="0"
                                        FontSize="15"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE93C;" />
                                </Grid>
                            </Grid>
                        </Button>
                        <Button
                            x:Name="isFavouriteIconButton"
                            Grid.Column="1"
                            Margin="0,5,5,5"
                            Padding="3"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{Binding DataContext.ViewModel.IsFavouriteIconButtonChangeCommand, ElementName=MusicListView, Mode=OneWay}"
                            CommandParameter="{x:Bind}">
                            <FontIcon
                                x:Name="IsFavouriteIcon"
                                Foreground="Red"
                                Glyph="{x:Bind IsFavorite, Mode=TwoWay, Converter={StaticResource FavouriteIconConverter}}" />
                        </Button>
                        <TextBlock
                            Grid.Column="2"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="3"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Tapped="AuthorTextBlock_Tapped"
                            Text="{x:Bind Author, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="4"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Tapped="AlbumTextBlock_Tapped"
                            Text="{x:Bind Album, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="5"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{x:Bind DiskNumber, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="6"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{x:Bind TrackNumber, Mode=OneWay}" />
                        <Image
                            Grid.Column="7"
                            Height="14"
                            Margin="5"
                            VerticalAlignment="Center"
                            Source="{x:Bind Converter={StaticResource MusicStatusToHRimgConverter}, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="8"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{x:Bind Duration, Converter={StaticResource TimeSpanToStringConverter}}" />
                        <Button
                            Grid.Column="9"
                            Margin="5"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{Binding DataContext.ViewModel.AddMusicToCurrentPlayListCommand, ElementName=MusicListView, Mode=OneWay}"
                            CommandParameter="{x:Bind}">
                            <FontIcon
                                Margin="0,2,0,0"
                                VerticalAlignment="Center"
                                Glyph="&#xE710;" />
                        </Button>
                        <FontIcon
                            x:Name="IsExistOnDeviceIcon"
                            Grid.Column="10"
                            FontSize="14"
                            Glyph="{x:Bind IsExistOnDevice, Mode=OneWay, Converter={StaticResource IsExistOnDeviceConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
