<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Uid="ListeningReportPreviewDialog"
    x:Class="WinUIMusicPlayer.View.ListeningReportPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinUIMusicPlayer.ViewModel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSavePreview, Mode=OneWay}"
    PrimaryButtonClick="Save_Click" Closing="Dialog_Closing">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">584</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">940</x:Double>
        <Thickness x:Key="ContentDialogPadding">20</Thickness>
        <DataTemplate x:Key="PosterTemplate" x:DataType="vm:ListeningReportViewModel">
            <Grid x:Name="PosterCanvas" Width="540" Height="675">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#182A29" Offset="0" />
                        <GradientStop Color="#102021" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Image Source="{x:Bind PreviewBackground, Mode=OneWay}" Stretch="Fill" IsHitTestVisible="False" />
                <Grid Padding="34" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                    <TextBlock Text="OriginalSound" Foreground="#FFE1C8" FontWeight="SemiBold" CharacterSpacing="128" />
                    <StackPanel Grid.Row="1" Margin="0,19,0,20" Spacing="4">
                        <TextBlock Text="{x:Bind Presentation.Heading, Mode=OneWay}" Foreground="#FFF6E6"
                                   FontSize="35" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Presentation.Coverage, Mode=OneWay}" Foreground="#F8E9D8"
                                   FontSize="14" TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnDefinitions="*,130" ColumnSpacing="18" VerticalAlignment="Center">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind Presentation.Duration, Mode=OneWay}" Foreground="#FFF6E6"
                                       FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Uid="ListeningReportDuration" Foreground="#F8E9D8" FontSize="15" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,11,0,0">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Presentation.PlayCount, Mode=OneWay}" Foreground="#FFF6E6" FontSize="23" FontWeight="SemiBold" />
                                    <TextBlock x:Uid="ListeningReportPlays" Foreground="#F8E9D8" FontSize="14" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Presentation.ActiveDays, Mode=OneWay}" Foreground="#FFF6E6" FontSize="23" FontWeight="SemiBold" />
                                    <TextBlock x:Uid="ListeningReportDays" Foreground="#F8E9D8" FontSize="14" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="130" Height="130" VerticalAlignment="Center">
                            <Ellipse Fill="#293C3C" />
                            <Ellipse Width="104" Height="104" Stroke="#506566" StrokeThickness="1" />
                            <Ellipse Width="82" Height="82" Stroke="#506566" StrokeThickness="1" />
                            <Ellipse Width="49" Height="49" Fill="#FFE1C8" />
                            <Ellipse Width="7" Height="7" Fill="#293C3C" />
                            <Border x:Name="PosterCover" CornerRadius="12">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind PreviewCover, Mode=OneWay}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="3*,2*" ColumnSpacing="20" Margin="0,12,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Presentation.TrackVariety.Label, Mode=OneWay}" Foreground="#FFE1C8" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Presentation.TrackVariety.Value, Mode=OneWay}" Foreground="#FFF6E6" FontSize="17" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" Visibility="{x:Bind Presentation.PeakHour.Visibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Presentation.PeakHour.Label, Mode=OneWay}" Foreground="#FFE1C8" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Presentation.PeakHour.Value, Mode=OneWay}" Foreground="#FFF6E6" FontSize="17" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="4" ColumnDefinitions="3*,2*" ColumnSpacing="20" Margin="0,18,0,16">
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="ListeningReportTopSongs" Foreground="#FFE1C8" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Presentation.PosterSongs, Mode=OneWay}" Foreground="#FFF6E6"
                                       FontSize="17" TextTrimming="CharacterEllipsis" LineHeight="24" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" Visibility="{x:Bind Presentation.PosterArtistVisibility, Mode=OneWay}">
                            <TextBlock x:Uid="ListeningReportTopArtist" Foreground="#FFE1C8" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Presentation.PosterArtist, Mode=OneWay}" Foreground="#FFF6E6"
                                       FontSize="17" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="5" Spacing="3">
                        <Rectangle Height="1" Fill="#4F6666" Margin="0,2,0,8" />
                        <TextBlock Text="{x:Bind Presentation.Zone, Mode=OneWay}" Foreground="#F8E9D8" FontSize="12" TextWrapping="Wrap" MaxLines="2" />
                        <TextBlock Text="{x:Bind Presentation.Footnote, Mode=OneWay}" Foreground="#F8E9D8" FontSize="12" TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid RowDefinitions="*,Auto,Auto">
        <Grid x:Name="PreviewViewport">
            <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly">
                <ContentPresenter x:Name="PosterPreview" Content="{x:Bind ViewModel}" ContentTemplate="{StaticResource PosterTemplate}" />
            </Viewbox>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,12,0,0">
            <ComboBox x:Name="ShaderPicker" x:Uid="ListeningReportShader" HorizontalAlignment="Stretch"
                      IsEnabled="{x:Bind ViewModel.CanSelectShader, Mode=OneWay}"
                      SelectedIndex="{x:Bind ViewModel.SelectedShaderIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="BackgroundShader_Fluid" />
                <ComboBoxItem x:Uid="BackgroundShader_PS3XMB" />
                <ComboBoxItem x:Uid="BackgroundShader_RotatingMesh" />
                <ComboBoxItem x:Uid="BackgroundShader_LiquidFlow" />
                <ComboBoxItem x:Uid="BackgroundShader_GradientFlow" />
                <ComboBoxItem x:Uid="BackgroundShader_WavyBackground" />
                <ComboBoxItem x:Uid="BackgroundShader_ChromaticResonance" />
            </ComboBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Height="32">
                <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsPreviewBusy, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ImageDimensions}" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                   Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.SaveStatus, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.SaveStatusVisibility, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</ContentDialog>
