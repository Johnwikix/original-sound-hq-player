<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="WinUIMusicPlayer.View.SubView.AlbumDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View.SubView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    Title="专辑属性"
    MinWidth="550"
    MinHeight="700"
    mc:Ignorable="d">

    <winex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </winex:WindowEx.SystemBackdrop>
    <Grid>
        <Grid
            x:Name="AlbumDetailTitleBar"
            Height="44"
            Margin="0"
            Padding="0"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="AlbumDetailTitleBar"
                Grid.Column="1"
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <Grid x:Name="LoadingGrid" Visibility="Collapsed">
            <ProgressRing
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />
            <TextBlock
                x:Uid="LoadingTextBlock"
                Margin="0,180,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="AlbumDetail">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,50,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        CornerRadius="10">
                        <Grid>
                            <Image Canvas.ZIndex="1" Source="{x:Bind AlbumCoverBitmap, Mode=TwoWay}" />
                            <Grid
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                Canvas.ZIndex="0">
                                <Viewbox Stretch="Uniform">
                                    <Border
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                                        <!--  图标层  -->
                                        <FontIcon
                                            Width="200"
                                            Height="200"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Canvas.ZIndex="1"
                                            FontSize="100"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE93C;" />
                                    </Border>
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <Button
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Click="GetImageFromNet_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon FontSize="16" Glyph="&#xebd3;" />
                                        </StackPanel>
                                    </Button.Content>
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="GetImageFromNetButton" />
                                    </ToolTipService.ToolTip>
                                </Button>
                                <Button
                                    Margin="5"
                                    HorizontalAlignment="Stretch"
                                    Click="SaveImageButton_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon FontSize="16" Glyph="&#xe78c;" />
                                        </StackPanel>
                                    </Button.Content>
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="SaveImageButton" />
                                    </ToolTipService.ToolTip>
                                </Button>
                                <Button
                                    Margin="5"
                                    HorizontalAlignment="Stretch"
                                    Click="SelectCoverImageButton_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon FontSize="16" Glyph="&#xe70f;" />
                                        </StackPanel>
                                    </Button.Content>
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="SelectCoverImageButton" />
                                    </ToolTipService.ToolTip>
                                </Button>
                            </StackPanel>
                            <TextBlock
                                x:Uid="TitleLabel"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="10,5,0,5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontWeight="Bold" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="5"
                                HorizontalAlignment="Stretch"
                                BorderThickness="0"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                Text="{x:Bind MusicDetail.Album, Mode=TwoWay}" />
                            <TextBlock
                                x:Uid="YearLabel"
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="10,5,0,5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontWeight="Bold" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="4"
                                Margin="5,5,10,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                Text="{x:Bind MusicDetail.Year, Mode=TwoWay}" />
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button x:Uid="SaveButton" Margin="5">
                    <Button.Flyout>
                        <Flyout x:Name="ConfirmFlyout">
                            <StackPanel>
                                <TextBlock
                                    x:Uid="SaveConfirm"
                                    Margin="0,0,0,12"
                                    Style="{ThemeResource BaseTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        x:Uid="ConfirmButton"
                                        Margin="0,0,10,0"
                                        Click="ConfirmButton_Click" />
                                    <Button
                                        x:Uid="CancelButton"
                                        Margin="0,0,10,0"
                                        Click="CloseFlyoutButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Uid="SaveToDataBase"
                    Margin="5"
                    Click="SaveToDataBaseButton_Click" />
                <Button
                    x:Uid="CloseButtonItem"
                    Margin="5"
                    Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</winex:WindowEx>
