<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.AddPlayListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CornerRadius="10"
    mc:Ignorable="d">
    <StackPanel MinWidth="300" Spacing="16">
        <Button
            x:Name="ImportM3u8Button"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="ImportM3u8Button_Click">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon
                    Margin="0,1,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Glyph="&#xE8B5;" />
                <TextBlock x:Name="ImportButtonText" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <TextBox x:Name="NameTextBox" />
        <Grid Margin="0,8,0,0" ColumnSpacing="8" ColumnDefinitions="*,*">
            <Button
                x:Name="ConfirmButton"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="ConfirmButton_Click"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="CancelButton"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="CancelButton_Click"
                CornerRadius="{ThemeResource ControlCornerRadius}" />
        </Grid>
    </StackPanel>
</ContentDialog>
