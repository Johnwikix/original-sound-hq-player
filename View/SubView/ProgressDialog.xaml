<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.ProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View.SubView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="处理中..."
    mc:Ignorable="d">

    <Grid>
        <StackPanel>
            <ProgressRing x:Name="progressRing" IsActive="True"/>
            <TextBlock x:Name="statusText" Margin="0,10,0,0"/>
            <ProgressBar x:Name="progressBar" Value="0" Minimum="0" Maximum="100" Margin="0,10,0,0"/>
            <TextBlock x:Name="progressText" Text="0%" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</ContentDialog>
