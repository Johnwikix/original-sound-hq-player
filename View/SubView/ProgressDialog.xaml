<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.ProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View.SubView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CornerRadius="10"
    mc:Ignorable="d">

    <Grid>
        <StackPanel>
            <ProgressRing x:Name="progressRing" IsActive="True" />
            <TextBlock x:Name="statusText" Margin="0,10,0,0" />
            <ProgressBar
                x:Name="progressBar"
                Margin="0,10,0,0"
                Maximum="100"
                Minimum="0"
                Value="0" />
            <TextBlock
                x:Name="progressText"
                Margin="0,10,0,0"
                Text="0%" />
        </StackPanel>
    </Grid>
</ContentDialog>
