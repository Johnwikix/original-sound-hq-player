<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.View.SubView.Settings.CoverBackgroundSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:customControl="using:WinUIMusicPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}">
        <Grid Style="{StaticResource SettingsGridStyle}">
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition IsStaggeringEnabled="True" />
                </StackPanel.ChildrenTransitions>

                <TextBlock
                    x:Uid="SettingCover"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard Description="{x:Bind tool:ToolUtils.GetString('CoverSizeToolTip'), Mode=OneWay}">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="CoverSize" />
                    </controls:SettingsCard.Header>
                    <NumberBox
                        x:Name="CoverSize"
                        Width="300"
                        LargeChange="10"
                        Minimum="0"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.AppViewModel.CoverSize, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock
                            x:Uid="AutoCoverMatching"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ToggleSwitch
                        MinWidth="0"
                        IsOn="{x:Bind ViewModel.AppViewModel.IsAutoCoverEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="PlaybackTitleEffect" />
                    </controls:SettingsCard.Header>
                    <ComboBox
                        Width="300"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.AppViewModel.TextEffectItems}"
                        SelectedItem="{x:Bind ViewModel.AppViewModel.Win2dTextEffectType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="model:EffectComboBoxItem">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock
                            x:Uid="MusicInfoVisible"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ToggleSwitch
                        MinWidth="0"
                        IsOn="{x:Bind ViewModel.AppViewModel.IsMusicInfoVisible, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard Description="{x:Bind tool:ToolUtils.GetString('ForceLeftWhenOff'), Mode=OneWay}">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="UseAlignmentInPortrait" />
                    </controls:SettingsCard.Header>
                    <Grid Width="300" ColumnDefinitions="Auto,*">
                        <ToggleSwitch
                            Grid.Column="0"
                            MinWidth="0"
                            Margin="0,0,10,0"
                            IsOn="{x:Bind ViewModel.AppViewModel.UsePlayingDetailAlignmentInPortrait, Mode=TwoWay}" />
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectedValue="{x:Bind ViewModel.AppViewModel.PlayingDetailAlignment, Mode=TwoWay, Converter={StaticResource EnumToStringConverter}}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem x:Uid="Left" Tag="Left" />
                            <ComboBoxItem x:Uid="Center" Tag="Center" />
                            <ComboBoxItem x:Uid="Right" Tag="Right" />
                        </ComboBox>
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsExpander
                    Header="{x:Bind tool:ToolUtils.GetString('PlaybackHdr')}"
                    Description="{x:Bind ViewModel.AppViewModel.PlaybackHdrStatusText, Mode=OneWay}">
                    <ToggleSwitch
                        MinWidth="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind tool:ToolUtils.GetString('PlaybackHdr')}"
                        IsOn="{x:Bind ViewModel.AppViewModel.PlaybackHdrEnabled, Mode=TwoWay}" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            Header="{x:Bind tool:ToolUtils.GetString('PlaybackHdrWhite')}"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.PlaybackHdrEnabled, Mode=OneWay}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Slider
                                    Width="200"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="PlaybackHdrReferenceWhiteNits"
                                    AutomationProperties.Name="{x:Bind tool:ToolUtils.GetString('PlaybackHdrWhite')}"
                                    Minimum="80"
                                    Maximum="1000"
                                    StepFrequency="10"
                                    Value="{x:Bind ViewModel.AppViewModel.PlaybackHdrReferenceWhiteNits, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    MinWidth="60"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.AppViewModel.FormatPlaybackHdrNits(ViewModel.AppViewModel.PlaybackHdrReferenceWhiteNits), Mode=OneWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Header="{x:Bind tool:ToolUtils.GetString('PlaybackHdrPeak')}"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.PlaybackHdrEnabled, Mode=OneWay}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Slider
                                    Width="200"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="PlaybackHdrPeakNits"
                                    AutomationProperties.Name="{x:Bind tool:ToolUtils.GetString('PlaybackHdrPeak')}"
                                    Minimum="80"
                                    Maximum="4000"
                                    StepFrequency="10"
                                    Value="{x:Bind ViewModel.AppViewModel.PlaybackHdrPeakNits, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    MinWidth="60"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.AppViewModel.FormatPlaybackHdrNits(ViewModel.AppViewModel.PlaybackHdrPeakNits), Mode=OneWay}" />
                            </Grid>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <TextBlock
                    x:Uid="ShaderBackgroundExpander"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="ShaderBackground" />
                    </controls:SettingsCard.Header>
                    <Grid Width="300" ColumnDefinitions="Auto,*">
                        <ToggleSwitch
                            Grid.Column="0"
                            MinWidth="0"
                            Margin="0,0,10,0"
                            IsOn="{x:Bind ViewModel.AppViewModel.IsFluidBackgroundEnabled, Mode=TwoWay}" />
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.IsFluidBackgroundEnabled, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.AppViewModel.BackgroundShaderIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="BackgroundShader_Fluid" />
                            <ComboBoxItem x:Uid="BackgroundShader_PS3XMB" />
                            <ComboBoxItem x:Uid="BackgroundShader_RotatingMesh" />
                            <ComboBoxItem x:Uid="BackgroundShader_LiquidFlow" />
                            <ComboBoxItem x:Uid="BackgroundShader_GradientFlow" />
                            <ComboBoxItem x:Uid="BackgroundShader_WavyBackground" />
                            <ComboBoxItem x:Uid="BackgroundShader_ChromaticResonance" />
                        </ComboBox>
                    </Grid>
                </controls:SettingsCard>

                <controls:SettingsExpander
                    Header="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrum')}"
                    Description="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumDescription')}"
                    IsEnabled="{x:Bind ViewModel.AppViewModel.IsFluidBackgroundEnabled, Mode=OneWay}">
                    <ToggleSwitch
                        MinWidth="0"
                        AutomationProperties.AutomationId="PlaybackSpectrumToggle"
                        AutomationProperties.Name="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrum')}"
                        IsOn="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Enabled, Mode=TwoWay}" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumColor')}"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Enabled, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox Width="200" SelectedIndex="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.ColorMode, Mode=TwoWay}">
                                    <ComboBoxItem Content="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumAdaptiveColor')}" />
                                    <ComboBoxItem Content="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumAdaptiveGray')}" />
                                    <ComboBoxItem Content="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumCustom')}" />
                                </ComboBox>
                                <controls:ColorPickerButton
                                    SelectedColor="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.CustomColor, Mode=TwoWay}"
                                    Visibility="{x:Bind tool:BindUtils.BoolToVisibilityConverter(ViewModel.AppViewModel.PlaybackSpectrum.IsCustomColor), Mode=OneWay}" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumOpacity')}"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Enabled, Mode=OneWay}">
                            <NumberBox Width="200" Minimum="0" Maximum="100" SmallChange="1" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Opacity, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumPosition')}"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Enabled, Mode=OneWay}">
                            <ComboBox Width="200" SelectedIndex="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Placement, Mode=TwoWay}">
                                <ComboBoxItem Content="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumTop')}" />
                                <ComboBoxItem Content="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumBottom')}" />
                                <ComboBoxItem Content="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumAroundArtwork')}" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumStyle')}"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Enabled, Mode=OneWay}">
                            <ComboBox Width="200" SelectedIndex="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Style, Mode=TwoWay}">
                                <ComboBoxItem Content="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumCurve')}" />
                                <ComboBoxItem Content="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumBars')}" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumCount')}"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Enabled, Mode=OneWay}">
                            <NumberBox Width="200" Minimum="1" Maximum="1024" SmallChange="1" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Count, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumSensitivity')}"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Enabled, Mode=OneWay}">
                            <NumberBox Width="200" Minimum="50" Maximum="500" SmallChange="1" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Sensitivity, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumDelay')}"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Enabled, Mode=OneWay}">
                            <NumberBox Width="200" Minimum="0" Maximum="2000" SmallChange="1" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.DelayMs, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumBreathing')}"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Enabled, Mode=OneWay}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <ToggleSwitch MinWidth="0" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Breathing, Mode=TwoWay}" />
                                <NumberBox Grid.Column="1" Width="140" VerticalAlignment="Center"
                                    Minimum="0" Maximum="200" SmallChange="1" SpinButtonPlacementMode="Inline"
                                    AutomationProperties.Name="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumBreathingIntensity')}"
                                    IsEnabled="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Breathing, Mode=OneWay}" Value="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.BreathingIntensity, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('PlaybackSpectrumGlow')}"
                            IsEnabled="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Enabled, Mode=OneWay}">
                            <ToggleSwitch MinWidth="0" IsOn="{x:Bind ViewModel.AppViewModel.PlaybackSpectrum.Glow, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard IsEnabled="{x:Bind tool:BindUtils.IsLightWaveEnabled(ViewModel.AppViewModel.IsFluidBackgroundEnabled, ViewModel.AppViewModel.BackgroundShaderIndex), Mode=OneWay}">
                    <controls:SettingsCard.Header>
                        <TextBlock
                            x:Uid="EnableLightWave"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ToggleSwitch
                        MinWidth="0"
                        IsOn="{x:Bind ViewModel.AppViewModel.EnableLightWave, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard IsEnabled="{x:Bind ViewModel.AppViewModel.IsFluidBackgroundEnabled, Mode=OneWay}">
                    <controls:SettingsCard.Header>
                        <TextBlock
                            x:Uid="FogEffect"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ToggleSwitch
                        MinWidth="0"
                        IsOn="{x:Bind ViewModel.AppViewModel.IsFogEffectEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard IsEnabled="{x:Bind ViewModel.AppViewModel.IsFluidBackgroundEnabled, Mode=OneWay}">
                    <controls:SettingsCard.Header>
                        <TextBlock
                            x:Uid="SnowEffect"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ToggleSwitch
                        MinWidth="0"
                        IsOn="{x:Bind ViewModel.AppViewModel.IsSnowEffectEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard IsEnabled="{x:Bind ViewModel.AppViewModel.IsFluidBackgroundEnabled, Mode=OneWay}">
                    <controls:SettingsCard.Header>
                        <TextBlock
                            x:Uid="RaindropEffect"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ToggleSwitch
                        MinWidth="0"
                        IsOn="{x:Bind ViewModel.AppViewModel.IsRaindropEffectEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard IsEnabled="{x:Bind ViewModel.AppViewModel.IsFluidBackgroundEnabled, Mode=OneWay}">
                    <controls:SettingsCard.Header>
                        <TextBlock
                            x:Uid="PaletteAlgorithm"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ComboBox
                        Width="300"
                        SelectedIndex="{x:Bind ViewModel.AppViewModel.PaletteAlgorithmIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="K-Means++" />
                        <ComboBoxItem Content="OctTree" />
                    </ComboBox>
                </controls:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
