<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.View.SubView.Settings.LastFmSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:tool="using:WinUIMusicPlayer.Utils">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <TextBlock Text="Last.fm" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
        <controls:SettingsCard Header="{x:Bind ViewModel.AccountText, Mode=OneWay}"
                               Description="{x:Bind tool:ToolUtils.GetString('LastFmEnableDescription')}">
            <ToggleSwitch AutomationProperties.AutomationId="LastFmEnabled"
                AutomationProperties.Name="{x:Bind tool:ToolUtils.GetString('LastFmEnable')}"
                MinWidth="0" VerticalAlignment="Center"
                IsEnabled="{x:Bind ViewModel.CanToggle, Mode=OneWay}"
                IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
        </controls:SettingsCard>
        <controls:SettingsExpander AutomationProperties.AutomationId="LastFmCredentialsExpander"
                                   Header="{x:Bind tool:ToolUtils.GetString('LastFmCredentials')}"
                                   Description="{x:Bind tool:ToolUtils.GetString('LastFmCredentialsHelp')}">
            <controls:SettingsExpander.Items>
                <controls:SettingsCard Header="API Key">
                    <TextBox Width="280" MaxLength="32" AutomationProperties.AutomationId="LastFmApiKey"
                        AutomationProperties.Name="API Key" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        Text="{x:Bind ViewModel.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="Shared Secret" Description="{x:Bind ViewModel.SecretHint, Mode=OneWay}">
                    <PasswordBox Width="280" MaxLength="32" AutomationProperties.AutomationId="LastFmSharedSecret"
                        AutomationProperties.Name="Shared Secret" IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        Password="{x:Bind ViewModel.SharedSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:SettingsCard>
                <controls:SettingsCard ContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind tool:ToolUtils.GetString('LastFmSaveCredentials')}"
                            AutomationProperties.AutomationId="LastFmSaveCredentials" Command="{x:Bind ViewModel.SaveCredentialsCommand}" />
                        <HyperlinkButton Content="{x:Bind tool:ToolUtils.GetString('LastFmApplyCredentials')}"
                            NavigateUri="https://www.last.fm/api/account/create" />
                    </StackPanel>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>
        <controls:SettingsExpander AutomationProperties.AutomationId="LastFmAccountExpander"
                                   Header="{x:Bind tool:ToolUtils.GetString('LastFmAccountActions')}">
            <controls:SettingsExpander.Items>
                <controls:SettingsCard ContentAlignment="Left">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind tool:ToolUtils.GetString('LastFmAuthorize')}"
                                AutomationProperties.AutomationId="LastFmAuthorize" Command="{x:Bind ViewModel.AuthorizeCommand}" />
                            <Button Content="{x:Bind tool:ToolUtils.GetString('LastFmCompleteAuthorization')}"
                                AutomationProperties.AutomationId="LastFmCompleteAuthorization" Command="{x:Bind ViewModel.CompleteAuthorizationCommand}" />
                            <Button Content="{x:Bind tool:ToolUtils.GetString('LastFmDisconnect')}"
                                AutomationProperties.AutomationId="LastFmDisconnect" Command="{x:Bind ViewModel.DisconnectCommand}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{x:Bind tool:ToolUtils.GetString('LastFmDisconnectHelp')}" />
                        <HyperlinkButton Padding="0" HorizontalAlignment="Left"
                            Content="{x:Bind tool:ToolUtils.GetString('LastFmManageApplications')}"
                            NavigateUri="https://www.last.fm/settings/applications" />
                    </StackPanel>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>
        <InfoBar IsOpen="True" IsClosable="False" Severity="{x:Bind ViewModel.Severity, Mode=OneWay}"
            AutomationProperties.AutomationId="LastFmStatus" Message="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        <controls:SettingsCard Header="{x:Bind ViewModel.QueueText, Mode=OneWay}"
                               Description="{x:Bind tool:ToolUtils.GetString('LastFmQueueHelp')}">
            <Button Content="{x:Bind tool:ToolUtils.GetString('LastFmRetry')}"
                AutomationProperties.AutomationId="LastFmRetry" Command="{x:Bind ViewModel.RetryCommand}" />
        </controls:SettingsCard>
        <controls:SettingsExpander AutomationProperties.AutomationId="LastFmHistoryExpander"
                                   Header="{x:Bind tool:ToolUtils.GetString('LastFmHistoryTitle')}">
            <controls:SettingsExpander.Items>
                <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('LastFmIncludeOlderHistory')}"
                                       Description="{x:Bind tool:ToolUtils.GetString('LastFmIncludeOlderHistoryHelp')}">
                    <ToggleSwitch MinWidth="0" VerticalAlignment="Center" AutomationProperties.AutomationId="LastFmIncludeOlderHistory"
                        AutomationProperties.Name="{x:Bind tool:ToolUtils.GetString('LastFmIncludeOlderHistory')}"
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.IncludeOlderHistory, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard ContentAlignment="Left">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" Text="{x:Bind tool:ToolUtils.GetString('LastFmHistoryHelp')}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind tool:ToolUtils.GetString('LastFmImportHistory')}"
                                AutomationProperties.AutomationId="LastFmImportHistory" Command="{x:Bind ViewModel.ImportHistoryCommand}" />
                            <Button Content="{x:Bind tool:ToolUtils.GetString('LastFmCancelHistory')}"
                                AutomationProperties.AutomationId="LastFmCancelHistory" Command="{x:Bind ViewModel.CancelHistoryImportCommand}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="LastFmHistoryResult"
                            Visibility="{x:Bind ViewModel.HistoryResultVisibility, Mode=OneWay}"
                            Text="{x:Bind ViewModel.HistoryResultText, Mode=OneWay}" />
                    </StackPanel>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>
        <controls:SettingsExpander AutomationProperties.AutomationId="LastFmFavoritesExpander"
                                   Header="{x:Bind tool:ToolUtils.GetString('LastFmFavoritesTitle')}">
            <controls:SettingsExpander.Items>
                <controls:SettingsCard ContentAlignment="Left">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" Text="{x:Bind tool:ToolUtils.GetString('LastFmFavoritesHelp')}" />
                        <TextBlock AutomationProperties.AutomationId="LastFmFavoriteQueue"
                            Text="{x:Bind ViewModel.FavoriteQueueText, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind tool:ToolUtils.GetString('LastFmImportFavorites')}"
                                AutomationProperties.AutomationId="LastFmImportFavorites" Command="{x:Bind ViewModel.ImportFavoritesCommand}" />
                            <Button Content="{x:Bind tool:ToolUtils.GetString('LastFmCancelFavoriteImport')}"
                                AutomationProperties.AutomationId="LastFmCancelFavoriteImport" Command="{x:Bind ViewModel.CancelFavoriteImportCommand}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="LastFmFavoriteResult"
                            Visibility="{x:Bind ViewModel.FavoriteResultVisibility, Mode=OneWay}"
                            Text="{x:Bind ViewModel.FavoriteResultText, Mode=OneWay}" />
                    </StackPanel>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>
    </StackPanel>
</UserControl>
