<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUIMusicPlayer.View.SubView.Settings.DspSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:tool="using:WinUIMusicPlayer.Utils">
    <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}">
        <Grid Style="{StaticResource SettingsGridStyle}">
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock x:Uid="DspSection" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                <InfoBar x:Name="AvailabilityBar" IsOpen="False" IsClosable="False" Severity="Informational" />
                <TextBlock x:Uid="DspIntro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('DspMaster')}"
                    Description="{x:Bind tool:ToolUtils.GetString('DspMasterDescription')}">
                    <ToggleSwitch x:Name="MasterToggle" MinWidth="0" IsEnabled="False" Toggled="Master_Toggled" />
                </controls:SettingsCard>
                <ContentControl x:Name="PcmSettings" IsEnabled="False" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                    <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('DspEqualizer')}"
                        Description="{x:Bind tool:ToolUtils.GetString('DspEqualizerDescription')}">
                        <Button x:Uid="DspOpenEqualizer" Click="OpenEqualizer_Click" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('DspNormalize')}"
                        Description="{x:Bind tool:ToolUtils.GetString('DspNormalizeDescription')}">
                        <ToggleSwitch x:Name="NormalizeToggle" MinWidth="0" Toggled="Setting_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('DspTarget')}"
                        Description="{x:Bind tool:ToolUtils.GetString('DspTargetDescription')}">
                        <NumberBox x:Name="TargetBox" Width="220" Minimum="-24" Maximum="-12" SmallChange="1"
                            SpinButtonPlacementMode="Inline" ValueChanged="Number_ValueChanged" />
                    </controls:SettingsCard>
                    <TextBlock x:Name="AnalysisText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('DspHeadroom')}"
                        Description="{x:Bind tool:ToolUtils.GetString('DspHeadroomDescription')}">
                        <NumberBox x:Name="HeadroomBox" Width="220" Minimum="-24" Maximum="0" SmallChange="1"
                            SpinButtonPlacementMode="Inline" ValueChanged="Number_ValueChanged" />
                    </controls:SettingsCard>
                    <ContentControl x:Name="StereoSettings" HorizontalContentAlignment="Stretch">
                      <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                        <TextBlock x:Uid="DspChannels" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('DspBalance')}"
                            Description="{x:Bind tool:ToolUtils.GetString('DspBalanceDescription')}">
                            <Grid Width="300" ColumnDefinitions="100,*">
                                <TextBlock Grid.Column="0" Margin="5,0" VerticalAlignment="Center"
                                    Text="{x:Bind tool:BindUtils.FormatF0(BalanceSlider.Value), Mode=OneWay}" />
                                <Slider x:Name="BalanceSlider" Grid.Column="1" Minimum="-100" Maximum="100" StepFrequency="1"
                                    ValueChanged="Slider_ValueChanged" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('DspSwap')}">
                            <ToggleSwitch x:Name="SwapToggle" MinWidth="0" Toggled="Setting_Toggled" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('DspMono')}">
                            <ToggleSwitch x:Name="MonoToggle" MinWidth="0" Toggled="Setting_Toggled" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('DspCrossfeed')}"
                            Description="{x:Bind tool:ToolUtils.GetString('DspCrossfeedDescription')}">
                            <ComboBox x:Name="CrossfeedCombo" Width="220" SelectionChanged="Crossfeed_SelectionChanged">
                                <ComboBoxItem x:Uid="DspCrossfeedOff" />
                                <ComboBoxItem x:Uid="DspCrossfeedLight" />
                                <ComboBoxItem x:Uid="DspCrossfeedMedium" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="{x:Bind tool:ToolUtils.GetString('DspWidth')}"
                            Description="{x:Bind tool:ToolUtils.GetString('DspWidthDescription')}">
                            <Grid Width="300" ColumnDefinitions="100,*">
                                <TextBlock Grid.Column="0" Margin="5,0" VerticalAlignment="Center"
                                    Text="{x:Bind tool:BindUtils.FormatPercent(WidthSlider.Value), Mode=OneWay}" />
                                <Slider x:Name="WidthSlider" Grid.Column="1" Minimum="0" Maximum="150" StepFrequency="1"
                                    ValueChanged="Slider_ValueChanged" />
                            </Grid>
                        </controls:SettingsCard>
                      </StackPanel>
                    </ContentControl>
                    <Button x:Uid="DspReset" HorizontalAlignment="Left" Click="Reset_Click" />
                  </StackPanel>
                </ContentControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
