<UserControl
    x:Class="WinUIMusicPlayer.View.SubView.Settings.DspDeviceBindingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tool="using:WinUIMusicPlayer.Utils">
    <StackPanel Spacing="8" MinWidth="220">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{x:Bind tool:ToolUtils.GetString('DspDeviceMode')}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                IsEnabled="{x:Bind ViewModel.CanChangeCorrectionMode, Mode=OneWay}"
                IsOn="{x:Bind ViewModel.DeviceCorrectionEnabled, Mode=TwoWay}" />
        </Grid>
        <TextBlock Text="{x:Bind tool:ToolUtils.GetString('DspDeviceDescription')}" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind ViewModel.ActualCorrectionOutput, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind tool:ToolUtils.GetString('DspDeviceTarget')}" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.CorrectionDevices}"
                DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.SelectedCorrectionDevice, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="{x:Bind tool:ToolUtils.GetString('DspDeviceRefresh')}"
                Command="{x:Bind ViewModel.RefreshCorrectionDevicesCommand}" />
        </Grid>
        <TextBlock Text="{x:Bind ViewModel.CorrectionBindingStatus, Mode=OneWay}" TextWrapping="Wrap" />
        <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Bind tool:ToolUtils.GetString('DspDeviceLoad')}" Command="{x:Bind ViewModel.LoadCorrectionCommand}" />
            <Button Content="{x:Bind ViewModel.SaveCorrectionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.BindCorrectionCommand}" />
            <Button Content="{x:Bind tool:ToolUtils.GetString('DspDeviceRemove')}" Command="{x:Bind ViewModel.RemoveCorrectionCommand}" />
        </StackPanel>
        <Button Content="{x:Bind tool:ToolUtils.GetString('DspDeviceRetry')}" Command="{x:Bind ViewModel.RetryCorrectionCommand}" />
        <InfoBar IsOpen="{x:Bind ViewModel.ImportFailed, Mode=OneWay}" IsClosable="False" Severity="Error"
            Message="{x:Bind ViewModel.ImportError, Mode=OneWay}" />
    </StackPanel>
</UserControl>
