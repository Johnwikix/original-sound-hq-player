<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.View.SubView.Settings.GeneralSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:customControl="using:WinUIMusicPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource SettingsScrollViewerStyle}">
        <Grid Style="{StaticResource SettingsGridStyle}">
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition IsStaggeringEnabled="True" />
                </StackPanel.ChildrenTransitions>

                <TextBlock x:Uid="SettingOutput" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.AppViewModel.OutputLicenseRestricted, Mode=OneWay}"
                    Visibility="{x:Bind tool:BindUtils.BoolToVisibilityConverter(ViewModel.AppViewModel.OutputLicenseRestricted), Mode=OneWay}"
                    Message="{x:Bind tool:ToolUtils.GetString('LicenseRestrictedOutput')}"
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button
                            Content="{x:Bind tool:ToolUtils.GetString('LicensePurchase')}"
                            Command="{x:Bind ViewModel.AppViewModel.PurchaseLicenseCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingOutputDevice" TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ComboBox
                        x:Name="OutputDeviceComboBox"
                        Width="300"
                        ItemsSource="{x:Bind ViewModel.AppViewModel.BassOutputDevices, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.AppViewModel.SelectedDevice, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="model:BassOutputDevice">
                                <TextBlock Text="{x:Bind Tag}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingBufferSize" TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <NumberBox
                        x:Name="LatencyNumberBox"
                        Width="300"
                        LargeChange="100"
                        Maximum="900"
                        Minimum="100"
                        SmallChange="10"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.AppViewModel.Latency, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard IsEnabled="{x:Bind tools:BindUtils.BoolToBoolReConverter(ViewModel.AppViewModel.IsDopEnabled), Mode=OneWay}">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="DSD2PCMFreq" TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ComboBox
                        Width="300"
                        ItemsSource="{x:Bind ViewModel.AppViewModel.DsdPcmFreqs, Mode=OneWay}"
                        SelectedValue="{x:Bind ViewModel.AppViewModel.DsdPcmFreq, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard IsEnabled="{x:Bind tools:BindUtils.BoolToBoolReConverter(ViewModel.AppViewModel.IsDopEnabled), Mode=OneWay}">
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="SettingDSDGain" TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <NumberBox
                        x:Name="DSDGainNumberBox"
                        Width="300"
                        Minimum="0"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.AppViewModel.DsdGain, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard Description="{x:Bind ViewModel.AppViewModel.DsdCardDescription, Mode=OneWay}" Header="DSD Dop / DSD Native">
                    <ToggleSwitch MinWidth="0"
                        IsEnabled="{x:Bind ViewModel.AppViewModel.DsdBitstreamAllowed, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.AppViewModel.IsDopEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind tool:ToolUtils.GetString('ExperimentalSurround51Title'), Mode=OneWay}"
                    Description="{x:Bind ViewModel.AppViewModel.Surround51CardDescription, Mode=OneWay}">
                    <ToggleSwitch MinWidth="0" VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.AppViewModel.Surround51Allowed, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind tool:ToolUtils.GetString('ExperimentalSurround51Title'), Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.AppViewModel.ExperimentalSurround51, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Visibility="{x:Bind tool:BindUtils.BoolToVisibilityConverter(ViewModel.AppViewModel.ExperimentalSurround51), Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Header>
                        <TextBlock Text="{x:Bind ViewModel.AppViewModel.SurroundStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind tool:ToolUtils.GetString('ExperimentalAtmosTitle'), Mode=OneWay}"
                    Description="{x:Bind ViewModel.AppViewModel.AtmosCardDescription, Mode=OneWay}">
                    <ToggleSwitch MinWidth="0" VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.AppViewModel.AtmosPassthroughAllowed, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind tool:ToolUtils.GetString('ExperimentalAtmosTitle'), Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.AppViewModel.ExperimentalAtmosPassthrough, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Visibility="{x:Bind tool:BindUtils.BoolToVisibilityConverter(ViewModel.AppViewModel.ExperimentalAtmosPassthrough), Mode=OneWay}"
                    Header="{x:Bind tool:ToolUtils.GetString('AtmosDeviceTitle')}"
                    Description="{x:Bind tool:ToolUtils.GetString('AtmosDeviceDescription')}">
                    <ComboBox Width="300"
                        AutomationProperties.Name="{x:Bind tool:ToolUtils.GetString('AtmosDeviceTitle')}"
                        ItemsSource="{x:Bind ViewModel.AppViewModel.AtmosDevices}"
                        DisplayMemberPath="Name"
                        SelectedItem="{x:Bind ViewModel.AppViewModel.SelectedAtmosDevice, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Visibility="{x:Bind tool:BindUtils.BoolToVisibilityConverter(ViewModel.AppViewModel.ExperimentalAtmosPassthrough), Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Header>
                        <TextBlock Text="{x:Bind ViewModel.AppViewModel.AtmosStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="FadeInOut" TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ToggleSwitch MinWidth="0" IsOn="{x:Bind ViewModel.AppViewModel.IsFadeEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <TextBlock x:Uid="SettingInterface" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="DefaultEntryInterface" TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ComboBox
                        Width="300"
                        SelectedValue="{x:Bind ViewModel.AppViewModel.DefaultEntryComboBoxTag, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem x:Uid="AddFolderCombox" Tag="AddFolder" />
                        <ComboBoxItem x:Uid="MusicBrowseCombox" Tag="MusicBrowse" />
                        <ComboBoxItem x:Uid="PlayListsCombox" Tag="PlayLists" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="DefaultMusicEntryInterface" TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ComboBox
                        Width="300"
                        SelectedValue="{x:Bind ViewModel.AppViewModel.DefaultPlayListComboBoxTag, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem x:Uid="SongCombox" Tag="song" />
                        <ComboBoxItem x:Uid="AlbumCombox" Tag="album" />
                        <ComboBoxItem x:Uid="ArtistCombox" Tag="artist" />
                        <ComboBoxItem x:Uid="FolderCombox" Tag="folder" />
                        <ComboBoxItem x:Uid="FavouriteCombox" Tag="favourite" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsExpander>
                    <controls:SettingsExpander.Header>
                        <TextBlock x:Uid="CloseButtonFunction" TextWrapping="Wrap" />
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="CloseAppRadioButton"
                                x:Uid="CloseApp"
                                GroupName="ClosedGroup"
                                IsChecked="{x:Bind ViewModel.AppViewModel.IsRunningBackend, Mode=TwoWay, Converter={StaticResource BooleanNegationConverter}}"
                                Tag="Closed" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="RunningBackendRadioButton"
                                x:Uid="Backgrounder"
                                GroupName="ClosedGroup"
                                IsChecked="{x:Bind ViewModel.AppViewModel.IsRunningBackend, Mode=TwoWay}"
                                Tag="RunningBackend" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <TextBlock x:Uid="Appearance" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsExpander>
                    <controls:SettingsExpander.Header>
                        <TextBlock x:Uid="AppStyle" TextWrapping="Wrap" />
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <TextBlock x:Uid="IsUpdateBackDrop" TextWrapping="Wrap" />
                            </controls:SettingsCard.Header>
                            <ToggleSwitch MinWidth="0" IsOn="{x:Bind ViewModel.AppViewModel.IsUpdateBackDrop, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="TransparentTintRadioButton"
                                x:Uid="TransparentTintStyle"
                                Command="{x:Bind ViewModel.AppViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="TransparentTint"
                                GroupName="BackdropGroup"
                                IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.BackdropType,'TransparentTint')}"
                                Tag="TransparentTint" />
                        </controls:SettingsCard>

                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="MicaRadioButton"
                                x:Uid="MicaStyle"
                                Command="{x:Bind ViewModel.AppViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="Mica"
                                GroupName="BackdropGroup"
                                IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.BackdropType,'Mica')}"
                                Tag="Mica" />
                        </controls:SettingsCard>

                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="AcrylicRadioButton"
                                x:Uid="AcrylicStyle"
                                Command="{x:Bind ViewModel.AppViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="Acrylic"
                                GroupName="BackdropGroup"
                                IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.BackdropType,'Acrylic')}"
                                Tag="Acrylic" />
                        </controls:SettingsCard>

                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="TransparentAcrylicRadioButton"
                                x:Uid="TransparentAcrylicStyle"
                                Command="{x:Bind ViewModel.AppViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="TransparentAcrylic"
                                GroupName="BackdropGroup"
                                IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.BackdropType,'TransparentAcrylic')}"
                                Tag="TransparentAcrylic" />
                        </controls:SettingsCard>

                        <controls:SettingsCard ContentAlignment="Left" Visibility="{x:Bind ViewModel.CheckSystemVersion()}">
                            <RadioButton
                                x:Name="CustomAcrylicStyleRadioButton"
                                x:Uid="CustomAcrylicStyle"
                                Command="{x:Bind ViewModel.AppViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="CustomAcrylicStyle"
                                GroupName="BackdropGroup"
                                IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.BackdropType,'CustomAcrylicStyle')}"
                                Tag="CustomAcrylicStyle" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Visibility="{x:Bind ViewModel.AppViewModel.IsColorPickerVisible, Mode=OneWay}">
                            <controls:SettingsCard.Header>
                                <TextBlock x:Uid="CustomOpacity" TextWrapping="Wrap" />
                            </controls:SettingsCard.Header>
                            <Slider
                                Width="245"
                                Maximum="100"
                                Minimum="0"
                                Value="{x:Bind ViewModel.AppViewModel.CustomOpacity, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard ContentAlignment="Left" Visibility="{x:Bind ViewModel.AppViewModel.IsColorPickerVisible, Mode=OneWay}">
                            <ColorPicker
                                ColorSpectrumShape="Ring"
                                IsAlphaEnabled="True"
                                IsAlphaSliderVisible="True"
                                IsAlphaTextInputVisible="True"
                                IsColorChannelTextInputVisible="True"
                                IsColorSliderVisible="True"
                                IsHexInputVisible="False"
                                IsMoreButtonVisible="True"
                                Color="{x:Bind ViewModel.AppViewModel.CustomColor, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander>
                    <controls:SettingsExpander.Header>
                        <TextBlock x:Uid="ThemeStyle" TextWrapping="Wrap" />
                    </controls:SettingsExpander.Header>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard IsEnabled="{x:Bind ViewModel.AppViewModel.IsFluidBackgroundEnabled, Mode=OneWay}">
                            <controls:SettingsCard.Header>
                                <TextBlock x:Uid="UseImageDominantTheme" TextWrapping="Wrap" />
                            </controls:SettingsCard.Header>
                            <ToggleSwitch MinWidth="0" IsOn="{x:Bind ViewModel.AppViewModel.UseImageDominantTheme, Mode=TwoWay}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="DefaultRadioButton"
                                x:Uid="SystemDefaultTheme"
                                Command="{x:Bind ViewModel.AppViewModel.ThemeTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="Default"
                                GroupName="ThemeGroup"
                                IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.ThemeType,'Default')}"
                                Tag="Default" />
                        </controls:SettingsCard>

                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="DarkRadioButton"
                                x:Uid="Dark"
                                Command="{x:Bind ViewModel.AppViewModel.ThemeTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="Dark"
                                GroupName="ThemeGroup"
                                IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.ThemeType,'Dark')}"
                                Tag="Dark" />
                        </controls:SettingsCard>

                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="LightRadioButton"
                                x:Uid="Light"
                                Command="{x:Bind ViewModel.AppViewModel.ThemeTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="Light"
                                GroupName="ThemeGroup"
                                IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.ThemeType,'Light')}"
                                Tag="Light" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <TextBlock x:Uid="Advanced" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="FolderWatchEnabled" TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <ToggleSwitch MinWidth="0" IsOn="{x:Bind ViewModel.AppViewModel.IsFolderWatchEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="TrimOnHide" />
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="TrimOnHideDescription" TextWrapping="Wrap" />
                    </controls:SettingsCard.Description>
                    <ToggleSwitch MinWidth="0" IsOn="{x:Bind ViewModel.AppViewModel.IsTrimOnHideEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="TrimAfterPlayback" />
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="TrimAfterPlaybackDescription" TextWrapping="Wrap" />
                    </controls:SettingsCard.Description>
                    <ToggleSwitch MinWidth="0" IsOn="{x:Bind ViewModel.AppViewModel.IsTrimAfterPlaybackEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="ArtistSplitSymbols" />
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="ArtistSplitSymbolsDescription" TextWrapping="Wrap" />
                    </controls:SettingsCard.Description>
                    <TextBox Width="240" Text="{x:Bind ViewModel.AppViewModel.ArtistSplitSymbols, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="TrimNowLabel" TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <Button Command="{x:Bind ViewModel.AppViewModel.TrimNowCommand, Mode=OneWay}">
                        <Button.Content>
                            <FontIcon Glyph="&#xE895;" />
                        </Button.Content>
                    </Button>
                </controls:SettingsCard>

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="WindowBoundsDescription" TextWrapping="Wrap" />
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <TextBlock x:Uid="WindowBoundsHint" TextWrapping="Wrap" />
                    </controls:SettingsCard.Description>
                    <Button
                        x:Uid="ResetWindowBounds"
                        MinWidth="0"
                        Command="{x:Bind ViewModel.AppViewModel.ResetWindowBoundsCommand, Mode=OneWay}" />
                </controls:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
