<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.ConvolutionCurveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:eq="using:WinUIMusicPlayer.Controls.Equalizer"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    Title="{x:Bind ViewModel.TitleText}"
    CloseButtonText="{x:Bind ViewModel.CancelText}"
    CornerRadius="10"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind ViewModel.ApplyText}">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
    </ContentDialog.Resources>
    <ContentDialog.CloseButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </ContentDialog.CloseButtonStyle>
    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </ContentDialog.PrimaryButtonStyle>
    <ScrollViewer
        x:Name="EditorScroll"
        Padding="15,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="EditorPanel" Spacing="12">
            <TextBlock
                x:Uid="CurveIntro"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <eq:FrequencyResponseControl x:Name="Response" />
            <TextBlock
                x:Uid="CurveNodeHint"
                FontSize="12"
                TextWrapping="Wrap" />
            <Grid
                x:Name="PointFields"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="12"
                RowSpacing="8">
                <ComboBox
                    x:Name="NodePicker"
                    x:Uid="CurveNodePicker"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Nodes}" SelectedIndex="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}" />
                <NumberBox
                    x:Name="FrequencyInput"
                    x:Uid="CurveFrequency"
                    Grid.Column="1"
                    Maximum="20000"
                    Minimum="20"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.Frequency, Mode=TwoWay}" />
                <NumberBox
                    x:Name="GainInput"
                    x:Uid="CurveGain"
                    Grid.Column="2"
                    Maximum="12"
                    Minimum="-12"
                    SmallChange="0.1"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.Gain, Mode=TwoWay}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="AddPointButton"
                    x:Uid="CurveAdd"
                    Command="{x:Bind ViewModel.AddPointCommand}" />
                <Button
                    x:Name="RemovePointButton"
                    x:Uid="CurveRemove"
                    Command="{x:Bind ViewModel.RemovePointCommand}" />
                <Button x:Uid="CurveFlat" Command="{x:Bind ViewModel.ResetFlatCommand}" />
            </StackPanel>
            <StackPanel Spacing="8">
                <CheckBox
                    x:Name="AutoHeadroom"
                    x:Uid="CurveAutoHeadroom"
                    IsChecked="{x:Bind ViewModel.AutoPreamp, Mode=TwoWay}" />
                <ToggleSwitch
                    x:Name="Audition"
                    x:Uid="CurveAudition"
                    IsOn="{x:Bind ViewModel.Audition, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.CanAudition, Mode=OneWay}" />
            </StackPanel>
            <NumberBox
                x:Name="TrimInput"
                x:Uid="CurveTrim"
                Width="220"
                HorizontalAlignment="Left"
                Maximum="24"
                Minimum="-48"
                SmallChange="0.5"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind ViewModel.PreampDb, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.ManualGainEnabled, Mode=OneWay}" />
            <TextBlock x:Uid="CurvePresetHeading" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox
                    x:Name="Presets"
                    x:Uid="CurvePresets"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Presets}"
                    IsEnabled="{x:Bind ViewModel.CanSavePreset, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                    PlaceholderText="{x:Bind ViewModel.PresetPlaceholder, Mode=OneWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="model:CurvePreset">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Uid="CurveSavePreset" Grid.Column="1" IsEnabled="{x:Bind ViewModel.CanSavePreset, Mode=OneWay}">
                    <Button.Flyout>
                        <Flyout x:Name="SaveFlyout">
                            <StackPanel Width="240" Spacing="8">
                                <TextBox
                                    x:Name="PresetName"
                                    x:Uid="CurvePresetName"
                                    MaxLength="80" Text="{x:Bind ViewModel.PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button x:Uid="CurveSaveNewPreset" Command="{x:Bind ViewModel.SavePresetCommand}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <StackPanel x:Name="PresetActions" Orientation="Horizontal" Spacing="8">
                <Button x:Uid="CurveUpdatePreset" Command="{x:Bind ViewModel.UpdatePresetCommand}" />
                <Button x:Uid="CurveDeletePreset" IsEnabled="{x:Bind ViewModel.CanDeletePreset, Mode=OneWay}">
                    <Button.Flyout>
                        <Flyout x:Name="DeleteFlyout">
                            <StackPanel MaxWidth="280" Spacing="12">
                                <TextBlock Text="{x:Bind ViewModel.DeletePresetConfirmation, Mode=OneWay}" TextWrapping="Wrap" />
                                <Button x:Uid="CurveDeletePreset" Command="{x:Bind ViewModel.DeletePresetCommand}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <InfoBar
                x:Name="Notice"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Visibility="{x:Bind tool:BindUtils.BoolToVisibilityConverter(ViewModel.HasError), Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
