<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.ConvolutionCurveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:eq="using:WinUIMusicPlayer.Controls.Equalizer"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    CornerRadius="10">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <Thickness x:Key="ContentDialogPadding">16</Thickness>
        <Thickness x:Key="ContentDialogContentMargin">0</Thickness>
        <Style x:Key="CurveIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
        </Style>
    </ContentDialog.Resources>
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock
                Text="{x:Bind ViewModel.TitleText}"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind ViewModel.CloseText}"
                ToolTipService.ToolTip="{x:Bind ViewModel.CloseText}"
                Click="CloseButton_Click"
                Style="{StaticResource CurveIconButtonStyle}">
                <FontIcon Glyph="&#xE894;" />
            </Button>
        </Grid>
    <ScrollViewer
        x:Name="EditorScroll"
        Grid.Row="1"
        Padding="15,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="EditorPanel" Spacing="12">
            <TextBlock
                x:Uid="CurveIntro"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <eq:FrequencyResponseControl x:Name="Response" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
            <TextBlock
                x:Uid="CurveNodeHint"
                FontSize="12"
                TextWrapping="Wrap" />
            <Grid
                x:Name="PointFields"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="12"
                RowSpacing="8">
                <ComboBox
                    x:Name="NodePicker"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    x:Uid="CurveNodePicker"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Nodes}" SelectedIndex="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}" />
                <NumberBox
                    x:Name="FrequencyInput"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    x:Uid="CurveFrequency"
                    Grid.Column="1"
                    Maximum="20000"
                    Minimum="20"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.Frequency, Mode=TwoWay}" />
                <NumberBox
                    x:Name="GainInput"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    x:Uid="CurveGain"
                    Grid.Column="2"
                    Maximum="12"
                    Minimum="-12"
                    SmallChange="0.1"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.Gain, Mode=TwoWay}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="AddPointButton"
                    x:Uid="CurveAdd"
                    Command="{x:Bind ViewModel.AddPointCommand}" />
                <Button
                    x:Name="RemovePointButton"
                    x:Uid="CurveRemove"
                    Command="{x:Bind ViewModel.RemovePointCommand}" />
                <Button x:Uid="CurveFlat" Command="{x:Bind ViewModel.ResetFlatCommand}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Spacing="8">
                <CheckBox
                    x:Name="AutoHeadroom"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    x:Uid="CurveAutoHeadroom"
                    IsChecked="{x:Bind ViewModel.AutoPreamp, Mode=TwoWay}" />
            </StackPanel>
            <NumberBox
                x:Name="TrimInput"
                x:Uid="CurveTrim"
                Width="220"
                HorizontalAlignment="Left"
                Maximum="24"
                Minimum="-48"
                SmallChange="0.5"
                SpinButtonPlacementMode="Inline"
                Value="{x:Bind ViewModel.PreampDb, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.ManualGainEnabled, Mode=OneWay}" />
            <TextBlock x:Uid="CurvePresetHeading" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox
                    x:Name="Presets"
                    x:Uid="CurvePresets"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Presets}"
                    IsEnabled="{x:Bind ViewModel.CanSavePreset, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                    PlaceholderText="{x:Bind ViewModel.PresetPlaceholder, Mode=OneWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="model:CurvePreset">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Uid="CurveSavePreset" Grid.Column="1" IsEnabled="{x:Bind ViewModel.CanSavePreset, Mode=OneWay}">
                    <Button.Flyout>
                        <Flyout x:Name="SaveFlyout">
                            <StackPanel Width="240" Spacing="8">
                                <TextBox
                                    x:Name="PresetName"
                                    x:Uid="CurvePresetName"
                                    MaxLength="80" Text="{x:Bind ViewModel.PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button x:Uid="CurveSaveNewPreset" Command="{x:Bind ViewModel.SavePresetCommand}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <StackPanel x:Name="PresetActions" Orientation="Horizontal" Spacing="8">
                <Button x:Uid="CurveApplyPreset" Command="{x:Bind ViewModel.ApplyPresetCommand}" />
                <Button x:Uid="CurveUpdatePreset" Command="{x:Bind ViewModel.UpdatePresetCommand}" />
                <Button x:Uid="CurveDeletePreset" IsEnabled="{x:Bind ViewModel.CanDeletePreset, Mode=OneWay}">
                    <Button.Flyout>
                        <Flyout x:Name="DeleteFlyout">
                            <StackPanel MaxWidth="280" Spacing="12">
                                <TextBlock Text="{x:Bind ViewModel.DeletePresetConfirmation, Mode=OneWay}" TextWrapping="Wrap" />
                                <Button x:Uid="CurveDeletePreset" Command="{x:Bind ViewModel.DeletePresetCommand}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <ContentPresenter x:Name="DeviceBindingsHost" />
            <InfoBar
                x:Name="Notice"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Visibility="{x:Bind tool:BindUtils.BoolToVisibilityConverter(ViewModel.HasError), Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
        </StackPanel>
    </ScrollViewer>
    </Grid>
</ContentDialog>
