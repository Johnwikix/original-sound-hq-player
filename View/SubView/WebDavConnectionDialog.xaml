<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.WebDavConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinUIMusicPlayer.ViewModel"
    x:Uid="WebDavConnectionDialog"
    Title="WebDAV"
    PrimaryButtonClick="Save_Click">
    <ScrollViewer MaxHeight="640">
        <StackPanel Width="440" Spacing="10">
            <TextBlock x:Uid="WebDavConnectionHelp" TextWrapping="Wrap" />
            <TextBox x:Uid="WebDavName" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox x:Uid="WebDavAddress" Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox x:Uid="WebDavUserName" Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox x:Uid="WebDavPassword" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
            <Button x:Uid="WebDavConnectButton" Command="{x:Bind ViewModel.ConnectCommand}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
            <ListView MaxHeight="160" ItemsSource="{x:Bind ViewModel.Folders}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WebDavFolderChoice">
                        <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <CheckBox x:Uid="WebDavReadMetadata" IsChecked="{x:Bind ViewModel.ReadMetadata, Mode=TwoWay}" />
            <CheckBox x:Uid="WebDavScanOnStartup" IsChecked="{x:Bind ViewModel.ScanOnStartup, Mode=TwoWay}" />
            <CheckBox x:Uid="WebDavSourceEnabled" IsChecked="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
