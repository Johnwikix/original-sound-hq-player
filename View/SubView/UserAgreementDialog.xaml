<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.UserAgreementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    Title="{x:Bind tool:ToolUtils.GetString('AgreementTitle')}"
    PrimaryButtonText="{x:Bind tool:ToolUtils.GetString('AgreementAccept')}"
    CloseButtonText="{x:Bind tool:ToolUtils.GetString('AgreementDecline')}"
    DefaultButton="None"
    PrimaryButtonClick="Accept_Click"
    Closing="Dialog_Closing">
    <Grid MaxWidth="680" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="{x:Bind tool:ToolUtils.GetString('AgreementIntroduction')}" TextWrapping="Wrap" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ComboBox ItemsSource="{x:Bind ViewModel.Documents, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.DocumentIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                AutomationProperties.Name="{x:Bind tool:ToolUtils.GetString('AgreementDocument')}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="model:LegalDocument"><TextBlock Text="{x:Bind Title}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Languages}"
                SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}"
                AutomationProperties.Name="{x:Bind tool:ToolUtils.GetString('AgreementLanguage')}" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <TextBlock Text="{x:Bind ViewModel.Version, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            <HyperlinkButton Grid.Column="1" Content="{x:Bind tool:ToolUtils.GetString('AgreementOnline')}"
                NavigateUri="{x:Bind ViewModel.DocumentUri, Mode=OneWay}" />
        </Grid>
        <ScrollViewer x:Name="DocumentScroll" Grid.Row="3" MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.Document.Summary, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Document.Sections, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="model:LegalSection">
                            <StackPanel Spacing="8" Margin="0,0,0,20">
                                <TextBlock Text="{x:Bind tool:ToolUtils.GetString('AgreementImportant')}" FontWeight="Bold"
                                    Visibility="{x:Bind tool:BindUtils.BoolToVisibilityConverter(Important)}" />
                                <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ItemsControl ItemsSource="{x:Bind Paragraphs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,0,10" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <InfoBar Grid.Row="4" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False"
            Severity="Error" Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
    </Grid>
</ContentDialog>
