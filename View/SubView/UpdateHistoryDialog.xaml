<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.UpdateHistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CornerRadius="10"
    mc:Ignorable="d">
    <Grid MinWidth="400" MaxWidth="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer
            Grid.Row="1"
            MaxHeight="400"
            Margin="0,16,0,16">
            <TextBlock
                x:Name="ReleaseNotesText"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
        </ScrollViewer>
        <Border
            Grid.Row="2"
            Margin="0,8,0,0"
            BorderThickness="0,1,0,0">
            <Border.BorderBrush>
                <SolidColorBrush Opacity="0.15" Color="Gray" />
            </Border.BorderBrush>
            <StackPanel
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Spacing="4">
                <TextBlock
                    x:Uid="StarOnGitHub"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <HyperlinkButton x:Name="GitHubLink" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
