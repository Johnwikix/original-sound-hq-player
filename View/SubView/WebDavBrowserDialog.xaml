<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.WebDavBrowserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:WinUIMusicPlayer.ViewModel"
    x:Uid="WebDavBrowserDialog" Title="WebDAV">
    <Grid Width="560" Height="470" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <TextBlock x:Uid="WebDavBrowserTreeHelp" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TreeView x:Name="BrowserTree" Grid.Row="1" SelectionMode="Multiple"
                  Expanding="Tree_Expanding" ItemInvoked="Tree_ItemInvoked"
                  SelectionChanged="Tree_SelectionChanged"
                  AutomationProperties.Name="WebDAV">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="controls:TreeViewNode">
                    <TreeViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind ((vm:WebDavTreeItem)Content).IconGlyph}" FontSize="15" />
                            <TextBlock Text="{x:Bind ((vm:WebDavTreeItem)Content).Name}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
            <Button x:Uid="WebDavPlaySelectedButton" Command="{x:Bind ViewModel.PlaySelectedCommand}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Uid="WebDavSelectedCountLabel" />
                <TextBlock Text="{x:Bind ViewModel.SelectedTrackCount, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</ContentDialog>
