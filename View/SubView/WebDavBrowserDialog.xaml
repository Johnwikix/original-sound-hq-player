<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.WebDavBrowserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dav="using:WinUIMusicPlayer.Services.WebDav"
    x:Uid="WebDavBrowserDialog" Title="WebDAV">
    <Grid Width="520" Height="430" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <Button x:Uid="WebDavUpButton" Command="{x:Bind ViewModel.UpCommand}" />
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Directory, Mode=OneWay}" TextWrapping="Wrap" />
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Entries}" IsItemClickEnabled="True" ItemClick="Item_Click" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dav:WebDavEntry"><TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
    </Grid>
</ContentDialog>
