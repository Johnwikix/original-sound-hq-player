<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.EqualizerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View.SubView"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    >

    <ContentDialog.Resources>
        <Style x:Key="FrequencyLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="GainLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="EqualizerSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Height" Value="200"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Minimum" Value="-12"/>
            <Setter Property="Maximum" Value="12"/>
            <Setter Property="Value" Value="0"/>
            <Setter Property="TickPlacement" Value="Outside"/>
            <Setter Property="TickFrequency" Value="3"/>
            <Setter Property="StepFrequency" Value="0.5"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </ContentDialog.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Uid="EqualizerDialogTitle" FontSize="20" FontWeight="SemiBold" 
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <ComboBox x:Name="ComboBoxPresets" 
                        Margin="0,8,0,0"
                        Width="100"
                        IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}"
                        SelectionChanged="ComboBoxPresets_SelectionChanged">
                    <ComboBoxItem x:Uid="EqCustom" Tag="Custom"/>
                    <ComboBoxItem x:Uid="EqFlat" Tag="Flat"/>
                    <ComboBoxItem x:Uid="EqRock" Tag="Rock"/>
                    <ComboBoxItem x:Uid="EqPop" Tag="Pop"/>
                    <ComboBoxItem x:Uid="EqJazz" Tag="Jazz"/>
                    <ComboBoxItem x:Uid="EqClassical" Tag="Classical"/>
                    <ComboBoxItem x:Uid="EqElectronic" Tag="Electronic"/>
                    <ComboBoxItem x:Uid="EqVocal" Tag="Vocal"/>
                </ComboBox>
                <ToggleSwitch x:Name="ToggleSwitchEqualizer" 
                              Margin="8,5,0,0" 
                              Toggled="ToggleSwitchEqualizer_Toggled"
                              VerticalAlignment="Center"
                />                
            </StackPanel>

            <!-- 右上角关闭按钮 -->
            <Button x:Name="CloseButton" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_Click">
                <FontIcon Glyph="&#xE894;"/>
            </Button>           
        </Grid>

        <!-- 均衡器滑块区域 -->
        <Border Grid.Row="1"                 
                Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 滑块区域 -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" 
                             VerticalScrollBarVisibility="Disabled" ZoomMode="Disabled" 
                             Margin="0,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- 32Hz -->
                        <StackPanel Margin="1,0">
                            <Slider x:Name="Slider32Hz" Style="{StaticResource EqualizerSliderStyle}" 
                                   ValueChanged="OnSliderValueChanged" Tag="32Hz"
                                   IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}"
                                />
                            <TextBlock Text="32Hz" Style="{StaticResource FrequencyLabelStyle}"/>
                        </StackPanel>

                        <!-- 64Hz -->
                        <StackPanel Margin="1,0">
                            <Slider x:Name="Slider64Hz" Style="{StaticResource EqualizerSliderStyle}" 
                                   ValueChanged="OnSliderValueChanged" Tag="64Hz"
                                   IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}"
                                    />
                            <TextBlock Text="64Hz" Style="{StaticResource FrequencyLabelStyle}"/>
                        </StackPanel>

                        <!-- 125Hz -->
                        <StackPanel Margin="1,0">
                            <Slider x:Name="Slider125Hz" Style="{StaticResource EqualizerSliderStyle}" 
                                   ValueChanged="OnSliderValueChanged" Tag="125Hz" 
                                    IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}"/>
                            <TextBlock Text="125Hz" Style="{StaticResource FrequencyLabelStyle}"/>
                        </StackPanel>

                        <!-- 250Hz -->
                        <StackPanel Margin="1,0">
                            <Slider x:Name="Slider250Hz" Style="{StaticResource EqualizerSliderStyle}" 
                                   ValueChanged="OnSliderValueChanged" Tag="250Hz" 
                                    IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}"/>
                            <TextBlock Text="250Hz" Style="{StaticResource FrequencyLabelStyle}"/>
                        </StackPanel>

                        <!-- 500Hz -->
                        <StackPanel Margin="1,0">
                            <Slider x:Name="Slider500Hz" Style="{StaticResource EqualizerSliderStyle}" 
                                   ValueChanged="OnSliderValueChanged" Tag="500Hz" 
                                    IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}"/>
                            <TextBlock Text="500Hz" Style="{StaticResource FrequencyLabelStyle}"/>
                        </StackPanel>

                        <!-- 1kHz -->
                        <StackPanel Margin="1,0">
                            <Slider x:Name="Slider1kHz" Style="{StaticResource EqualizerSliderStyle}" 
                                   ValueChanged="OnSliderValueChanged" Tag="1kHz" 
                                    IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}"/>
                            <TextBlock Text="1kHz" Style="{StaticResource FrequencyLabelStyle}"/>
                        </StackPanel>

                        <!-- 2kHz -->
                        <StackPanel Margin="1,0">
                            <Slider x:Name="Slider2kHz" Style="{StaticResource EqualizerSliderStyle}" 
                                   ValueChanged="OnSliderValueChanged" Tag="2kHz" 
                                    IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}"/>
                            <TextBlock Text="2kHz" Style="{StaticResource FrequencyLabelStyle}"/>
                        </StackPanel>

                        <!-- 4kHz -->
                        <StackPanel Margin="1,0">
                            <Slider x:Name="Slider4kHz" Style="{StaticResource EqualizerSliderStyle}" 
                                   ValueChanged="OnSliderValueChanged" Tag="4kHz" 
                                    IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}"/>
                            <TextBlock Text="4kHz" Style="{StaticResource FrequencyLabelStyle}"/>
                        </StackPanel>

                        <!-- 8kHz -->
                        <StackPanel Margin="1,0">
                            <Slider x:Name="Slider8kHz" Style="{StaticResource EqualizerSliderStyle}" 
                                   ValueChanged="OnSliderValueChanged" Tag="8kHz" 
                                    IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}"/>
                            <TextBlock Text="8kHz" Style="{StaticResource FrequencyLabelStyle}"/>
                        </StackPanel>

                        <!-- 16kHz -->
                        <StackPanel Margin="1,0">
                            <Slider x:Name="Slider16kHz" Style="{StaticResource EqualizerSliderStyle}" 
                                   ValueChanged="OnSliderValueChanged" Tag="16kHz" 
                                    IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}"/>
                            <TextBlock Text="16kHz" Style="{StaticResource FrequencyLabelStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
