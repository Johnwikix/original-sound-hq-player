<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WinUIMusicPlayer.View.SubView.EqualizerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.Controls.Equalizer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View.SubView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CornerRadius="10"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Style x:Key="EqIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <!--  收紧对话框留白，让均衡器区域更紧凑  -->
        <Thickness x:Key="ContentDialogPadding">16</Thickness>
        <Thickness x:Key="ContentDialogContentMargin">0</Thickness>
    </ContentDialog.Resources>

    <Grid RowDefinitions="Auto,*">

        <!--  标题区域  -->
        <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock
                    x:Uid="EqualizerDialogTitle"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <ToggleSwitch
                    x:Name="ToggleSwitchEqualizer"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Toggled="ToggleSwitchEqualizer_Toggled" />
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                <ComboBox
                    x:Name="ComboBoxPresets"
                    Width="160"
                    IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}"
                    SelectionChanged="ComboBoxPresets_SelectionChanged" />
                <Button
                    x:Name="AddPresetButton"
                    Style="{StaticResource EqIconButtonStyle}"
                    Click="AddPresetButton_Click">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                </Button>
                <Button
                    x:Name="SavePresetButton"
                    IsEnabled="False"
                    Style="{StaticResource EqIconButtonStyle}"
                    Click="SavePresetButton_Click">
                    <FontIcon FontSize="14" Glyph="&#xE74E;" />
                </Button>
                <Button
                    x:Name="DeletePresetButton"
                    IsEnabled="False"
                    Style="{StaticResource EqIconButtonStyle}"
                    Click="DeletePresetButton_Click">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                </Button>
                <Button x:Name="MoreOptionsButton" Style="{StaticResource EqIconButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="EqImportItem" Click="ImportPresetItem_Click" />
                            <MenuFlyoutItem x:Uid="EqExportItem" Click="ExportPresetItem_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="CloseButton"
                    Style="{StaticResource EqIconButtonStyle}"
                    Click="CloseButton_Click">
                    <FontIcon Glyph="&#xE894;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  均衡器编辑区（dB 刻度 + 频段滑条）  -->
        <controls:EqualizerControl x:Name="Equalizer" Grid.Row="1" Margin="4,8,4,8" IsEnabled="{x:Bind ToggleSwitchEqualizer.IsOn, Mode=OneWay}" />
    </Grid>
</ContentDialog>
