<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="WinUIMusicPlayer.View.SubView.MusicDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View.SubView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    Title="音乐属性"
    MinWidth="650"
    MinHeight="750"
    mc:Ignorable="d">

    <winex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </winex:WindowEx.SystemBackdrop>

    <Grid>
        <Grid Visibility="{x:Bind BoolToVisibility(IsLoading)}">
            <ProgressRing
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />
            <TextBlock
                x:Uid="LoadingGrid"
                Margin="0,180,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <Grid
            x:Name="MusicDetailTitleBar"
            Height="44"
            Margin="0"
            Padding="0"
            VerticalAlignment="Top">
            <TextBlock
                x:Uid="MusicDetailTitleBar"
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Grid Margin="0,44,0,0" Visibility="{x:Bind BoolToNVisibility(IsLoading)}" RowDefinitions="*,Auto">

            <ScrollViewer
                Grid.Row="0"
                Padding="14,8,14,4"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <StackPanel Margin="12,0" Spacing="6">
                        <StackPanel>
                            <TextBlock
                                x:Uid="TitleTextBlock"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <TextBox
                                BorderThickness="0"
                                Text="{x:Bind MusicDetail.Title, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock
                                x:Uid="AuthorTextBlock"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <TextBox
                                BorderThickness="0"
                                Text="{x:Bind MusicDetail.Author, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock
                                x:Uid="AlbumTextBlock"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <TextBox
                                BorderThickness="0"
                                Text="{x:Bind MusicDetail.Album, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Grid
                        Margin="12,0"
                        ColumnSpacing="14"
                        RowSpacing="6"
                        ColumnDefinitions="*,*,*,*">
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock
                                x:Uid="YearTextBlock"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <NumberBox
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind MusicDetail.Year, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock
                                x:Uid="DiskNumberBox"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <NumberBox
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind MusicDetail.DiskNumber, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock
                                x:Uid="TrackNumberBox"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <NumberBox
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind MusicDetail.TrackNumber, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3">
                            <TextBlock
                                x:Uid="LyricsTimeOffsetTag"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <NumberBox
                                LargeChange="1000"
                                Maximum="10000"
                                Minimum="-10000"
                                SmallChange="100"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind MusicDetail.LyricsOffsetMs, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid
                        Margin="12,0"
                        ColumnSpacing="14"
                        RowSpacing="6"
                        ColumnDefinitions="*,*,*,*">
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock
                                x:Uid="DurationTextBlock"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <TextBlock Margin="0,4,0,0" Text="{x:Bind ConvertDuration(MusicDetail.Duration), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock
                                x:Uid="BitDepthTextBlock"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <TextBlock Margin="0,4,0,0" Text="{x:Bind ConvertBitDepth(MusicDetail.BitDepth), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock
                                x:Uid="BitRateTextBlock"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <TextBlock Margin="0,4,0,0" Text="{x:Bind ConvertBitRate(MusicDetail.BitRate), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3">
                            <TextBlock
                                x:Uid="SampleRateTextBlock"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <TextBlock Margin="0,4,0,0" Text="{x:Bind ConvertSampleRate(MusicDetail.SampleRate), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid
                        Margin="12,0"
                        ColumnSpacing="14"
                        RowSpacing="6"
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock
                                x:Uid="LastFolderNameTextBlock"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind MusicDetail.LastLevelFolderPath, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock
                                x:Uid="PathTextBlock"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind MusicDetail.Path, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock
                                x:Uid="CreateTime"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ConvertTime(MusicDetail.CreateTime), Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock
                                x:Uid="UpdateTime"
                                Margin="0,0,0,2"
                                FontSize="12"
                                Opacity="0.7" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ConvertTime(MusicDetail.UpdateTime), Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,12,0" ColumnDefinitions="*,Auto,12,Auto">
                        <Pivot
                            Grid.Column="0"
                            Height="300"
                            Padding="0,4,0,0">
                            <PivotItem>
                                <PivotItem.Header>
                                    <TextBlock FontSize="14" Text="Lrc" />
                                </PivotItem.Header>
                                <TextBox
                                    MinHeight="120"
                                    Margin="0,4,0,0"
                                    BorderThickness="0"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Text="{x:Bind LyricsText, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                            </PivotItem>
                            <PivotItem>
                                <PivotItem.Header>
                                    <TextBlock x:Uid="LrcTranslation" FontSize="14" />
                                </PivotItem.Header>
                                <TextBox
                                    MinHeight="120"
                                    Margin="0,4,0,0"
                                    BorderThickness="0"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Text="{x:Bind TranslatedLyricsText, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                            </PivotItem>
                            <PivotItem>
                                <PivotItem.Header>
                                    <TextBlock FontSize="14" Text="Krc" />
                                </PivotItem.Header>
                                <TextBox
                                    MinHeight="120"
                                    Margin="0,4,0,0"
                                    BorderThickness="0"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Text="{x:Bind KrcText, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                            </PivotItem>
                            <PivotItem>
                                <PivotItem.Header>
                                    <TextBlock x:Uid="KrcTranslation" FontSize="14" />
                                </PivotItem.Header>
                                <TextBox
                                    MinHeight="120"
                                    Margin="0,4,0,0"
                                    BorderThickness="0"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Text="{x:Bind TKrcText, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                            </PivotItem>
                        </Pivot>
                        <StackPanel
                            Grid.Column="1"
                            Margin="0"
                            VerticalAlignment="Bottom"
                            Spacing="4">
                            <Button
                                Width="36"
                                Height="36"
                                Padding="0"
                                Click="OpenFile_Click">
                                <FontIcon FontSize="14" Glyph="&#xE838;" />
                            </Button>
                            <Button
                                Width="36"
                                Height="36"
                                Padding="0"
                                Click="ReadLyricsFromFile_Click">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Uid="ReadLyricsFromFile" />
                                </ToolTipService.ToolTip>
                            </Button>
                            <Button
                                Width="36"
                                Height="36"
                                Padding="0"
                                Click="SaveLyrics_Click">
                                <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Uid="SaveLyricsTextBox" />
                                </ToolTipService.ToolTip>
                            </Button>
                            <Button
                                Width="36"
                                Height="36"
                                Padding="0"
                                Click="GetLyricsFromNet_Click">
                                <Grid>
                                    <FontIcon FontSize="14" Glyph="&#xF385;" />
                                    <FontIcon FontSize="14" Glyph="&#xF386;" />
                                </Grid>
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Uid="LyricsTextBox" />
                                </ToolTipService.ToolTip>
                            </Button>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="3"
                            Width="244"
                            Height="284"
                            Margin="0,16,0,0"
                            VerticalAlignment="Top">
                            <StackPanel
                                Margin="0,0,0,8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="GetImageFromNet_Click">
                                    <FontIcon FontSize="14" Glyph="&#xebd3;" />
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="GetImageFromNetButton" />
                                    </ToolTipService.ToolTip>
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="SaveImageButton_Click">
                                    <FontIcon FontSize="14" Glyph="&#xe78c;" />
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="SaveImageButton" />
                                    </ToolTipService.ToolTip>
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Click="SelectCoverImageButton_Click">
                                    <FontIcon FontSize="14" Glyph="&#xe70f;" />
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="SelectCoverImageButton" />
                                    </ToolTipService.ToolTip>
                                </Button>
                            </StackPanel>
                            <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="6">
                                <Grid>
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="80"
                                        Glyph="&#xE93C;"
                                        Opacity="0.3" />
                                    <Image Source="{x:Bind AlbumCoverBitmap, Mode=TwoWay}" Stretch="Uniform" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="1"
                Margin="14,4,14,12"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button x:Uid="SaveButton">
                    <Button.Flyout>
                        <Flyout x:Name="ConfirmFlyout">
                            <StackPanel>
                                <TextBlock
                                    x:Uid="SaveConfirm"
                                    Margin="0,0,0,12"
                                    Style="{ThemeResource BaseTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        x:Uid="ConfirmButton"
                                        Margin="0,0,10,0"
                                        Click="ConfirmButton_Click" />
                                    <Button
                                        x:Uid="CancelButton"
                                        Margin="0,0,10,0"
                                        Click="CloseFlyoutButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Uid="SaveToDataBase" Click="SaveToDataBaseButton_Click" />
                <Button x:Uid="CloseButtonItem" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</winex:WindowEx>