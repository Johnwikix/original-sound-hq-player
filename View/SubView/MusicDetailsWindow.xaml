<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUIMusicPlayer.View.SubView.MusicDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View.SubView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Music Details">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>
    <Grid>
        <Grid
            x:Name="MusicDetailTitleBar"
            Height="44"
            Margin="0"
            VerticalAlignment="Top"
            Padding="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="18,0,0,0"
                Grid.Column="1"
                FontSize="16"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="音乐详情"/>
        </Grid>
        <RelativePanel Margin="10 50 10 10">
            <ScrollViewer Margin="0 0 0 50" VerticalScrollBarVisibility="Auto">
                <Grid                    
                    RelativePanel.AlignLeftWithPanel="True"
                    RelativePanel.AlignTopWithPanel="True"
                    RelativePanel.AlignRightWithPanel="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="标题：" FontWeight="Bold" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <TextBox x:Name="TitleTextBlock" TextWrapping="Wrap"  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5" />

                        <TextBlock Text="艺术家：" FontWeight="Bold" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <TextBox x:Name="AuthorTextBlock" TextWrapping="Wrap"  Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5" />

                        <TextBlock Text="专辑：" FontWeight="Bold" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <TextBox x:Name="AlbumTextBlock" TextWrapping="Wrap"  Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5" />

                        <TextBlock Text="年份：" FontWeight="Bold" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <TextBox x:Name="YearTextBlock" TextWrapping="Wrap"  Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5" />

                        <TextBlock Text="轨道编号：" FontWeight="Bold" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <TextBox x:Name="TrackNumberBox" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5"/>

                        <TextBlock Text="歌词：" FontWeight="Bold" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <TextBox x:Name="LyricsTextBox" MaxHeight="100" TextWrapping="Wrap"  Grid.Row="5" Grid.Column="1" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Margin="5"/>

                        <TextBlock Text="时长：" FontWeight="Bold" Grid.Row="6" Grid.Column="0" HorizontalAlignment="Right" Margin="5"/>
                        <TextBlock x:Name="DurationTextBlock" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" Margin="5"/>

                        <TextBlock Text="位深：" FontWeight="Bold" Grid.Row="7" Grid.Column="0" HorizontalAlignment="Right" Margin="5"/>
                        <TextBlock x:Name="BitDepthTextBlock" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left" Margin="5"/>

                        <TextBlock Text="比特率：" FontWeight="Bold" Grid.Row="8" Grid.Column="0" HorizontalAlignment="Right" Margin="5"/>
                        <TextBlock x:Name="BitRateTextBlock" Grid.Row="8" Grid.Column="1" HorizontalAlignment="Left" Margin="5"/>

                        <TextBlock Text="采样率：" FontWeight="Bold" Grid.Row="9" Grid.Column="0" HorizontalAlignment="Right" Margin="5"/>
                        <TextBlock x:Name="SampleRateTextBlock" Grid.Row="9" Grid.Column="1" HorizontalAlignment="Left" Margin="5"/>

                        <TextBlock Text="路径：" FontWeight="Bold" Grid.Row="10" Grid.Column="0" HorizontalAlignment="Right" Margin="5"/>
                        <TextBlock TextWrapping="WrapWholeWords" TextTrimming="WordEllipsis" x:Name="PathTextBlock" Grid.Row="10" Grid.Column="1" HorizontalAlignment="Left" Margin="5"/>
                    </Grid>
                    <Grid Grid.Column="1" Margin="10">
                        <StackPanel>
                            <Image x:Name="AlbumCoverImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"></Image>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Click="SaveImageButton_Click" Margin="5" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xe78c;" FontSize="16"/>
                                </Button>
                                <Button Click="SelectCoverImageButton_Click" Margin="5" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xe70f;" FontSize="16"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <StackPanel
                RelativePanel.AlignBottomWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                Orientation="Horizontal"
            >                
                <Button
                    Content="确认修改"
                    Click="ConfirmButton_Click"
                    Margin="5"/>
                <Button
                    Content="关闭"
                    Click="CloseButton_Click"
                    Margin="5"/>
            </StackPanel>
           
        </RelativePanel>
    </Grid>
</Window>
