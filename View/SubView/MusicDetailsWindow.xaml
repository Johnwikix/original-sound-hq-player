<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="WinUIMusicPlayer.View.SubView.MusicDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View.SubView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    Title="音乐属性"
    MinWidth="750"
    MinHeight="900"
    mc:Ignorable="d">

    <winex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </winex:WindowEx.SystemBackdrop>
    <Grid>
        <Grid
            x:Name="MusicDetailTitleBar"
            Height="44"
            Margin="0"
            Padding="0"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="MusicDetailTitleBar"
                Grid.Column="1"
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <Grid Visibility="{x:Bind BoolToVisibility(IsLoading)}">
            <ProgressRing
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />
            <TextBlock
                x:Uid="LoadingGrid"
                Margin="0,180,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
        <RelativePanel Margin="10,50,10,10" Visibility="{x:Bind BoolToNVisibility(IsLoading)}">
            <ScrollViewer
                Margin="0,0,0,50"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.AlignTopWithPanel="True"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="2.5*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="5*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Uid="TitleTextBlock"
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            Text="{x:Bind MusicDetail.Title, Mode=TwoWay}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Uid="AuthorTextBlock"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            Text="{x:Bind MusicDetail.Author, Mode=TwoWay}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Uid="AlbumTextBlock"
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            Text="{x:Bind MusicDetail.Album, Mode=TwoWay}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Uid="YearTextBlock"
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <NumberBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            Minimum="0"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Text="{x:Bind MusicDetail.Year, Mode=TwoWay}" />

                        <TextBlock
                            x:Uid="DiskNumberBox"
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <NumberBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            Minimum="0"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Text="{x:Bind MusicDetail.DiskNumber, Mode=TwoWay}" />

                        <TextBlock
                            x:Uid="TrackNumberBox"
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <NumberBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            Minimum="0"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Text="{x:Bind MusicDetail.TrackNumber, Mode=TwoWay}" />
                        <TextBlock
                            x:Uid="LyricsTimeOffsetTag"
                            Grid.Row="6"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <NumberBox
                            Grid.Row="6"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            LargeChange="1000"
                            Maximum="10000"
                            Minimum="-10000"
                            SmallChange="100"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind MusicDetail.LyricsOffsetMs, Mode=TwoWay}" />
                        <Grid Grid.Row="7" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Pivot Padding="0">
                                    <PivotItem>
                                        <PivotItem.Header>
                                            <TextBlock FontSize="16" Text="Lrc" />
                                        </PivotItem.Header>
                                        <TextBox
                                            Grid.Row="1"
                                            Height="200"
                                            Margin="0,5,0,5"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="0"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            Text="{x:Bind MusicDetail.Lyrics, Mode=TwoWay}"
                                            TextWrapping="Wrap" />
                                    </PivotItem>
                                    <PivotItem>
                                        <PivotItem.Header>
                                            <TextBlock x:Uid="LrcTranslation" FontSize="16" />
                                        </PivotItem.Header>
                                        <TextBox
                                            Grid.Row="2"
                                            Height="200"
                                            Margin="0,5,0,5"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="0"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            Text="{x:Bind MusicDetail.TranslatedLyrics, Mode=TwoWay}"
                                            TextWrapping="Wrap" />
                                    </PivotItem>
                                    <PivotItem>
                                        <PivotItem.Header>
                                            <TextBlock FontSize="16" Text="Krc" />
                                        </PivotItem.Header>
                                        <TextBox
                                            Grid.Row="2"
                                            Height="200"
                                            Margin="0,5,0,5"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="0"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            Text="{x:Bind MusicDetail.Krc, Mode=TwoWay}"
                                            TextWrapping="Wrap" />
                                    </PivotItem>
                                    <PivotItem>
                                        <PivotItem.Header>
                                            <TextBlock x:Uid="KrcTranslation" FontSize="16" />
                                        </PivotItem.Header>
                                        <TextBox
                                            Grid.Row="2"
                                            Height="200"
                                            Margin="0,5,0,5"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="0"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            Text="{x:Bind MusicDetail.TKrc, Mode=TwoWay}"
                                            TextWrapping="Wrap" />
                                    </PivotItem>
                                </Pivot>
                            </Grid>
                            <Grid
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button
                                    Grid.Row="0"
                                    Margin="0,5,5,5"
                                    VerticalAlignment="Stretch"
                                    Click="OpenFile_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid>
                                                <FontIcon FontSize="16" Glyph="&#xE838;" />
                                            </Grid>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                                <Button
                                    Grid.Row="1"
                                    Margin="0,5,5,5"
                                    VerticalAlignment="Stretch"
                                    Click="ReadLyricsFromFile_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid>
                                                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                                            </Grid>
                                        </StackPanel>
                                    </Button.Content>
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="ReadLyricsFromFile" />
                                    </ToolTipService.ToolTip>
                                </Button>
                                <Button
                                    Grid.Row="2"
                                    Margin="0,5,5,5"
                                    VerticalAlignment="Stretch"
                                    Click="SaveLyrics_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid>
                                                <FontIcon FontSize="16" Glyph="&#xE74E;" />
                                            </Grid>
                                        </StackPanel>
                                    </Button.Content>
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="SaveLyricsTextBox" />
                                    </ToolTipService.ToolTip>
                                </Button>
                                <Button
                                    Grid.Row="3"
                                    Margin="0,5,5,5"
                                    VerticalAlignment="Stretch"
                                    Click="GetLyricsFromNet_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid>
                                                <FontIcon FontSize="16" Glyph="&#xF385;" />
                                                <FontIcon FontSize="16" Glyph="&#xF386;" />
                                            </Grid>
                                        </StackPanel>
                                    </Button.Content>
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="LyricsTextBox" />
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>
                        </Grid>
                        <TextBlock
                            x:Uid="DurationTextBlock"
                            Grid.Row="8"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="8"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Left"
                            Text="{x:Bind ConvertDuration(MusicDetail.Duration), Mode=OneWay}" />

                        <TextBlock
                            x:Uid="BitDepthTextBlock"
                            Grid.Row="9"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="9"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Left"
                            Text="{x:Bind ConvertBitDepth(MusicDetail.BitDepth), Mode=OneWay}" />

                        <TextBlock
                            x:Uid="BitRateTextBlock"
                            Grid.Row="10"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="10"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Left"
                            Text="{x:Bind ConvertBitRate(MusicDetail.BitRate), Mode=OneWay}" />

                        <TextBlock
                            x:Uid="SampleRateTextBlock"
                            Grid.Row="11"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="11"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Left"
                            Text="{x:Bind ConvertSampleRate(MusicDetail.SampleRate), Mode=OneWay}" />

                        <TextBlock
                            x:Uid="LastFolderNameTextBlock"
                            Grid.Row="12"
                            Grid.Column="0"
                            Margin="5"
                            HorizontalAlignment="Right"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="12"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Left"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind MusicDetail.LastLevelFolderPath, Mode=OneWay}"
                            TextTrimming="WordEllipsis"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Uid="PathTextBlock"
                            Grid.Row="13"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="13"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Left"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind MusicDetail.Path, Mode=OneWay}"
                            TextTrimming="WordEllipsis"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Uid="CreateTime"
                            Grid.Row="14"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="14"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Left"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ConvertTime(MusicDetail.CreateTime), Mode=OneWay}"
                            TextTrimming="WordEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Uid="UpdateTime"
                            Grid.Row="15"
                            Grid.Column="0"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Right"
                            FontWeight="Bold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="15"
                            Grid.Column="1"
                            Margin="5,5,5,0"
                            HorizontalAlignment="Left"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ConvertTime(MusicDetail.UpdateTime), Mode=OneWay}"
                            TextTrimming="WordEllipsis"
                            TextWrapping="Wrap" />
                    </Grid>
                    <Grid Grid.Column="1" Margin="5">
                        <StackPanel>
                            <Border
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                CornerRadius="5">
                                <Grid>
                                    <Image Canvas.ZIndex="1" Source="{x:Bind AlbumCoverBitmap, Mode=TwoWay}" />
                                    <Grid
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        Canvas.ZIndex="0">
                                        <Viewbox Stretch="Uniform">
                                            <Border
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                                                <!--  图标层  -->
                                                <FontIcon
                                                    Width="100"
                                                    Height="100"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Canvas.ZIndex="1"
                                                    FontSize="50"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE93C;" />
                                            </Border>
                                        </Viewbox>
                                    </Grid>
                                </Grid>
                            </Border>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Button
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Click="GetImageFromNet_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon FontSize="16" Glyph="&#xebd3;" />
                                        </StackPanel>
                                    </Button.Content>
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="GetImageFromNetButton" />
                                    </ToolTipService.ToolTip>
                                </Button>
                                <Button
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Click="SaveImageButton_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon FontSize="16" Glyph="&#xe78c;" />
                                        </StackPanel>
                                    </Button.Content>
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="SaveImageButton" />
                                    </ToolTipService.ToolTip>
                                </Button>
                                <Button
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    Click="SelectCoverImageButton_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon FontSize="16" Glyph="&#xe70f;" />
                                        </StackPanel>
                                    </Button.Content>
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="SelectCoverImageButton" />
                                    </ToolTipService.ToolTip>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <StackPanel
                Orientation="Horizontal"
                RelativePanel.AlignBottomWithPanel="True"
                RelativePanel.AlignRightWithPanel="True">
                <Button x:Uid="SaveButton" Margin="5">
                    <Button.Flyout>
                        <Flyout x:Name="ConfirmFlyout">
                            <StackPanel>
                                <TextBlock
                                    x:Uid="SaveConfirm"
                                    Margin="0,0,0,12"
                                    Style="{ThemeResource BaseTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        x:Uid="ConfirmButton"
                                        Margin="0,0,10,0"
                                        Click="ConfirmButton_Click" />
                                    <Button
                                        x:Uid="CancelButton"
                                        Margin="0,0,10,0"
                                        Click="CloseFlyoutButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Uid="SaveToDataBase"
                    Margin="5"
                    Click="SaveToDataBaseButton_Click" />
                <Button
                    x:Uid="CloseButtonItem"
                    Margin="5"
                    Click="CloseButton_Click" />
            </StackPanel>

        </RelativePanel>
    </Grid>
</winex:WindowEx>
