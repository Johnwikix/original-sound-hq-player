<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="WinUIMusicPlayer.View.SubView.MusicDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    xmlns:winex="using:WinUIEx"
    Title="音乐属性"
    MinWidth="640"
    MinHeight="560"
    mc:Ignorable="d">

    <winex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </winex:WindowEx.SystemBackdrop>

    <Grid tool:ApplicationFont.IsEnabled="True" RowDefinitions="48,*" KeyDown="Root_KeyDown">
        <Grid x:Name="MusicDetailTitleBar" />
        <controls:MusicDetailControl x:Name="DetailView" Grid.Row="1" />
    </Grid>
</winex:WindowEx>
