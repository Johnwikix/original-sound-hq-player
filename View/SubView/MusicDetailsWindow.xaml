<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUIMusicPlayer.View.SubView.MusicDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View.SubView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="音乐属性">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>
    <Grid>
        <Grid
            x:Name="MusicDetailTitleBar"
            Height="44"
            Margin="0"
            VerticalAlignment="Top"
            Padding="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="18,0,0,0"
                Grid.Column="1"
                FontSize="16"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="音乐详情"/>
        </Grid>
        <Grid x:Name="LoadingGrid" Visibility="Collapsed">
            <ProgressRing IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100"/>
            <TextBlock Text="正在处理保存，请稍候..." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,180,0,0"/>
        </Grid>
        <RelativePanel x:Name="MusicDetail"  Margin="10 50 10 10">
            <ScrollViewer 
                Margin="0 0 0 50" 
                VerticalScrollBarVisibility="Auto"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignTopWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="2.5*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="5*"/>                            
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="标题：" FontWeight="Bold" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <TextBox x:Name="TitleTextBlock" BorderThickness="0"  TextWrapping="Wrap"  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5" />

                        <TextBlock Text="艺术家：" FontWeight="Bold" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <TextBox x:Name="AuthorTextBlock" BorderThickness="0" TextWrapping="Wrap"  Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5" />

                        <TextBlock Text="专辑：" FontWeight="Bold" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <TextBox x:Name="AlbumTextBlock"  BorderThickness="0" TextWrapping="Wrap"  Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5" />

                        <TextBlock Text="年份：" FontWeight="Bold" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <TextBox x:Name="YearTextBlock" BorderThickness="0" TextWrapping="Wrap"  Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5" />

                        <TextBlock Text="轨道编号：" FontWeight="Bold" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5"/>
                        <TextBox x:Name="TrackNumberBox" BorderThickness="0" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5"/>

                        <TextBlock Text="歌词：" FontWeight="Bold" Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5"/>
                        <Grid Grid.Row="5" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LyricsTextBox" BorderThickness="0" Height="100" TextWrapping="Wrap" Grid.Row="0"  Grid.Column="0" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" Margin="5"/>
                            <Button Click="GetLyricsFromNet_Click" Grid.Row="0" Grid.Column="1" Margin="5" VerticalAlignment="Stretch">                               
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid>
                                            <FontIcon Glyph="&#xF385;" FontSize="16"/>
                                            <FontIcon Glyph="&#xF386;" FontSize="16"/>
                                        </Grid>
                                    </StackPanel>
                                </Button.Content>
                                <ToolTipService.ToolTip>
                                    <ToolTip>
                                        在线匹配歌词
                                    </ToolTip>
                                </ToolTipService.ToolTip>
                            </Button>
                        </Grid>

                        <TextBlock Text="时长：" FontWeight="Bold" Grid.Row="6" Grid.Column="0" HorizontalAlignment="Right" Margin="5"/>
                        <TextBlock x:Name="DurationTextBlock" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" Margin="5"/>

                        <TextBlock Text="位深：" FontWeight="Bold" Grid.Row="7" Grid.Column="0" HorizontalAlignment="Right" Margin="5"/>
                        <TextBlock x:Name="BitDepthTextBlock" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left" Margin="5"/>

                        <TextBlock Text="比特率：" FontWeight="Bold" Grid.Row="8" Grid.Column="0" HorizontalAlignment="Right" Margin="5"/>
                        <TextBlock x:Name="BitRateTextBlock" Grid.Row="8" Grid.Column="1" HorizontalAlignment="Left" Margin="5"/>

                        <TextBlock Text="采样率：" FontWeight="Bold" Grid.Row="9" Grid.Column="0" HorizontalAlignment="Right" Margin="5"/>
                        <TextBlock x:Name="SampleRateTextBlock" Grid.Row="9" Grid.Column="1" HorizontalAlignment="Left" Margin="5"/>

                        <TextBlock Text="最后目录：" FontWeight="Bold" Grid.Row="10" Grid.Column="0" HorizontalAlignment="Right" Margin="5"/>
                        <TextBlock TextWrapping="WrapWholeWords" TextTrimming="WordEllipsis" x:Name="LastFolderNameTextBlock" Grid.Row="10" Grid.Column="1" HorizontalAlignment="Left" Margin="5"/>

                        <TextBlock Text="路径：" FontWeight="Bold" Grid.Row="11" Grid.Column="0" HorizontalAlignment="Right" Margin="5"/>
                        <TextBlock TextWrapping="WrapWholeWords" TextTrimming="WordEllipsis" x:Name="PathTextBlock" Grid.Row="11" Grid.Column="1" HorizontalAlignment="Left" Margin="5"/>
                    </Grid>
                    <Grid Grid.Column="1" Margin="10">
                        <StackPanel>
                            <Image x:Name="AlbumCoverImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"></Image>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Click="GetImageFromNet_Click" Margin="5" HorizontalAlignment="Center">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon Glyph="&#xebd3;" FontSize="16"/>        
                                        </StackPanel>
                                    </Button.Content>
                                    <ToolTipService.ToolTip>
                                        <ToolTip>
                                            在线匹配封面
                                        </ToolTip>
                                    </ToolTipService.ToolTip>                                    
                                </Button>
                                <Button Click="SaveImageButton_Click" Margin="5" HorizontalAlignment="Center">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon Glyph="&#xe78c;" FontSize="16"/>
                                        </StackPanel>
                                    </Button.Content>
                                    <ToolTipService.ToolTip>
                                        <ToolTip>
                                            保存到本地
                                        </ToolTip>
                                    </ToolTipService.ToolTip>                                    
                                </Button>
                                <Button Click="SelectCoverImageButton_Click" Margin="5" HorizontalAlignment="Center">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon Glyph="&#xe70f;" FontSize="16"/>
                                        </StackPanel>
                                    </Button.Content>
                                    <ToolTipService.ToolTip>
                                        <ToolTip>
                                            编辑封面
                                        </ToolTip>
                                    </ToolTipService.ToolTip>                                    
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <StackPanel
                RelativePanel.AlignBottomWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                Orientation="Horizontal"
            >
                <Button
                    Content="保存"
                    Margin="5">
                    <Button.Flyout>
                        <Flyout x:Name="ConfirmFlyout">
                            <StackPanel>
                                <TextBlock Style="{ThemeResource BaseTextBlockStyle}" Text="是否确定保存元信息至音乐" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="ConfirmButton_Click" Content="确认" Margin="0 0 10 0"/>
                                    <Button Content="取消"  Click="CloseFlyoutButton_Click" Margin="0 0 10 0"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    Content="关闭"
                    Click="CloseButton_Click"
                    Margin="5"/>
            </StackPanel>
           
        </RelativePanel>
    </Grid>
</Window>
