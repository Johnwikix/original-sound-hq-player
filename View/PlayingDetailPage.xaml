<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.PlayingDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:aic="using:AnimatedWin2dControls.Controls.AlbumImgControl"
    xmlns:atb="using:AnimatedWin2dControls.Controls.AnimatedTextBlock"
    xmlns:awc="using:AnimatedWin2dControls.Controls"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:lyrics="using:WinUIMusicPlayer.Controls.Lyrics"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    mc:Ignorable="d">

    <Grid>
        <awc:ShaderBackgroundControl
            x:Name="BackGround"
            EnableLightWave="{x:Bind ViewModel.AppViewModel.EnableLightWave, Mode=OneWay}"
            ImageBytes="{x:Bind ViewModel.AppViewModel.LyricPageBackgroundData, Mode=OneWay}"
            IsDark="{x:Bind ViewModel.AppViewModel.IsDarkMode, Mode=OneWay}"
            ThemeResolved="BackGround_ThemeResolved"
            UseImageDominantTheme="{x:Bind ViewModel.AppViewModel.UseImageDominantTheme, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.AppViewModel.IsBackgroundCoverEnabled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
        <Grid
            x:Name="PlayingDetail"
            Grid.Row="2"
            Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="TopControl"
                Grid.Column="0"
                Margin="45,5,5,0"
                VerticalAlignment="Top"
                Opacity="{x:Bind ViewModel.AppViewModel.TopControlsOpacity, Mode=OneWay}"
                Orientation="Horizontal"
                PointerEntered="TopControl_PointerEntered"
                PointerExited="TopControl_PointerExited">
                <StackPanel.OpacityTransition>
                    <ScalarTransition />
                </StackPanel.OpacityTransition>
                <Button
                    x:Name="CancelPlayingDetailButton"
                    Margin="10,0,0,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="CancelPlayingDetailButton_Click">
                    <FontIcon FontSize="16" Glyph="&#xE70D;" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Q" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button
                    Margin="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.FullScreenButtonChangedCommand, Mode=OneWay}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" />
                    </Button.KeyboardAccelerators>
                    <FontIcon
                        x:Name="FullScreenIcon"
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Glyph="{x:Bind ViewModel.AppViewModel.IsFullScreen, Converter={StaticResource FullScreenIconConverter}, Mode=OneWay}" />
                </Button>
                <Button
                    Margin="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.PlayDetailButtonVisibleChangedCommand, Mode=OneWay}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="V" />
                    </Button.KeyboardAccelerators>
                    <FontIcon
                        x:Name="VisibleIcon"
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Glyph="{x:Bind ViewModel.AppViewModel.IsPlayDetailButtonVisible, Converter={StaticResource PlayDetailButtonVisibleConverter}, Mode=OneWay}" />
                </Button>
            </StackPanel>
            <!--  专辑封面  -->
            <Grid Grid.Column="0" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3.5*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="6*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid
                        x:Name="PlayingDetailAlbumCoverImageGrid"
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        x:Load="{x:Bind tool:BindUtils.BoolToBoolReConverter(ViewModel.AppViewModel.IsWin2dCoverImageControlEnable), Mode=OneTime}"
                        CornerRadius="10">
                        <Image x:Name="AlbumCover" Canvas.ZIndex="1">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:FadeImageBehavior
                                    x:Name="AlbumCoverBehavior"
                                    Enable="{x:Bind tool:BindUtils.BoolToBoolReConverter(ViewModel.AppViewModel.IsWin2dCoverImageControlEnable), Mode=OneTime}"
                                    ImageBytes="{x:Bind ViewModel.AppViewModel.LyricPageBackgroundData, Mode=OneWay}"
                                    Duration="00:00:1" />
                            </interactivity:Interaction.Behaviors>
                        </Image>
                        <Grid
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                            Canvas.ZIndex="0"
                            Visibility="{x:Bind AlbumCoverBehavior.ImageVisibility, Mode=OneWay}">
                            <Viewbox Stretch="Uniform">
                                <Border
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                                    <!--  图标层  -->
                                    <FontIcon
                                        Width="200"
                                        Height="200"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Canvas.ZIndex="1"
                                        FontSize="100"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE93C;" />
                                </Border>
                            </Viewbox>
                        </Grid>
                    </Grid>
                    <aic:AlbumArtControl
                        x:Name="AlbumArtControl"
                        x:Load="{x:Bind ViewModel.AppViewModel.IsWin2dCoverImageControlEnable, Mode=OneTime}"
                        DpiScale="{x:Bind ViewModel.AppViewModel.DpiScale, Mode=OneWay}"
                        ImageBytes="{x:Bind ViewModel.AppViewModel.LyricPageBackgroundData, Mode=OneWay}"
                        IsActive="{x:Bind ViewModel.AppViewModel.IsWin2dCoverImageControlEnable, Mode=OneTime}"
                        IsDark="{x:Bind ViewModel.AppViewModel.IsDarkMode, Mode=OneWay}"
                        IsShadowEnabled="True" />
                </Grid>
                <Grid
                    x:Name="AnimatedTextBlock"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="25,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <atb:AnimatedTextBlock
                        x:Name="AnimatedPlayingDetailTitleTextBlock"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0"
                        x:Load="{x:Bind ViewModel.AppViewModel.IsWin2dAnimatedText, Mode=OneTime}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <atb:AnimatedTextBlock
                        x:Name="AnimatedPlayingDetailAlbumArtistTextBlock"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,0,1"
                        x:Load="{x:Bind ViewModel.AppViewModel.IsWin2dAnimatedText, Mode=OneTime}"
                        FontSize="24"
                        FontWeight="Normal"
                        Opacity="0.8"
                        Text="{x:Bind tool:BindUtils.MusicToInfo(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <dev:AutoScrollView
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0"
                        Padding="0"
                        IsPlaying="False"
                        Opacity="{x:Bind tool:BindUtils.BoolToOpacityReConverter(ViewModel.AppViewModel.IsWin2dAnimatedText), Mode=OneTime}"
                        PointerCanceled="AutoScrollHover_PointerCanceled"
                        PointerEntered="AutoScrollHover_PointerEntered"
                        PointerExited="AutoScrollHover_PointerExited">
                        <TextBlock
                            x:Name="PlayingDetailTitleTextBlock"
                            Margin="0"
                            HorizontalAlignment="Left"
                            FontSize="{x:Bind ViewModel.TitleFontSize, Mode=OneWay}"
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                            TextAlignment="Left"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </dev:AutoScrollView>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,0,2"
                        Opacity="{x:Bind tool:BindUtils.BoolToOpacityRe08Converter(ViewModel.AppViewModel.IsWin2dAnimatedText), Mode=OneTime}">
                        <dev:AutoScrollView
                            Margin="0"
                            Padding="0"
                            IsPlaying="False"
                            PointerCanceled="AutoScrollHover_PointerCanceled"
                            PointerEntered="AutoScrollHover_PointerEntered"
                            PointerExited="AutoScrollHover_PointerExited">
                            <TextBlock
                                x:Name="PlayingDetailAlbumTextBlock"
                                Margin="0"
                                HorizontalAlignment="Left"
                                FontSize="{x:Bind ViewModel.ArtistAlbumFontSize, Mode=OneWay}"
                                FontWeight="Normal"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Album, Mode=OneWay}"
                                TextAlignment="Left"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </dev:AutoScrollView>
                        <dev:AutoScrollView
                            Margin="0"
                            Padding="0"
                            IsPlaying="False"
                            PointerCanceled="AutoScrollHover_PointerCanceled"
                            PointerEntered="AutoScrollHover_PointerEntered"
                            PointerExited="AutoScrollHover_PointerExited">
                            <TextBlock
                                x:Name="PlayingDetailArtistTextBlock"
                                Margin="0"
                                HorizontalAlignment="Left"
                                FontSize="{x:Bind ViewModel.ArtistAlbumFontSize, Mode=OneWay}"
                                FontWeight="Normal"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Author, Mode=OneWay}"
                                TextAlignment="Left"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </dev:AutoScrollView>
                    </StackPanel>
                    <Button
                        x:Name="AnimatedPlayBarFavouriteButtonPlayingDetail"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.UpdateFavouriteCommand, Mode=OneWay}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="L" />
                        </Button.KeyboardAccelerators>
                        <FontIcon Foreground="Red" Glyph="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.IsFavorite, Mode=TwoWay, Converter={StaticResource FavouriteIconConverter}}" />
                    </Button>
                </Grid>
                <StackPanel
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="20,0,20,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="MusicInfoPanel"
                            Grid.Column="0"
                            Margin="5,2,0,1"
                            HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="PlayingDetailMusicInfoTextBlock"
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                FontSize="{x:Bind ViewModel.InfoFontSize, Mode=OneWay}"
                                Text="{x:Bind ViewModel.AppViewModel.MusicInfo, Mode=OneWay}" />
                            <Image
                                x:Name="PlayingDetailHRImage"
                                Grid.Column="1"
                                Height="{x:Bind ViewModel.InfoFontSize, Mode=OneWay}"
                                Source="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic, Converter={StaticResource MusicStatusToHRimgConverter}, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            x:Name="PlayTimeTextBlockPlayingDetail"
                            Grid.Column="1"
                            Margin="10,0,0,5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            FontSize="{x:Bind ViewModel.InfoFontSize, Mode=OneWay}"
                            Text="{x:Bind ViewModel.AppViewModel.PlayTimeText, Mode=TwoWay}" />
                    </Grid>
                    <!--  控制面板  -->
                    <Grid x:Name="PlayingDetailControlBar">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Slider
                            x:Name="ProgressSliderPlayingDetail"
                            Grid.Row="0"
                            Margin="0"
                            VerticalAlignment="Center"
                            Loaded="ProgressSliderPlayingDetail_Loaded"
                            Maximum="{x:Bind ViewModel.AppViewModel.ProgressSliderMax, Mode=TwoWay}"
                            Minimum="0"
                            PointerEntered="ProgressSlider_PointerEntered"
                            PointerExited="ProgressSlider_PointerExited"
                            ThumbToolTipValueConverter="{StaticResource AdvancedThumbToolTipValueConverter}"
                            Value="{x:Bind ViewModel.AppViewModel.ProgressSlider, Mode=TwoWay}" />
                        <Grid
                            Grid.Row="1"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button
                                x:Name="EqualizerButtonPlayingDetail"
                                Grid.Column="0"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="EqualizerButton_Click">
                                <FontIcon x:Name="EqualizerIconPlayingDetail" Glyph="&#xE9E9;" />
                            </Button>
                            <Button
                                x:Name="CurrentPlayListButtonPlayingDetail"
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="CurrentPlayListButtonPlayingDetail_Click">
                                <FontIcon x:Name="CurrentPlayListIconPlayingDetail" Glyph="&#xE90B;" />
                            </Button>
                            <TeachingTip
                                x:Name="CurrentPlayListTeachingTipPlayingDetail"
                                IsLightDismissEnabled="True"
                                Target="{x:Bind CurrentPlayListButtonPlayingDetail}">
                                <TeachingTip.Content>
                                    <Grid Width="290" Margin="0">
                                        <!--  ListView内容，给右上角留出空间  -->
                                        <ListView
                                            x:Name="CurrentPlayListViewPlayingDetail"
                                            MaxHeight="400"
                                            Margin="0,24,0,0"
                                            DoubleTapped="CurrentPlayListViewPlayingDetail_DoubleTapped"
                                            ItemsSource="{x:Bind ViewModel.AppViewModel.CurrentPlayingList, Mode=OneWay}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="model:Music">
                                                    <TextBlock
                                                        Margin="5"
                                                        VerticalAlignment="Center"
                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <!--  关闭按钮在最上层  -->
                                        <Button
                                            x:Name="CurrentPlayListTeachingTipCloseButton"
                                            Width="24"
                                            Height="24"
                                            Margin="0,0,4,0"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Canvas.ZIndex="999"
                                            Click="CurrentPlayListTeachingTipPlayingDetailCloseButton_Click">
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </TeachingTip.Content>
                            </TeachingTip>

                            <Button
                                x:Name="LastMusicButtonPlayingDetail"
                                Grid.Column="2"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.LastMusicButtonChangedCommand, Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Up" />
                                </Button.KeyboardAccelerators>
                                <FontIcon FontSize="22" Glyph="&#xe892;" />
                            </Button>

                            <!--  播放按钮  -->
                            <Button
                                x:Name="PlayPauseButtonPlayingDetail"
                                Grid.Column="3"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.PlayButtonChangedCommand, Mode=OneWay}"
                                Style="{StaticResource CircularHoverButtonStyle}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Space" />
                                </Button.KeyboardAccelerators>
                                <FontIcon
                                    Width="45"
                                    Height="45"
                                    FontSize="30"
                                    Glyph="{x:Bind ViewModel.AppViewModel.IsPlaying, Converter={StaticResource PlayStatusToIconConverter}, Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="NextMusicButtonPlayingDetail"
                                Grid.Column="4"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.NextMusicButtonChangedCommand, Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Down" />
                                </Button.KeyboardAccelerators>
                                <FontIcon FontSize="22" Glyph="&#xe893;" />
                            </Button>
                            <!--  播放模式按钮  -->
                            <Button
                                x:Name="PlayModeButtonPlayingDetail"
                                Grid.Column="5"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.PlayModeChangedCommand, Mode=OneWay}">
                                <FontIcon x:Name="PlayModeIconPlayingDetail" Glyph="{x:Bind ViewModel.AppViewModel.CurrentPlayMode, Converter={StaticResource PlayModeToIconConverter}, Mode=TwoWay}" />
                            </Button>
                            <Button
                                x:Name="VolumePlayingDetailBtn"
                                Grid.Column="6"
                                Margin="0,0,5,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0">
                                <FontIcon
                                    x:Name="VolumeSliderIconPlayingDetail"
                                    Grid.Column="0"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Glyph="{x:Bind ViewModel.AppViewModel.Volume, Converter={StaticResource VolumeToIconConverter}, Mode=OneWay}" />
                                <Button.Flyout>
                                    <Flyout x:Name="VolumeFlyout" Placement="Right">
                                        <Slider
                                            x:Name="VolumeSliderPlayingDetail"
                                            Width="100"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Minimum="0"
                                            PointerEntered="VolumeSlider_PointerEntered"
                                            PointerExited="VolumeSlider_PointerExited"
                                            PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                                            Value="{x:Bind ViewModel.AppViewModel.Volume, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,40,0,40">
                <!--  添加歌词显示列表  -->
                <controls:OpacityMaskView
                    x:Name="MaskView"
                    Margin="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <controls:OpacityMaskView.OpacityMask>
                        <Rectangle Stretch="UniformToFill">
                            <Rectangle.Fill>
                                <LinearGradientBrush MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#0000FFFF" />
                                    <GradientStop Offset="0.05" Color="#00FFFFFF" />
                                    <GradientStop Offset="0.15" Color="#0FFFFFFF" />
                                    <GradientStop Offset="0.25" Color="#5FFFFFFF" />
                                    <GradientStop Offset="0.35" Color="#FFFFFFFF" />
                                    <GradientStop Offset="0.65" Color="#FFFFFFFF" />
                                    <GradientStop Offset="0.75" Color="#5FFFFFFF" />
                                    <GradientStop Offset="0.85" Color="#0FFFFFFF" />
                                    <GradientStop Offset="0.95" Color="#00FFFFFF" />
                                    <GradientStop Offset="1" Color="#0000FFFF" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </controls:OpacityMaskView.OpacityMask>
                    <ScrollView
                        x:Name="LyricViewer"
                        Margin="0"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Height="1080" />
                            <ListView
                                x:Name="LyricsListView"
                                Margin="{x:Bind ViewModel.AppViewModel.LyricsMargin, Mode=OneWay}"
                                VerticalAlignment="Stretch"
                                behaviors:LyricsAutoScrollBehavior.TargetScrollView="{x:Bind LyricViewer}"
                                IsItemClickEnabled="True"
                                ItemClick="LyricsListView_ItemClick"
                                ItemsSource="{x:Bind ViewModel.AppViewModel.UILyrics, Mode=TwoWay}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter
                                                        x:Name="ContentPresenter"
                                                        Margin="{TemplateBinding Padding}"
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                        Background="{TemplateBinding Background}"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        ContentTransitions="{TemplateBinding ContentTransitions}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="lyrics:LyricLine">
                                        <Grid
                                            x:Name="LyricsLineGrid"
                                            Padding="0"
                                            CornerRadius="5"
                                            PointerEntered="LyricsLineGrid_PointerEntered"
                                            PointerExited="LyricsLineGrid_PointerExited">
                                            <lyrics:LyricsLineControl
                                                x:Name="LyricsLineControl"
                                                HorizontalAlignment="{x:Bind model:AppSettings.LyricsAlignment, Converter={StaticResource TextAlignmentToHorizontalAlignmentConverter}, Mode=OneWay}"
                                                FontFamily="{x:Bind model:AppSettings.GlobalFont}"
                                                IsCurrentLine="{x:Bind IsCurrent, Mode=OneWay}"
                                                IsGlobalFontSizeEnabled="{x:Bind model:AppSettings.IsGlobalFontSizeEnabled, Mode=OneWay}"
                                                LyricWords="{x:Bind Words, Mode=OneWay}"
                                                LyricsFontSize="{x:Bind model:AppSettings.GlobalFontSize, Mode=OneWay}"
                                                TextAlignment="{x:Bind model:AppSettings.LyricsAlignment, Mode=OneWay}"
                                                TranslateFontSize="{x:Bind model:AppSettings.GlobalFontSize, Mode=OneWay}"
                                                TranslateText="{x:Bind TransLateText}"
                                                TranslateVisibility="{x:Bind TransLateText, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}">
                                                <interactivity:Interaction.Behaviors>
                                                    <behaviors:LyricsAutoScrollBehavior />
                                                </interactivity:Interaction.Behaviors>
                                            </lyrics:LyricsLineControl>
                                            <dev:BlurEffectControl
                                                x:Name="BlurEffectControlSample"
                                                Margin="0"
                                                HorizontalAlignment="Stretch"
                                                BlurAmount="{x:Bind model:AppSettings.LyricsBlurAmount}"
                                                IsBlurEnabled="True" />
                                        </Grid>
