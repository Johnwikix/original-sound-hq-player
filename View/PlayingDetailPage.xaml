<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.PlayingDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:aic="using:AnimatedWin2dControls.Controls.AlbumImgControl"
    xmlns:atb="using:AnimatedWin2dControls.Controls.AnimatedTextBlock"
    xmlns:awc="using:AnimatedWin2dControls.Controls"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:lyrics="using:WinUIMusicPlayer.Controls.Lyrics"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    xmlns:uc="using:WinUIMusicPlayer.Controls"
    mc:Ignorable="d">

    <Grid>
        <awc:ShaderBackgroundControl
            x:Name="BackGround"
            EnableLightWave="{x:Bind ViewModel.AppViewModel.EnableLightWave, Mode=OneWay}"
            ImageBytes="{x:Bind ViewModel.AppViewModel.LyricPageBackgroundData, Mode=OneWay}"
            IsDark="{x:Bind ViewModel.AppViewModel.IsDarkMode, Mode=OneWay}"
            ThemeResolved="BackGround_ThemeResolved"
            UseImageDominantTheme="{x:Bind ViewModel.AppViewModel.UseImageDominantTheme, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.AppViewModel.IsBackgroundCoverEnabled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
        <Grid
            x:Name="PlayingDetail"
            Grid.Row="2"
            Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="TopControl"
                Grid.Column="0"
                Margin="45,5,5,0"
                VerticalAlignment="Top"
                Opacity="{x:Bind ViewModel.AppViewModel.TopControlsOpacity, Mode=OneWay}"
                Orientation="Horizontal"
                PointerEntered="TopControl_PointerEntered"
                PointerExited="TopControl_PointerExited">
                <StackPanel.OpacityTransition>
                    <ScalarTransition />
                </StackPanel.OpacityTransition>
                <Button
                    x:Name="CancelPlayingDetailButton"
                    Margin="10,0,0,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="CancelPlayingDetailButton_Click"
                    Style="{StaticResource MenuButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE70D;" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Q" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button
                    Margin="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.FullScreenButtonChangedCommand, Mode=OneWay}"
                    Style="{StaticResource MenuButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" />
                    </Button.KeyboardAccelerators>
                    <FontIcon
                        x:Name="FullScreenIcon"
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Glyph="{x:Bind ViewModel.AppViewModel.IsFullScreen, Converter={StaticResource FullScreenIconConverter}, Mode=OneWay}" />
                </Button>
                <Button
                    Margin="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.PlayDetailButtonVisibleChangedCommand, Mode=OneWay}"
                    Style="{StaticResource MenuButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="V" />
                    </Button.KeyboardAccelerators>
                    <FontIcon
                        x:Name="VisibleIcon"
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Glyph="{x:Bind ViewModel.AppViewModel.IsPlayDetailButtonVisible, Converter={StaticResource PlayDetailButtonVisibleConverter}, Mode=OneWay}" />
                </Button>
            </StackPanel>
            <!--  专辑封面  -->
            <Grid Grid.Column="0" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <controls:OpacityMaskView
                    x:Name="MaskView"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <controls:OpacityMaskView.OpacityMask>
                        <Rectangle Stretch="UniformToFill">
                            <Rectangle.Fill>
                                <LinearGradientBrush MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="0.05" Color="#FFFFFFFF" />
                                    <GradientStop Offset="0.95" Color="#FFFFFFFF" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </controls:OpacityMaskView.OpacityMask>
                    <Grid>
                        <Grid
                            x:Name="PlayingDetailAlbumCoverImageGrid"
                            Margin="0"
                            Padding="50,20,50,20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            x:Load="{x:Bind tool:BindUtils.BoolToBoolReConverter(ViewModel.AppViewModel.IsWin2dCoverImageControlEnable), Mode=OneTime}"
                            CornerRadius="10">
                            <uc:ImageSwitcher
                                CornerRadiusAmount="12"
                                ImageBytes="{x:Bind ViewModel.AppViewModel.LyricPageBackgroundData, Mode=OneWay}"
                                IsDark="{x:Bind ViewModel.AppViewModel.IsDarkMode, Mode=OneWay}"
                                ShadowAmount="16"
                                SwitchType="{x:Bind model:AppSettings.ImageSwitchType, Mode=OneWay}" />
                        </Grid>
                        <aic:AlbumArtControl
                            x:Name="AlbumArtControl"
                            Margin="30,0,30,0"
                            x:Load="{x:Bind ViewModel.AppViewModel.IsWin2dCoverImageControlEnable, Mode=OneTime}"
                            ImageBytes="{x:Bind ViewModel.AppViewModel.LyricPageBackgroundData, Mode=OneWay}"
                            IsActive="{x:Bind ViewModel.AppViewModel.IsWin2dCoverImageControlEnable, Mode=OneTime}"
                            IsDark="{x:Bind ViewModel.AppViewModel.IsDarkMode, Mode=OneWay}"
                            IsShadowEnabled="True" />
                    </Grid>
                </controls:OpacityMaskView>
                <Grid
                    x:Name="AnimatedTextBlock"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="50,0,50,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <atb:AnimatedTextBlock
                        x:Name="AnimatedPlayingDetailTitleTextBlock"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0"
                        x:Load="{x:Bind ViewModel.AppViewModel.IsWin2dAnimatedText, Mode=OneTime}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <atb:AnimatedTextBlock
                        x:Name="AnimatedPlayingDetailAlbumArtistTextBlock"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,0,1"
                        x:Load="{x:Bind ViewModel.AppViewModel.IsWin2dAnimatedText, Mode=OneTime}"
                        FontSize="24"
                        FontWeight="Normal"
                        Opacity="0.8"
                        Text="{x:Bind tool:BindUtils.MusicToInfo(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <dev:AutoScrollView
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0"
                        Padding="0"
                        IsPlaying="False"
                        Opacity="{x:Bind tool:BindUtils.BoolToOpacityReConverter(ViewModel.AppViewModel.IsWin2dAnimatedText), Mode=OneTime}"
                        PointerCanceled="AutoScrollHover_PointerCanceled"
                        PointerEntered="AutoScrollHover_PointerEntered"
                        PointerExited="AutoScrollHover_PointerExited">
                        <TextBlock
                            x:Name="PlayingDetailTitleTextBlock"
                            Margin="0"
                            HorizontalAlignment="Left"
                            FontSize="{x:Bind ViewModel.TitleFontSize, Mode=OneWay}"
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                            TextAlignment="Left"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </dev:AutoScrollView>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,0,2"
                        Opacity="{x:Bind tool:BindUtils.BoolToOpacityRe08Converter(ViewModel.AppViewModel.IsWin2dAnimatedText), Mode=OneTime}">
                        <dev:AutoScrollView
                            Margin="0"
                            Padding="0"
                            IsPlaying="False"
                            PointerCanceled="AutoScrollHover_PointerCanceled"
                            PointerEntered="AutoScrollHover_PointerEntered"
                            PointerExited="AutoScrollHover_PointerExited">
                            <TextBlock
                                x:Name="PlayingDetailAlbumTextBlock"
                                Margin="0"
                                HorizontalAlignment="Left"
                                FontSize="{x:Bind ViewModel.ArtistAlbumFontSize, Mode=OneWay}"
                                FontWeight="Normal"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Album, Mode=OneWay}"
                                TextAlignment="Left"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </dev:AutoScrollView>
                        <dev:AutoScrollView
                            Margin="0"
                            Padding="0"
                            IsPlaying="False"
                            PointerCanceled="AutoScrollHover_PointerCanceled"
                            PointerEntered="AutoScrollHover_PointerEntered"
                            PointerExited="AutoScrollHover_PointerExited">
                            <TextBlock
                                x:Name="PlayingDetailArtistTextBlock"
                                Margin="0"
                                HorizontalAlignment="Left"
                                FontSize="{x:Bind ViewModel.ArtistAlbumFontSize, Mode=OneWay}"
                                FontWeight="Normal"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Author, Mode=OneWay}"
                                TextAlignment="Left"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </dev:AutoScrollView>
                    </StackPanel>
                    <Button
                        x:Name="AnimatedPlayBarFavouriteButtonPlayingDetail"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.UpdateFavouriteCommand, Mode=OneWay}"
                        Style="{StaticResource MenuButtonStyle}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="L" />
                        </Button.KeyboardAccelerators>
                        <FontIcon
                            FontSize="{x:Bind ViewModel.SecondControlSize, Mode=OneWay}"
                            Foreground="Red"
                            Glyph="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.IsFavorite, Mode=TwoWay, Converter={StaticResource FavouriteIconConverter}}" />
                    </Button>
                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Style="{StaticResource MenuButtonStyle}">
                        <FontIcon
                            Grid.Column="0"
                            Margin="0"
                            VerticalAlignment="Center"
                            FontSize="{x:Bind ViewModel.SecondControlSize, Mode=OneWay}"
                            Glyph="&#xE917;" />
                        <Button.Flyout>
                            <Flyout Placement="Right">
                                <NumberBox
                                    Width="175"
                                    LargeChange="1000"
                                    Maximum="10000"
                                    Minimum="-10000"
                                    SmallChange="100"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.LyricsOffsetMs, Mode=TwoWay}" />
                            </Flyout>
                        </Button.Flyout>
                        <ToolTipService.ToolTip>
                            <ToolTip x:Uid="LyricsTimeOffset" />
                        </ToolTipService.ToolTip>
                    </Button>
                </Grid>
                <StackPanel
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="20,0,20,20">
                    <Grid Margin="30,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="MusicInfoPanel"
                            Grid.Column="0"
                            Margin="0,5,0,0"
                            HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="PlayingDetailMusicInfoTextBlock"
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                FontSize="{x:Bind ViewModel.InfoFontSize, Mode=OneWay}"
                                Text="{x:Bind ViewModel.AppViewModel.MusicInfo, Mode=OneWay}" />
                            <Image
                                x:Name="PlayingDetailHRImage"
                                Grid.Column="1"
                                Height="{x:Bind ViewModel.InfoFontSize, Mode=OneWay}"
                                Source="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic, Converter={StaticResource MusicStatusToHRimgConverter}, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            x:Name="PlayTimeTextBlockPlayingDetail"
                            Grid.Column="1"
                            Margin="0,5,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            FontSize="{x:Bind ViewModel.InfoFontSize, Mode=OneWay}"
                            Text="{x:Bind ViewModel.AppViewModel.PlayTimeText, Mode=TwoWay}" />
                    </Grid>
                    <!--  控制面板  -->
                    <Grid x:Name="PlayingDetailControlBar">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Slider
                            x:Name="ProgressSliderPlayingDetail"
                            Grid.Row="0"
                            Margin="30,0"
                            VerticalAlignment="Center"
                            Loaded="ProgressSliderPlayingDetail_Loaded"
                            Maximum="{x:Bind ViewModel.AppViewModel.ProgressSliderMax, Mode=TwoWay}"
                            Minimum="0"
                            PointerEntered="ProgressSlider_PointerEntered"
                            PointerExited="ProgressSlider_PointerExited"
                            ThumbToolTipValueConverter="{StaticResource AdvancedThumbToolTipValueConverter}"
                            Value="{x:Bind ViewModel.AppViewModel.ProgressSlider, Mode=TwoWay}" />
                        <Grid
                            Grid.Row="1"
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button
                                x:Name="EqualizerButtonPlayingDetail"
                                Grid.Column="0"
                                Margin="{x:Bind ViewModel.ControlMargin, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="EqualizerButton_Click"
                                Style="{StaticResource MenuButtonStyle}">
                                <FontIcon
                                    x:Name="EqualizerIconPlayingDetail"
                                    FontSize="{x:Bind ViewModel.SecondControlSize, Mode=OneWay}"
                                    Glyph="&#xE9E9;" />
                            </Button>
                            <Button
                                x:Name="CurrentPlayListButtonPlayingDetail"
                                Grid.Column="1"
                                Margin="{x:Bind ViewModel.ControlMargin, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="CurrentPlayListButtonPlayingDetail_Click"
                                Style="{StaticResource MenuButtonStyle}">
                                <FontIcon
                                    x:Name="CurrentPlayListIconPlayingDetail"
                                    FontSize="{x:Bind ViewModel.SecondControlSize, Mode=OneWay}"
                                    Glyph="&#xE90B;" />
                            </Button>
                            <TeachingTip
                                x:Name="CurrentPlayListTeachingTipPlayingDetail"
                                IsLightDismissEnabled="True"
                                Target="{x:Bind CurrentPlayListButtonPlayingDetail}">
                                <TeachingTip.Content>
                                    <Grid Width="290" Margin="0">
                                        <!--  ListView内容，给右上角留出空间  -->
                                        <ListView
                                            x:Name="CurrentPlayListViewPlayingDetail"
                                            MaxHeight="400"
                                            Margin="0,24,0,0"
                                            DoubleTapped="CurrentPlayListViewPlayingDetail_DoubleTapped"
                                            ItemsSource="{x:Bind ViewModel.AppViewModel.CurrentPlayingList, Mode=OneWay}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="model:Music">
                                                    <TextBlock
                                                        Margin="5"
                                                        VerticalAlignment="Center"
                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <!--  关闭按钮在最上层  -->
                                        <Button
                                            x:Name="CurrentPlayListTeachingTipCloseButton"
                                            Width="24"
                                            Height="24"
                                            Margin="0,0,4,0"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Canvas.ZIndex="999"
                                            Click="CurrentPlayListTeachingTipPlayingDetailCloseButton_Click">
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </TeachingTip.Content>
                            </TeachingTip>

                            <Button
                                x:Name="LastMusicButtonPlayingDetail"
                                Grid.Column="2"
                                Margin="{x:Bind ViewModel.ControlMargin, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.LastMusicButtonChangedCommand, Mode=OneWay}"
                                Style="{StaticResource MenuButtonStyle}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Up" />
                                </Button.KeyboardAccelerators>
                                <FontIcon FontSize="{x:Bind ViewModel.SecondControlSize, Mode=OneWay}" Glyph="&#xF8AC;" />
                            </Button>

                            <!--  播放按钮  -->
                            <Button
                                x:Name="PlayPauseButtonPlayingDetail"
                                Grid.Column="3"
                                Margin="{x:Bind ViewModel.ControlMargin, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.PlayButtonChangedCommand, Mode=OneWay}"
                                Style="{StaticResource PlayButtonStyle}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Space" />
                                </Button.KeyboardAccelerators>
                                <FontIcon
                                    Width="{x:Bind ViewModel.FirstShapeSize, Mode=OneWay}"
                                    Height="{x:Bind ViewModel.FirstShapeSize, Mode=OneWay}"
                                    FontSize="{x:Bind ViewModel.FirstControlSize, Mode=OneWay}"
                                    Glyph="{x:Bind ViewModel.AppViewModel.IsPlaying, Converter={StaticResource PlayStatusToIconConverter}, Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="NextMusicButtonPlayingDetail"
                                Grid.Column="4"
                                Margin="{x:Bind ViewModel.ControlMargin, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.NextMusicButtonChangedCommand, Mode=OneWay}"
                                Style="{StaticResource MenuButtonStyle}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Down" />
                                </Button.KeyboardAccelerators>
                                <FontIcon FontSize="{x:Bind ViewModel.SecondControlSize, Mode=OneWay}" Glyph="&#xF8AD;" />
                            </Button>
                            <!--  播放模式按钮  -->
                            <Button
                                x:Name="PlayModeButtonPlayingDetail"
                                Grid.Column="5"
                                Margin="{x:Bind ViewModel.ControlMargin, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.PlayModeChangedCommand, Mode=OneWay}"
                                Style="{StaticResource MenuButtonStyle}">
                                <FontIcon
                                    x:Name="PlayModeIconPlayingDetail"
                                    FontSize="{x:Bind ViewModel.SecondControlSize, Mode=OneWay}"
                                    Glyph="{x:Bind ViewModel.AppViewModel.CurrentPlayMode, Converter={StaticResource PlayModeToIconConverter}, Mode=TwoWay}" />
                            </Button>
                            <Button
                                x:Name="VolumePlayingDetailBtn"
                                Grid.Column="6"
                                Margin="{x:Bind ViewModel.ControlMargin, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource MenuButtonStyle}">
                                <FontIcon
                                    x:Name="VolumeSliderIconPlayingDetail"
                                    Grid.Column="0"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    FontSize="{x:Bind ViewModel.SecondControlSize, Mode=OneWay}"
                                    Glyph="{x:Bind ViewModel.AppViewModel.Volume, Converter={StaticResource VolumeToIconConverter}, Mode=OneWay}" />
                                <Button.Flyout>
                                    <Flyout x:Name="VolumeFlyout" Placement="Right">
                                        <Slider
                                            x:Name="VolumeSliderPlayingDetail"
                                            Width="100"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Minimum="0"
                                            PointerEntered="VolumeSlider_PointerEntered"
                                            PointerExited="VolumeSlider_PointerExited"
                                            PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                                            Value="{x:Bind ViewModel.AppViewModel.Volume, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>
            <Grid
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,40,0,40">
                <!--  添加歌词显示列表  -->
                <lyrics:LyricsControl
                    x:Name="LyricsView"
                    AnimationSmoothness="1"
                    CurrentPlayingTime="{x:Bind ViewModel.AppViewModel.CurrentPlayingTime, Mode=OneWay}"
                    FontFamilyName="{x:Bind model:AppSettings.GlobalFont.Source, Mode=OneWay}"
                    IsDark="{x:Bind ViewModel.AppViewModel.IsDarkMode, Mode=OneWay}"
                    IsPlaying="{x:Bind ViewModel.AppViewModel.IsPlaying, Mode=OneWay}"
                    LyricInteracted="LyricsView_LyricInteracted"
                    LyricsBlurAmount="{x:Bind ViewModel.AppViewModel.LyricsBlurAmount, Mode=OneWay}"
                    LyricsFontSize="{x:Bind tool:BindUtils.LyricsFontSizeConverter(ViewModel.AppViewModel.LyricsFontSize, ViewModel.AppViewModel.GlobalFontSize, ViewModel.AppViewModel.IsGlobalFontSizeEnabled), Mode=OneWay}"
                    LyricsMargin="{x:Bind ViewModel.AppViewModel.LyricsMargin, Mode=OneWay}"
                    LyricsOffsetMs="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.LyricsOffsetMs, Mode=OneWay}"
                    LyricsTextAlignment="{x:Bind tool:BindUtils.ConvertStringToTextAlignment(ViewModel.AppViewModel.LyricsAlignment), Mode=OneWay}"
                    UILyrics="{x:Bind ViewModel.AppViewModel.UILyrics, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
