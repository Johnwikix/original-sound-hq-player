<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    mc:Ignorable="d">

    <Grid>
        <Grid
            x:Name="AppTitleBar"
            Height="44"
            Margin="48,0,0,0"
            Padding="0"
            VerticalAlignment="Top"
            Opacity="{x:Bind tools:BindUtils.VisibilityToOpacityReConverter(PlayingFrame.Visibility), Mode=OneWay}">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="AppTitle"
                Grid.Column="1"
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <Grid x:Name="NavigationViewControlGrid">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <NavigationView
                x:Name="NavigationViewControl"
                BackRequested="NavigationViewControl_BackRequested"
                IsBackButtonVisible="Visible"
                IsBackEnabled="{x:Bind ViewModel.AppViewModel.IsBackBtnEnable, Mode=OneWay}"
                IsPaneOpen="False"
                IsPaneToggleButtonVisible="True"
                ItemInvoked="NavigationView_ItemInvoked"
                PaneDisplayMode="LeftCompact"
                Visibility="{x:Bind tools:BindUtils.VisiblilityToVisibilityConverter(PlayingFrame.Visibility), Mode=OneWay}">
                <NavigationView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" Invoked="KeyboardAccelerator_Invoked" />
                </NavigationView.KeyboardAccelerators>
                <NavigationView.MenuItems>
                    <NavigationViewItem Icon="NewFolder" Tag="AddFolder">
                        <NavigationViewItem.Content>
                            <TextBlock x:Uid="AddFolder" />
                        </NavigationViewItem.Content>
                    </NavigationViewItem>
                    <NavigationViewItem Icon="Audio" Tag="MusicBrowse">
                        <NavigationViewItem.Content>
                            <TextBlock x:Uid="MusicBrowse" />
                        </NavigationViewItem.Content>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <Frame x:Name="MainFrame" Background="Transparent" />
            </NavigationView>
        </Grid>
        <Frame x:Name="PlayingFrame" Visibility="Collapsed" />
    </Grid>
</Page>
