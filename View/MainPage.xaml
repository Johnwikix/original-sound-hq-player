<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    mc:Ignorable="d">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid
                    x:Name="AppTitleBar"
                    Height="44"
                    Margin="50,0,0,0"
                    Padding="0"
                    VerticalAlignment="Top"
                    Opacity="{x:Bind tools:BindUtils.VisibilityToOpacityConverter(NavigationViewControl.Visibility), Mode=OneWay}">
                    <Grid.OpacityTransition>
                        <ScalarTransition />
                    </Grid.OpacityTransition>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="AppTitle"
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
                <NavigationView
                    x:Name="NavigationViewControl"
                    BackRequested="NavigationViewControl_BackRequested"
                    IsBackButtonVisible="Visible"
                    IsBackEnabled="{x:Bind ViewModel.AppViewModel.IsBackBtnEnable, Mode=OneWay}"
                    IsPaneToggleButtonVisible="True"
                    ItemInvoked="NavigationView_ItemInvoked"
                    PaneDisplayMode="Auto">
                    <NavigationView.AutoSuggestBox>
                        <AutoSuggestBox
                            x:Name="SearchAutoSuggestBox"
                            x:Uid="SearchMusic"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.AppViewModel.SearchText, Mode=TwoWay}" />
                    </NavigationView.AutoSuggestBox>
                    <NavigationView.MenuItems>
                        <NavigationViewItem Icon="NewFolder" Tag="AddFolder">
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="AddFolder" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                        <NavigationViewItem Icon="Audio" Tag="MusicBrowse">
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="MusicBrowse" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                        <NavigationViewItem Tag="PlayLists">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="{StaticResource UntamedFontFamily}" Glyph="&#xED3B;" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="PlayLists" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                    <Frame x:Name="MainFrame" Background="Transparent" />
                </NavigationView>
            </Grid>
            <Grid
                x:Name="BottomControlBar"
                Grid.Row="1"
                Height="120"
                Margin="10,0,10,10"
                Visibility="{x:Bind NavigationViewControl.Visibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider
                        x:Name="ProgressSlider"
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        Loaded="ProgressSlider_Loaded"
                        Maximum="{x:Bind ViewModel.AppViewModel.ProgressSliderMax, Mode=TwoWay}"
                        Minimum="0"
                        PointerEntered="ProgressSlider_PointerEntered"
                        PointerExited="ProgressSlider_PointerExited"
                        ThumbToolTipValueConverter="{StaticResource AdvancedThumbToolTipValueConverter}"
                        Value="{x:Bind ViewModel.AppViewModel.ProgressSlider, Mode=TwoWay}" />
                    <TextBlock
                        x:Name="PlayTimeTextBlock"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.AppViewModel.PlayTimeText, Mode=OneWay}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        x:Name="AlbumCoverAuthorTitleModel"
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Visible">
                        <Button
                            x:Name="AlbumCoverImageBtn"
                            Margin="5,0,5,0"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.AlbumCoverImageCommand, Mode=OneWay}"
                            CornerRadius="5"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource SimpleHoverButtonStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="AlbumCoverImageGrid" Grid.Row="0">
                                    <Grid
                                        x:Name="AlbumCoverImage"
                                        Width="80"
                                        Height="80"
                                        Canvas.ZIndex="1">
                                        <Image
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="UniformToFill">
                                            <interactivity:Interaction.Behaviors>
                                                <behaviors:FadeImageBehavior ImageHash="{x:Bind ViewModel.AppViewModel.LyricPageBackgroundHash, Mode=OneWay}" Duration="00:00:1" />
                                            </interactivity:Interaction.Behaviors>
                                        </Image>
                                    </Grid>
                                    <Grid
                                        Width="80"
                                        Height="80"
                                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                        Canvas.ZIndex="0">
                                        <FontIcon
                                            Canvas.ZIndex="0"
                                            FontSize="40"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE93C;" />
                                    </Grid>
                                </Grid>

                                <FontIcon
                                    x:Name="AlbumCoverImageChevronUp"
                                    Grid.Row="0"
                                    Glyph="&#xE70E;"
                                    Opacity="0" />
                            </Grid>
                        </Button>
                        <Grid
                            Width="Auto"
                            Height="80"
                            MaxWidth="300">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <dev:AutoScrollView
                                Grid.Row="0"
                                Margin="10,0,10,0"
                                IsPlaying="False"
                                PointerCanceled="AutoScrollHover_PointerCanceled"
                                PointerEntered="AutoScrollHover_PointerEntered"
                                PointerExited="AutoScrollHover_PointerExited">
                                <TextBlock
                                    x:Name="MusicTitleTextBlock"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </dev:AutoScrollView>
                            <Button
                                x:Name="MusicAlbumTextBlock"
                                Grid.Row="1"
                                Margin="10,0,10,0"
                                Padding="1"
                                VerticalAlignment="Bottom"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}">
                                <Button.Content>
                                    <dev:AutoScrollView
                                        Margin="0"
                                        IsPlaying="False"
                                        PointerCanceled="AutoScrollHover_PointerCanceled"
                                        PointerEntered="AutoScrollHover_PointerEntered"
                                        PointerExited="AutoScrollHover_PointerExited">
                                        <TextBlock
                                            FontSize="12"
                                            Tapped="AlbumTextBlock_Tapped"
                                            Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Album, Mode=OneWay}"
                                            TextTrimming="WordEllipsis" />
                                    </dev:AutoScrollView>
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="MusicAuthorTextBlock"
                                Grid.Row="2"
                                Margin="10,0,10,0"
                                Padding="1"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}">
                                <Button.Content>
                                    <dev:AutoScrollView
                                        Margin="0"
                                        IsPlaying="False"
                                        PointerCanceled="AutoScrollHover_PointerCanceled"
                                        PointerEntered="AutoScrollHover_PointerEntered"
                                        PointerExited="AutoScrollHover_PointerExited">
                                        <TextBlock
                                            FontSize="12"
                                            Tapped="AuthorTextBlock_Tapped"
                                            Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Author, Mode=OneWay}"
                                            TextTrimming="WordEllipsis" />
                                    </dev:AutoScrollView>
                                </Button.Content>
                            </Button>
                            <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="MusicInfoTextBlock"
                                    Grid.Column="0"
                                    Margin="10,0,10,0"
                                    FontSize="12"
                                    Text="{x:Bind ViewModel.AppViewModel.MusicInfo, Mode=OneWay}" />
                                <Border
                                    x:Name="HRImage"
                                    Grid.Column="1"
                                    Padding="4,0,4,1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#F7C8AC"
                                    CornerRadius="2"
                                    Visibility="{x:Bind tools:BindUtils.GetHrMusicVisibility(ViewModel.AppViewModel.CurrentPlayingMusic.SampleRate, ViewModel.AppViewModel.CurrentPlayingMusic.BitDepth), Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="8"
                                        FontWeight="Bold"
                                        Foreground="#F98555"
                                        Text="HQ" />
                                </Border>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <Grid
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button
                            x:Name="PlayBarFavouriteButton"
                            Grid.Column="0"
                            Margin="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.UpdateFavouriteCommand, Mode=OneWay}"
                            CommandParameter="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon Foreground="Red" Glyph="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.IsFavorite, Mode=TwoWay, Converter={StaticResource FavouriteIconConverter}}" />
                        </Button>

                        <Button
                            x:Name="FastBackwardButton"
                            Grid.Column="1"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.FastBackwardButtonCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" Glyph="&#xED3C;" />
                        </Button>

                        <Button
                            x:Name="LastMusicButton"
                            Grid.Column="2"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.LastMusicButtonChangedCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentPlayListExist(ViewModel.AppViewModel.CurrentPlayingList), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="22" Glyph="&#xF8AC;" />
                        </Button>

                        <Button
                            x:Name="PlayPauseButton"
                            Grid.Column="3"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.PlayButtonChangedCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource PlayButtonStyle}">
                            <FontIcon
                                Width="45"
                                Height="45"
                                FontSize="30"
                                Glyph="{x:Bind ViewModel.AppViewModel.IsPlaying, Converter={StaticResource PlayStatusToIconConverter}, Mode=OneWay}" />
                        </Button>

                        <Button
                            x:Name="NextMusicButton"
                            Grid.Column="4"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.NextMusicButtonChangedCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentPlayListExist(ViewModel.AppViewModel.CurrentPlayingList), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="22" Glyph="&#xF8AD;" />
                        </Button>

                        <Button
                            x:Name="FastForwardButton"
                            Grid.Column="5"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.FastForwardButtonCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" Glyph="&#xED3D;" />
                        </Button>

                        <Button
                            x:Name="StopButton"
                            Grid.Column="6"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.StopButtonChangedCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" Glyph="&#xEE95;" />
                        </Button>
                    </Grid>
                    <StackPanel
                        Grid.Column="2"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="VolumeUp"
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.AppViewModel.VolumeUpChangedCommand, Mode=OneWay}"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <FontIcon Glyph="&#xE9E9;" />
                        </Button>
                        <Button
                            x:Name="VolumeDown"
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.AppViewModel.VolumeDownChangedCommand, Mode=OneWay}"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <FontIcon Glyph="&#xE9E9;" />
                        </Button>
                        <Button
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="VolumeSliderIcon"
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                Glyph="{x:Bind ViewModel.AppViewModel.Volume, Converter={StaticResource VolumeToIconConverter}, Mode=OneWay}" />
                            <Button.Flyout>
                                <Flyout x:Name="VolumeFlyout" Placement="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind ViewModel.AppViewModel.VolumeSliderIconButtonChangedCommand, Mode=OneWay}">
                                            <FontIcon
                                                x:Name="VolumeInsideSliderIcon"
                                                Grid.Column="0"
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                Glyph="{x:Bind ViewModel.AppViewModel.Volume, Converter={StaticResource VolumeToIconConverter}, Mode=OneWay}" />
                                        </Button>
                                        <Slider
                                            x:Name="VolumeSlider"
                                            Grid.Column="1"
                                            Width="150"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Minimum="0"
                                            PointerEntered="VolumeSlider_PointerEntered"
                                            PointerExited="VolumeSlider_PointerExited"
                                            PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                                            Value="{x:Bind ViewModel.AppViewModel.Volume, Mode=TwoWay}" />
                                        <TextBlock
                                            Width="30"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind ViewModel.AppViewModel.Volume, Mode=OneWay}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{x:Bind ViewModel.AppViewModel.Volume, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button
                            x:Name="CurrentPlayListButton"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="CurrentPlayListButton_Click"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon x:Name="CurrentPlayListIcon" Glyph="&#xE90B;" />
                        </Button>
                        <Button
                            x:Name="EqualizerButton"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.EqualizerButtonCommand, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon x:Name="EqualizerIcon" Glyph="&#xE9E9;" />
                        </Button>
                        <TeachingTip
                            x:Name="CurrentPlayListTeachingTip"
                            IsLightDismissEnabled="True"
                            Target="{x:Bind CurrentPlayListButton}">
                            <TeachingTip.Content>
                                <Grid Width="290">
                                    <ListView
                                        x:Name="CurrentPlayListView"
                                        Width="290"
                                        MaxHeight="400"
                                        Margin="0,24,0,0"
                                        DoubleTapped="CurrentPlayListView_DoubleTapped"
                                        ItemsSource="{x:Bind ViewModel.AppViewModel.CurrentPlayingList, Mode=OneWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="model:Music">
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="5"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <Button
                                        x:Name="CloseButton"
                                        Width="24"
                                        Height="24"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Canvas.ZIndex="999"
                                        Click="CurrentPlayListTeachingTipCloseButton_Click">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                            Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </TeachingTip.Content>
                        </TeachingTip>
                        <Button
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.AppViewModel.FullScreenButtonChangedCommand, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="FullScreenIcon"
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Glyph="{x:Bind ViewModel.AppViewModel.IsFullScreen, Converter={StaticResource FullScreenIconConverter}, Mode=OneWay}" />
                        </Button>
                        <Button
                            x:Name="PlayModeButton"
                            Margin="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.PlayModeChangedCommand, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon x:Name="PlayModeIcon" Glyph="{x:Bind ViewModel.AppViewModel.CurrentPlayMode, Converter={StaticResource PlayModeToIconConverter}, Mode=TwoWay}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <Frame x:Name="PlayingFrame" Visibility="Collapsed" />
    </Grid>
</Page>
