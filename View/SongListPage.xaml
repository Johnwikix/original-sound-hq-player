<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIMusicPlayer.View.SongListPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    TabIndex="0"
    xmlns:converters="using:WinUIMusicPlayer.Converters">
    <Page.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </Page.Resources>
    <ListView x:Name="MusicListView" DoubleTapped="MusicListView_DoubleTapped"  Grid.Row="1">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="model:Music">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Title}" Grid.Column="0" Margin="10" />
                    <TextBlock Text="{x:Bind Author}" Grid.Column="1" Margin="10" />
                    <TextBlock Text="{x:Bind Album}" Grid.Column="2" Margin="10" />
                    <TextBlock Text="{x:Bind Duration, Converter={StaticResource TimeSpanToStringConverter}}" Grid.Column="3" Margin="10"  />
                    <Button x:Name="RemoveMusicButton"  Grid.Column="4" Click="RemoveMusicButton_Click" Tag="{x:Bind Id}" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" >
                        <FontIcon Glyph="&#xecc9;"/>
                    </Button>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</Page> 
