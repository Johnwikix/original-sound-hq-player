<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIMusicPlayer.View.SongListPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:attached="using:WinUIMusicPlayer.AttachedProperties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    TabIndex="0"
    xmlns:converters="using:WinUIMusicPlayer.Converters">
    <Page.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <converters:SampleRateBitDepthConverter x:Key="SampleRateBitDepthConverter"/>
        <converters:FavouriteIconConverter x:Key="FavouriteIconConverter"/>
        <converters:FavouriteTextConverter x:Key="FavouriteTextConverter"/>
        <Style x:Key="ListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="ContextFlyout">
                <Setter.Value>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="播放" Click="PlayMenuItem_Click"/>
                        <MenuFlyoutItem Text="{Binding isFavorite, Converter={StaticResource FavouriteTextConverter}}" Click="SetAsFavoriteMenuItem_Click"/>
                        <MenuFlyoutSubItem Text="添加到播放列表">
                            <MenuFlyoutItem Text="添加到播放列表" Click="AddToPlaylistMenuItem_Click"/>                            
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem Text="打开文件位置" Click="OpenInExplorer_Click"/>
                        <MenuFlyoutItem Text="删除" Click="DeleteMenuItem_Click"/>
                    </MenuFlyout>
                </Setter.Value>
            </Setter>            
        </Style>
    </Page.Resources>
    <Grid>
        <ListView x:Name="MusicListView" 
          DoubleTapped="MusicListView_DoubleTapped" 
          ItemContainerStyle="{StaticResource ListViewItemStyle}" 
          RightTapped="MusicListView_RightTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Music">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="isFavouriteIconButton"  
                        Grid.Column="0"                            
                        Tag="{x:Bind}" 
                        Click="IsFavouriteIconButton_Click"
                        VerticalAlignment="Center" 
                        Margin="5" BorderThickness="0" 
                        BorderBrush="Transparent" 
                        Background="Transparent" >
                            <FontIcon x:Name="IsFavouriteIcon" Glyph="{x:Bind isFavorite,Mode=OneWay,Converter={StaticResource FavouriteIconConverter}}" Foreground="Red"/>
                        </Button>
                        <TextBlock Text="{x:Bind Title}" Grid.Column="1" Margin="5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Author}" 
                           Grid.Column="2" Margin="5" 
                           VerticalAlignment="Center" 
                           TextTrimming="CharacterEllipsis"
                           Tapped="AuthorTextBlock_Tapped"
                           />
                        <TextBlock Text="{x:Bind Album}" Grid.Column="3" Margin="5" VerticalAlignment="Center" 
                           TextTrimming="CharacterEllipsis"
                           Tapped="AlbumTextBlock_Tapped" />
                        <Image Source="ms-appx:///Assets/hr.png" Height="10" Grid.Column="4" Margin="5" VerticalAlignment="Center">
                            <attached:MultiValueBindingHelper.Bindings>
                                <attached:MultiBindingInfo>
                                    <attached:MultiBindingInfo.Binding1>
                                        <Binding Path="SampleRate"/>
                                    </attached:MultiBindingInfo.Binding1>
                                    <attached:MultiBindingInfo.Binding2>
                                        <Binding Path="BitDepth"/>
                                    </attached:MultiBindingInfo.Binding2>
                                    <attached:MultiBindingInfo.Converter>
                                        <converters:SampleRateBitDepthConverter/>
                                    </attached:MultiBindingInfo.Converter>
                                </attached:MultiBindingInfo>
                            </attached:MultiValueBindingHelper.Bindings>
                        </Image>
                        <TextBlock Text="{x:Bind Duration, Converter={StaticResource TimeSpanToStringConverter}}" Grid.Column="5" Margin="5" VerticalAlignment="Center"  />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>    
</Page> 
