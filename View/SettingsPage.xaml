<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    xmlns:ui="using:CommunityToolkit.WinUI"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="FontComboboxTemplate" x:DataType="model:FontInfo">
            <TextBlock FontFamily="{x:Bind FontFamily}" Text="{x:Bind DisplayName}" />
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="48,32,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="32,0,32,0">
            <TextBlock
                x:Uid="Settings"
                Margin="10,20,0,10"
                FontSize="28" />
        </Grid>

        <ScrollView Grid.Row="1">
            <StackPanel Margin="32,0,32,0">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="False" />
                    <RepositionThemeTransition IsStaggeringEnabled="True" />
                </StackPanel.ChildrenTransitions>

                <!--  音频设置  -->
                <TextBlock
                    x:Uid="SettingAudio"
                    Margin="10,10,0,0"
                    FontSize="16" />
                <StackPanel>
                    <StackPanel.ChildrenTransitions>
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </StackPanel.ChildrenTransitions>
                    <controls:SettingsExpander x:Uid="SettingOutput" Margin="10,10,10,0">
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingOutputDevice">
                                <ComboBox
                                    x:Name="OutputDeviceComboBox"
                                    Width="300"
                                    ItemsSource="{x:Bind ViewModel.AppViewModel.BassOutputDevices, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.AppViewModel.SelectedDevice, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="model:BassOutputDevice">
                                            <TextBlock Text="{x:Bind Tag}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingBufferSize">
                                <NumberBox
                                    x:Name="LatencyNumberBox"
                                    Width="300"
                                    LargeChange="100"
                                    Maximum="900"
                                    Minimum="100"
                                    SmallChange="10"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.AppViewModel.Latency, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="DSD2PCMFreq">
                                <ComboBox
                                    Width="300"
                                    IsEnabled="{x:Bind ViewModel.AppViewModel.IsDopEnabled, Converter={StaticResource BooleanNegationConverter}, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.AppViewModel.DsdPcmFreqs, Mode=OneWay}"
                                    SelectedValue="{x:Bind ViewModel.AppViewModel.DsdPcmFreq, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingDSDGain">
                                <NumberBox
                                    x:Name="DSDGainNumberBox"
                                    Width="300"
                                    IsEnabled="{x:Bind ViewModel.AppViewModel.IsDopEnabled, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}"
                                    Minimum="0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.AppViewModel.DsdGain, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="{x:Bind tool:ToolUtils.GetString('DsdDopDescription')}" Header="DSD Dop / DSD Native">
                                <ToggleSwitch IsOn="{x:Bind ViewModel.AppViewModel.IsDopEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="FadeInOut" Description="{x:Bind tool:ToolUtils.GetString('FadeInOutDescription')}">
                                <ToggleSwitch IsOn="{x:Bind ViewModel.AppViewModel.IsFadeEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <controls:SettingsCard
                        x:Name="SpectrumVisualization"
                        x:Uid="SpectrumVisualization"
                        Margin="10,0,10,0"
                        Click="SpectrumVisualization_Click"
                        Description="© 2025 Sennpei Studio"
                        HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/SpectrumVisualization.png}"
                        IsClickEnabled="True" />
                </StackPanel>

                <!--  功能设置  -->
                <TextBlock
                    x:Uid="SettingFunction"
                    Margin="10,10,0,0"
                    FontSize="16" />
                <controls:SettingsExpander x:Uid="SettingInterface" Margin="10,10,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="DefaultEntryInterface">
                            <ComboBox
                                x:Name="DefaultEntryComboBox"
                                Width="300"
                                SelectedValue="{x:Bind ViewModel.AppViewModel.DefaultEntryComboBoxTag, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem x:Uid="AddFolderCombox" Tag="AddFolder" />
                                <ComboBoxItem x:Uid="MusicBrowseCombox" Tag="MusicBrowse" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="DefaultMusicEntryInterface">
                            <ComboBox
                                x:Name="DefualtPlayListComboBox"
                                Width="300"
                                SelectedValue="{x:Bind ViewModel.AppViewModel.DefaultPlayListComboBoxTag, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem x:Uid="SongCombox" Tag="song" />
                                <ComboBoxItem x:Uid="AlbumCombox" Tag="album" />
                                <ComboBoxItem x:Uid="ArtistCombox" Tag="artist" />
                                <ComboBoxItem x:Uid="FolderCombox" Tag="folder" />
                                <ComboBoxItem x:Uid="FavouriteCombox" Tag="favourite" />
                                <ComboBoxItem x:Uid="PlaylistCombox" Tag="playList" />
                            </ComboBox>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  封面设置  -->
                <controls:SettingsExpander x:Uid="SettingCover" Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="CoverSize" Description="{x:Bind tool:ToolUtils.GetString('CoverSizeToolTip')}">
                            <NumberBox
                                x:Name="CoverSize"
                                Width="300"
                                LargeChange="10"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.AppViewModel.CoverSize, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="CoverDiskCache" Description="{x:Bind tool:ToolUtils.GetString('RebootToApply')}">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{x:Bind ViewModel.AppViewModel.OpenCoverCacheLocationCommand, Mode=OneWay}">
                                    <Button.Content>
                                        <dev:AutoScrollView
                                            Grid.Row="0"
                                            Margin="0,0,10,0"
                                            IsPlaying="False"
                                            PointerCanceled="AutoScrollHover_PointerCanceled"
                                            PointerEntered="AutoScrollHover_PointerEntered"
                                            PointerExited="AutoScrollHover_PointerExited">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{x:Bind ViewModel.AppViewModel.MusicCoverCache, Mode=OneWay}"
                                                TextAlignment="Right"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </dev:AutoScrollView>
                                    </Button.Content>
                                </Button>
                                <Button
                                    x:Uid="ChangeMusicCoverCache"
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.AppViewModel.ChangeCoverCacheLocationCommand, Mode=OneWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="MaxCoverCacheCount">
                            <NumberBox
                                Width="300"
                                LargeChange="10"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.AppViewModel.MaxCoverCacheCount, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="AutoCoverMatching">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AppViewModel.IsAutoCoverEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="FluidBackground">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AppViewModel.IsFluidBackgroundEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="EnableLightWave">
                            <ToggleSwitch IsEnabled="{x:Bind ViewModel.AppViewModel.IsFluidBackgroundEnabled, Mode=OneWay}" IsOn="{x:Bind ViewModel.AppViewModel.EnableLightWave, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="Win2dCover" Description="{x:Bind tool:ToolUtils.GetString('RebootToApply')}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AppViewModel.IsWin2dCoverImageControlEnable, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="Win2dAnimatedTitle" Description="{x:Bind tool:ToolUtils.GetString('RebootToApply')}">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    IsOn="{x:Bind ViewModel.AppViewModel.IsWin2dAnimatedText, Mode=TwoWay}" />
                                <ComboBox
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.AppViewModel.IsWin2dAnimatedText, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.AppViewModel.TextEffectItems}"
                                    SelectedItem="{x:Bind ViewModel.AppViewModel.Win2dTextEffectType, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="model:EffectComboBoxItem">
                                            <TextBlock Text="{x:Bind DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  歌词设置  -->
                <controls:SettingsExpander x:Uid="SettingLyrics" Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="AutoLyricMatching">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AppViewModel.IsAutoLyricsEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="EnableAdvancedLyricsEffect" Description="{x:Bind tool:ToolUtils.GetString('RebootToApply')}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AppViewModel.EnableAdvancedLyricsEffect, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="LyricsFontFamily">
                            <ComboBox
                                x:Name="LyricsFontFamily"
                                Width="300"
                                ItemTemplate="{StaticResource FontComboboxTemplate}"
                                ItemsSource="{x:Bind ViewModel.AppViewModel.FontFamilyList, Mode=OneWay}"
                                SelectedValue="{x:Bind ViewModel.AppViewModel.FontFamily, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="LyricsFontSize">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    IsOn="{x:Bind ViewModel.AppViewModel.IsGlobalFontSizeEnabled, Mode=TwoWay}" />
                                <NumberBox
                                    x:Name="LyricsFontSize"
                                    Grid.Column="1"
                                    VerticalAlignment="Stretch"
                                    LargeChange="10"
                                    Minimum="0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.AppViewModel.GlobalFontSize, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="LyricsAlignment">
                            <ComboBox
                                x:Name="LyricsAlignmentComboBox"
                                Width="300"
                                SelectedValue="{x:Bind ViewModel.AppViewModel.LyricsAlignment, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem x:Uid="Left" Tag="Left" />
                                <ComboBoxItem x:Uid="Center" Tag="Center" />
                                <ComboBoxItem x:Uid="Right" Tag="Right" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="LyricsMargin">
                            <NumberBox
                                x:Name="LyricsMarginNumberBox"
                                Width="300"
                                LargeChange="10"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.AppViewModel.LyricsMargin, Converter={StaticResource ThicknessToDoubleConverter}, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="LyricsBlurAmount">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind tool:BindUtils.FormatF1(ViewModel.AppViewModel.LyricsBlurAmount), Mode=OneWay}" />
                                <Slider
                                    Grid.Column="1"
                                    Maximum="10"
                                    Minimum="0"
                                    SnapsTo="Ticks"
                                    TickFrequency="0.1"
                                    TickPlacement="Outside"
                                    Value="{x:Bind ViewModel.AppViewModel.LyricsBlurAmount, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="PlayingLineTopOffset">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind tool:BindUtils.FormatPercent(ViewModel.AppViewModel.PlayingLineTopOffsetPercent), Mode=OneWay}" />
                                <Slider
                                    Grid.Column="1"
                                    Maximum="70"
                                    Minimum="30"
                                    SnapsTo="Ticks"
                                    TickFrequency="1"
                                    TickPlacement="Outside"
                                    Value="{x:Bind ViewModel.AppViewModel.PlayingLineTopOffsetPercent, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="UnplayedOpacity">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind tool:BindUtils.FormatPercent(ViewModel.AppViewModel.UnplayedOpacityPercent), Mode=OneWay}" />
                                <Slider
                                    Grid.Column="1"
                                    Maximum="100"
                                    Minimum="0"
                                    SnapsTo="Ticks"
                                    TickFrequency="1"
                                    TickPlacement="Outside"
                                    Value="{x:Bind ViewModel.AppViewModel.UnplayedOpacityPercent, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="TranslatedOpacity">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind tool:BindUtils.FormatPercent(ViewModel.AppViewModel.TranslatedOpacityPercent), Mode=OneWay}" />
                                <Slider
                                    Grid.Column="1"
                                    Maximum="100"
                                    Minimum="0"
                                    SnapsTo="Ticks"
                                    TickFrequency="1"
                                    TickPlacement="Outside"
                                    Value="{x:Bind ViewModel.AppViewModel.TranslatedOpacityPercent, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="CharFloatAmount" IsEnabled="{x:Bind ViewModel.AppViewModel.EnableAdvancedLyricsEffect, Mode=OneWay}">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind tool:BindUtils.FormatF1(ViewModel.AppViewModel.CharFloatAmount), Mode=OneWay}" />
                                <Slider
                                    Grid.Column="1"
                                    Maximum="10"
                                    Minimum="0"
                                    SnapsTo="Ticks"
                                    TickFrequency="0.1"
                                    TickPlacement="Outside"
                                    Value="{x:Bind ViewModel.AppViewModel.CharFloatAmount, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="CharScaleAmount" IsEnabled="{x:Bind ViewModel.AppViewModel.EnableAdvancedLyricsEffect, Mode=OneWay}">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind tool:BindUtils.FormatF0(ViewModel.AppViewModel.CharScaleAmount), Mode=OneWay}" />
                                <Slider
                                    Grid.Column="1"
                                    Maximum="150"
                                    Minimum="50"
                                    SnapsTo="Ticks"
                                    TickFrequency="1"
                                    TickPlacement="Outside"
                                    Value="{x:Bind ViewModel.AppViewModel.CharScaleAmount, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="GlowAmount" IsEnabled="{x:Bind ViewModel.AppViewModel.EnableAdvancedLyricsEffect, Mode=OneWay}">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind tool:BindUtils.FormatF1(ViewModel.AppViewModel.GlowAmount), Mode=OneWay}" />
                                <Slider
                                    Grid.Column="1"
                                    Maximum="10"
                                    Minimum="0"
                                    SnapsTo="Ticks"
                                    TickFrequency="0.1"
                                    TickPlacement="Outside"
                                    Value="{x:Bind ViewModel.AppViewModel.GlowAmount, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="LongSyllableThreshold" IsEnabled="{x:Bind ViewModel.AppViewModel.EnableAdvancedLyricsEffect, Mode=OneWay}">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind tool:BindUtils.FormatMs(ViewModel.AppViewModel.LongSyllableThreshold), Mode=OneWay}" />
                                <Slider
                                    Grid.Column="1"
                                    Maximum="1000"
                                    Minimum="400"
                                    SnapsTo="Ticks"
                                    TickFrequency="10"
                                    TickPlacement="Outside"
                                    Value="{x:Bind ViewModel.AppViewModel.LongSyllableThreshold, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="TargetFrameRate" IsEnabled="{x:Bind ViewModel.AppViewModel.EnableAdvancedLyricsEffect, Mode=OneWay}">
                            <ComboBox
                                Width="300"
                                ItemsSource="{x:Bind ViewModel.AppViewModel.TargetFrameRateOptions}"
                                SelectedItem="{x:Bind ViewModel.AppViewModel.TargetFrameRate, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:Double">
                                        <TextBlock>
                                            <Run Text="{x:Bind Mode=OneWay}" />
                                            <Run Text=" hz" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  关闭按钮功能  -->
                <controls:SettingsExpander x:Uid="CloseButtonFunction" Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Name="CloseAppRadioButton"
                                    x:Uid="CloseApp"
                                    GroupName="ClosedGroup"
                                    IsChecked="{x:Bind ViewModel.AppViewModel.IsRunningBackend, Mode=TwoWay, Converter={StaticResource BooleanNegationConverter}}"
                                    Tag="Closed" />
                                <RadioButton
                                    x:Name="RunningBackendRadioButton"
                                    x:Uid="Backgrounder"
                                    GroupName="ClosedGroup"
                                    IsChecked="{x:Bind ViewModel.AppViewModel.IsRunningBackend, Mode=TwoWay}"
                                    Tag="RunningBackend" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  音乐库文件夹监听功能  -->
                <controls:SettingsCard x:Uid="FolderWatchEnabled" Margin="10,0,10,0">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AppViewModel.IsFolderWatchEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!--  外观设置  -->
                <TextBlock
                    x:Uid="Appearance"
                    Margin="10,10,0,0"
                    FontSize="16" />

                <!--  背景设置  -->
                <controls:SettingsExpander x:Uid="AppStyle" Margin="10,10,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="IsUpdateBackDrop">
                            <ToggleSwitch IsEnabled="{x:Bind ViewModel.AppViewModel.IsFluidBackgroundEnabled, Mode=OneWay}" IsOn="{x:Bind ViewModel.AppViewModel.IsUpdateBackDrop, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Name="TransparentTintRadioButton"
                                    x:Uid="TransparentTintStyle"
                                    Command="{x:Bind ViewModel.AppViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="TransparentTint"
                                    GroupName="BackdropGroup"
                                    IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.BackdropType,'TransparentTint')}"
                                    Tag="TransparentTint" />
                                <RadioButton
                                    x:Name="MicaRadioButton"
                                    x:Uid="MicaStyle"
                                    Command="{x:Bind ViewModel.AppViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="Mica"
                                    GroupName="BackdropGroup"
                                    IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.BackdropType,'Mica')}"
                                    Tag="Mica" />
                                <RadioButton
                                    x:Name="AcrylicRadioButton"
                                    x:Uid="AcrylicStyle"
                                    Command="{x:Bind ViewModel.AppViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="Acrylic"
                                    GroupName="BackdropGroup"
                                    IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.BackdropType,'Acrylic')}"
                                    Tag="Acrylic" />
                                <RadioButton
                                    x:Name="TransparentAcrylicRadioButton"
                                    x:Uid="TransparentAcrylicStyle"
                                    Command="{x:Bind ViewModel.AppViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="TransparentAcrylic"
                                    GroupName="BackdropGroup"
                                    IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.BackdropType,'TransparentAcrylic')}"
                                    Tag="TransparentAcrylic" />
                                <RadioButton
                                    x:Name="CustomAcrylicStyleRadioButton"
                                    x:Uid="CustomAcrylicStyle"
                                    Command="{x:Bind ViewModel.AppViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="CustomAcrylicStyle"
                                    GroupName="BackdropGroup"
                                    IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.BackdropType,'CustomAcrylicStyle')}"
                                    Tag="CustomAcrylicStyle"
                                    Visibility="{x:Bind ViewModel.CheckSystemVersion()}" />
                                <StackPanel Visibility="{x:Bind ViewModel.AppViewModel.IsColorPickerVisible, Mode=OneWay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Uid="CustomOpacity"
                                            Grid.Column="0"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center" />
                                        <Slider
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Maximum="100"
                                            Minimum="0"
                                            Value="{x:Bind ViewModel.AppViewModel.CustomOpacity, Mode=TwoWay}" />
                                    </Grid>
                                    <ColorPicker
                                        ColorSpectrumShape="Ring"
                                        IsAlphaEnabled="True"
                                        IsAlphaSliderVisible="True"
                                        IsAlphaTextInputVisible="True"
                                        IsColorChannelTextInputVisible="True"
                                        IsColorSliderVisible="True"
                                        IsHexInputVisible="False"
                                        IsMoreButtonVisible="True"
                                        Color="{x:Bind ViewModel.AppViewModel.CustomColor, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  主题设置  -->
                <controls:SettingsExpander x:Uid="ThemeStyle" Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="UseImageDominantTheme">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AppViewModel.UseImageDominantTheme, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Name="DefaultRadioButton"
                                    x:Uid="SystemDefaultTheme"
                                    Command="{x:Bind ViewModel.AppViewModel.ThemeTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="Default"
                                    GroupName="ThemeGroup"
                                    IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.ThemeType,'Default')}"
                                    Tag="Default" />
                                <RadioButton
                                    x:Name="DarkRadioButton"
                                    x:Uid="Dark"
                                    Command="{x:Bind ViewModel.AppViewModel.ThemeTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="Dark"
                                    GroupName="ThemeGroup"
                                    IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.ThemeType,'Dark')}"
                                    Tag="Dark" />
                                <RadioButton
                                    x:Name="LightRadioButton"
                                    x:Uid="Light"
                                    Command="{x:Bind ViewModel.AppViewModel.ThemeTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="Light"
                                    GroupName="ThemeGroup"
                                    IsChecked="{x:Bind tool:BindUtils.RadioButtonTagToBoolConverter(ViewModel.AppViewModel.ThemeType,'Light')}"
                                    Tag="Light" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  动画设置  -->
                <!--<controls:SettingsExpander x:Uid="AnimationSettings" Margin="10,0,10,0">
