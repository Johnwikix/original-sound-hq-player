<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sub="using:WinUIMusicPlayer.View.SubView.Settings"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    x:Uid="Settings"
                    Margin="16,10,16,10"
                    VerticalAlignment="Center"
                    FontSize="28" />
                <SelectorBar
                    x:Name="SectionSelector"
                    VerticalAlignment="Center">
                    <SelectorBarItem
                        x:Uid="SettingsSectionGeneral"
                        FontSize="20"
                        Tag="General"
                        IsSelected="True" />
                    <SelectorBarItem
                        x:Uid="SettingsSectionShortcuts"
                        FontSize="20"
                        Tag="Shortcuts" />
                    <SelectorBarItem
                        x:Uid="SettingsSectionCoverBackground"
                        FontSize="20"
                        Tag="CoverBackground" />
                    <SelectorBarItem
                        x:Uid="SettingsSectionLyrics"
                        FontSize="20"
                        Tag="Lyrics" />
                    <SelectorBarItem
                        x:Uid="SettingsSectionAbout"
                        FontSize="20"
                        Tag="About" />
                </SelectorBar>
            </StackPanel>
        </Grid>

        <controls:SwitchPresenter
            Grid.Row="1"
            Value="{x:Bind SectionSelector.SelectedItem.Tag, Mode=OneWay}">
            <controls:SwitchPresenter.ContentTransitions>
                <TransitionCollection>
                    <PopupThemeTransition />
                </TransitionCollection>
            </controls:SwitchPresenter.ContentTransitions>

            <!--  功能设置（含音频、外观）  -->
            <controls:Case Value="General">
                <sub:GeneralSettingsControl />
            </controls:Case>

            <!--  快捷键设置  -->
            <controls:Case Value="Shortcuts">
                <sub:ShortcutsSettingsControl />
            </controls:Case>

            <!--  封面与着色器背景  -->
            <controls:Case Value="CoverBackground">
                <sub:CoverBackgroundSettingsControl />
            </controls:Case>

            <!--  歌词与桌面歌词  -->
            <controls:Case Value="Lyrics">
                <sub:LyricsSettingsControl />
            </controls:Case>

            <!--  关于（含音频可视化）  -->
            <controls:Case Value="About">
                <sub:AboutSettingsControl />
            </controls:Case>
        </controls:SwitchPresenter>
    </Grid>
</Page>
