<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sub="using:WinUIMusicPlayer.View.SubView.Settings"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*">

        <TextBlock
            x:Uid="Settings"
            Grid.Row="0"
            Margin="16,10,0,10"
            FontSize="28" />

        <SelectorBar
            x:Name="SectionSelector"
            Grid.Row="1"
            Margin="12,0,12,4">
            <SelectorBarItem
                x:Uid="SettingsSectionAudio"
                Tag="Audio"
                IsSelected="True" />
            <SelectorBarItem
                x:Uid="SettingsSectionGeneral"
                Tag="General" />
            <SelectorBarItem
                x:Uid="SettingsSectionShortcuts"
                Tag="Shortcuts" />
            <SelectorBarItem
                x:Uid="SettingsSectionCoverBackground"
                Tag="CoverBackground" />
            <SelectorBarItem
                x:Uid="SettingsSectionLyrics"
                Tag="Lyrics" />
            <SelectorBarItem
                x:Uid="SettingsSectionAppearance"
                Tag="Appearance" />
            <SelectorBarItem
                x:Uid="SettingsSectionAbout"
                Tag="About" />
        </SelectorBar>

        <controls:SwitchPresenter
            Grid.Row="2"
            Value="{x:Bind SectionSelector.SelectedItem.Tag, Mode=OneWay}">
            <controls:SwitchPresenter.ContentTransitions>
                <TransitionCollection>
                    <PopupThemeTransition />
                </TransitionCollection>
            </controls:SwitchPresenter.ContentTransitions>

            <!--  音频设置  -->
            <controls:Case Value="Audio">
                <sub:AudioSettingsControl />
            </controls:Case>

            <!--  功能设置  -->
            <controls:Case Value="General">
                <sub:GeneralSettingsControl />
            </controls:Case>

            <!--  快捷键设置  -->
            <controls:Case Value="Shortcuts">
                <sub:ShortcutsSettingsControl />
            </controls:Case>

            <!--  封面与着色器背景  -->
            <controls:Case Value="CoverBackground">
                <sub:CoverBackgroundSettingsControl />
            </controls:Case>

            <!--  歌词与桌面歌词  -->
            <controls:Case Value="Lyrics">
                <sub:LyricsSettingsControl />
            </controls:Case>

            <!--  外观设置  -->
            <controls:Case Value="Appearance">
                <sub:AppearanceSettingsControl />
            </controls:Case>

            <!--  关于  -->
            <controls:Case Value="About">
                <sub:AboutSettingsControl />
            </controls:Case>
        </controls:SwitchPresenter>
    </Grid>
</Page>
