                <!--  窗口大小设置  -->
                <controls:SettingsExpander x:Uid="MainWindowSizeSettings" Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="IsCustomAppSize" Description="{x:Bind tool:ToolUtils.GetString('CustomAppSizeDescription')}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AppViewModel.IsCustomAppSize, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="AppWidth">
                            <NumberBox
                                x:Name="AppWidth"
                                Width="300"
                                LargeChange="100"
                                Minimum="1280"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.AppViewModel.AppWidth, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="AppHeight">
                            <NumberBox
                                x:Name="AppHeight"
                                Width="300"
                                LargeChange="100"
                                Minimum="720"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.AppViewModel.AppHeight, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  关于  -->
                <TextBlock
                    x:Uid="SettingsAbout"
                    Margin="10,10,0,10"
                    FontSize="16" />

                <controls:SettingsExpander
                    x:Uid="AppTitleHeader"
                    Margin="10,0,10,0"
                    Description="© 2025 Sennpei Studio"
                    HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/Square44x44Logo.altform-unplated_targetsize-32.png}">
                    <TextBlock
                        x:Name="Version"
                        Margin="10"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{x:Bind ViewModel.AppViewModel.Version, Mode=OneWay}" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <HyperlinkButton
                                    x:Name="WebSite"
                                    x:Uid="OfficialWebSite"
                                    Command="{x:Bind ViewModel.AppViewModel.OpenWebSiteCommand, Mode=OneWay}" />
                                <HyperlinkButton
                                    x:Name="ThirdParty"
                                    x:Uid="ThirdPartyComponents"
                                    Click="ThirdParty_Click" />
                                <HyperlinkButton
                                    x:Name="LogPath"
                                    x:Uid="LogPath"
                                    Command="{x:Bind ViewModel.AppViewModel.OpenLogPathCommand, Mode=OneWay}" />
                                <HyperlinkButton
                                    x:Name="MainGitHub"
                                    Command="{x:Bind ViewModel.AppViewModel.OpenMainGitHubCommand, Mode=OneWay}"
                                    Content="GitHub" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>