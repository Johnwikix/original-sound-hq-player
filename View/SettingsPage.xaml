<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    xmlns:ui="using:CommunityToolkit.WinUI"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="FontComboboxTemplate" x:DataType="model:FontInfo">
            <TextBlock FontFamily="{x:Bind FontFamily}" Text="{x:Bind DisplayName}" />
        </DataTemplate>
    </Page.Resources>
    <Grid Margin="48,32,0,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="100" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid Grid.Row="0" Margin="32,0,32,0">
            <TextBlock
                x:Uid="Settings"
                Margin="10,20,0,10"
                FontSize="28" />
        </Grid>
        <ScrollView Grid.Row="1">
            <Grid Margin="32,0,32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" IsStaggeringEnabled="False" />
                    <RepositionThemeTransition IsStaggeringEnabled="True" />
                </Grid.ChildrenTransitions>
                <TextBlock
                    x:Uid="SettingAudio"
                    Grid.Row="1"
                    Margin="10,10,0,0"
                    FontSize="16" />
                <StackPanel Grid.Row="2">
                    <StackPanel.ChildrenTransitions>
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </StackPanel.ChildrenTransitions>
                    <controls:SettingsExpander x:Uid="SettingOutput" Margin="10,10,10,0">
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Uid="SettingOutputDevice">
                                <ComboBox
                                    x:Name="OutputDeviceComboBox"
                                    Width="300"
                                    DisplayMemberPath="Tag"
                                    ItemsSource="{x:Bind ViewModel.BassOutputDevices, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingBufferSize">
                                <NumberBox
                                    x:Name="LatencyNumberBox"
                                    Width="300"
                                    LargeChange="100"
                                    Maximum="900"
                                    Minimum="100"
                                    SmallChange="10"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.Latency, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="DSD2PCMFreq">
                                <ComboBox
                                    Width="300"
                                    IsEnabled="{x:Bind ViewModel.IsDopEnabled, Converter={StaticResource BooleanNegationConverter}, Mode=OneWay}"
                                    SelectedValue="{x:Bind ViewModel.DsdPcmFreq, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="44100Hz" Tag="44100" />
                                    <ComboBoxItem Content="88200Hz" Tag="88200" />
                                    <ComboBoxItem Content="176400Hz" Tag="176400" />
                                    <ComboBoxItem Content="352800Hz" Tag="352800" />
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="SettingDSDGain">
                                <NumberBox
                                    x:Name="DSDGainNumberBox"
                                    Width="300"
                                    IsEnabled="{x:Bind ViewModel.IsDopEnabled, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}"
                                    Minimum="0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.DsdGain, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="{x:Bind tool:ToolUtils.GetString('DsdDopDescription')}" Header="DSD Dop / DSD Native">
                                <ToggleSwitch IsOn="{x:Bind ViewModel.IsDopEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Uid="FadeInOut" Description="{x:Bind tool:ToolUtils.GetString('FadeInOutDescription')}">
                                <ToggleSwitch IsOn="{x:Bind ViewModel.IsFadeEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <controls:SettingsCard
                        x:Name="SpectrumVisualization"
                        x:Uid="SpectrumVisualization"
                        Grid.Row="10"
                        Margin="10,0,10,0"
                        Click="SpectrumVisualization_Click"
                        Description="© 2025 Sennpei Studio"
                        HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/SpectrumVisualization.png}"
                        IsClickEnabled="True" />
                </StackPanel>
                <!--  功能设置  -->
                <TextBlock
                    x:Uid="SettingFunction"
                    Grid.Row="3"
                    Margin="10,10,0,0"
                    FontSize="16" />
                <controls:SettingsExpander
                    x:Uid="SettingInterface"
                    Grid.Row="4"
                    Margin="10,10,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="DefaultEntryInterface">
                            <ComboBox
                                x:Name="DefaultEntryComboBox"
                                Width="300"
                                SelectedValue="{x:Bind ViewModel.DefaultEntryComboBoxTag, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem x:Uid="AddFolderCombox" Tag="AddFolder" />
                                <ComboBoxItem x:Uid="MusicBrowseCombox" Tag="MusicBrowse" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="DefaultMusicEntryInterface">
                            <ComboBox
                                x:Name="DefualtPlayListComboBox"
                                Width="300"
                                SelectedValue="{x:Bind ViewModel.DefaultPlayListComboBoxTag, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem x:Uid="SongCombox" Tag="song" />
                                <ComboBoxItem x:Uid="AlbumCombox" Tag="album" />
                                <ComboBoxItem x:Uid="ArtistCombox" Tag="artist" />
                                <ComboBoxItem x:Uid="FolderCombox" Tag="folder" />
                                <ComboBoxItem x:Uid="FavouriteCombox" Tag="favourite" />
                                <ComboBoxItem x:Uid="PlaylistCombox" Tag="playList" />
                            </ComboBox>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <!--  封面歌词设置  -->
                <controls:SettingsExpander
                    x:Uid="SettingCoverLyrics"
                    Grid.Row="5"
                    Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            x:Name="LrcAPISource"
                            x:Uid="CoverServiceLrcAPISource"
                            Click="LrcAPISource_Click"
                            Description="{x:Bind tool:ToolUtils.GetString('CoverServiceLrcAPISourceDoc')}"
                            IsClickEnabled="True">
                            <TextBox
                                x:Name="LrcAPITextBox"
                                Width="300"
                                Text="{x:Bind ViewModel.LrcAPISource, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="CoverServiceLrcAPISourceAuthCode">
                            <TextBox
                                x:Name="LrcAPIAuthTextBox"
                                Width="300"
                                Text="{x:Bind ViewModel.LrcAPIAuth, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="CoverSize" Description="{x:Bind tool:ToolUtils.GetString('CoverSizeToolTip')}">
                            <NumberBox
                                x:Name="CoverSize"
                                Width="300"
                                LargeChange="10"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.CoverSize, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="CoverDiskCache">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Width="300"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.MusicCoverCache, Mode=OneWay}"
                                    TextAlignment="Right"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="{x:Bind ViewModel.MusicCoverCache, Mode=OneWay}" VerticalOffset="10" />
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                                <Button x:Uid="ChangeMusicCoverCache" Command="{x:Bind ViewModel.ChangeCoverCacheLocationCommand, Mode=OneWay}" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="CoverCache">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsCoverCacheEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="BackgroundCover">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsBackgroundCoverEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="AutoLyricMatching">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsAutoLyricsEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="WFWLyricsEnabled" Description="{x:Bind tool:ToolUtils.GetString('WFWLyricsDescription')}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsWFWLyrics, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="GradientBlurEnabled">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsGradientBlurEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="LyricsFontFamily">
                            <ComboBox
                                x:Name="LyricsFontFamily"
                                Width="300"
                                ItemTemplate="{StaticResource FontComboboxTemplate}"
                                ItemsSource="{x:Bind ViewModel.FontFamilyList, Mode=OneWay}"
                                SelectedValue="{x:Bind ViewModel.FontFamily, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="LyricsFontSize">
                            <Grid Width="300">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    IsOn="{x:Bind ViewModel.IsGlobalFontSizeEnabled, Mode=TwoWay}" />
                                <NumberBox
                                    x:Name="LyricsFontSize"
                                    Grid.Column="1"
                                    VerticalAlignment="Stretch"
                                    LargeChange="10"
                                    Minimum="0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.GlobalFontSize, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="LyricsAlignment">
                            <ComboBox
                                x:Name="LyricsAlignmentComboBox"
                                Width="300"
                                SelectedValue="{x:Bind ViewModel.LyricsAlignment, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem x:Uid="Left" Tag="Left" />
                                <ComboBoxItem x:Uid="Center" Tag="Center" />
                                <ComboBoxItem x:Uid="Right" Tag="Right" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="LyricsMargin">
                            <NumberBox
                                x:Name="LyricsMarginNumberBox"
                                Width="300"
                                LargeChange="10"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.LyricsMargin, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <!--  关闭按钮功能  -->
                <controls:SettingsExpander
                    x:Uid="CloseButtonFunction"
                    Grid.Row="7"
                    Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Name="CloseAppRadioButton"
                                    x:Uid="CloseApp"
                                    Command="{x:Bind ViewModel.BackgroundRunningChangedCommand, Mode=OneWay}"
                                    CommandParameter="Closed"
                                    GroupName="ClosedGroup"
                                    IsChecked="{x:Bind ViewModel.IsRunningBackend, Mode=TwoWay, Converter={StaticResource BooleanNegationConverter}}"
                                    Tag="Closed" />
                                <RadioButton
                                    x:Name="RunningBackendRadioButton"
                                    x:Uid="Backgrounder"
                                    Command="{x:Bind ViewModel.BackgroundRunningChangedCommand, Mode=OneWay}"
                                    CommandParameter="RunningBackend"
                                    GroupName="ClosedGroup"
                                    IsChecked="{x:Bind ViewModel.IsRunningBackend, Mode=TwoWay}"
                                    Tag="RunningBackend" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  进程优先级功能  -->
                <!--<controls:SettingsExpander x:Uid="ProcessPriorityFunction" Grid.Row="8" Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Name="ProcessNormalRadioButton"
                                    x:Uid="ProcessPriorityNormal"
                                    Command="{x:Bind ViewModel.ProcessPriorityChangedCommand, Mode=OneWay}"
                                    CommandParameter="Normal"
                                    GroupName="ProcessPriorityGroup"
                                    IsChecked="{x:Bind ViewModel.IsProcessAboveNormal, Mode=TwoWay, Converter={StaticResource BooleanNegationConverter}}"
                                    Tag="Normal" />
                                <RadioButton
                                    x:Name="ProcessAboveNormalRadioButton"
                                    x:Uid="ProcessPriorityAboveNormal"
                                    Command="{x:Bind ViewModel.ProcessPriorityChangedCommand, Mode=OneWay}"
                                    CommandParameter="AboveNormal"
                                    GroupName="ProcessPriorityGroup"
                                    IsChecked="{x:Bind ViewModel.IsProcessAboveNormal, Mode=TwoWay}"
                                    Tag="AboveNormal" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>-->
                <!--  音乐库文件夹监听功能  -->
                <controls:SettingsCard
                    x:Uid="FolderWatchEnabled"
                    Grid.Row="9"
                    Margin="10,0,10,0">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsFolderWatchEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>
                <!--  外观设置  -->
                <TextBlock
                    x:Uid="Appearance"
                    Grid.Row="10"
                    Margin="10,10,0,0"
                    FontSize="16" />
                <!--  背景设置  -->
                <controls:SettingsExpander
                    x:Uid="AppStyle"
                    Grid.Row="11"
                    Margin="10,10,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="IsUpdateBackDrop">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsUpdateBackDrop, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Name="TransparentTintRadioButton"
                                    x:Uid="TransparentTintStyle"
                                    Command="{x:Bind ViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="TransparentTint"
                                    GroupName="BackdropGroup"
                                    IsChecked="{Binding ViewModel.BackdropType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=TransparentTint}"
                                    Tag="TransparentTint" />
                                <RadioButton
                                    x:Name="MicaRadioButton"
                                    x:Uid="MicaStyle"
                                    Command="{x:Bind ViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="Mica"
                                    GroupName="BackdropGroup"
                                    IsChecked="{Binding ViewModel.BackdropType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=Mica}"
                                    Tag="Mica" />
                                <RadioButton
                                    x:Name="AcrylicRadioButton"
                                    x:Uid="AcrylicStyle"
                                    Command="{x:Bind ViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="Acrylic"
                                    GroupName="BackdropGroup"
                                    IsChecked="{Binding ViewModel.BackdropType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=Acrylic}"
                                    Tag="Acrylic" />
                                <RadioButton
                                    x:Name="TransparentAcrylicRadioButton"
                                    x:Uid="TransparentAcrylicStyle"
                                    Command="{x:Bind ViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="TransparentAcrylic"
                                    GroupName="BackdropGroup"
                                    IsChecked="{Binding ViewModel.BackdropType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=TransparentAcrylic}"
                                    Tag="TransparentAcrylic" />
                                <RadioButton
                                    x:Name="CustomAcrylicStyleRadioButton"
                                    x:Uid="CustomAcrylicStyle"
                                    Command="{x:Bind ViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="CustomAcrylicStyle"
                                    GroupName="BackdropGroup"
                                    IsChecked="{Binding ViewModel.BackdropType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=CustomAcrylicStyle}"
                                    Tag="CustomAcrylicStyle"
                                    Visibility="{x:Bind ViewModel.CheckSystemVersion()}" />
                                <StackPanel Visibility="{x:Bind ViewModel.IsColorPickerVisible, Mode=OneWay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Uid="CustomOpacity"
                                            Grid.Column="0"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center" />
                                        <Slider
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Maximum="100"
                                            Minimum="0"
                                            Value="{x:Bind ViewModel.CustomOpacity, Mode=TwoWay}" />
                                    </Grid>
                                    <ColorPicker
                                        ColorSpectrumShape="Ring"
                                        IsAlphaEnabled="True"
                                        IsAlphaSliderVisible="True"
                                        IsAlphaTextInputVisible="True"
                                        IsColorChannelTextInputVisible="True"
                                        IsColorSliderVisible="True"
                                        IsHexInputVisible="False"
                                        IsMoreButtonVisible="True"
                                        Color="{x:Bind ViewModel.CustomColor, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <!--  主题设置  -->
                <controls:SettingsExpander
                    x:Uid="ThemeStyle"
                    Grid.Row="12"
                    Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Name="DefaultRadioButton"
                                    x:Uid="SystemDefaultTheme"
                                    Command="{x:Bind ViewModel.ThemeTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="Default"
                                    GroupName="ThemeGroup"
                                    IsChecked="{Binding ViewModel.ThemeType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=Default}"
                                    Tag="Default" />
                                <RadioButton
                                    x:Name="DarkRadioButton"
                                    x:Uid="Dark"
                                    Command="{x:Bind ViewModel.ThemeTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="Dark"
                                    GroupName="ThemeGroup"
                                    IsChecked="{Binding ViewModel.ThemeType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=Dark}"
                                    Tag="Dark" />
                                <RadioButton
                                    x:Name="LightRadioButton"
                                    x:Uid="Light"
                                    Command="{x:Bind ViewModel.ThemeTypeChangedCommand, Mode=OneWay}"
                                    CommandParameter="Light"
                                    GroupName="ThemeGroup"
                                    IsChecked="{Binding ViewModel.ThemeType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=Light}"
                                    Tag="Light" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <!--  动画设置  -->
                <controls:SettingsExpander
                    x:Uid="AnimationSettings"
                    Grid.Row="13"
                    Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="EntranceAnimationTime">
                            <NumberBox
                                x:Name="EntranceAnimationTimeNumberBox"
                                Width="300"
                                LargeChange="100"
                                Minimum="0"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.EntranceAnimationTime, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="SlideAnimationTime">
                            <NumberBox
                                x:Name="SlideAnimationTimeNumberBox"
                                Width="300"
                                LargeChange="100"
                                Minimum="0"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.SlideAnimationTime, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="DrillInAnimationTime">
                            <NumberBox
                                x:Name="DrillInAnimationTimeBox"
                                Width="300"
                                LargeChange="100"
                                Minimum="0"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.DrillInAnimationTime, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  窗口大小设置  -->
                <controls:SettingsExpander
                    x:Uid="MainWindowSizeSettings"
                    Grid.Row="14"
                    Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="IsCustomAppSize" Description="{x:Bind tool:ToolUtils.GetString('CustomAppSizeDescription')}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsCustomAppSize, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="AppWidth">
                            <NumberBox
                                x:Name="AppWidth"
                                Width="300"
                                LargeChange="100"
                                Minimum="1280"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.AppWidth, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="AppHeight">
                            <NumberBox
                                x:Name="AppHeight"
                                Width="300"
                                LargeChange="100"
                                Minimum="720"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.AppHeight, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>


                <TextBlock
                    x:Uid="SettingsAbout"
                    Grid.Row="15"
                    Margin="10,10,0,10"
                    FontSize="16" />

                <controls:SettingsExpander
                    x:Uid="AppTitleHeader"
                    Grid.Row="16"
                    Margin="10,0,10,0"
                    Description="© 2025 Sennpei Studio"
                    HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/Square44x44Logo.altform-unplated_targetsize-32.png}">
                    <TextBlock
                        x:Name="Version"
                        Grid.Column="3"
                        Margin="10"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{x:Bind ViewModel.Version, Mode=OneWay}" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <HyperlinkButton
                                    x:Name="WebSite"
                                    x:Uid="OfficialWebSite"
                                    Command="{x:Bind ViewModel.OpenWebSiteCommand, Mode=OneWay}" />
                                <HyperlinkButton
                                    x:Name="ThirdParty"
                                    x:Uid="ThirdPartyComponents"
                                    Click="ThirdParty_Click" />
                                <HyperlinkButton
                                    x:Name="LogPath"
                                    x:Uid="LogPath"
                                    Command="{x:Bind ViewModel.OpenLogPathCommand, Mode=OneWay}" />
                                <HyperlinkButton
                                    x:Name="PlayerGitHub"
                                    x:Uid="PlayerGitHub"
                                    Command="{x:Bind ViewModel.OpenPlayerGitHubCommand, Mode=OneWay}" />
                                <HyperlinkButton
                                    x:Name="MainGitHub"
                                    x:Uid="MainGitHub"
                                    Command="{x:Bind ViewModel.OpenMainGitHubCommand, Mode=OneWay}" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </Grid>
        </ScrollView>
    </Grid>
</Page>
