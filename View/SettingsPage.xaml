<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIMusicPlayer.View.SettingsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    >

    
    <Grid Margin="0 32 0 32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="32 0 32 0" Grid.Row="0">
            <TextBlock x:Uid="Settings" FontSize="28" Margin="10 20 0 20" />
        </Grid>
        <ScrollView Grid.Row="1">
            <Grid Margin="32 0 32 0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>                
                <TextBlock x:Uid="SettingAudio" FontSize="16" Grid.Row="1" Margin="10 20 0 0" />
                <Expander x:Name="AudioSettings" Margin="10 10 10 10" IsExpanded="True" x:Uid="SettingOutput" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Grid.Row="2" >
                    <Expander.Content>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingOutputMode" FontSize="14" Grid.Column="0" Grid.Row="0" Margin="10" VerticalAlignment="Center" />
                            <ComboBox x:Name="OutputModeComboBox"  Grid.Column="1" Grid.Row="0" SelectionChanged="OutputModeComboBox_SelectionChanged" Margin="10" Width="300" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <ComboBoxItem x:Uid="WasapiExclusivePush" Tag="WasapiExclusivePush"/>
                                <ComboBoxItem x:Uid="WasapiExclusiveEvent" Tag="WasapiExclusiveEvent"/>
                                <ComboBoxItem x:Uid="WasapiShared" Tag="WasapiShared"/>
                                <ComboBoxItem x:Uid="WaveOut" Tag="WaveOut"/>
                                <ComboBoxItem x:Uid="DirectSound" Tag="DirectSound"/>
                            </ComboBox>

                            <!-- 输出设备选择 -->
                            <TextBlock x:Uid="SettingOutputDevice" FontSize="14"  Grid.Column="0" Grid.Row="1" Margin="10" VerticalAlignment="Center"/>
                            <ComboBox x:Name="OutputDeviceComboBox"  Grid.Column="1" Grid.Row="1" Margin="10" SelectionChanged="OutputDeviceComboBox_SelectionChanged" Width="300" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <!-- 缓冲区大小输入 -->
                            <TextBlock x:Uid="SettingBufferSize" FontSize="14"  Grid.Column="0" Grid.Row="2" Margin="10" VerticalAlignment="Center"/>
                            <NumberBox x:Name="LatencyNumberBox"  Grid.Column="1" Grid.Row="2" Margin="10" ValueChanged="LatencyNumberBox_ValueChanged" Width="300" Value="200" Minimum="0" SpinButtonPlacementMode="Inline" SmallChange="10" LargeChange="100" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <!-- DSD增益设置 -->
                            <TextBlock x:Uid="SettingDSDGain" FontSize="14"  Grid.Column="0" Grid.Row="3" Margin="10" VerticalAlignment="Center"/>
                            <NumberBox x:Name="DSDGainNumberBox"  Grid.Column="1" Grid.Row="3" Margin="10" ValueChanged="DSDGain_ValueChanged" Width="300" Value="200" Minimum="0" SpinButtonPlacementMode="Inline" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Expander.Content>
                </Expander>
                <TextBlock x:Uid="SettingFunction" FontSize="16" Grid.Row="3" Margin="10 10 0 0" />
                <Expander x:Name="UiSettings" Margin="10 10 10 0" x:Uid="SettingInterface" Grid.Row="4" HorizontalContentAlignment="Stretch"  HorizontalAlignment="Stretch">
                    <Expander.Content>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="DefaultEntryInterface" FontSize="14"  Grid.Column="0" Grid.Row="0" Margin="10" VerticalAlignment="Center" />
                            <ComboBox x:Name="DefualtEntryComboBox"  Grid.Column="1" Grid.Row="0" SelectionChanged="DefualtEntryComboBox_SelectionChanged" Width="300" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <ComboBoxItem x:Uid="AddFolderCombox" Tag="AddFolder"/>
                                <ComboBoxItem x:Uid="MusicBrowseCombox" Tag="MusicBrowse"/>
                            </ComboBox>
                            <TextBlock x:Uid="DefaultMusicEntryInterface" FontSize="14" Grid.Column="0" Grid.Row="1" Margin="10" VerticalAlignment="Center" />
                            <ComboBox x:Name="DefualtPlayListComboBox"  Grid.Column="1" Grid.Row="1" SelectionChanged="DefualtPlayListComboBox_SelectionChanged" Width="300" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <ComboBoxItem x:Uid="SongCombox" Tag="song"/>
                                <ComboBoxItem x:Uid="AlbumCombox" Tag="album"/>
                                <ComboBoxItem x:Uid="ArtistCombox" Tag="artist"/>
                                <ComboBoxItem x:Uid="FolderCombox" Tag="folder"/>
                                <ComboBoxItem x:Uid="FavouriteCombox" Tag="favourite"/>
                                <ComboBoxItem x:Uid="PlaylistCombox" Tag="playList"/>
                            </ComboBox>
                        </Grid>
                    </Expander.Content>
                </Expander>
                <Expander x:Name="CoverSettings" Margin="10 0 10 0" x:Uid="SettingCoverLyrics" Grid.Row="5" HorizontalContentAlignment="Stretch"  HorizontalAlignment="Stretch">
                    <Expander.Content>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                                <TextBlock x:Uid="CoverServiceLrcAPISource" FontSize="14" Margin="10" VerticalAlignment="Center"/>
                                <FontIcon FontSize="14" Glyph="&#xE897;" VerticalAlignment="Center" Tapped="ToolTip_Tapped">
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="CoverServiceLrcAPISourceDoc" VerticalOffset="10"/>
                                    </ToolTipService.ToolTip>
                                </FontIcon>
                            </StackPanel>                            
                            <TextBox x:Name="LrcAPITextBox"  Grid.Column="1" Grid.Row="0" TextWrapping="Wrap" TextChanged="LrcAPITextBox_TextChanged" Width="300" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock x:Uid="CoverServiceLrcAPISourceAuthCode"  Grid.Column="0" Grid.Row="1" FontSize="14" Margin="10" VerticalAlignment="Center"/>
                            <TextBox x:Name="LrcAPIAuthTextBox"  Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" TextChanged="LrcAPIAuthTextBox_TextChanged" Width="300" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <StackPanel Grid.Column="0" Grid.Row="3" Orientation="Horizontal">
                                <TextBlock x:Uid="CoverCache"  FontSize="14" Margin="10" VerticalAlignment="Center"/>
                                <!--<FontIcon FontSize="14" Glyph="&#xE897;" VerticalAlignment="Center">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="开启后根据专辑封面数量内存占用会有一定上升" VerticalOffset="10"/>
                                    </ToolTipService.ToolTip>
                                </FontIcon>-->
                            </StackPanel>
                            <ToggleSwitch FlowDirection="RightToLeft"  Grid.Column="1" Grid.Row="3" x:Name="CoverCacheToggle" Toggled="CoverCacheToggle_Toggled"  HorizontalAlignment="Right" Margin="10"/>
                            <TextBlock x:Uid="MaximumNumberOfPreLoadedCovers"  Grid.Column="0" Grid.Row="2" FontSize="14" Margin="10" VerticalAlignment="Center"/>
                            <NumberBox x:Name="MaxCoverPreLoadNumberBox" ValueChanged="MaxCoverPreLoadNumberBox_ValueChanged" Grid.Column="1" Grid.Row="2" Value="50" Minimum="0" SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="10" Width="300" HorizontalAlignment="Right" Margin="10"/>
                            <StackPanel Grid.Column="0" Grid.Row="4" Orientation="Horizontal">
                                <TextBlock x:Uid="AutoLyricMatching"  FontSize="14" Margin="10" VerticalAlignment="Center"/>
                                <FontIcon FontSize="14" Glyph="&#xE897;" VerticalAlignment="Center">
                                    <ToolTipService.ToolTip>
                                        <ToolTip x:Uid="NeedConfigureLrcAPIService" VerticalOffset="10"/>
                                    </ToolTipService.ToolTip>
                                </FontIcon>
                            </StackPanel>
                            <ToggleSwitch FlowDirection="RightToLeft"  Grid.Column="1" Grid.Row="4" x:Name="AutoLyricsToggle" Toggled="AutoLyricsToggle_Toggled"  HorizontalAlignment="Right" Margin="10"/>
                        </Grid>
                    </Expander.Content>
                </Expander>
                <Expander x:Name="CloseSettings" Margin="10 0 10 10" x:Uid="CloseButtonFunction" Grid.Row="6" HorizontalContentAlignment="Stretch"  HorizontalAlignment="Stretch">
                    <Expander.Content>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="10">
                                <RadioButton x:Name="CloseAppRadioButton" x:Uid="CloseApp" 
                                        Checked="ClosedRadioButton_Checked" 
                                        Tag="Closed"
                                        GroupName="ClosedGroup"
                                        Margin="0,5,0,5"/>
                                <RadioButton x:Name="RunningBackendRadioButton" x:Uid="Backgrounder" 
                                        Checked="ClosedRadioButton_Checked" 
                                        Tag="RunningBackend"
                                        GroupName="ClosedGroup"
                                        Margin="0,5,0,5"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Content>
                </Expander>
                <TextBlock x:Uid="Appearance" FontSize="16" Grid.Row="7" Margin="10 10 0 0" />
                <Expander x:Name="BackdropSettings" 
                        x:Uid="AppStyle" 
                        Margin="10 10 10 0"
                        Grid.Row="8"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Stretch">
                    <Expander.Content>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="10">
                                <RadioButton x:Name="MicaRadioButton" x:Uid="MicaStyle" 
                                    Checked="BackdropRadioButton_Checked" 
                                    Tag="Mica"
                                    GroupName="BackdropGroup"
                                    Margin="0,5,0,5"/>
                                <RadioButton x:Name="AcrylicRadioButton" x:Uid="AcrylicStyle" 
                                    Checked="BackdropRadioButton_Checked" 
                                    Tag="Acrylic"
                                    GroupName="BackdropGroup"
                                    Margin="0,5,0,5"/>
                                <RadioButton x:Name="TransparentAcrylicRadioButton" x:Uid="TransparentAcrylicStyle" 
                                    Checked="BackdropRadioButton_Checked" 
                                    Tag="TransparentAcrylic"
                                    GroupName="BackdropGroup"
                                    Margin="0,5,0,5"/>                                
                            </StackPanel>
                        </Grid>
                    </Expander.Content>
                </Expander>
                <Expander x:Name="ThemeSettings" 
                        x:Uid="ThemeStyle" 
                        Margin="10 0 10 0"
                        Grid.Row="9"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Stretch">
                    <Expander.Content>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="10">
                                <RadioButton x:Name="DefaultRadioButton" x:Uid="SystemDefaultTheme" 
                                    Checked="ThemeRadioButton_Checked" 
                                    Tag="Default"
                                    GroupName="ThemeGroup"
                                    Margin="0,5,0,5"/>
                                <RadioButton x:Name="DarkRadioButton" x:Uid="Dark" 
                                    Checked="ThemeRadioButton_Checked" 
                                    Tag="Dark"
                                    GroupName="ThemeGroup"
                                    Margin="0,5,0,5"/>
                                <RadioButton x:Name="LightRadioButton" x:Uid="Light" 
                                    Checked="ThemeRadioButton_Checked" 
                                    Tag="Light"
                                    GroupName="ThemeGroup"
                                    Margin="0,5,0,5"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Content>
                </Expander>
            </Grid>
        </ScrollView>
    </Grid>    
</Page>
