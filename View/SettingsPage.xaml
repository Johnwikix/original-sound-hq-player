<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    xmlns:ui="using:CommunityToolkit.WinUI"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid Margin="48,32,0,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="100" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid Grid.Row="0" Margin="32,0,32,0">
            <TextBlock
                x:Uid="Settings"
                Margin="10,20,0,20"
                FontSize="28" />
        </Grid>
        <ScrollView Grid.Row="1">
            <Grid Margin="32,0,32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Uid="SettingAudio"
                    Grid.Row="1"
                    Margin="10,20,0,0"
                    FontSize="16" />
                <controls:SettingsExpander
                    x:Uid="SettingOutput"
                    Grid.Row="2"
                    Margin="10,10,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="SettingOutputMode">
                            <ComboBox
                                x:Name="OutputModeComboBox"
                                Width="300"
                                SelectedValue="{Binding ViewModel.OutputModeTag, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem x:Uid="WasapiExclusivePush" Tag="WasapiExclusivePush" />
                                <ComboBoxItem x:Uid="WasapiExclusiveEvent" Tag="WasapiExclusiveEvent" />
                                <ComboBoxItem x:Uid="WasapiShared" Tag="WasapiShared" />
                                <ComboBoxItem x:Uid="WaveOut" Tag="WaveOut" />
                                <ComboBoxItem x:Uid="DirectSound" Tag="DirectSound" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="SettingOutputDevice">
                            <ComboBox
                                x:Name="OutputDeviceComboBox"
                                Width="300"
                                ItemsSource="{Binding ViewModel.OutputDevices, Mode=OneWay}"
                                SelectedItem="{Binding ViewModel.DeviceName, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="SettingBufferSize">
                            <NumberBox
                                x:Name="LatencyNumberBox"
                                Width="300"
                                LargeChange="100"
                                Maximum="900"
                                Minimum="100"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ViewModel.Latency, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="SettingDSDGain">
                            <NumberBox
                                x:Name="DSDGainNumberBox"
                                Width="300"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ViewModel.DsdGain, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="SettingIsGlobalFFmpegEnabled">
                            <ToggleSwitch IsOn="{Binding ViewModel.IsGlobalFFmpegEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <!--  功能设置  -->
                <TextBlock
                    x:Uid="SettingFunction"
                    Grid.Row="3"
                    Margin="10,10,0,0"
                    FontSize="16" />
                <controls:SettingsExpander
                    x:Uid="SettingInterface"
                    Grid.Row="4"
                    Margin="10,10,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="DefaultEntryInterface">
                            <ComboBox
                                x:Name="DefaultEntryComboBox"
                                Width="300"
                                SelectedValue="{Binding ViewModel.DefaultEntryComboBoxTag, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem x:Uid="AddFolderCombox" Tag="AddFolder" />
                                <ComboBoxItem x:Uid="MusicBrowseCombox" Tag="MusicBrowse" />
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="DefaultMusicEntryInterface">
                            <ComboBox
                                x:Name="DefualtPlayListComboBox"
                                Width="300"
                                SelectedValue="{Binding ViewModel.DefaultPlayListComboBoxTag, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem x:Uid="SongCombox" Tag="song" />
                                <ComboBoxItem x:Uid="AlbumCombox" Tag="album" />
                                <ComboBoxItem x:Uid="ArtistCombox" Tag="artist" />
                                <ComboBoxItem x:Uid="FolderCombox" Tag="folder" />
                                <ComboBoxItem x:Uid="FavouriteCombox" Tag="favourite" />
                                <ComboBoxItem x:Uid="PlaylistCombox" Tag="playList" />
                            </ComboBox>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <!--  封面歌词设置  -->
                <controls:SettingsExpander
                    x:Uid="SettingCoverLyrics"
                    Grid.Row="5"
                    Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            x:Name="LrcAPISource"
                            x:Uid="CoverServiceLrcAPISource"
                            Click="LrcAPISource_Click"
                            Description="{x:Bind tool:ToolUtils.GetString('CoverServiceLrcAPISourceDoc')}"
                            IsClickEnabled="True">
                            <TextBox
                                x:Name="LrcAPITextBox"
                                Width="300"
                                Text="{Binding ViewModel.LrcAPISource, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="CoverServiceLrcAPISourceAuthCode">
                            <TextBox
                                x:Name="LrcAPIAuthTextBox"
                                Width="300"
                                Text="{Binding ViewModel.LrcAPIAuth, Mode=TwoWay}"
                                TextWrapping="Wrap" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="CoverSize" Description="{x:Bind tool:ToolUtils.GetString('CoverSizeToolTip')}">
                            <NumberBox
                                x:Name="CoverSize"
                                Width="300"
                                LargeChange="10"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ViewModel.CoverSize, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="CoverCache" Description="{x:Bind tool:ToolUtils.GetString('CoverCacheDescription')}">
                            <ToggleSwitch IsOn="{Binding ViewModel.IsCoverCacheEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="CoverLoadThreadCount" Description="{x:Bind tool:ToolUtils.GetString('CoverLoadThreadCountDescription')}">
                            <NumberBox
                                x:Name="CoverLoadThreadCountNumberBox"
                                Width="300"
                                Maximum="16"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ViewModel.CoverLoadThreadCount, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="AutoLyricMatching" Description="{x:Bind tool:ToolUtils.GetString('NeedConfigureLrcAPIService')}">
                            <ToggleSwitch IsOn="{Binding ViewModel.IsAutoLyricsEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="BackgroundCover">
                            <ToggleSwitch IsOn="{Binding ViewModel.IsBackgroundCoverEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="LyricsFontFamily">
                            <ComboBox
                                x:Name="LyricsFontFamily"
                                Width="300"
                                ItemsSource="{Binding ViewModel.FontFamilyList, Mode=OneWay}"
                                SelectedValue="{Binding ViewModel.FontFamily, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <!--  关闭按钮功能  -->
                <controls:SettingsExpander
                    x:Uid="CloseButtonFunction"
                    Grid.Row="6"
                    Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="CloseAppRadioButton"
                                x:Uid="CloseApp"
                                Command="{Binding ViewModel.BackgroundRunningChangedCommand, Mode=OneWay}"
                                CommandParameter="Closed"
                                GroupName="ClosedGroup"
                                IsChecked="{Binding ViewModel.IsRunningBackend, Mode=TwoWay, Converter={StaticResource BooleanNegationConverter}}"
                                Tag="Closed" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="RunningBackendRadioButton"
                                x:Uid="Backgrounder"
                                Command="{Binding ViewModel.BackgroundRunningChangedCommand, Mode=OneWay}"
                                CommandParameter="RunningBackend"
                                GroupName="ClosedGroup"
                                IsChecked="{Binding ViewModel.IsRunningBackend, Mode=TwoWay}"
                                Tag="RunningBackend" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <!--  音乐库文件夹监听功能  -->
                <controls:SettingsCard
                    x:Uid="FolderWatchEnabled"
                    Grid.Row="7"
                    Margin="10,0,10,0">
                    <ToggleSwitch IsOn="{Binding ViewModel.IsFolderWatchEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <!--  进程优先级功能  -->
                <controls:SettingsExpander
                    x:Uid="ProcessPriorityFunction"
                    Grid.Row="8"
                    Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="ProcessNormalRadioButton"
                                x:Uid="ProcessPriorityNormal"
                                Command="{Binding ViewModel.ProcessPriorityChangedCommand, Mode=OneWay}"
                                CommandParameter="Normal"
                                GroupName="ProcessPriorityGroup"
                                IsChecked="{Binding ViewModel.IsProcessAboveNormal, Mode=TwoWay, Converter={StaticResource BooleanNegationConverter}}"
                                Tag="Normal" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="ProcessAboveNormalRadioButton"
                                x:Uid="ProcessPriorityAboveNormal"
                                Command="{Binding ViewModel.ProcessPriorityChangedCommand, Mode=OneWay}"
                                CommandParameter="AboveNormal"
                                GroupName="ProcessPriorityGroup"
                                IsChecked="{Binding ViewModel.IsProcessAboveNormal, Mode=TwoWay}"
                                Tag="AboveNormal" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <!--  外观设置  -->
                <TextBlock
                    x:Uid="Appearance"
                    Grid.Row="9"
                    Margin="10,10,0,0"
                    FontSize="16" />
                <!--  背景设置  -->
                <controls:SettingsExpander
                    x:Uid="AppStyle"
                    Grid.Row="10"
                    Margin="10,10,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="MicaRadioButton"
                                x:Uid="MicaStyle"
                                Command="{Binding ViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="Mica"
                                GroupName="BackdropGroup"
                                IsChecked="{Binding ViewModel.BackdropType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=Mica}"
                                Tag="Mica" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="AcrylicRadioButton"
                                x:Uid="AcrylicStyle"
                                Command="{Binding ViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="Acrylic"
                                GroupName="BackdropGroup"
                                IsChecked="{Binding ViewModel.BackdropType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=Acrylic}"
                                Tag="Acrylic" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="TransparentAcrylicRadioButton"
                                x:Uid="TransparentAcrylicStyle"
                                Command="{Binding ViewModel.BackdropTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="TransparentAcrylic"
                                GroupName="BackdropGroup"
                                IsChecked="{Binding ViewModel.BackdropType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=TransparentAcrylic}"
                                Tag="TransparentAcrylic" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <!--  主题设置  -->
                <controls:SettingsExpander
                    x:Uid="ThemeStyle"
                    Grid.Row="11"
                    Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="DefaultRadioButton"
                                x:Uid="SystemDefaultTheme"
                                Command="{Binding ViewModel.ThemeTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="Default"
                                GroupName="ThemeGroup"
                                IsChecked="{Binding ViewModel.ThemeType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=Default}"
                                Tag="Default" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="DarkRadioButton"
                                x:Uid="Dark"
                                Command="{Binding ViewModel.ThemeTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="Dark"
                                GroupName="ThemeGroup"
                                IsChecked="{Binding ViewModel.ThemeType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=Dark}"
                                Tag="Dark" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButton
                                x:Name="LightRadioButton"
                                x:Uid="Light"
                                Command="{Binding ViewModel.ThemeTypeChangedCommand, Mode=OneWay}"
                                CommandParameter="Light"
                                GroupName="ThemeGroup"
                                IsChecked="{Binding ViewModel.ThemeType, Mode=TwoWay, Converter={StaticResource RadioButtonTagToBoolConverter}, ConverterParameter=Light}"
                                Tag="Light" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <!--  动画设置  -->
                <controls:SettingsExpander
                    x:Uid="AnimationSettings"
                    Grid.Row="12"
                    Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="EntranceAnimationTime">
                            <NumberBox
                                x:Name="EntranceAnimationTimeNumberBox"
                                Width="300"
                                LargeChange="100"
                                Minimum="0"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ViewModel.EntranceAnimationTime, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="SlideAnimationTime">
                            <NumberBox
                                x:Name="SlideAnimationTimeNumberBox"
                                Width="300"
                                LargeChange="100"
                                Minimum="0"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ViewModel.SlideAnimationTime, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="DrillInAnimationTime">
                            <NumberBox
                                x:Name="DrillInAnimationTimeBox"
                                Width="300"
                                LargeChange="100"
                                Minimum="0"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ViewModel.DrillInAnimationTime, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  窗口大小设置  -->
                <controls:SettingsExpander
                    x:Uid="MainWindowSizeSettings"
                    Grid.Row="13"
                    Margin="10,0,10,0">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="IsCustomAppSize" Description="{x:Bind tool:ToolUtils.GetString('CustomAppSizeDescription')}">
                            <ToggleSwitch IsOn="{Binding ViewModel.IsCustomAppSize, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="AppWidth">
                            <NumberBox
                                x:Name="AppWidth"
                                Width="300"
                                LargeChange="100"
                                Minimum="1280"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ViewModel.AppWidth, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="AppHeight">
                            <NumberBox
                                x:Name="AppHeight"
                                Width="300"
                                LargeChange="100"
                                Minimum="720"
                                SmallChange="10"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding ViewModel.AppHeight, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>


                <TextBlock
                    x:Uid="SettingsAbout"
                    Grid.Row="14"
                    Margin="10,10,0,10"
                    FontSize="16" />

                <controls:SettingsExpander
                    x:Uid="AppTitleHeader"
                    Grid.Row="15"
                    Margin="10,0,10,0"
                    Description="© 2025 Sennpei Studio"
                    HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/Square44x44Logo.altform-unplated_targetsize-32.png}">
                    <TextBlock
                        x:Name="Version"
                        Grid.Column="3"
                        Margin="10"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{Binding ViewModel.Version, Mode=OneWay}" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <HyperlinkButton
                                x:Name="ThirdParty"
                                x:Uid="ThirdPartyComponents"
                                Click="ThirdParty_Click" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <HyperlinkButton
                                x:Name="LogPath"
                                x:Uid="LogPath"
                                Command="{Binding ViewModel.OpenLogPathCommand, Mode=OneWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </Grid>
        </ScrollView>
    </Grid>
</Page>
