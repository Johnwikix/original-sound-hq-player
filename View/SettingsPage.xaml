                                Value="{x:Bind ViewModel.AppViewModel.EntranceAnimationTime, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="SlideAnimationTime">
                            <NumberBox
                                x:Name="SlideAnimationTimeNumberBox"
                                Width="300"
