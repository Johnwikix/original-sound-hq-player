<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:customControl="using:WinUIMusicPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="FontComboboxTemplate" x:DataType="model:FontInfo">
            <TextBlock FontFamily="{x:Bind FontFamily}" Text="{x:Bind DisplayName}" />
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="0" RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Margin="0">
            <TextBlock
                x:Uid="Settings"
                Margin="10,10,0,10"
                FontSize="28" />
        </Grid>

        <ScrollViewer x:Name="ContentScroller" Padding="0,0,6,0" Grid.Row="1">
            <StackPanel x:Name="ContentPanel" Margin="0">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition IsStaggeringEnabled="True" />
                </StackPanel.ChildrenTransitions>
                <!--  音频设置  -->
                <TextBlock
                    x:Uid="SettingAudio"
                    Margin="10,10,0,0"
                    FontSize="16" />
                <StackPanel>
                    <Expander
                        MinHeight="69"
                        Margin="10,10,10,0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Expander.Header>
                            <Grid Padding="16,16,4,16">
                                <TextBlock
                                    x:Uid="SettingOutput"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <StackPanel>
                                <Grid
                                    MinHeight="52"
                                    Padding="58,8,44,8"
                                    HorizontalAlignment="Stretch"
                                    BorderThickness="0,1,0,0"
                                    ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        x:Uid="SettingOutputDevice"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14" />
                                    <ComboBox
                                        x:Name="OutputDeviceComboBox"
                                        Grid.Column="1"
                                        Width="300"
                                        VerticalAlignment="Center"
                                        ItemsSource="{x:Bind ViewModel.AppViewModel.BassOutputDevices, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.AppViewModel.SelectedDevice, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="model:BassOutputDevice">
                                                <TextBlock Text="{x:Bind Tag}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid
                                    MinHeight="52"
                                    Padding="58,8,44,8"
                                    HorizontalAlignment="Stretch"
                                    BorderThickness="0,1,0,0"
                                    ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        x:Uid="SettingBufferSize"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14" />
                                    <NumberBox
                                        x:Name="LatencyNumberBox"
                                        Grid.Column="1"
                                        Width="300"
                                        VerticalAlignment="Center"
                                        LargeChange="100"
                                        Maximum="900"
                                        Minimum="100"
                                        SmallChange="10"
                                        SpinButtonPlacementMode="Inline"
                                        Value="{x:Bind ViewModel.AppViewModel.Latency, Mode=TwoWay}" />
                                </Grid>

                                <Grid
                                    MinHeight="52"
                                    Padding="58,8,44,8"
                                    HorizontalAlignment="Stretch"
                                    ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        x:Uid="DSD2PCMFreq"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14" />
                                    <ComboBox
                                        Grid.Column="1"
                                        Width="300"
                                        VerticalAlignment="Center"
                                        IsEnabled="{x:Bind ViewModel.AppViewModel.IsDopEnabled, Converter={StaticResource BooleanNegationConverter}, Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.AppViewModel.DsdPcmFreqs, Mode=OneWay}"
                                        SelectedValue="{x:Bind ViewModel.AppViewModel.DsdPcmFreq, Mode=TwoWay}" />
                                </Grid>

                                <Grid
                                    MinHeight="52"
                                    Padding="58,8,44,8"
                                    HorizontalAlignment="Stretch"
                                    ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        x:Uid="SettingDSDGain"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14" />
                                    <NumberBox
                                        x:Name="DSDGainNumberBox"
                                        Grid.Column="1"
                                        Width="300"
                                        VerticalAlignment="Center"
                                        IsEnabled="{x:Bind ViewModel.AppViewModel.IsDopEnabled, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}"
                                        Minimum="0"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Inline"
                                        Value="{x:Bind ViewModel.AppViewModel.DsdGain, Mode=TwoWay}" />
                                </Grid>

                                <Grid
                                    MinHeight="52"
                                    Padding="58,8,44,8"
                                    HorizontalAlignment="Stretch"
                                    ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" Text="DSD Dop / DSD Native" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind tool:ToolUtils.GetString('DsdDopDescription')}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        MinWidth="0"
                                        IsOn="{x:Bind ViewModel.AppViewModel.IsDopEnabled, Mode=TwoWay}" />
                                </Grid>

                                <Grid
                                    MinHeight="52"
                                    Padding="58,8,44,8"
                                    HorizontalAlignment="Stretch"
                                    ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Uid="FadeInOut" FontSize="14" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind tool:ToolUtils.GetString('FadeInOutDescription')}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        MinWidth="0"
                                        IsOn="{x:Bind ViewModel.AppViewModel.IsFadeEnabled, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Expander.Content>
                    </Expander>

                    <controls:SettingsCard
                        x:Name="SpectrumVisualization"
                        x:Uid="SpectrumVisualization"
                        Margin="10,0,10,0"
                        Click="SpectrumVisualization_Click"
                        Description="© 2026 Sennpei Studio"
                        HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/SpectrumVisualization.png}"
                        IsClickEnabled="True" />
                </StackPanel>

                <!--  功能设置  -->
                <TextBlock
                    x:Uid="SettingFunction"
                    Margin="10,10,0,0"
                    FontSize="16" />
                <Expander
                    MinHeight="69"
                    Margin="10,10,10,0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Expander.Header>
                        <Grid Padding="16,16,4,16">
                            <TextBlock
                                x:Uid="SettingInterface"
                                VerticalAlignment="Center"
                                FontSize="14" />
                        </Grid>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel>
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="DefaultEntryInterface"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="300"
                                    VerticalAlignment="Center"
                                    SelectedValue="{x:Bind ViewModel.AppViewModel.DefaultEntryComboBoxTag, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem x:Uid="AddFolderCombox" Tag="AddFolder" />
                                    <ComboBoxItem x:Uid="MusicBrowseCombox" Tag="MusicBrowse" />
                                    <ComboBoxItem x:Uid="PlayListsCombox" Tag="PlayLists" />
                                </ComboBox>
                            </Grid>

                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="DefaultMusicEntryInterface"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="300"
                                    VerticalAlignment="Center"
                                    SelectedValue="{x:Bind ViewModel.AppViewModel.DefaultPlayListComboBoxTag, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem x:Uid="SongCombox" Tag="song" />
                                    <ComboBoxItem x:Uid="AlbumCombox" Tag="album" />
                                    <ComboBoxItem x:Uid="ArtistCombox" Tag="artist" />
                                    <ComboBoxItem x:Uid="FolderCombox" Tag="folder" />
                                    <ComboBoxItem x:Uid="FavouriteCombox" Tag="favourite" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!--  高级  -->
                <Expander
                    MinHeight="69"
                    Margin="10,0,10,0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Expander.Header>
                        <Grid Padding="16,16,4,16">
                            <TextBlock
                                x:Uid="Advanced"
                                VerticalAlignment="Center"
                                FontSize="14" />
                        </Grid>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel>
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="FolderWatchEnabled"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    IsOn="{x:Bind ViewModel.AppViewModel.IsFolderWatchEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Uid="TrimOnHide" FontSize="14" />
                                    <TextBlock
                                        x:Uid="TrimOnHideDescription"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsOn="{x:Bind ViewModel.AppViewModel.IsTrimOnHideEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Uid="TrimAfterPlayback" FontSize="14" />
                                    <TextBlock
                                        x:Uid="TrimAfterPlaybackDescription"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsOn="{x:Bind ViewModel.AppViewModel.IsTrimAfterPlaybackEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="TrimNowLabel"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.AppViewModel.TrimNowCommand, Mode=OneWay}">
                                    <Button.Content>
                                        <FontIcon Glyph="&#xE895;" />
                                    </Button.Content>
                                </Button>
                            </Grid>

                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Uid="WindowBoundsDescription"
                                        FontSize="14"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Uid="WindowBoundsHint"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Uid="ResetWindowBounds"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.AppViewModel.ResetWindowBoundsCommand, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!--  快捷键设置  -->
                <Expander
                    MinHeight="69"
                    Margin="10,0,10,0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Expander.Header>
                        <Grid Padding="16,16,4,16">
                            <TextBlock
                                x:Uid="SettingsPageShortcuts"
                                VerticalAlignment="Center"
                                FontSize="14" />
                        </Grid>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel>
                            <InfoBar
                                Title="{x:Bind ViewModel.AppViewModel.GlobalHotKeyConflictTitle, Mode=OneWay}"
                                IsOpen="{x:Bind ViewModel.AppViewModel.HasGlobalHotKeyConflict, Mode=OneWay}"
                                Severity="Warning" />
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Uid="SettingsPageEnableGlobalHotKey" FontSize="14" />
                                    <TextBlock
                                        x:Uid="SettingsPageEnableGlobalHotKeyDescription"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsOn="{x:Bind ViewModel.AppViewModel.EnableGlobalHotKey, Mode=TwoWay}" />
                            </Grid>
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="SettingsPagePlayPauseShortcut"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <customControl:ShortcutTextBox Grid.Column="1" Shortcut="{x:Bind ViewModel.AppViewModel.PlayOrPauseShortcut, Mode=TwoWay}" />
                            </Grid>
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="SettingsPageNextSongShortcut"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <customControl:ShortcutTextBox Grid.Column="1" Shortcut="{x:Bind ViewModel.AppViewModel.NextSongShortcut, Mode=TwoWay}" />
                            </Grid>
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="SettingsPagePreviousSongShortcut"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <customControl:ShortcutTextBox Grid.Column="1" Shortcut="{x:Bind ViewModel.AppViewModel.PreviousSongShortcut, Mode=TwoWay}" />
                            </Grid>
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="SettingsPageVolumeUpShortcut"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <customControl:ShortcutTextBox Grid.Column="1" Shortcut="{x:Bind ViewModel.AppViewModel.VolumeUpShortcut, Mode=TwoWay}" />
                            </Grid>
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="SettingsPageVolumeDownShortcut"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <customControl:ShortcutTextBox Grid.Column="1" Shortcut="{x:Bind ViewModel.AppViewModel.VolumeDownShortcut, Mode=TwoWay}" />
                            </Grid>
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="SettingsPageTogglePlayingDetailShortcut"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <customControl:ShortcutTextBox Grid.Column="1" Shortcut="{x:Bind ViewModel.AppViewModel.TogglePlayingDetailShortcut, Mode=TwoWay}" />
                            </Grid>
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="SettingsPageBackShortcut"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <customControl:ShortcutTextBox Grid.Column="1" Shortcut="{x:Bind ViewModel.AppViewModel.BackShortcut, Mode=TwoWay}" />
                            </Grid>
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="SettingsPageShowWindowShortcut"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <customControl:ShortcutTextBox Grid.Column="1" Shortcut="{x:Bind ViewModel.AppViewModel.ShowWindowShortcut, Mode=TwoWay}" />
                            </Grid>
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="SettingsPageToggleFullScreenShortcut"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <customControl:ShortcutTextBox Grid.Column="1" Shortcut="{x:Bind ViewModel.AppViewModel.ToggleFullScreenShortcut, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!--  封面设置  -->
                <Expander
                    MinHeight="69"
                    Margin="10,0,10,0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Expander.Header>
                        <Grid Padding="16,16,4,16">
                            <TextBlock
                                x:Uid="SettingCover"
                                VerticalAlignment="Center"
                                FontSize="14" />
                        </Grid>
                    </Expander.Header>
                    <Expander.Content>
                        <StackPanel>
                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Uid="CoverSize" FontSize="14" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind tool:ToolUtils.GetString('CoverSizeToolTip')}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <NumberBox
                                    x:Name="CoverSize"
                                    Grid.Column="1"
                                    Width="300"
                                    VerticalAlignment="Center"
                                    LargeChange="10"
                                    Minimum="0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.AppViewModel.CoverSize, Mode=TwoWay}" />
                            </Grid>

                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Uid="CoverDiskCache" FontSize="14" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind tool:ToolUtils.GetString('RebootToApply')}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid
                                    Grid.Column="1"
                                    Width="300"
                                    ColumnDefinitions="*,Auto">
                                    <Button
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{x:Bind ViewModel.AppViewModel.OpenCoverCacheLocationCommand, Mode=OneWay}">
                                        <Button.Content>
                                            <dev:AutoScrollView
                                                x:Name="AutoScrollViewControl"
                                                Margin="0,0,10,0"
                                                IsPlaying="False"
                                                PointerCanceled="AutoScrollHover_PointerCanceled"
                                                PointerEntered="AutoScrollHover_PointerEntered"
                                                PointerExited="AutoScrollHover_PointerExited">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind ViewModel.AppViewModel.MusicCoverCache, Mode=OneWay}"
                                                    TextAlignment="Right"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </dev:AutoScrollView>
                                        </Button.Content>
                                    </Button>
                                    <Button
                                        x:Uid="ChangeMusicCoverCache"
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.AppViewModel.ChangeCoverCacheLocationCommand, Mode=OneWay}" />
                                </Grid>
                            </Grid>

                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <TextBlock
                                    x:Uid="AutoCoverMatching"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsOn="{x:Bind ViewModel.AppViewModel.IsAutoCoverEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Uid="Win2dCover" FontSize="14" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind tool:ToolUtils.GetString('RebootToApply')}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    IsOn="{x:Bind ViewModel.AppViewModel.IsWin2dCoverImageControlEnable, Mode=TwoWay}" />
                            </Grid>

                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
                                HorizontalAlignment="Stretch"
                                ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Uid="Win2dAnimatedTitle" FontSize="14" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind tool:ToolUtils.GetString('RebootToApply')}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid
                                    Grid.Column="1"
                                    Width="300"
                                    ColumnDefinitions="Auto,*">
                                    <ToggleSwitch
                                        Grid.Column="0"
                                        MinWidth="0"
                                        Margin="0,0,10,0"
                                        IsOn="{x:Bind ViewModel.AppViewModel.IsWin2dAnimatedText, Mode=TwoWay}" />
                                    <ComboBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        IsEnabled="{x:Bind ViewModel.AppViewModel.IsWin2dAnimatedText, Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.AppViewModel.TextEffectItems}"
                                        SelectedItem="{x:Bind ViewModel.AppViewModel.Win2dTextEffectType, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="model:EffectComboBoxItem">
                                                <TextBlock Text="{x:Bind DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Grid>

                            <Grid
                                MinHeight="52"
                                Padding="58,8,44,8"
