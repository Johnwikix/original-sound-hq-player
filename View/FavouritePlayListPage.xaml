<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.FavouritePlayListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:WinUIMusicPlayer.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="ListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="ContextFlyout">
                <Setter.Value>
                    <MenuFlyout extensions:MenuFlyoutExtensions.PrepareCommand="{x:Bind ViewModel.PrepareMenuCommand}" extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.MenuOptions, Mode=OneWay}" />
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <ListView
            x:Name="MusicListView"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
            DoubleTapped="MusicListView_DoubleTapped"
            ItemContainerStyle="{StaticResource ListViewItemStyle}"
            ItemsSource="{x:Bind ViewModel.AppViewModel.FavoriteSongs, Mode=TwoWay}"
            RightTapped="MusicListView_RightTapped"
            SelectedItem="{x:Bind ViewModel.SelectedMusic, Mode=TwoWay}"
            SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Music">
                    <controls:MusicListRowControl Music="{x:Bind Mode=OneWay}" ArtistInvoked="MusicRow_ArtistInvoked" AlbumInvoked="MusicRow_AlbumInvoked" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  空状态：库非空但没有任何收藏（搜索过滤导致的空列表不显示）  -->
        <Grid
            x:Name="FavoriteEmptyGrid"
            Visibility="{x:Bind ViewModel.AppViewModel.FavoriteEmptyVisibility, Mode=OneWay}">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Border
                    Width="96"
                    Height="96"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="28">
                    <FontIcon
                        FontSize="44"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xEB51;" />
                </Border>
                <TextBlock
                    x:Uid="FavouritePlayListPageEmptyTitle"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="FavouritePlayListPageEmptySubtitle"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
