<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.FavouritePlayListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:extensions="using:WinUIMusicPlayer.Extensions"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="ListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="ContextFlyout">
                <Setter.Value>
                    <MenuFlyout extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.MenuOptions, Mode=OneWay}" />
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <ListView
        x:Name="MusicListView"
        AllowDrop="True"
        CanDragItems="True"
        CanReorderItems="True"
        ContainerContentChanging="MusicListView_ContainerContentChanging"
        DoubleTapped="MusicListView_DoubleTapped"
        ItemContainerStyle="{StaticResource ListViewItemStyle}"
        ItemsSource="{x:Bind ViewModel.AppViewModel.FavoriteSongs, Mode=TwoWay}"
        RightTapped="MusicListView_RightTapped"
        SelectedItem="{x:Bind ViewModel.SelectedMusic, Mode=TwoWay}"
        SelectionMode="Extended"
        VirtualizingStackPanel.VirtualizationMode="Recycling">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="model:Music">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.25*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="CoverThumbnail"
                        Grid.Column="0"
                        Margin="0,5,10,5"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind PlayCommand, Mode=OneWay}"
                        CommandParameter="FavoriteSongsView"
                        CornerRadius="5"
                        Style="{StaticResource PlayHoverButtonStyle}">
                        <Grid Width="40" Height="40">
                            <Image
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Canvas.ZIndex="1"
                                Stretch="UniformToFill">
                                <interactivity:Interaction.Behaviors>
                                    <behaviors:AlbumCoverBehavior Music="{x:Bind Mode=OneWay}" />
                                </interactivity:Interaction.Behaviors>
                            </Image>
                            <Grid
                                Width="40"
                                Height="40"
                                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                Canvas.ZIndex="0">
                                <FontIcon
                                    Canvas.ZIndex="0"
                                    FontSize="15"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE93C;" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button
                        x:Name="isFavouriteIconButton"
                        Grid.Column="1"
                        Margin="0,5,5,5"
                        Padding="3"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind UpdateFavouriteCommand, Mode=OneWay}">
                        <FontIcon
                            x:Name="IsFavouriteIcon"
                            Foreground="Red"
                            Glyph="{x:Bind IsFavorite, Converter={StaticResource FavouriteIconConverter}}" />
                    </Button>
                    <TextBlock
                        Grid.Column="2"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="3"
                        Margin="5"
                        Padding="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0">
                        <Button.Content>
                            <dev:AutoScrollView
                                Margin="0"
                                IsPlaying="False"
                                PointerCanceled="AutoScrollHover_PointerCanceled"
                                PointerEntered="AutoScrollHover_PointerEntered"
                                PointerExited="AutoScrollHover_PointerExited">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Tapped="AuthorTextBlock_Tapped"
                                    Text="{x:Bind Author, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </dev:AutoScrollView>
                        </Button.Content>
                    </Button>
                    <Button
                        Grid.Column="4"
                        Margin="5"
                        Padding="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0">
                        <Button.Content>
                            <dev:AutoScrollView
                                Margin="0"
                                IsPlaying="False"
                                PointerCanceled="AutoScrollHover_PointerCanceled"
                                PointerEntered="AutoScrollHover_PointerEntered"
                                PointerExited="AutoScrollHover_PointerExited">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Tapped="AlbumTextBlock_Tapped"
                                    Text="{x:Bind Album, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </dev:AutoScrollView>
                        </Button.Content>
                    </Button>
                    <Image
                        Grid.Column="5"
                        Height="14"
                        Margin="5"
                        VerticalAlignment="Center"
                        Source="{x:Bind Converter={StaticResource MusicStatusToHRimgConverter}, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="6"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="{x:Bind Duration, Converter={StaticResource TimeSpanToStringConverter}}" />
                    <Button
                        Grid.Column="7"
                        Margin="5"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind AddMusicToCurrentPlayListCommand, Mode=OneWay}">
                        <FontIcon
                            Margin="0,2,0,0"
                            VerticalAlignment="Center"
                            Glyph="&#xE710;" />
                    </Button>
                    <FontIcon
                        x:Name="IsExistOnDeviceIcon"
                        Grid.Column="8"
                        FontSize="14"
                        Glyph="{x:Bind IsExistOnDevice, Mode=OneWay, Converter={StaticResource IsExistOnDeviceConverter}}" />
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</Page>
