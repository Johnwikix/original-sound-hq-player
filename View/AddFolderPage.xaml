<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.AddFolderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:sub="using:WinUIMusicPlayer.View.SubView"
    xmlns:tools="using:WinUIMusicPlayer.Utils">
    <Grid
        AllowDrop="True"
        Background="Transparent"
        DragLeave="Grid_DragLeave"
        DragOver="Grid_DragOver"
        Drop="Grid_Drop"
        Unloaded="DropTarget_Unloaded">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,24" Spacing="24">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="MusicSources" FontSize="28" />
                        <TextBlock
                            x:Uid="MusicSourcesSubtitle"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <DropDownButton
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('MusicSourcesAdd')}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="{x:Bind tools:ToolUtils.GetString('MusicSourcesAdd')}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.AddFolderCommand}" Text="{x:Bind tools:ToolUtils.GetString('MusicSourcesLocal')}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="AddWebDav_Click" Text="WebDAV">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE753;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{x:Bind tools:ToolUtils.GetString('MusicSourcesLocal')}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.FolderList.Count, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                        <ProgressRing
                            Width="24"
                            Height="24"
                            IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                        <TextBlock x:Uid="ProcessingDataHint" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                        <TextBlock
                            x:Uid="MusicSourcesLocalEmpty"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </Border>
                    <ListView
                        x:Name="FolderListView"
                        IsTabStop="False"
                        ItemsSource="{x:Bind ViewModel.FolderList, Mode=OneWay}"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:Folder">
                                <Border
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid
                                        MinHeight="56"
                                        ColumnDefinitions="40,*,Auto"
                                        ColumnSpacing="12">
                                        <Button
                                            x:Name="OpenFolderButton"
                                            Width="40"
                                            Height="40"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind OpenFolderCommand}"
                                            CommandParameter="{x:Bind}"
                                            CornerRadius="10"
                                            Style="{StaticResource MenuButtonStyle}"
                                            Visibility="{x:Bind CanOpenInExplorer, Mode=OneWay}">
                                            <FontIcon
                                                FontSize="18"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Glyph="&#xE8B7;" />
                                            <ToolTipService.ToolTip>
                                                <ToolTip x:Uid="OpenFolderToolTip" />
                                            </ToolTipService.ToolTip>
                                        </Button>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Path}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                            <StackPanel
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Opacity="0.7"
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind SongCount, Mode=OneWay}" />
                                                <TextBlock
                                                    x:Uid="FolderNumberOfSongs"
                                                    Margin="3,0,0,0"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button
                                                x:Name="RescanFolderButton"
                                                Width="34"
                                                Height="34"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Command="{x:Bind RescanFolderCommand}"
                                                CommandParameter="{x:Bind}"
                                                Style="{StaticResource MenuButtonStyle}">
                                                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                                                <ToolTipService.ToolTip>
                                                    <ToolTip x:Uid="RescanFolderToolTip" />
                                                </ToolTipService.ToolTip>
                                            </Button>
                                            <Button
                                                x:Name="RemoveFolderButton"
                                                Width="34"
                                                Height="34"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Command="{x:Bind RemoveFolderCommand}"
                                                CommandParameter="{x:Bind}"
                                                Style="{StaticResource MenuButtonStyle}">
                                                <FontIcon FontSize="16" Glyph="&#xECC9;" />
                                                <ToolTipService.ToolTip>
                                                    <ToolTip x:Uid="RemoveFolderToolTip" />
                                                </ToolTipService.ToolTip>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <sub:WebDavSourcesControl x:Name="RemoteSources" />
                <TextBlock
                    x:Uid="AddFolderPageDragHint"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        <Grid
            x:Name="DropOverlay"
            Margin="12"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                CornerRadius="12"
                Opacity="0.35" />
            <Rectangle
                Margin="2"
                RadiusX="10"
                RadiusY="10"
                Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                StrokeDashArray="4,4"
                StrokeThickness="2" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon
                    FontSize="16"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE8B7;" />
                <TextBlock
                    x:Uid="AddFolderPageDropOverlayText"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
