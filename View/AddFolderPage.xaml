<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.AddFolderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid Margin="48,0,0,0">
        <!--  Loading 界面  -->
        <Grid x:Name="LoadingGrid" Visibility="Collapsed">
            <ProgressRing
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />
            <TextBlock
                Margin="0,180,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="正在处理数据，请稍候..." />
        </Grid>
        <Grid
            x:Name="AddFolderGrid"
            Margin="0,38,0,0"
            AllowDrop="True"
            DragOver="Grid_DragOver"
            Drop="Grid_Drop">
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="100" />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button
                x:Name="AddFolder"
                Margin="25,10,10,10"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="AddFolderButton_Click">
                <FontIcon Glyph="&#xe8f4;" />
            </Button>
            <ListView
                x:Name="FolderListView"
                Grid.Row="1"
                ItemsSource="{Binding ViewModel.FolderList, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:Folder">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="OpenFolderButton"
                                Grid.Column="0"
                                Margin="10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="OpenFolderButton_Click"
                                Tag="{x:Bind Path}">
                                <FontIcon Glyph="&#xe838;" />
                            </Button>
                            <Button
                                x:Name="RescanFolderButton"
                                Grid.Column="1"
                                Margin="10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="RescanFolderButton_Click"
                                Tag="{x:Bind Id}">
                                <FontIcon Glyph="&#xe72c;" />
                            </Button>
                            <StackPanel
                                Grid.Column="2"
                                Margin="10,5,10,5"
                                Orientation="Vertical">
                                <!--<TextBlock FontSize="16" Text="{x:Bind Name}" />-->
                                <TextBlock FontSize="16" Text="{x:Bind Path}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="12" Text="{x:Bind SongCount}" />
                                    <TextBlock
                                        x:Uid="FolderNumberOfSongs"
                                        Margin="3,0,0,0"
                                        FontSize="12" />
                                </StackPanel>

                            </StackPanel>
                            <Button
                                x:Name="RemoveFolderButton"
                                Grid.Column="3"
                                Margin="10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="RemoveFolderButton_Click"
                                Tag="{x:Bind Id}">
                                <FontIcon Glyph="&#xecc9;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
