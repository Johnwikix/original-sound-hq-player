<UserControl
    x:Class="WinUIMusicPlayer.View.Controls.HomeMusicDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns:extensions="using:WinUIMusicPlayer.Extensions">
    <UserControl.Resources>
        <Style x:Key="PropertyCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <DataTemplate x:Key="WrappedActionText"><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" /></DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="DetailRoot" RowDefinitions="Auto,*" Background="Transparent">
        <Grid Margin="24,12,24,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ContentControl x:Name="HeaderFocus" IsTabStop="True" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('MusicDetailTitle')}">
                <TextBlock x:Uid="MusicDetailTitleBar" FontSize="22" FontWeight="SemiBold" />
            </ContentControl>
            <ProgressRing x:Name="ActivityIndicator" Grid.Column="1" Width="24" Height="24" IsActive="{x:Bind Editor.IsBusy, Mode=OneWay}" />
        </Grid>
        <ScrollViewer x:Name="DetailScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,12,24,32" Spacing="24">
                <Grid x:Name="HeroLayout" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="28" RowSpacing="20">
                    <Border x:Name="CoverHost" Width="256" Height="256" CornerRadius="8" HorizontalAlignment="Left">
                        <Grid>
                            <controls:MusicCoverControl x:Name="Artwork" DecodePixelSize="600" />
                            <Image x:Name="CoverPreviewImage" Source="{x:Bind Editor.CoverPreview, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel x:Name="HeroText" Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Song.Music.Title, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind Text(Song.Music.Author), Mode=OneWay}" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind Text(Song.Music.Album), Mode=OneWay}" FontSize="16" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind Song.Reason, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6" Margin="0,8,0,0">
                            <Button x:Name="PlayButton" x:Uid="HomePlaySong" Style="{StaticResource HomeSongActionButtonStyle}"
                                Command="{x:Bind Song.PlayCommand, Mode=OneWay}" CommandParameter="{x:Bind Song, Mode=OneWay}">
                                <FontIcon Glyph="&#xE768;" FontSize="16" />
                            </Button>
                            <Button x:Name="FavoriteButton" x:Uid="HomeFavorite" Style="{StaticResource HomeSongActionButtonStyle}"
                                Command="{x:Bind Song.Music.UpdateFavouriteCommand, Mode=OneWay}" CommandParameter="{x:Bind Song.Music, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind tools:BindUtils.FavouriteGlyphConverter(Song.Music.IsFavorite), Mode=OneWay}" Foreground="Red" FontSize="16" />
                            </Button>
                            <Button x:Name="QueueButton" x:Uid="HomeAddToQueue" Style="{StaticResource HomeSongActionButtonStyle}"
                                Command="{x:Bind Song.Music.AddMusicToCurrentPlayListCommand, Mode=OneWay}" CommandParameter="{x:Bind Song.Music, Mode=OneWay}">
                                <FontIcon Glyph="&#xE710;" FontSize="16" />
                            </Button>
                            <Button x:Name="PlaylistButton" Style="{StaticResource HomeSongActionButtonStyle}"
                                AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('FlyoutAddToPlaylist')}"
                                ToolTipService.ToolTip="{x:Bind tools:ToolUtils.GetString('FlyoutAddToPlaylist')}">
                                <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="PlaylistMenu"
                                        extensions:MenuFlyoutExtensions.PrepareCommand="{x:Bind ViewModel.PreparePlaylistMenuCommand, Mode=OneWay}"
                                        extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.PlaylistMenuItems, Mode=OneWay}" />
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <Button x:Uid="HomeDetailsFindCover" Style="{StaticResource HomeSongActionButtonStyle}" Command="{x:Bind Editor.FindCoverCommand, Mode=OneWay}"><FontIcon FontSize="16" Glyph="&#xEBD3;" /></Button>
                            <Button x:Uid="HomeDetailsExportCover" Style="{StaticResource HomeSongActionButtonStyle}" Command="{x:Bind Editor.ExportCoverCommand, Mode=OneWay}"><FontIcon FontSize="16" Glyph="&#xE78C;" /></Button>
                            <Button x:Uid="HomeDetailsChooseCover" Style="{StaticResource HomeSongActionButtonStyle}" Command="{x:Bind Editor.ChooseCoverCommand, Mode=OneWay}"><FontIcon FontSize="16" Glyph="&#xE70F;" /></Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="HomeSongTags" FontSize="18" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="18">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock x:Uid="TitleTextBlock" Style="{StaticResource PropertyCaption}" />
                                <TextBox x:Name="TitleInput" IsEnabled="{x:Bind tools:BindUtils.BoolToBoolReConverter(Editor.IsLoading), Mode=OneWay}"
                                    IsReadOnly="{x:Bind Song.Music.IsRemote, Mode=OneWay}" Text="{x:Bind Editor.Metadata.Draft.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="AuthorTextBlock" Style="{StaticResource PropertyCaption}" />
                                <TextBox x:Name="AuthorInput" IsEnabled="{x:Bind tools:BindUtils.BoolToBoolReConverter(Editor.IsLoading), Mode=OneWay}"
                                    IsReadOnly="{x:Bind Song.Music.IsRemote, Mode=OneWay}" Text="{x:Bind Editor.Metadata.Draft.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                <TextBlock x:Uid="AlbumTextBlock" Style="{StaticResource PropertyCaption}" />
                                <TextBox x:Name="AlbumInput" IsEnabled="{x:Bind tools:BindUtils.BoolToBoolReConverter(Editor.IsLoading), Mode=OneWay}"
                                    IsReadOnly="{x:Bind Song.Music.IsRemote, Mode=OneWay}" Text="{x:Bind Editor.Metadata.Draft.Album, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="MusicTagAlbumArtist" Style="{StaticResource PropertyCaption}" />
                                <TextBox x:Name="AlbumArtistInput" IsEnabled="{x:Bind tools:BindUtils.BoolToBoolReConverter(Editor.IsLoading), Mode=OneWay}"
                                    IsReadOnly="{x:Bind Song.Music.IsRemote, Mode=OneWay}" Text="{x:Bind Editor.Metadata.Draft.AlbumArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                                <TextBlock x:Uid="MusicTagGenre" Style="{StaticResource PropertyCaption}" />
                                <TextBox x:Name="GenreInput" IsEnabled="{x:Bind tools:BindUtils.BoolToBoolReConverter(Editor.IsLoading), Mode=OneWay}"
                                    IsReadOnly="{x:Bind Song.Music.IsRemote, Mode=OneWay}" Text="{x:Bind Editor.Metadata.Draft.Genre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="MusicTagComposer" Style="{StaticResource PropertyCaption}" />
                                <TextBox x:Name="ComposerInput" IsEnabled="{x:Bind tools:BindUtils.BoolToBoolReConverter(Editor.IsLoading), Mode=OneWay}"
                                    IsReadOnly="{x:Bind Song.Music.IsRemote, Mode=OneWay}" Text="{x:Bind Editor.Metadata.Draft.Composer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0" Spacing="6">
                                <TextBlock x:Uid="MusicTagLyricist" Style="{StaticResource PropertyCaption}" />
                                <TextBox x:Name="LyricistInput" IsEnabled="{x:Bind tools:BindUtils.BoolToBoolReConverter(Editor.IsLoading), Mode=OneWay}"
                                    IsReadOnly="{x:Bind Song.Music.IsRemote, Mode=OneWay}" Text="{x:Bind Editor.Metadata.Draft.Lyricist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="MusicTagConductor" Style="{StaticResource PropertyCaption}" />
                                <TextBox x:Name="ConductorInput" IsEnabled="{x:Bind tools:BindUtils.BoolToBoolReConverter(Editor.IsLoading), Mode=OneWay}"
                                    IsReadOnly="{x:Bind Song.Music.IsRemote, Mode=OneWay}" Text="{x:Bind Editor.Metadata.Draft.Conductor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="0" Spacing="6">
                                <TextBlock x:Uid="MusicTagCatalogNumber" Style="{StaticResource PropertyCaption}" />
                                <TextBox x:Name="CatalogNumberInput" IsEnabled="{x:Bind tools:BindUtils.BoolToBoolReConverter(Editor.IsLoading), Mode=OneWay}"
                                    IsReadOnly="{x:Bind Song.Music.IsRemote, Mode=OneWay}" Text="{x:Bind Editor.Metadata.Draft.CatalogNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="YearTextBlock" Style="{StaticResource PropertyCaption}" />
                                <NumberBox x:Name="YearInput" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Compact"
                                    IsEnabled="{x:Bind Editor.CanEditTags, Mode=OneWay}" Value="{x:Bind Editor.Metadata.Draft.Year, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.Column="0" Spacing="6">
                                <TextBlock x:Uid="DiskNumberBox" Style="{StaticResource PropertyCaption}" />
                                <NumberBox x:Name="DiskInput" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Compact"
                                    IsEnabled="{x:Bind Editor.CanEditTags, Mode=OneWay}" Value="{x:Bind Editor.Metadata.Draft.DiskNumber, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="TrackNumberBox" Style="{StaticResource PropertyCaption}" />
                                <NumberBox x:Name="TrackInput" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Compact"
                                    IsEnabled="{x:Bind Editor.CanEditTags, Mode=OneWay}" Value="{x:Bind Editor.Metadata.Draft.TrackNumber, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="HomeSongAudio" FontSize="18" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="18">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="DurationTextBlock" Style="{StaticResource PropertyCaption}" />
                                <TextBlock Text="{x:Bind Duration(Song.Music.Duration), Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="BitDepthTextBlock" Style="{StaticResource PropertyCaption}" />
                                <TextBlock Text="{x:Bind BitDepth(Song.Music.BitDepth), Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="BitRateTextBlock" Style="{StaticResource PropertyCaption}" />
                                <TextBlock Text="{x:Bind BitRate(Song.Music.BitRate), Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="SampleRateTextBlock" Style="{StaticResource PropertyCaption}" />
                                <TextBlock Text="{x:Bind SampleRate(Song.Music.SampleRate), Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="HomeSongChannels" Style="{StaticResource PropertyCaption}" />
                                <TextBlock Text="{x:Bind Number(Song.Music.Channel), Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="HomeSongFormat" Style="{StaticResource PropertyCaption}" />
                                <TextBlock Text="{x:Bind Text(Song.Music.Extension), Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="HomeDetailsFiles" FontSize="18" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="18">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock x:Uid="LastFolderNameTextBlock" Style="{StaticResource PropertyCaption}" />
                                <TextBox IsReadOnly="True" Text="{x:Bind Text(Song.Music.LastLevelFolderPath), Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="PathTextBlock" Style="{StaticResource PropertyCaption}" />
                                <TextBox IsReadOnly="True" Text="{x:Bind Text(Song.Music.Path), Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                <TextBlock x:Uid="CreateTime" Style="{StaticResource PropertyCaption}" />
                                <TextBox IsReadOnly="True" Text="{x:Bind Time(Song.Music.CreateTime), Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="UpdateTime" Style="{StaticResource PropertyCaption}" />
                                <TextBox IsReadOnly="True" Text="{x:Bind Time(Song.Music.UpdateTime), Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="Lyrics" FontSize="18" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="LyricsTimeOffsetTag" Style="{StaticResource PropertyCaption}" />
                                <NumberBox x:Name="OffsetInput" Width="160" HorizontalAlignment="Left" Minimum="-10000" Maximum="10000" SmallChange="100" LargeChange="1000" SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind Song.Music.LyricsOffsetMs, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Uid="HomeDetailsOpenLocation" Style="{StaticResource HomeSongActionButtonStyle}" Command="{x:Bind Editor.OpenLocationCommand, Mode=OneWay}"><FontIcon FontSize="16" Glyph="&#xE838;" /></Button>
                            <Button x:Uid="HomeDetailsReadEmbedded" Style="{StaticResource HomeSongActionButtonStyle}" Command="{x:Bind Editor.ReadEmbeddedCommand, Mode=OneWay}"><FontIcon FontSize="16" Glyph="&#xE72C;" /></Button>
                            <Button x:Uid="HomeDetailsExportLyrics" Style="{StaticResource HomeSongActionButtonStyle}" Command="{x:Bind Editor.Lyrics.ExportCommand, Mode=OneWay}"><FontIcon FontSize="16" Glyph="&#xE74E;" /></Button>
                            <Button x:Uid="HomeDetailsRefreshLyrics" Style="{StaticResource HomeSongActionButtonStyle}" Command="{x:Bind Editor.Lyrics.RefreshCommand, Mode=OneWay}">
                                <Grid><FontIcon FontSize="16" Glyph="&#xF385;" /><FontIcon FontSize="16" Glyph="&#xF386;" /></Grid>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Editor.Lyrics.Status, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind TextVisibility(Editor.Lyrics.Status), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Editor.Lyrics.Error, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="{x:Bind TextVisibility(Editor.Lyrics.Error), Mode=OneWay}" />
                        <Pivot x:Name="LyricsTabs" Height="360" Padding="0">
                            <PivotItem>
                                <PivotItem.Header><TextBlock x:Uid="LyricsOriginalTab" FontSize="14" /></PivotItem.Header>
                                <TextBox x:Name="OriginalLyricsInput" AcceptsReturn="True" MinHeight="220" IsReadOnly="{x:Bind Editor.IsLoading, Mode=OneWay}"
                                    TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Text="{x:Bind Editor.Lyrics.OriginalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </PivotItem>
                            <PivotItem>
                                <PivotItem.Header><TextBlock x:Uid="LyricsTranslationTab" FontSize="14" /></PivotItem.Header>
                                <TextBox x:Name="TranslationLyricsInput" AcceptsReturn="True" MinHeight="220" IsReadOnly="{x:Bind Editor.IsLoading, Mode=OneWay}"
                                    TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Text="{x:Bind Editor.Lyrics.TranslationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </PivotItem>
                            <PivotItem>
                                <PivotItem.Header><TextBlock x:Uid="LyricsPronunciationTab" FontSize="14" /></PivotItem.Header>
                                <TextBox x:Name="PronunciationLyricsInput" AcceptsReturn="True" MinHeight="220" IsReadOnly="{x:Bind Editor.IsLoading, Mode=OneWay}"
                                    TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Text="{x:Bind Editor.Lyrics.PronunciationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </PivotItem>
                        </Pivot>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(Editor.Lyrics.HasLegacy), Mode=OneWay}">
                            <Button x:Uid="LyricsRestoreLegacyLrc" Style="{StaticResource HomeSongActionButtonStyle}" ContentTemplate="{StaticResource WrappedActionText}"
                                Command="{x:Bind Editor.Lyrics.RestoreLegacyCommand, Mode=OneWay}" CommandParameter="Lrc" />
                            <Button x:Uid="LyricsRestoreLegacyKrc" Grid.Column="1" Style="{StaticResource HomeSongActionButtonStyle}" ContentTemplate="{StaticResource WrappedActionText}"
                                Command="{x:Bind Editor.Lyrics.RestoreLegacyCommand, Mode=OneWay}" CommandParameter="Krc" />
                        </Grid>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" MaxWidth="700" HorizontalAlignment="Left">
                        <Button x:Name="SaveFileButton" x:Uid="SaveButton" Style="{StaticResource HomeSongActionButtonStyle}" ContentTemplate="{StaticResource WrappedActionText}" IsEnabled="{x:Bind Editor.CanSaveFile, Mode=OneWay}">
                            <Button.Flyout><Flyout x:Name="ConfirmFlyout">
                                <StackPanel Spacing="12" MaxWidth="360">
                                    <TextBlock x:Uid="SaveConfirm" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Uid="ConfirmButton" Style="{StaticResource HomeSongActionButtonStyle}" Click="Confirm_Click" Command="{x:Bind Editor.SaveFileCommand, Mode=OneWay}" />
                                        <Button x:Uid="CancelButton" Style="{StaticResource HomeSongActionButtonStyle}" Click="Cancel_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout></Button.Flyout>
                        </Button>
                        <Button x:Name="SaveDatabaseButton" x:Uid="SaveToDataBase" Grid.Column="1" Style="{StaticResource HomeSongActionButtonStyle}" ContentTemplate="{StaticResource WrappedActionText}"
                            Command="{x:Bind Editor.SaveDatabaseCommand, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="24,8,24,0" Spacing="8">
            <InfoBar x:Name="ErrorInfo" IsOpen="{x:Bind HasText(ViewModel.ErrorMessage), Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Warning" IsClosable="False" />
            <InfoBar x:Name="EditorErrorInfo" IsOpen="{x:Bind HasText(Editor.Error), Mode=OneWay}" Message="{x:Bind Editor.Error, Mode=OneWay}" Severity="Error" IsClosable="False">
                <InfoBar.ActionButton><Button x:Uid="HomeRetry" Style="{StaticResource HomeSongActionButtonStyle}"
                    Command="{x:Bind Editor.LoadCommand, Mode=OneWay}" Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(Editor.LoadFailed), Mode=OneWay}" /></InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
    </Grid>
</UserControl>
