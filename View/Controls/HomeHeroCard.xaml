<UserControl
    x:Class="WinUIMusicPlayer.View.Controls.HomeHeroCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls">
    <Border CornerRadius="8" Background="#FF202020">
        <Border.Shadow><ThemeShadow /></Border.Shadow>
        <Grid x:Name="HeroLayout">
            <controls:MusicCoverControl x:Name="Artwork" Music="{x:Bind Theme.Artwork, Mode=OneWay}" DecodePixelSize="800" RenderTransformOrigin="0.5,0.5" />
            <Rectangle IsHitTestVisible="False" RadiusX="8" RadiusY="8">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="ShadeStart" Offset="0" Color="#F5101010" />
                        <GradientStop x:Name="ShadeMiddle" Offset="0.48" Color="#D8101010" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel x:Name="ActionPanel" Margin="40,24,24,24" MaxWidth="300" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8">
                <TextBlock x:Name="TitleText" Text="{x:Bind Theme.Title, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" RenderTransformOrigin="0.5,0.5" />
                <TextBlock x:Name="DescriptionText" Text="{x:Bind Theme.Description, Mode=OneWay}" MaxWidth="240" FontWeight="SemiBold" Foreground="White" Opacity="0.8" TextWrapping="Wrap" RenderTransformOrigin="0.5,0.5" />
                <Button x:Name="PlayButton" x:Uid="HomePlayTheme" Margin="0,8,0,0" MinWidth="120" CornerRadius="8" Foreground="White" BorderThickness="0,0,0,2"
                    Command="{x:Bind Theme.PlayCommand, Mode=OneWay}" CommandParameter="{x:Bind Theme, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                    <Button.Background><SolidColorBrush x:Name="ActionBrush" Color="#FF303030" /></Button.Background>
                    <Button.BorderBrush><SolidColorBrush x:Name="ActionBorderBrush" Color="#FF505050" /></Button.BorderBrush>
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" x:Name="ActionHoverBrush" Color="#FF505050" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" x:Name="ActionPressedBrush" Color="#FF202020" />
                    </Button.Resources>
                    <TextBlock x:Uid="HomePlay" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
