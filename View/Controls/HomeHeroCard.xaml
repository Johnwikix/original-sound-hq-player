<UserControl
    x:Class="WinUIMusicPlayer.View.Controls.HomeHeroCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="HeroShadeColor">#80F3F3F3</Color>
                    <Color x:Key="HeroShadeFadeColor">#00F3F3F3</Color>
                    <SolidColorBrush x:Key="HeroCardBackgroundBrush" Color="#FFF3F3F3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="HeroShadeColor">#80202020</Color>
                    <Color x:Key="HeroShadeFadeColor">#00202020</Color>
                    <SolidColorBrush x:Key="HeroCardBackgroundBrush" Color="#FF202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Color x:Key="HeroShadeColor">#80202020</Color>
                    <Color x:Key="HeroShadeFadeColor">#00202020</Color>
                    <SolidColorBrush x:Key="HeroCardBackgroundBrush" Color="#FF202020" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="ShadowHost" IsHitTestVisible="False" />
        <Border CornerRadius="8" Background="{ThemeResource HeroCardBackgroundBrush}">
            <Grid x:Name="HeroLayout">
                <controls:MusicCoverControl x:Name="Artwork" DecodePixelSize="800"
                    EnableCarouselTransition="True" SlideFromRight="{x:Bind SlideFromRight, Mode=OneWay}" />
                <!-- 遮罩与卡片底色跟应用主题走：浅色主题配浅色遮罩 + 深色文字，深色主题反之；强度与渐变对齐原版 40% 宽、50% 不透明度。 -->
                <Rectangle IsHitTestVisible="False" RadiusX="8" RadiusY="8">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop x:Name="ShadeStart" Offset="0" Color="{ThemeResource HeroShadeColor}" />
                            <GradientStop x:Name="ShadeHold" Offset="0.28" Color="{ThemeResource HeroShadeColor}" />
                            <GradientStop x:Name="ShadeEnd" Offset="0.4" Color="{ThemeResource HeroShadeFadeColor}" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel x:Name="ActionPanel" Margin="40,24,24,24" MaxWidth="300" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8" RenderTransformOrigin="0.5,0.5">
                    <TextBlock x:Name="TitleText" Text="{x:Bind Theme.Title, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DescriptionText" Text="{x:Bind Theme.Description, Mode=OneWay}" MaxWidth="240" MaxLines="2" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button x:Name="PlayButton" x:Uid="HomePlayTheme" Style="{StaticResource MenuButtonStyle}" Margin="0,8,0,0" MinWidth="120" CornerRadius="8" Foreground="White" BorderThickness="0,0,0,2"
                        Command="{x:Bind Theme.PlayCommand, Mode=OneWay}" CommandParameter="{x:Bind Theme, Mode=OneWay}">
                        <Button.Background><SolidColorBrush x:Name="ActionBrush" Color="#FF303030" /></Button.Background>
                        <Button.BorderBrush><SolidColorBrush x:Name="ActionBorderBrush" Color="#FF505050" /></Button.BorderBrush>
                        <Button.Resources>
                            <SolidColorBrush x:Key="AppBarButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="AppBarButtonForegroundPressed" Color="White" />
                            <SolidColorBrush x:Key="AppBarButtonBackgroundPointerOver" x:Name="ActionHoverBrush" Color="#FF505050" />
                            <SolidColorBrush x:Key="AppBarButtonBackgroundPressed" x:Name="ActionPressedBrush" Color="#FF202020" />
                        </Button.Resources>
                        <TextBlock x:Uid="HomePlay" TextTrimming="CharacterEllipsis" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
