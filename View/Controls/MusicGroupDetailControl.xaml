<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.View.Controls.MusicGroupDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:extensions="using:WinUIMusicPlayer.Extensions"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    x:Name="DetailRoot"
    mc:Ignorable="d">
    <UserControl.OpacityTransition>
        <ScalarTransition Duration="0:0:0" />
    </UserControl.OpacityTransition>
    <UserControl.Resources>
        <Style
            x:Key="ListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="ContextFlyout">
                <Setter.Value>
                    <MenuFlyout extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.MenuOptions, Mode=OneWay}" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="DetailInfoBar"
            Grid.Row="0"
            Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="DetailCoverBorder"
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:FieldModifier="public"
                CornerRadius="{x:Bind ViewModel.CoverCornerRadius, Mode=OneWay}">
                <Grid>
                    <Grid
                        x:Name="AlbumCoverImage"
                        Width="150"
                        Height="150"
                        Canvas.ZIndex="1">
                        <Image
                            x:Name="DetailCoverImage"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Canvas.ZIndex="1"
                            Stretch="UniformToFill">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:AlbumCoverBehavior Music="{x:Bind ViewModel.CoverSource, Mode=OneWay}" />
                            </interactivity:Interaction.Behaviors>
                        </Image>
                    </Grid>
                    <Grid
                        Width="150"
                        Height="150"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                        Canvas.ZIndex="0">
                        <FontIcon
                            Canvas.ZIndex="0"
                            FontSize="50"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.CoverGlyph, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Width="Auto">
                <Grid.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                    </TransitionCollection>
                </Grid.Transitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <dev:AutoScrollView
                    Grid.Row="0"
                    Margin="20,0,10,0"
                    IsPlaying="False"
                    PointerCanceled="AutoScrollHover_PointerCanceled"
                    PointerEntered="AutoScrollHover_PointerEntered"
                    PointerExited="AutoScrollHover_PointerExited">
                    <TextBlock
                        x:Name="TitleTextBlock"
                        FontSize="30"
                        FontWeight="Bold"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </dev:AutoScrollView>
                <dev:AutoScrollView
                    Grid.Row="1"
                    Margin="20,0,10,0"
                    VerticalAlignment="Bottom"
                    IsPlaying="False"
                    PointerCanceled="AutoScrollHover_PointerCanceled"
                    PointerEntered="AutoScrollHover_PointerEntered"
                    PointerExited="AutoScrollHover_PointerExited">
                    <TextBlock
                        x:Name="SecondaryTitleTextBlock"
                        FontSize="20"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.SecondTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </dev:AutoScrollView>
                <TextBlock
                    x:Name="ThirdTitleTextBlock"
                    Grid.Row="2"
                    Margin="20,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.ThirdTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Grid
                    Grid.Row="3"
                    Margin="10,0,10,0"
                    VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        Command="{x:Bind ViewModel.PlayAllCommand, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE768;" />
                                <TextBlock x:Uid="PlayAll" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="AddToPlayListBtn"
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        Click="AddToPlayListBtn_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE710;" />
                                <TextBlock x:Uid="AddTo" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button.Content>
                        <Button.Flyout>
                            <MenuFlyout x:Name="PlayList" />
                        </Button.Flyout>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Margin="10,0,10,0"
                        Command="{x:Bind ViewModel.AlbumInfoChangedCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsAlbumDetail, Mode=OneWay}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE70F;" />
                                <TextBlock x:Uid="Edit" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
        <ListView
            x:Name="MusicListView"
            Grid.Row="1"
            DoubleTapped="MusicListView_DoubleTapped"
            ItemContainerStyle="{StaticResource ListViewItemStyle}"
            ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
            RightTapped="MusicListView_RightTapped"
            SelectedItem="{x:Bind ViewModel.SelectedMusic, Mode=TwoWay}"
            SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Music">
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="0.5*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="CoverThumbnail"
                            Grid.Column="0"
                            Margin="0,5,10,5"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind PlayCommand, Mode=OneWay}"
                            CommandParameter="{Binding PlaySourceTag, ElementName=DetailRoot}"
                            CornerRadius="5"
                            Style="{StaticResource PlayHoverButtonStyle}">
                            <Grid Width="40" Height="40">
                                <Image
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Canvas.ZIndex="1"
                                    Stretch="UniformToFill">
                                    <interactivity:Interaction.Behaviors>
                                        <behaviors:AlbumCoverBehavior Music="{x:Bind Mode=OneWay}" />
                                    </interactivity:Interaction.Behaviors>
                                </Image>
                                <Grid
                                    Width="40"
                                    Height="40"
                                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                    Canvas.ZIndex="0">
                                    <FontIcon
                                        Canvas.ZIndex="0"
                                        FontSize="15"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE93C;" />
                                </Grid>
                            </Grid>
                        </Button>
                        <Button
                            x:Name="isFavouriteIconButton"
                            Grid.Column="1"
                            Margin="0,5,5,5"
                            Padding="3"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind UpdateFavouriteCommand, Mode=OneWay}">
                            <FontIcon
                                x:Name="IsFavouriteIcon"
                                Foreground="Red"
                                Glyph="{x:Bind IsFavorite, Mode=TwoWay, Converter={StaticResource FavouriteIconConverter}}" />
                        </Button>
                        <TextBlock
                            Grid.Column="2"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            Grid.Column="3"
                            Margin="5"
                            Padding="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AuthorButton_Click">
                            <Button.Content>
                                <dev:AutoScrollView
                                    Margin="0"
                                    IsPlaying="False"
                                    PointerCanceled="AutoScrollHover_PointerCanceled"
                                    PointerEntered="AutoScrollHover_PointerEntered"
                                    PointerExited="AutoScrollHover_PointerExited">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Author, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </dev:AutoScrollView>
                            </Button.Content>
                        </Button>
                        <Button
                            Grid.Column="4"
                            Margin="5"
                            Padding="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AlbumButton_Click">
                            <Button.Content>
                                <dev:AutoScrollView
                                    Margin="0"
                                    IsPlaying="False"
                                    PointerCanceled="AutoScrollHover_PointerCanceled"
                                    PointerEntered="AutoScrollHover_PointerEntered"
                                    PointerExited="AutoScrollHover_PointerExited">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Album, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </dev:AutoScrollView>
                            </Button.Content>
                        </Button>
                        <TextBlock
                            Grid.Column="5"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{x:Bind DiskNumber, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="6"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{x:Bind TrackNumber, Mode=OneWay}" />
                        <Border
                            Grid.Column="7"
                            Height="14"
                            MinWidth="26"
                            Padding="0,0,0,2"
                            Margin="5"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Background="#F7C8AC"
                            CornerRadius="2"
                            Visibility="{x:Bind tool:BindUtils.GetHrMusicVisibility(SampleRate, BitDepth), Mode=OneWay}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextAlignment="Center"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="#F98555"
                                Text="HQ" />
                        </Border>
                        <TextBlock
                            Grid.Column="8"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{x:Bind Duration, Converter={StaticResource TimeSpanToStringConverter}}" />
                        <Button
                            Grid.Column="9"
                            Margin="5"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind AddMusicToCurrentPlayListCommand, Mode=OneWay}">
                            <FontIcon
                                Margin="0,2,0,0"
                                VerticalAlignment="Center"
                                Glyph="&#xE710;" />
                        </Button>
                        <FontIcon
                            x:Name="IsExistOnDeviceIcon"
                            Grid.Column="10"
                            FontSize="14"
                            Glyph="{x:Bind IsExistOnDevice, Mode=OneWay, Converter={StaticResource IsExistOnDeviceConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
