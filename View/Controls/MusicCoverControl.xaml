<UserControl
    x:Class="WinUIMusicPlayer.View.Controls.MusicCoverControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource SubtleFillColorSecondaryBrush}">
        <FontIcon Glyph="&#xE93C;" FontSize="44" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Image x:Name="CoverImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
    </Grid>
</UserControl>
