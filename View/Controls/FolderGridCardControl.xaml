<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.View.Controls.FolderGridCardControl"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    x:Name="Root">
    <Grid ColumnDefinitions="*">
        <Grid Grid.Row="0" Visibility="Collapsed">
            <ProgressRing
                Width="50"
                Height="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />
        </Grid>
        <StackPanel
            Grid.Row="0"
            Margin="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid Width="150" Height="150">
                <Border
                    x:Name="CoverBorder"
                    Grid.Row="0"
                    Width="150"
                    Height="150"
                    Margin="0,0,0,0"
                    Padding="0"
                    CornerRadius="10">
                    <Grid>
                        <Image
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Canvas.ZIndex="1"
                            Stretch="UniformToFill">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:AlbumCoverBehavior Music="{x:Bind Music, Mode=OneWay}" />
                            </interactivity:Interaction.Behaviors>
                        </Image>
                        <Grid
                            Width="150"
                            Height="150"
                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                            Canvas.ZIndex="0">
                            <FontIcon
                                Canvas.ZIndex="0"
                                FontSize="50"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xf12b;" />
                        </Grid>
                    </Grid>
                </Border>
                <FontIcon
                    x:Name="IsExistOnDeviceIcon"
                    Margin="0,0,5,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    FontSize="16"
                    Glyph="{x:Bind tools:BindUtils.IsExistOnDeviceGlyphConverter(Music.IsExistOnDevice), Mode=OneWay}" />
            </Grid>
            <TextBlock
                Width="150"
                Height="60"
                Margin="0,5,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{x:Bind Music.LastLevelFolderPath, Mode=OneWay}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
