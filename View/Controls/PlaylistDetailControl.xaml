<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.View.Controls.PlaylistDetailControl"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:extensions="using:WinUIMusicPlayer.Extensions"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    x:Name="DetailRoot"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="ListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="ContextFlyout">
                <Setter.Value>
                    <MenuFlyout extensions:MenuFlyoutExtensions.PrepareCommand="{x:Bind ViewModel.PrepareMenuCommand}" extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.MenuOptions, Mode=OneWay}" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*">
        <Grid
            x:Name="DetailInfoBar"
            Grid.Row="0"
            Margin="10,0,10,10"
            ColumnDefinitions="Auto,*">
            <Border
                x:Name="DetailCoverBorder"
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:FieldModifier="public"
                CornerRadius="{x:Bind ViewModel.CoverCornerRadius, Mode=OneWay}">
                <Grid>
                    <Grid
                        x:Name="AlbumCoverImage"
                        Width="150"
                        Height="150"
                        Canvas.ZIndex="1">
                        <Image
                            x:Name="DetailCoverImage"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Canvas.ZIndex="1"
                            Stretch="UniformToFill">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:AlbumCoverBehavior Music="{x:Bind ViewModel.CoverSource, Mode=OneWay}" />
                            </interactivity:Interaction.Behaviors>
                        </Image>
                    </Grid>
                    <Grid
                        Width="150"
                        Height="150"
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                        Canvas.ZIndex="0">
                        <FontIcon
                            Canvas.ZIndex="0"
                            FontSize="50"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.CoverGlyph, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Width="Auto" RowDefinitions="Auto,*,*,Auto">
                <dev:AutoScrollView
                    Grid.Row="0"
                    Margin="20,0,10,0"
                    IsPlaying="False"
                    PointerCanceled="AutoScrollHover_PointerCanceled"
                    PointerEntered="AutoScrollHover_PointerEntered"
                    PointerExited="AutoScrollHover_PointerExited">
                    <TextBlock
                        x:Name="TitleTextBlock"
                        FontSize="30"
                        FontWeight="Bold"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </dev:AutoScrollView>
                <dev:AutoScrollView
                    Grid.Row="1"
                    Margin="20,0,10,0"
                    VerticalAlignment="Bottom"
                    IsPlaying="False"
                    PointerCanceled="AutoScrollHover_PointerCanceled"
                    PointerEntered="AutoScrollHover_PointerEntered"
                    PointerExited="AutoScrollHover_PointerExited">
                    <TextBlock
                        x:Name="SecondaryTitleTextBlock"
                        FontSize="20"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.SecondTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </dev:AutoScrollView>
                <TextBlock
                    x:Name="ThirdTitleTextBlock"
                    Grid.Row="2"
                    Margin="20,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.ThirdTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Grid
                    Grid.Row="3"
                    Margin="10,0,10,0"
                    VerticalAlignment="Bottom"
                    ColumnDefinitions="Auto,Auto,Auto">
                    <Button
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        Command="{x:Bind ViewModel.PlayAllCommand, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE768;" />
                                <TextBlock x:Uid="PlayAll" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        Command="{x:Bind ViewModel.ExportCommand, Mode=OneWay}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xEDE1;" />
                                <TextBlock x:Uid="ExportM3u8List" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="EditPlaylistNameBtn"
                        Grid.Column="2"
                        Margin="10,0,10,0"
                        Click="EditPlaylistNameBtn_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE70F;" />
                                <TextBlock x:Uid="Edit" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
        <ListView
            x:Name="MusicListView"
            Grid.Row="1"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
            DoubleTapped="MusicListView_DoubleTapped"
            DragItemsCompleted="MusicListView_DragItemsCompleted"
            ItemContainerStyle="{StaticResource ListViewItemStyle}"
            ItemsSource="{x:Bind ViewModel.Songs, Mode=OneWay}"
            RightTapped="MusicListView_RightTapped"
            SelectedItem="{x:Bind ViewModel.SelectedMusic, Mode=TwoWay}"
            SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:PlayListMusicItem">
                    <local:MusicListRowControl Music="{x:Bind Music, Mode=OneWay}" ArtistInvoked="MusicRow_ArtistInvoked" AlbumInvoked="MusicRow_AlbumInvoked" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
