<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.View.Controls.MusicListRowControl"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:dev="using:DevWinUI"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    Unloaded="Row_Unloaded">
    <Grid MinHeight="50" Opacity="{x:Bind tools:BindUtils.MusicRowOpacity(Music.IsPlayable), Mode=OneWay}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="{x:Bind TrackColumnWidth(ShowTrackNumbers), Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind TrackColumnWidth(ShowTrackNumbers), Mode=OneWay}" />
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <Button
            x:Name="CoverThumbnail"
            Grid.Column="0"
            Margin="0,5,10,5"
            Padding="0"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Command="{x:Bind Music.PlayCommand, Mode=OneWay}"
            CommandParameter="{x:Bind Music, Mode=OneWay}"
            CornerRadius="5"
            Style="{StaticResource PlayHoverButtonStyle}">
            <Grid Width="40" Height="40">
                <Image
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Canvas.ZIndex="1"
                    Stretch="UniformToFill">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:AlbumCoverBehavior Music="{x:Bind Music, Mode=OneWay}" />
                    </interactivity:Interaction.Behaviors>
                </Image>
                <Grid
                    Width="40"
                    Height="40"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    Canvas.ZIndex="0">
                    <FontIcon
                        Canvas.ZIndex="0"
                        FontSize="15"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE93C;" />
                </Grid>
            </Grid>
        </Button>
        <Button
            x:Name="isFavouriteIconButton"
            Grid.Column="1"
            Margin="0,5,5,5"
            Padding="3"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Command="{x:Bind Music.UpdateFavouriteCommand, Mode=OneWay}"
            CommandParameter="{x:Bind Music, Mode=OneWay}">
            <FontIcon
                x:Name="IsFavouriteIcon"
                Foreground="Red"
                Glyph="{x:Bind tools:BindUtils.FavouriteGlyphConverter(Music.IsFavorite), Mode=OneWay}" />
        </Button>
        <TextBlock
            Grid.Column="2"
            Margin="5"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="{x:Bind Music.Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
        <Button
            Grid.Column="3"
            Margin="5"
            Padding="5"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="AuthorButton_Click">
            <Button.Content>
                <dev:AutoScrollView x:Name="AuthorScroll"
                    Margin="0"
                    IsPlaying="False"
                    PointerCanceled="AutoScrollHover_PointerCanceled"
                    PointerEntered="AutoScrollHover_PointerEntered"
                    PointerExited="AutoScrollHover_PointerExited">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind Music.Author, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </dev:AutoScrollView>
            </Button.Content>
        </Button>
        <Button
            Grid.Column="4"
            Margin="5"
            Padding="5"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="AlbumButton_Click">
            <Button.Content>
                <dev:AutoScrollView x:Name="AlbumScroll"
                    Margin="0"
                    IsPlaying="False"
                    PointerCanceled="AutoScrollHover_PointerCanceled"
                    PointerEntered="AutoScrollHover_PointerEntered"
                    PointerExited="AutoScrollHover_PointerExited">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind Music.Album, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </dev:AutoScrollView>
            </Button.Content>
        </Button>
        <TextBlock
            Grid.Column="5"
            Margin="5"
            VerticalAlignment="Center"
            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ShowTrackNumbers), Mode=OneWay}"
            Text="{x:Bind Music.DiskNumber, Mode=OneWay}" />
        <TextBlock
            Grid.Column="6"
            Margin="5"
            VerticalAlignment="Center"
            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ShowTrackNumbers), Mode=OneWay}"
            Text="{x:Bind Music.TrackNumber, Mode=OneWay}" />
        <Border
            Grid.Column="7"
            Padding="4,0,4,1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#F7C8AC"
            CornerRadius="2"
            Visibility="{x:Bind tools:BindUtils.GetHrMusicVisibility(Music.SampleRate, Music.BitDepth), Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="9"
                FontWeight="Bold"
                Foreground="#F98555"
                Text="HQ" />
        </Border>
        <TextBlock
            Grid.Column="8"
            Margin="5"
            VerticalAlignment="Center"
            Text="{x:Bind tools:BindUtils.TimeSpanToTextConverter(Music.Duration), Mode=OneWay}" />
        <Button
            Grid.Column="9"
            Margin="5"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Command="{x:Bind Music.AddMusicToCurrentPlayListCommand, Mode=OneWay}"
            CommandParameter="{x:Bind Music, Mode=OneWay}">
            <FontIcon
                Margin="0,2,0,0"
                VerticalAlignment="Center"
                Glyph="&#xE710;" />
        </Button>
        <FontIcon
            x:Name="IsExistOnDeviceIcon"
            Grid.Column="10"
            FontSize="14"
            Glyph="{x:Bind tools:BindUtils.IsExistOnDeviceGlyphConverter(Music.IsExistOnDevice), Mode=OneWay}" />
        <FontIcon
            Grid.Column="11"
            FontSize="14"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Glyph="{x:Bind tools:BindUtils.MusicSourceGlyph(Music.IsRemote, Music.IsRemoteOffline, Music.IsRemoteCached), Mode=OneWay}"
            AutomationProperties.Name="{x:Bind tools:BindUtils.MusicSourceLabel(Music.IsRemote, Music.IsRemoteCached), Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind tools:BindUtils.MusicSourceLabel(Music.IsRemote, Music.IsRemoteCached), Mode=OneWay}" />
    </Grid>
</UserControl>
