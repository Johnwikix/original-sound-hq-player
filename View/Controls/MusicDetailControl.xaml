<UserControl
    x:Class="WinUIMusicPlayer.View.Controls.MusicDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns:animations="using:WinUIMusicPlayer.Helper.Animations"
    xmlns:extensions="using:WinUIMusicPlayer.Extensions">
    <UserControl.Resources>
        <Style x:Key="PropertyCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Thickness x:Key="PivotHeaderItemMargin">0,0,24,0</Thickness>
        <DataTemplate x:Key="WrappedActionText"><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" /></DataTemplate>
    <Style x:Key="PrimarySaveStyle" TargetType="Button" BasedOn="{StaticResource HomeSongActionButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup
                                x:Name="CommonStates"
                                animations:FluentAnimation.PointerOver="Root"
                                animations:FluentAnimation.Pressed="Root">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorDisabledBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    </UserControl.Resources>
    <Grid x:Name="DetailRoot" RowDefinitions="Auto,*,Auto" Padding="32,16,32,20" Background="Transparent">
        <Grid x:Name="HeaderBar" Margin="0,0,0,20" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ContentControl x:Name="HeaderFocus" IsTabStop="True" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('MusicDetailTitle')}">
                <TextBlock x:Uid="MusicDetailTitleBar" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </ContentControl>
            <ProgressRing x:Name="ActivityIndicator" Grid.Column="1" Width="20" Height="20" IsActive="{x:Bind ViewModel.Editor.IsBusy, Mode=OneWay}" />
        </Grid>
        <Grid x:Name="HeroLayout" Grid.Row="1" ColumnDefinitions="240,36,*" RowDefinitions="*,0">
            <ScrollViewer x:Name="IdentityScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Hidden" IsTabStop="False">
                <Grid x:Name="IdentityLayout" RowDefinitions="Auto,Auto" ColumnDefinitions="240,*">
                    <Grid x:Name="ArtworkRegion" Width="240" Height="240" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                        <Border x:Name="CoverHost" Width="240" Height="240" CornerRadius="10" HorizontalAlignment="Left">
                            <Grid>
                                <controls:MusicCoverControl x:Name="Artwork" DecodePixelSize="600" />
                                <Image x:Name="CoverPreviewImage" Source="{x:Bind ViewModel.Editor.CoverPreview, Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <Button x:Name="ArtworkMenuButton" x:Uid="HomeDetailsArtworkMenu" Width="36" Height="36" MinWidth="36" MinHeight="36" Padding="9"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" CornerRadius="18"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}" Style="{StaticResource HomeSongActionButtonStyle}">
                            <FontIcon Glyph="&#xE70F;" FontSize="16" />
                            <Button.Flyout><MenuFlyout x:Name="CoverMenu">
                                <MenuFlyoutItem x:Uid="HomeDetailsFindCover" Command="{x:Bind ViewModel.Editor.FindCoverCommand, Mode=OneWay}" />
                                <MenuFlyoutItem x:Uid="HomeDetailsChooseCover" Command="{x:Bind ViewModel.Editor.ChooseCoverCommand, Mode=OneWay}" />
                                <MenuFlyoutItem x:Uid="HomeDetailsExportCover" Command="{x:Bind ViewModel.Editor.ExportCoverCommand, Mode=OneWay}" />
                            </MenuFlyout></Button.Flyout>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="HeroText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0" Spacing="8">
                        <TextBlock x:Name="SongTitleText" Text="{x:Bind Text(ViewModel.Editor.Metadata.Draft.Title), Mode=OneWay}" FontSize="26" FontWeight="SemiBold"
                            TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind Text(ViewModel.Editor.Metadata.Draft.Author), Mode=OneWay}" FontSize="15" TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="SongAlbumText" Text="{x:Bind Text(ViewModel.Editor.Metadata.Draft.Album), Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="RecommendationText" Text="{x:Bind ViewModel.Reason, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6" Margin="0,8,0,0">
                            <Button x:Name="PlayButton" x:Uid="HomePlaySong" Style="{StaticResource HomeSongActionButtonStyle}"
                                Command="{x:Bind ViewModel.PlayCommand, Mode=OneWay}" CommandParameter="{x:Bind ViewModel.PlayParameter, Mode=OneWay}">
                                <FontIcon Glyph="&#xE768;" FontSize="16" />
                            </Button>
                            <Button x:Name="FavoriteButton" x:Uid="HomeFavorite" Style="{StaticResource HomeSongActionButtonStyle}"
                                Command="{x:Bind ViewModel.Music.UpdateFavouriteCommand, Mode=OneWay}" CommandParameter="{x:Bind ViewModel.Music, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind tools:BindUtils.FavouriteGlyphConverter(ViewModel.Music.IsFavorite), Mode=OneWay}" Foreground="Red" FontSize="16" />
                            </Button>
                            <Button x:Name="QueueButton" x:Uid="HomeAddToQueue" Style="{StaticResource HomeSongActionButtonStyle}"
                                Command="{x:Bind ViewModel.Music.AddMusicToCurrentPlayListCommand, Mode=OneWay}" CommandParameter="{x:Bind ViewModel.Music, Mode=OneWay}">
                                <FontIcon Glyph="&#xE710;" FontSize="16" />
                            </Button>
                            <Button x:Name="PlaylistButton" Style="{StaticResource HomeSongActionButtonStyle}"
                                AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('FlyoutAddToPlaylist')}"
                                ToolTipService.ToolTip="{x:Bind tools:ToolUtils.GetString('FlyoutAddToPlaylist')}">
                                <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="PlaylistMenu"
                                        extensions:MenuFlyoutExtensions.PrepareCommand="{x:Bind ViewModel.PreparePlaylistMenuCommand, Mode=OneWay}"
                                        extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.PlaylistMenuItems, Mode=OneWay}" />
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Grid x:Name="WorkspaceViewport" Grid.Column="2" MinWidth="0" MinHeight="0" SizeChanged="PivotViewport_SizeChanged">
            <Pivot x:Name="WorkspaceTabs" Padding="0" SelectedIndex="0">
                <PivotItem Margin="0">
                    <PivotItem.Header><TextBlock x:Uid="HomeSongTags" FontSize="14" FontWeight="SemiBold" /></PivotItem.Header>
                    <ScrollViewer x:Name="DetailScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                        <StackPanel Spacing="24" Padding="0,12,0,24">
                            <StackPanel Spacing="4">
                    <TextBlock x:Uid="TitleTextBlock" Style="{StaticResource PropertyCaption}" />
                    <TextBox x:Name="TitleInput"
                        IsReadOnly="{x:Bind TagsReadOnly(ViewModel.Music.IsRemote, ViewModel.Editor.IsLoading), Mode=OneWay}" Text="{x:Bind ViewModel.Editor.Metadata.Draft.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <StackPanel Spacing="4">
                    <TextBlock x:Uid="AuthorTextBlock" Style="{StaticResource PropertyCaption}" />
                    <TextBox x:Name="AuthorInput"
                        IsReadOnly="{x:Bind TagsReadOnly(ViewModel.Music.IsRemote, ViewModel.Editor.IsLoading), Mode=OneWay}" Text="{x:Bind ViewModel.Editor.Metadata.Draft.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Uid="AlbumTextBlock" Style="{StaticResource PropertyCaption}" />
                    <TextBox x:Name="AlbumInput"
                        IsReadOnly="{x:Bind TagsReadOnly(ViewModel.Music.IsRemote, ViewModel.Editor.IsLoading), Mode=OneWay}" Text="{x:Bind ViewModel.Editor.Metadata.Draft.Album, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <StackPanel Spacing="4">
                    <TextBlock x:Uid="MusicTagAlbumArtist" Style="{StaticResource PropertyCaption}" />
                    <TextBox x:Name="AlbumArtistInput"
                        IsReadOnly="{x:Bind TagsReadOnly(ViewModel.Music.IsRemote, ViewModel.Editor.IsLoading), Mode=OneWay}" Text="{x:Bind ViewModel.Editor.Metadata.Draft.AlbumArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Uid="MusicTagGenre" Style="{StaticResource PropertyCaption}" />
                    <TextBox x:Name="GenreInput"
                        IsReadOnly="{x:Bind TagsReadOnly(ViewModel.Music.IsRemote, ViewModel.Editor.IsLoading), Mode=OneWay}" Text="{x:Bind ViewModel.Editor.Metadata.Draft.Genre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                        </Grid>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
<StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock x:Uid="YearTextBlock" Style="{StaticResource PropertyCaption}" />
                    <NumberBox x:Name="YearInput" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.Editor.CanEditTags, Mode=OneWay}" Value="{x:Bind ViewModel.Editor.Metadata.Draft.Year, Mode=TwoWay}" />
                </StackPanel>
<StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock x:Uid="DiskNumberBox" Style="{StaticResource PropertyCaption}" />
                    <NumberBox x:Name="DiskInput" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.Editor.CanEditTags, Mode=OneWay}" Value="{x:Bind ViewModel.Editor.Metadata.Draft.DiskNumber, Mode=TwoWay}" />
                </StackPanel>
<StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock x:Uid="TrackNumberBox" Style="{StaticResource PropertyCaption}" />
                    <NumberBox x:Name="TrackInput" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.Editor.CanEditTags, Mode=OneWay}" Value="{x:Bind ViewModel.Editor.Metadata.Draft.TrackNumber, Mode=TwoWay}" />
                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="MusicTagComposer" Style="{StaticResource PropertyCaption}" />
                                    <TextBox x:Name="ComposerInput"
                                        IsReadOnly="{x:Bind TagsReadOnly(ViewModel.Music.IsRemote, ViewModel.Editor.IsLoading), Mode=OneWay}" Text="{x:Bind ViewModel.Editor.Metadata.Draft.Composer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Uid="MusicTagLyricist" Style="{StaticResource PropertyCaption}" />
                                    <TextBox x:Name="LyricistInput"
                                        IsReadOnly="{x:Bind TagsReadOnly(ViewModel.Music.IsRemote, ViewModel.Editor.IsLoading), Mode=OneWay}" Text="{x:Bind ViewModel.Editor.Metadata.Draft.Lyricist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="MusicTagConductor" Style="{StaticResource PropertyCaption}" />
                                    <TextBox x:Name="ConductorInput"
                                        IsReadOnly="{x:Bind TagsReadOnly(ViewModel.Music.IsRemote, ViewModel.Editor.IsLoading), Mode=OneWay}" Text="{x:Bind ViewModel.Editor.Metadata.Draft.Conductor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Uid="MusicTagCatalogNumber" Style="{StaticResource PropertyCaption}" />
                                    <TextBox x:Name="CatalogNumberInput"
                                        IsReadOnly="{x:Bind TagsReadOnly(ViewModel.Music.IsRemote, ViewModel.Editor.IsLoading), Mode=OneWay}" Text="{x:Bind ViewModel.Editor.Metadata.Draft.CatalogNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Margin="0">
                    <PivotItem.Header><TextBlock x:Uid="HomeDetailsLyricsTab" FontSize="14" FontWeight="SemiBold" /></PivotItem.Header>
                    <Grid RowDefinitions="Auto,*" Padding="0,8,0,0">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <TextBlock x:Uid="LyricsTimeOffsetTag" Style="{StaticResource PropertyCaption}" VerticalAlignment="Center" />
                                <NumberBox x:Name="OffsetInput" Grid.Column="1" Width="176" Minimum="-10000" Maximum="10000" SmallChange="100" LargeChange="1000"
                                    SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.Music.LyricsOffsetMs, Mode=TwoWay}" />
                                <Button x:Name="LyricsToolsButton" x:Uid="HomeDetailsLyricsTools" Grid.Column="2" Width="36" Height="36" MinWidth="36" MinHeight="36" Padding="8"
                                    Style="{StaticResource HomeSongActionButtonStyle}">
                                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    <Button.Flyout><MenuFlyout x:Name="LyricsToolsMenu">
                                        <MenuFlyoutItem x:Uid="HomeDetailsReadEmbedded" Command="{x:Bind ViewModel.Editor.ReadEmbeddedCommand, Mode=OneWay}" />
                                        <MenuFlyoutItem x:Uid="HomeDetailsRefreshLyrics" Command="{x:Bind ViewModel.Editor.Lyrics.RefreshCommand, Mode=OneWay}" />
                                        <MenuFlyoutItem x:Uid="HomeDetailsExportLyrics" Command="{x:Bind ViewModel.Editor.Lyrics.ExportCommand, Mode=OneWay}" />
                                        <MenuFlyoutSeparator Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.Editor.Lyrics.HasLegacy), Mode=OneWay}" />
                                        <MenuFlyoutItem x:Uid="HomeDetailsRestoreLrc" Command="{x:Bind ViewModel.Editor.Lyrics.RestoreLegacyCommand, Mode=OneWay}" CommandParameter="Lrc"
                                            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.Editor.Lyrics.HasLegacy), Mode=OneWay}" />
                                        <MenuFlyoutItem x:Uid="HomeDetailsRestoreKrc" Command="{x:Bind ViewModel.Editor.Lyrics.RestoreLegacyCommand, Mode=OneWay}" CommandParameter="Krc"
                                            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.Editor.Lyrics.HasLegacy), Mode=OneWay}" />
                                    </MenuFlyout></Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Editor.Lyrics.Status, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind TextVisibility(ViewModel.Editor.Lyrics.Status), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.Editor.Lyrics.Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Visibility="{x:Bind TextVisibility(ViewModel.Editor.Lyrics.Error), Mode=OneWay}" />
                        </StackPanel>
                        <Grid x:Name="LyricsViewport" Grid.Row="1" MinWidth="0" MinHeight="0" SizeChanged="PivotViewport_SizeChanged">
                        <Pivot x:Name="LyricsTabs" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <PivotItem Margin="0">
                                <PivotItem.Header><TextBlock x:Uid="LyricsOriginalTab" FontSize="13" /></PivotItem.Header>
                                <TextBox x:Name="OriginalLyricsInput" VerticalAlignment="Stretch" AcceptsReturn="True" IsReadOnly="{x:Bind ViewModel.Editor.IsLoading, Mode=OneWay}"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                    Text="{x:Bind ViewModel.Editor.Lyrics.OriginalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </PivotItem>
                            <PivotItem Margin="0">
                                <PivotItem.Header><TextBlock x:Uid="LyricsTranslationTab" FontSize="13" /></PivotItem.Header>
                                <TextBox x:Name="TranslationLyricsInput" VerticalAlignment="Stretch" AcceptsReturn="True" IsReadOnly="{x:Bind ViewModel.Editor.IsLoading, Mode=OneWay}"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                    Text="{x:Bind ViewModel.Editor.Lyrics.TranslationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </PivotItem>
                            <PivotItem Margin="0">
                                <PivotItem.Header><TextBlock x:Uid="LyricsPronunciationTab" FontSize="13" /></PivotItem.Header>
                                <TextBox x:Name="PronunciationLyricsInput" VerticalAlignment="Stretch" AcceptsReturn="True" IsReadOnly="{x:Bind ViewModel.Editor.IsLoading, Mode=OneWay}"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                    Text="{x:Bind ViewModel.Editor.Lyrics.PronunciationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </PivotItem>
                        </Pivot>
                        </Grid>
                    </Grid>
                </PivotItem>
                <PivotItem Margin="0">
                    <PivotItem.Header><TextBlock x:Uid="HomeDetailsFiles" FontSize="14" FontWeight="SemiBold" /></PivotItem.Header>
                    <ScrollViewer x:Name="FileScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                        <StackPanel Spacing="24" Padding="0,16,0,24">
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="24">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                    <TextBlock x:Uid="DurationTextBlock" Style="{StaticResource PropertyCaption}" />
                                    <TextBlock Text="{x:Bind Duration(ViewModel.Music.Duration), Mode=OneWay}" FontSize="20" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                    <TextBlock x:Uid="HomeSongFormat" Style="{StaticResource PropertyCaption}" />
                                    <TextBlock Text="{x:Bind Text(ViewModel.Music.Extension), Mode=OneWay}" FontSize="20" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                    <TextBlock x:Uid="SampleRateTextBlock" Style="{StaticResource PropertyCaption}" />
                                    <TextBlock Text="{x:Bind SampleRate(ViewModel.Music.SampleRate), Mode=OneWay}" FontSize="20" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                    <TextBlock x:Uid="BitDepthTextBlock" Style="{StaticResource PropertyCaption}" />
                                    <TextBlock Text="{x:Bind BitDepth(ViewModel.Music.BitDepth), Mode=OneWay}" FontSize="20" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                                    <TextBlock x:Uid="BitRateTextBlock" Style="{StaticResource PropertyCaption}" />
                                    <TextBlock Text="{x:Bind BitRate(ViewModel.Music.BitRate), Mode=OneWay}" FontSize="20" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                                    <TextBlock x:Uid="HomeSongChannels" Style="{StaticResource PropertyCaption}" />
                                    <TextBlock Text="{x:Bind Number(ViewModel.Music.Channel), Mode=OneWay}" FontSize="20" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="LastFolderNameTextBlock" Style="{StaticResource PropertyCaption}" />
                                <TextBlock Text="{x:Bind Text(ViewModel.Music.LastLevelFolderPath), Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="PathTextBlock" Style="{StaticResource PropertyCaption}" />
                                <TextBlock Text="{x:Bind Text(ViewModel.Music.Path), Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                <Button x:Uid="HomeDetailsOpenLocation" HorizontalAlignment="Left" Margin="0,8,0,0" Style="{StaticResource HomeSongActionButtonStyle}"
                                    Command="{x:Bind ViewModel.Editor.OpenLocationCommand, Mode=OneWay}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Uid="CreateTime" Style="{StaticResource PropertyCaption}" />
                                    <TextBlock Text="{x:Bind Time(ViewModel.Music.CreateTime), Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock x:Uid="UpdateTime" Style="{StaticResource PropertyCaption}" />
                                    <TextBlock Text="{x:Bind Time(ViewModel.Music.UpdateTime), Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
            </Pivot>
            </Grid>
        </Grid>
        <Grid x:Name="FooterBar" Grid.Row="2" Margin="0,16,0,0" ColumnDefinitions="240,36,*">
            <Grid x:Name="FooterButtons" Grid.Column="2" ColumnDefinitions="*,*" ColumnSpacing="10" MaxWidth="520" HorizontalAlignment="Right">
                <Button x:Name="SaveFileButton" x:Uid="SaveButton" Style="{StaticResource HomeSongActionButtonStyle}" ContentTemplate="{StaticResource WrappedActionText}"
                    HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.Editor.CanSaveFile, Mode=OneWay}">
                    <Button.Flyout><Flyout x:Name="ConfirmFlyout">
                        <StackPanel Spacing="12" MaxWidth="360">
                            <TextBlock x:Uid="SaveConfirm" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="ConfirmButton" Style="{StaticResource HomeSongActionButtonStyle}" Click="Confirm_Click" Command="{x:Bind ViewModel.Editor.SaveFileCommand, Mode=OneWay}" />
                                <Button x:Uid="CancelButton" Style="{StaticResource HomeSongActionButtonStyle}" Click="Cancel_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout></Button.Flyout>
                </Button>
                <Button x:Name="SaveDatabaseButton" x:Uid="SaveToDataBase" Grid.Column="1" Style="{StaticResource PrimarySaveStyle}" ContentTemplate="{StaticResource WrappedActionText}"
                    HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.Editor.SaveDatabaseCommand, Mode=OneWay}" />
            </Grid>
        </Grid>
        <StackPanel x:Name="FeedbackLayer" Grid.Row="1" VerticalAlignment="Top" Spacing="8">
            <InfoBar x:Name="ErrorInfo" IsOpen="{x:Bind HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Warning" IsClosable="False" />
            <InfoBar x:Name="EditorErrorInfo" IsOpen="{x:Bind HasText(ViewModel.Editor.Error), Mode=OneWay}" Message="{x:Bind ViewModel.Editor.Error, Mode=OneWay}" Severity="Error" IsClosable="False">
                <InfoBar.ActionButton><Button x:Uid="HomeRetry" Style="{StaticResource HomeSongActionButtonStyle}"
                    Command="{x:Bind ViewModel.Editor.LoadCommand, Mode=OneWay}" Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.Editor.LoadFailed), Mode=OneWay}" /></InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
    </Grid>
</UserControl>
