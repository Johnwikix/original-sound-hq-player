<UserControl
    x:Class="WinUIMusicPlayer.View.Controls.HomeSongPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns:animations="using:WinUIMusicPlayer.Helper.Animations"
    xmlns:extensions="using:WinUIMusicPlayer.Extensions">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="PreviewBackground" Color="#FFF9F9F9" /></ResourceDictionary>
                <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="PreviewBackground" Color="#FF282C36" /></ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="PreviewBackground" Color="{ThemeResource SystemColorWindowColor}" /></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="PanelRoot" Background="{ThemeResource PreviewBackground}" CornerRadius="8"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Shadow><ThemeShadow /></Border.Shadow>
        <StackPanel>
            <Grid x:Name="CoverHost" CornerRadius="7,7,0,0">
                <controls:MusicCoverControl x:Name="Artwork" DecodePixelSize="400" />
            </Grid>
            <StackPanel x:Name="Details" Padding="16" Spacing="6">
                <TextBlock Text="{x:Bind Song.Music.Title, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                    MaxLines="1" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Song.Music.Author, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Song.Music.Album, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind Song.Reason, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6" Margin="0,8,0,0">
                    <Button x:Name="PlayButton" x:Uid="HomePlaySong" Style="{StaticResource HomeSongActionButtonStyle}"
                        Command="{x:Bind Song.PlayCommand, Mode=OneWay}" CommandParameter="{x:Bind Song, Mode=OneWay}">
                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                    </Button>
                    <Button x:Name="FavoriteButton" x:Uid="HomeFavorite" Style="{StaticResource HomeSongActionButtonStyle}"
                        Command="{x:Bind Song.Music.UpdateFavouriteCommand, Mode=OneWay}" CommandParameter="{x:Bind Song.Music, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind tools:BindUtils.FavouriteGlyphConverter(Song.Music.IsFavorite), Mode=OneWay}" Foreground="Red" FontSize="16" />
                    </Button>
                    <Button x:Name="QueueButton" x:Uid="HomeAddToQueue" Style="{StaticResource HomeSongActionButtonStyle}"
                        Command="{x:Bind Song.Music.AddMusicToCurrentPlayListCommand, Mode=OneWay}" CommandParameter="{x:Bind Song.Music, Mode=OneWay}">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                    </Button>
                    <Button x:Name="PlaylistButton" Style="{StaticResource HomeSongActionButtonStyle}"
                        AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('FlyoutAddToPlaylist')}"
                        ToolTipService.ToolTip="{x:Bind tools:ToolUtils.GetString('FlyoutAddToPlaylist')}">
                        <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="PlaylistMenu" Opening="PlaylistMenu_Opening" Closed="PlaylistMenu_Closed"
                                extensions:MenuFlyoutExtensions.PrepareCommand="{x:Bind ViewModel.PreparePlaylistMenuCommand, Mode=OneWay}"
                                extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.PlaylistMenuItems, Mode=OneWay}" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
