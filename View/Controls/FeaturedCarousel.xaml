<UserControl
    x:Class="WinUIMusicPlayer.View.Controls.FeaturedCarousel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="LayoutGrid" ColumnDefinitions="1.5*,*" RowDefinitions="400,24,0" ColumnSpacing="15" RowSpacing="15"
          KeyDown="Carousel_KeyDown" SizeChanged="Layout_SizeChanged" PointerEntered="Carousel_PointerEntered" PointerExited="Carousel_PointerExited"
          GotFocus="Carousel_GotFocus" LostFocus="Carousel_LostFocus">
        <Grid x:Name="SliderGrid" Background="Transparent">
            <ContentPresenter x:Name="Presenter" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                Content="{x:Bind SelectedItem, Mode=OneWay}" ContentTemplate="{x:Bind ItemTemplate, Mode=OneWay}" />
            <Button x:Name="PreviousButton" x:Uid="HomePrevious" Width="32" Height="32" Padding="0" CornerRadius="16" BorderThickness="0"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-10,0,0,0" Foreground="White" Background="#CC202020"
                Visibility="{x:Bind NavigationVisibility, Mode=OneWay}" Opacity="{x:Bind NavigationOpacity, Mode=OneWay}"
                Scale="{x:Bind NavigationScale, Mode=OneWay}" CenterPoint="16,16,0" IsHitTestVisible="{x:Bind IsNavigationInteractive, Mode=OneWay}" Click="Previous_Click">
                <Button.OpacityTransition><ScalarTransition Duration="0:0:0.16" /></Button.OpacityTransition>
                <Button.ScaleTransition><Vector3Transition Duration="0:0:0.16" /></Button.ScaleTransition>
                <FontIcon Glyph="&#xE76B;" FontSize="12" />
            </Button>
            <Button x:Name="NextButton" x:Uid="HomeNext" Width="32" Height="32" Padding="0" CornerRadius="16" BorderThickness="0"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-10,0" Foreground="White" Background="#CC202020"
                Visibility="{x:Bind NavigationVisibility, Mode=OneWay}" Opacity="{x:Bind NavigationOpacity, Mode=OneWay}"
                Scale="{x:Bind NavigationScale, Mode=OneWay}" CenterPoint="16,16,0" IsHitTestVisible="{x:Bind IsNavigationInteractive, Mode=OneWay}" Click="Next_Click">
                <Button.OpacityTransition><ScalarTransition Duration="0:0:0.16" /></Button.OpacityTransition>
                <Button.ScaleTransition><Vector3Transition Duration="0:0:0.16" /></Button.ScaleTransition>
                <FontIcon Glyph="&#xE76C;" FontSize="12" />
            </Button>
        </Grid>
        <PipsPager x:Name="Pager" Grid.Row="1" HorizontalAlignment="Center" Margin="0,-10,0,0"
            NumberOfPages="{x:Bind PageCount, Mode=OneWay}" SelectedPageIndex="{x:Bind SelectedIndex, Mode=OneWay}"
            SelectedIndexChanged="Pager_SelectedIndexChanged" Visibility="{x:Bind PagerVisibility, Mode=OneWay}" />
        <Grid x:Name="ThumbnailGrid" Grid.Column="1" ColumnDefinitions="*,*" RowDefinitions="1.35*,*" ColumnSpacing="15" RowSpacing="15"
            Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}">
            <Button x:Name="PrimaryThumbnail" Grid.ColumnSpan="2" Padding="0" CornerRadius="8" BorderThickness="0"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Command="{x:Bind ThumbnailCommand, Mode=OneWay}"
                CommandParameter="{x:Bind PrimaryItem, Mode=OneWay}" Content="{x:Bind PrimaryItem, Mode=OneWay}" ContentTemplate="{x:Bind ThumbnailTemplate, Mode=OneWay}">
                <Button.Shadow><ThemeShadow /></Button.Shadow>
            </Button>
            <Button x:Name="SecondaryThumbnail" Grid.Row="1" Padding="0" CornerRadius="8" BorderThickness="0"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Command="{x:Bind ThumbnailCommand, Mode=OneWay}"
                CommandParameter="{x:Bind SecondaryItem, Mode=OneWay}" Content="{x:Bind SecondaryItem, Mode=OneWay}" ContentTemplate="{x:Bind ThumbnailTemplate, Mode=OneWay}"
                Visibility="{x:Bind SecondaryVisibility, Mode=OneWay}">
                <Button.Shadow><ThemeShadow /></Button.Shadow>
            </Button>
            <Button x:Name="TertiaryThumbnail" Grid.Row="1" Grid.Column="1" Padding="0" CornerRadius="8" BorderThickness="0"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Command="{x:Bind ThumbnailCommand, Mode=OneWay}"
                CommandParameter="{x:Bind TertiaryItem, Mode=OneWay}" Content="{x:Bind TertiaryItem, Mode=OneWay}" ContentTemplate="{x:Bind ThumbnailTemplate, Mode=OneWay}"
                Visibility="{x:Bind TertiaryVisibility, Mode=OneWay}">
                <Button.Shadow><ThemeShadow /></Button.Shadow>
            </Button>
        </Grid>
    </Grid>
</UserControl>
