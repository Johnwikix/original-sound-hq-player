<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.FolderBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:WinUIMusicPlayer.Extensions"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    mc:Ignorable="d">
    <Grid Margin="0">
        <SemanticZoom
            x:Name="BrowseZoom"
            IsHitTestVisible="{x:Bind ViewModel.IsInDetailMode, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}"
            Opacity="{x:Bind ViewModel.IsInDetailMode, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter=invert}">
            <SemanticZoom.ZoomedInView>
                <GridView
                    x:Name="FolderGridView"
                    Margin="10,0,0,0"
                    IsItemClickEnabled="True"
                    IsRightTapEnabled="True"
                    ItemClick="FolderGridView_ItemClick"
                    ItemsSource="{x:Bind ViewModel.AppViewModel.FolderPageSource.View, Mode=OneWay}"
                    RightTapped="Folder_RightTapped"
                    SelectionMode="None">
                    <GridView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                            <Setter Property="ContextFlyout">
                                <Setter.Value>
                                    <MenuFlyout extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.FolderMenuOptions, Mode=OneWay}" />
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="model:MusicGroup">
                                    <TextBlock
                                        Margin="10,0,5,5"
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Key}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.HeaderContainerStyle>
                                <StaticResource ResourceKey="NoBorderGridViewHeaderItemStyle" />
                            </GroupStyle.HeaderContainerStyle>
                        </GroupStyle>
                    </GridView.GroupStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="model:Music">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Row="0" Visibility="Collapsed">
                                    <ProgressRing
                                        Width="50"
                                        Height="50"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsActive="True" />
                                </Grid>
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Grid Width="150" Height="150">
                                        <Border
                                            x:Name="CoverBorder"
                                            Grid.Row="0"
                                            Width="150"
                                            Height="150"
                                            Margin="0,0,0,0"
                                            Padding="0"
                                            CornerRadius="10">
                                            <Grid>
                                                <Image
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Canvas.ZIndex="1"
                                                    Stretch="UniformToFill">
                                                    <interactivity:Interaction.Behaviors>
                                                        <behaviors:AlbumCoverBehavior Music="{x:Bind Mode=OneWay}" />
                                                    </interactivity:Interaction.Behaviors>
                                                </Image>
                                                <Grid
                                                    Width="150"
                                                    Height="150"
                                                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                                    Canvas.ZIndex="0">
                                                    <FontIcon
                                                        Canvas.ZIndex="0"
                                                        FontSize="50"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xf12b;" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <FontIcon
                                            x:Name="IsExistOnDeviceIcon"
                                            Margin="0,0,5,5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            FontSize="16"
                                            Glyph="{x:Bind IsExistOnDevice, Mode=OneWay, Converter={StaticResource IsExistOnDeviceConverter}}" />
                                    </Grid>
                                    <TextBlock
                                        Width="150"
                                        Height="60"
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind LastLevelFolderPath}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </SemanticZoom.ZoomedInView>
            <SemanticZoom.ZoomedOutView>
                <GridView
                    x:Name="ZoomedOutGridView"
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsItemClickEnabled="True"
                    ItemsSource="{x:Bind ViewModel.AppViewModel.FolderPageSource.View.CollectionGroups, Mode=OneWay}"
                    ScrollViewer.IsHorizontalScrollChainingEnabled="False"
                    ScrollViewer.IsVerticalScrollChainingEnabled="False"
                    ScrollViewer.ZoomMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="ICollectionViewGroup">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="32"
                                Text="{x:Bind Group.(model:MusicGroup.Key), Mode=OneWay}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </SemanticZoom.ZoomedOutView>
        </SemanticZoom>
        <controls:MusicGroupDetailControl
            x:Name="DetailView"
            PlaySourceTag="FolderSongsView"
            IsHitTestVisible="{x:Bind ViewModel.IsInDetailMode, Mode=OneWay}"
            Opacity="{x:Bind ViewModel.IsInDetailMode, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
            x:FieldModifier="public" />
    </Grid>
</Page>
