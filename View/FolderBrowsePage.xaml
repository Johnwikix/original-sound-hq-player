<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.FolderBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:tools="using:WinUIMusicPlayer.Utils">
    <Grid>
        <ContentControl
            x:Name="MusicDetailsSource"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False">
            <Grid Margin="16,12,16,0" RowDefinitions="Auto,*">
                <InfoBar
                    Title="{x:Bind ViewModel.AppViewModel.InfoBarTitle, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.AppViewModel.InfoBarIsOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.AppViewModel.InfoBarMessage, Mode=OneWay}" />
                <Grid x:Name="BrowserColumns" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind ViewModel.FolderColumnWidth, Mode=TwoWay}" MinWidth="170" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="{x:Bind ViewModel.SongsColumnWidth, Mode=TwoWay}" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="TreePane"
                        Padding="0,0,8,0"
                        RowDefinitions="Auto,Auto,*"
                        RowSpacing="12">
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.PageTitle}" />
                        <ComboBox
                            Grid.Row="1"
                            Margin="4,0,0,0"
                            HorizontalAlignment="Stretch"
                            BorderBrush="Transparent"
                            Background="Transparent"
                            BorderThickness="0"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind ViewModel.MusicBrowseViewModel.RemoteSources.Choices}"
                            SelectedItem="{x:Bind ViewModel.MusicBrowseViewModel.RemoteSources.SelectedSource, Mode=TwoWay}" />
                        <ListView
                            x:Name="FolderTree"
                            Grid.Row="2"
                            CanDragItems="False"
                            CanReorderItems="False"
                            ItemsSource="{x:Bind ViewModel.VisibleNodes}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                            SelectionMode="Single">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:SelectionChangedCommandBehavior Command="{x:Bind ViewModel.SelectFolderCommand}" />
                                <behaviors:KeyDownCommandBehavior
                                    Key="Right"
                                    Command="{x:Bind ViewModel.NavigateIntoFolderCommand}"
                                    CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}" />
                                <behaviors:KeyDownCommandBehavior
                                    Key="Left"
                                    Command="{x:Bind ViewModel.NavigateOutOfFolderCommand}"
                                    CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}" />
                                <behaviors:ScrollSelectedItemIntoViewBehavior />
                            </interactivity:Interaction.Behaviors>
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                            </ListView.Resources>
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="32" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:FolderBrowserNode">
                                    <Grid
                                        MinHeight="32"
                                        ColumnDefinitions="Auto,Auto,*"
                                        ColumnSpacing="8"
                                        Margin="{x:Bind tools:BindUtils.FolderRowIndent(Depth), Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind Path}">
                                        <Grid Width="24" Height="32">
                                            <ToggleButton
                                                Width="24"
                                                Height="32"
                                                Padding="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                AutomationProperties.Name="{x:Bind Name}"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Command="{x:Bind ToggleFolderCommand}"
                                                CommandParameter="{x:Bind}"
                                                IsChecked="{x:Bind IsExpanded, Mode=OneWay}"
                                                IsTabStop="False"
                                                Style="{StaticResource DefaultToggleButtonStyle}"
                                                Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(HasChildren), Mode=OneWay}">
                                                <FontIcon FontSize="12" Glyph="{x:Bind tools:BindUtils.FolderChevronGlyph(IsExpanded), Mode=OneWay}" />
                                            </ToggleButton>
                                        </Grid>
                                        <FontIcon
                                            Grid.Column="1"
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE8B7;" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <toolkit:GridSplitter
                        x:Name="PaneSplitter"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind ViewModel.ResizePanesLabel}"
                        Background="Transparent"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Columns"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ResizePanesLabel}" />
                    <Grid
                        x:Name="SongsPane"
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        RowDefinitions="Auto,*"
                        RowSpacing="16">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                Grid.Row="1"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.CurrentPath, Mode=OneWay}" />
                            <Grid
                                Grid.Row="2"
                                Margin="0,6,0,0"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">
                                <ComboBox
                                    Width="140"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{x:Bind ViewModel.AppViewModel.SortOptions}"
                                    SelectedItem="{x:Bind ViewModel.AppViewModel.SelectedSortOption, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="model:SortOption">
                                            <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind DetailView.ViewModel.PlayAllCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasSongs, Mode=OneWay}"
                                    Style="{StaticResource FluentAccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                        <TextBlock x:Uid="PlayAll" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                        <controls:MusicGroupDetailControl
                            x:Name="DetailView"
                            Grid.Row="1"
                            DetailKind="Folder"
                            PlaySourceTag="FolderSongsView"
                            ShowHeader="False"
                            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.HasSongs), Mode=OneWay}" />
                        <StackPanel
                            Grid.Row="1"
                            MaxWidth="360"
                            Margin="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.IsEmpty), Mode=OneWay}">
                            <FontIcon
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8D6;" />
                            <TextBlock
                                FontSize="18"
                                Text="{x:Bind ViewModel.EmptyTitle}"
                                TextAlignment="Center" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.EmptyHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.MusicBrowseViewModel.EmptyAddFolderCommand}"
                                Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.ShowAddFolder), Mode=OneWay}">
                                <TextBlock x:Uid="AddFolder" />
                            </Button>
                        </StackPanel>
                        <ProgressRing
                            Grid.Row="1"
                            Width="32"
                            Height="32"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <InfoBar
                            Grid.Row="1"
                            VerticalAlignment="Top"
                            IsClosable="False"
                            IsOpen="{x:Bind HasText(ViewModel.Error), Mode=OneWay}"
                            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                            Severity="Error">
                            <InfoBar.ActionButton>
                                <Button AutomationProperties.Name="{x:Bind ViewModel.RetryLabel}" Command="{x:Bind ViewModel.RetryCommand}">
                                    <FontIcon Glyph="&#xE72C;" />
                                </Button>
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </Grid>
                </Grid>
            </Grid>
        </ContentControl>
        <ContentControl
            x:Name="MusicDetailsOverlay"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            TabFocusNavigation="Cycle"
            Visibility="Collapsed" />
    </Grid>
</Page>
