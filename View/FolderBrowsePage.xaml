<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.FolderBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tools="using:WinUIMusicPlayer.Utils">
    <Grid>
        <ContentControl x:Name="MusicDetailsSource" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
            <Grid Margin="16,12,16,0" RowDefinitions="Auto,*">
                <InfoBar IsOpen="{x:Bind ViewModel.AppViewModel.InfoBarIsOpen, Mode=TwoWay}"
                    Title="{x:Bind ViewModel.AppViewModel.InfoBarTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.AppViewModel.InfoBarMessage, Mode=OneWay}" />
                <Grid x:Name="BrowserColumns" Grid.Row="1" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="170" MaxWidth="280" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="TreePane" RowDefinitions="Auto,Auto,*" RowSpacing="12" Padding="0,0,12,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                        <TextBlock Margin="8,0,0,0" Text="{x:Bind ViewModel.PageTitle}" FontSize="22" FontWeight="SemiBold" />
                        <ComboBox Grid.Row="1" Margin="4,0,0,0" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                            ItemsSource="{x:Bind ViewModel.MusicBrowseViewModel.RemoteSources.Choices}"
                            SelectedItem="{x:Bind ViewModel.MusicBrowseViewModel.RemoteSources.SelectedSource, Mode=TwoWay}" />
                        <TreeView x:Name="FolderTree" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Roots}"
                            SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=OneWay}" SelectionMode="Single"
                            CanDragItems="False" CanReorderItems="False" SelectionChanged="Tree_SelectionChanged" Expanding="Tree_Expanding">
                            <TreeView.ItemTemplate>
                                <DataTemplate x:DataType="model:FolderBrowserNode">
                                    <TreeViewItem ItemsSource="{x:Bind VisibleChildren}"
                                        HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}"
                                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Path}">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </TreeViewItem>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                    <Grid x:Name="SongsPane" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="16">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" VerticalAlignment="Center"
                                    FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}" FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True"
                                TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.CurrentPath, Mode=OneWay}" />
                            <Grid Grid.Row="2" Margin="0,6,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox Width="140" HorizontalAlignment="Left" ItemsSource="{x:Bind ViewModel.AppViewModel.SortOptions}"
                                    SelectedItem="{x:Bind ViewModel.AppViewModel.SelectedSortOption, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="model:SortOption"><TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Command="{x:Bind DetailView.ViewModel.PlayAllCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasSongs, Mode=OneWay}" Style="{StaticResource FluentAccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock x:Uid="PlayAll" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                        <controls:MusicGroupDetailControl x:Name="DetailView" Grid.Row="1" DetailKind="Folder"
                            ShowHeader="False" PlaySourceTag="FolderSongsView"
                            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.HasSongs), Mode=OneWay}" />
                        <StackPanel Grid.Row="1" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="360"
                            Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.IsEmpty), Mode=OneWay}">
                            <FontIcon Glyph="&#xE8D6;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyTitle}" FontSize="18" TextAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyHint}" TextWrapping="Wrap" TextAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Command="{x:Bind ViewModel.MusicBrowseViewModel.EmptyAddFolderCommand}" HorizontalAlignment="Center"
                                Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.ShowAddFolder), Mode=OneWay}">
                                <TextBlock x:Uid="AddFolder" />
                            </Button>
                        </StackPanel>
                        <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="32" Height="32" />
                        <InfoBar Grid.Row="1" VerticalAlignment="Top" IsOpen="{x:Bind HasText(ViewModel.Error), Mode=OneWay}"
                            IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.Error, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button Command="{x:Bind ViewModel.RetryCommand}" AutomationProperties.Name="{x:Bind ViewModel.RetryLabel}">
                                    <FontIcon Glyph="&#xE72C;" />
                                </Button>
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </Grid>
                </Grid>
            </Grid>
        </ContentControl>
        <ContentControl x:Name="MusicDetailsOverlay" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
            Visibility="Collapsed" IsTabStop="False" TabFocusNavigation="Cycle" />
    </Grid>
</Page>
