<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.FolderBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Style/GroupStyleHeader.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="0">
        <SemanticZoom>
            <!--  详细视图 (ZoomedInView)  -->
            <SemanticZoom.ZoomedInView>
                <GridView
                    x:Name="FolderGridView"
                    Margin="10,0,0,0"
                    IsItemClickEnabled="True"
                    IsRightTapEnabled="True"
                    ItemClick="FolderGridView_ItemClick"
                    ItemsSource="{Binding ViewModel.GroupedMusicViewSource.View, Mode=OneWay}"
                    RightTapped="Folder_RightTapped"
                    VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <GridView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="10,0,5,5"
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Text="{Binding Key}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <GroupStyle.HeaderContainerStyle>
                                <StaticResource ResourceKey="NoBorderGridViewHeaderItemStyle" />
                            </GroupStyle.HeaderContainerStyle>
                        </GroupStyle>
                    </GridView.GroupStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Row="0" Visibility="Collapsed">
                                    <ProgressRing
                                        Width="50"
                                        Height="50"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsActive="True" />
                                </Grid>
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Grid Width="150" Height="150">
                                        <!--  图片在下层  -->
                                        <Border
                                            Grid.Row="0"
                                            Width="150"
                                            Height="150"
                                            Margin="0,0,0,0"
                                            Padding="0"
                                            CornerRadius="10">
                                            <Grid>
                                                <Grid
                                                    Width="150"
                                                    Height="150"
                                                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                                    Canvas.ZIndex="0">
                                                    <FontIcon
                                                        Canvas.ZIndex="0"
                                                        FontSize="50"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xf12b;" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <!--  图标位于右下角  -->
                                        <FontIcon
                                            x:Name="IsExistOnDeviceIcon"
                                            Margin="0,0,5,5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            FontSize="16"
                                            Glyph="{Binding IsExistOnDevice, Mode=OneWay, Converter={StaticResource IsExistOnDeviceConverter}}" />
                                    </Grid>

                                    <TextBlock
                                        Width="150"
                                        Height="60"
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding LastLevelFolderPath}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </SemanticZoom.ZoomedInView>

            <!--  概览视图 (ZoomedOutView)  -->
            <SemanticZoom.ZoomedOutView>
                <GridView
                    x:Name="ZoomedOutGridView"
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsItemClickEnabled="True"
                    ItemsSource="{Binding ViewModel.GroupedMusicViewSource.View.CollectionGroups, Mode=OneWay}"
                    ScrollViewer.IsHorizontalScrollChainingEnabled="False"
                    ScrollViewer.IsVerticalScrollChainingEnabled="False"
                    ScrollViewer.ZoomMode="Disabled">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="32"
                                Text="{Binding Group.Key}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </SemanticZoom.ZoomedOutView>
        </SemanticZoom>
