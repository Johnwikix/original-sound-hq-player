<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIMusicPlayer.View.MusicBrowsePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    TabIndex="0"
    xmlns:converters="using:WinUIMusicPlayer.Converters">
    <Page.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </Page.Resources>
    <Grid Margin="0 32 0 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10 0 0 0">
            <Button x:Name="SongButton" 
                    Click="NavigationButton_Click" 
                    Tag="Song" 
                    BorderThickness="0" 
                    BorderBrush="Transparent" 
                    FontSize="20"
                    Background="Transparent" >歌曲</Button>
            <Button x:Name="AlbumButton" 
                    Click="NavigationButton_Click" 
                    Tag="Album" BorderThickness="0" 
                    BorderBrush="Transparent" 
                    FontSize="20"
                    Background="Transparent" >专辑</Button>
            <Button x:Name="ArtistButton" 
                    Click="NavigationButton_Click" 
                    Tag="Artist" 
                    BorderThickness="0" 
                    BorderBrush="Transparent" 
                    FontSize="20"
                    Background="Transparent" >艺术家</Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="0" Margin="10">
            <TextBox x:Name="SearchTextBox" PlaceholderText="搜索音乐" Width="200" Margin="0 0 10 0" TextChanged="SearchTextBox_TextChanged"/>
            <Button Click="SearchButton_Click" BorderThickness="0" BorderBrush="Transparent" Background="Transparent">
                <FontIcon Glyph="&#xe721;"/>
            </Button>
        </StackPanel>
        <Frame x:Name="ContentFrame" Grid.Row="1" Margin="10"/>
        <!-- 底部控制区域 -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 进度条和播放时间 -->
                <RowDefinition Height="Auto"/>
                <!-- 封面、标题、作者、播放模式、播放按钮、音量 -->
            </Grid.RowDefinitions>

            <!-- 进度条和播放时间 -->
            <Grid Grid.Row="0" Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="ProgressSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Margin="0"
                        ValueChanged="ProgressSlider_ValueChanged"
                        Grid.Column="0"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="PlayTimeTextBlock" Grid.Column="1" Margin="10 0 0 0" VerticalAlignment="Center"/>
            </Grid>

            <!-- 封面、标题、作者组件 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                <Image x:Name="AlbumCoverImage" Width="80" Height="80" Margin="10"/>
                <Grid Width="Auto" Height="80">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>                    
                    <TextBlock Grid.Row="0" x:Name="MusicTitleTextBlock" FontSize="18" Margin="10,0,10,0"/>
                    <TextBlock Grid.Row="1" x:Name="MusicAuthorTextBlock" FontSize="12" Margin="10,0,10,0" VerticalAlignment="Center"/>
                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock  Grid.Column="0" x:Name="MusicInfoTextBlock" FontSize="12" Margin="10,0,10,0"/>
                        <Image x:Name="HRImage" Height="10" Grid.Column="1" ></Image>
                    </Grid>                    
                </Grid>
            </StackPanel>

            <!-- 播放模式、播放按钮 -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="FastBackwardButton" Click="FastBackwardButton_Click" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                    Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xeb9e;" FontSize="18"/>
                </Button>                
                
                <Button x:Name="LastMusicButton" Click="LastMusicButton_Click" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xe892;" FontSize="26"/>
                </Button>

                <!-- 播放按钮 -->
                <Button x:Name="PlayPauseButton" Click="PlayButton_Click" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE768;" Width="50" Height="50" FontSize="36"/>
                </Button>

                <Button x:Name="NextMusicButton" Click="NextMusicButton_Click" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xe893;" FontSize="26"/>
                </Button>

                <Button x:Name="FastForwardButton" Click="FastForwardButton_Click" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                    Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xeb9d;" FontSize="18"/>
                </Button>


            </Grid>
            <StackPanel Grid.Row="1" HorizontalAlignment="Right"  Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 0">
                <!-- 播放模式按钮 -->
                <Button x:Name="PlayModeButton" Click="PlayModeButton_Click" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <FontIcon x:Name="PlayModeIcon" Glyph="&#xe8ee;"/>
                </Button>
                <FontIcon x:Name="VolumeSliderIcon" VerticalAlignment="Center" Glyph="&#xe995;" Margin="0,0,10,0" Grid.Column="0"/>
                    <Slider
                    x:Name="VolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Width="100"
                    ValueChanged="VolumeSlider_ValueChanged"
                    HorizontalAlignment="Right"/>                
            </StackPanel>
        </Grid>
    </Grid>
</Page>