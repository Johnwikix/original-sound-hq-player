<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIMusicPlayer.View.MusicBrowsePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    mc:Ignorable="d"
    IsTabStop="True"
    TabIndex="0"
    xmlns:converters="using:WinUIMusicPlayer.Converters">
    <Page.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:BoolToFontSizeConverter x:Key="BoolToFontSizeConverter"/>
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:FavouriteIconConverter x:Key="FavouriteIconConverter"/>
        <converters:PlayModeToIconConverter x:Key="PlayModeToIconConverter"/>
        <converters:VolumeToIconConverter x:Key="VolumeToIconConverter"/>
        <converters:PlayStatusToIconConverter x:Key="PlayStatusToIconConverter"/>
        <converters:MusicStatusToHRimgConverter x:Key="MusicStatusToHRimgConverter"/>
    </Page.Resources>
    <Grid Margin="0 32 0 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TopPanel" Grid.Row="0" Visibility="Visible">            
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" 
                        Tag="Back" 
                        BorderThickness="0" 
                        BorderBrush="Transparent" 
                        FontSize="14"
                        Margin="20 0 5 0"
                        Background="Transparent" 
                        Click="BackButton_Click"
                    >
                    <FontIcon Glyph="&#xe830;" FontSize="14"/>
                </Button>
                <SelectorBar x:Name="selectPage" SelectionChanged="SelectPage_SelectionChanged">
                    <SelectorBarItem x:Name="Song" Tag="song" x:Uid="SongTab" FontSize="20" />
                    <SelectorBarItem x:Name="Album" Tag="album" x:Uid="AlbumTab" FontSize="20"/>
                    <SelectorBarItem x:Name="Artist" Tag="artist" x:Uid="ArtistTab" FontSize="20"/>
                    <SelectorBarItem x:Name="Folder" Tag="folder" x:Uid="FolderTab" FontSize="20"/>
                    <SelectorBarItem x:Name="Favourite" Tag="favourite" x:Uid="FavouriteTab" FontSize="20"/>
                    <SelectorBarItem x:Name="PlayList" Tag="playList" x:Uid="PlaylistTab" FontSize="20"/>
                </SelectorBar>
                <Button x:Name="PlayListAddButton" 
                     Click="AddPlayList_Click" 
                     Tag="PlayListAdd"
                     BorderThickness="0" 
                     BorderBrush="Transparent" 
                     FontSize="20"
                     Background="Transparent" >
                    <FontIcon Glyph="&#xe948;"></FontIcon>
                </Button>
            </StackPanel>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
                <TextBlock x:Uid="Transmitting" Visibility="Collapsed" HorizontalAlignment="Center" FontSize="15" VerticalAlignment="Center" Margin="5 0 5 0"/>
                <ProgressRing x:Name="ProcessingRing" Visibility="Collapsed" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20"/>
                <ComboBox x:Name="UsbDeviceCombox"  
                          Visibility="Collapsed"
                          FontSize="12"
                          VerticalAlignment="Center"
                          SelectionChanged="UsbDeviceCombox_SelectionChanged"
                          x:Uid="USBDevice"
                          Margin="10 0 10 0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="model:UsbStorageDevice">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Bind Path}" Margin="0,0,5,0"/>
                                <TextBlock Text="{x:Bind FreeSpaceInGB}" />
                                <TextBlock Text=" GB" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Uid="SortOrder" FontSize="14" Margin="10 0 10 0" VerticalAlignment="Center"/>
                <ComboBox x:Name="SortByComboBox"  
                        FontSize="12"
                        VerticalAlignment="Center"
                        SelectedIndex="0"
                        SelectionChanged="SortByComboBox_SelectionChanged"
                        Width="120" Margin="0 0 20 0">
                    <ComboBoxItem FontSize="12" x:Uid="SortOrderDefault" Tag="DefaultOrder"/>
                    <ComboBoxItem FontSize="12" x:Uid="SortOrderA_Z" Tag="A-Z"/>
                    <ComboBoxItem FontSize="12" x:Uid="SortOrderArtist" Tag="Artist"/>
                    <ComboBoxItem FontSize="12" x:Uid="SortOrderAlbum" Tag="Album"/>                    
                </ComboBox>
                <TextBox x:Name="SearchTextBox" x:Uid="SearchMusic" Width="200" Margin="0 0 10 0" TextChanged="SearchTextBox_TextChanged"/>
            </StackPanel>
        </Grid>
        <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" Grid.Row="1" Margin="10" Visibility="Visible"/>
        <Grid x:Name="PlayingDetail" Grid.Row="1" Visibility="Collapsed">
            <!-- Define transitions -->
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="50" FromVerticalOffset="0" />
                </TransitionCollection>
            </Grid.Transitions>
            <!-- 定义列和行 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 返回按钮 -->
            <StackPanel  Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="CancelPlayingDetailButton" Click="CancelPlayingDetailButton_Click"  Margin="20 10 10 10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent">
                    <FontIcon Glyph="&#xE70D;" ></FontIcon>
                    <Button.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="-20" />
                        </TransitionCollection>
                    </Button.Transitions>
                </Button>
                <Button Click="FullScreenButton_Click" Margin="0" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                    <FontIcon x:Name="FullScreenIcon"  VerticalAlignment="Center" Glyph="&#xe740;" Margin="0" Grid.Column="0"/>
                </Button>
            </StackPanel>            
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 专辑封面 -->
                <Border Grid.Row="0" CornerRadius="10" Margin="50 10 10 10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="PlayingDetailAlbumCoverImage" Source="{Binding ViewModel.MusicDetailCover,Mode=OneWay}" />
                </Border>
                <canvas:CanvasControl
                    Margin="50 10 10 10"
                    x:Name="SpectrumCanvas"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 右侧信息面板 -->
                <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10 10 50 10" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="50" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </StackPanel.Transitions>
                    <RichTextBlock x:Name="PlayingDetailTitleTextBlock" helper:RichTextBlockHelper.Text="{x:Bind ViewModel.CurrentPlayingMusic.Title, Mode=OneWay}" Margin="5 0 5 5" FontSize="36" FontWeight="Bold" TextWrapping="WrapWholeWords">
                        <RichTextBlock.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                            </TransitionCollection>
                        </RichTextBlock.Transitions>
                    </RichTextBlock>
                    <RichTextBlock x:Name="PlayingDetailAlbumTextBlock" helper:RichTextBlockHelper.Text="{x:Bind ViewModel.CurrentPlayingMusic.Album, Mode=OneWay}" Margin="5" FontSize="22" TextWrapping="WrapWholeWords">
                        <RichTextBlock.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                            </TransitionCollection>
                        </RichTextBlock.Transitions>
                    </RichTextBlock>
                    <RichTextBlock x:Name="PlayingDetailArtistTextBlock" helper:RichTextBlockHelper.Text="{x:Bind ViewModel.CurrentPlayingMusic.Author, Mode=OneWay}" Margin="5" FontSize="22" TextWrapping="WrapWholeWords">
                        <RichTextBlock.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                            </TransitionCollection>
                        </RichTextBlock.Transitions>
                    </RichTextBlock>
                    <Grid Margin="5,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="PlayingDetailMusicInfoTextBlock" Text="{Binding ViewModel.MusicInfo,Mode=OneWay}" FontSize="15" Margin="0,0,10,0">
                            <TextBlock.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                                </TransitionCollection>
                            </TextBlock.Transitions>
                        </TextBlock>
                        <Image x:Name="PlayingDetailHRImage"  Source="{Binding ViewModel.CurrentPlayingMusic,Converter={StaticResource MusicStatusToHRimgConverter},Mode=OneWay}"  Height="13" Grid.Column="1">
                            <Image.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                                </TransitionCollection>
                            </Image.Transitions>
                        </Image>
                    </Grid>
                </StackPanel>
                <!-- 添加歌词显示列表 -->
                <ListView x:Name="LyricsListView" 
                        Grid.Row="1"
                        Margin="15,20,5,10" 
                        VerticalAlignment="Stretch"
                        IsItemClickEnabled="False"
                        SelectionMode="None"
                        ItemsSource="{Binding ViewModel.UILyrics,Mode=TwoWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:LyricLine">
                            <TextBlock Text="{x:Bind Text}" 
                                TextWrapping="Wrap"
                                Margin="0,8,0,8"                               
                                FontSize="{x:Bind IsCurrent,Mode=OneWay, Converter={StaticResource BoolToFontSizeConverter}}"
                                FontWeight="{x:Bind IsCurrent, Mode=OneWay,Converter={StaticResource BoolToFontWeightConverter}}"
                                Opacity="{x:Bind IsCurrent,Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                                <TextBlock.Transitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                                    </TransitionCollection>
                                </TextBlock.Transitions>
                            </TextBlock>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        <!-- 底部控制区域 -->
        <Grid Grid.Row="2" Margin="10,0,10,10" Height="150">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 进度条和播放时间 -->
            <Grid Grid.Row="0" Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="ProgressSlider"
                        Minimum="0"
                        Maximum="{Binding ViewModel.ProgressSliderMax,Mode=TwoWay}"
                        Margin="0"
                        Value="{Binding ViewModel.ProgressSlider,Mode=TwoWay}"
                        PointerEntered="ProgressSlider_PointerEntered"
                        PointerExited="ProgressSlider_PointerExited"
                        Grid.Column="0"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="PlayTimeTextBlock" Text="{Binding ViewModel.PlayTimeText,Mode=TwoWay}" Grid.Column="1" Margin="10 0 0 0" VerticalAlignment="Center"/>
            </Grid>

            <!-- 封面、标题、作者组件 -->
            <StackPanel x:Name="AlbumCoverAuthorTitleModel" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0" Visibility="Visible">
                <StackPanel.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition/>
                    </TransitionCollection>
                </StackPanel.Transitions>
                <Image x:Name="AlbumCoverImage" Source="{Binding ViewModel.MusicDetailCover ,Mode=OneWay}"  Width="100" Height="100" Margin="10" Tapped="AlbumCoverImage_Tapped"/>
                <Grid Width="Auto" Height="100" MaxWidth="300">
                    <Grid.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </Grid.Transitions>
                    <!-- Rest of your grid content remains the same -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" 
                   x:Name="MusicTitleTextBlock" 
                   TextWrapping="WrapWholeWords" 
                   TextTrimming="WordEllipsis" 
                   Text="{Binding ViewModel.CurrentPlayingMusic.Title,Mode=OneWay}"
                   FontWeight="Bold" 
                   MaxHeight="50"
                   FontSize="18" 
                   Margin="10,0,10,0"/>
                    <TextBlock Grid.Row="1" x:Name="MusicAlbumTextBlock" Text="{Binding ViewModel.CurrentPlayingMusic.Album,Mode=OneWay}" TextTrimming="WordEllipsis" FontSize="12" Tapped="AlbumTextBlock_Tapped" Margin="10,0,10,0" VerticalAlignment="Bottom" />
                    <TextBlock Grid.Row="2" x:Name="MusicAuthorTextBlock" Text="{Binding ViewModel.CurrentPlayingMusic.Author,Mode=OneWay}" TextTrimming="WordEllipsis" FontSize="12" Tapped="AuthorTextBlock_Tapped" Margin="10,0,10,0" VerticalAlignment="Center" />
                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="MusicInfoTextBlock" Text="{Binding ViewModel.MusicInfo,Mode=OneWay}" FontSize="12" Margin="10,0,10,0"/>
                        <Image x:Name="HRImage" Source="{Binding ViewModel.CurrentPlayingMusic,Converter={StaticResource MusicStatusToHRimgConverter},Mode=OneWay}" Height="10" Grid.Column="1"></Image>
                    </Grid>
                </Grid>
            </StackPanel>

            <!-- 播放模式、播放按钮 -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="PlayBarFavouriteButton" Command="{Binding ViewModel.PlayBarFavouriteButtonChangedCommand,Mode=OneWay}" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                    Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="{x:Bind ViewModel.CurrentPlayingMusic.IsFavorite,Mode=TwoWay,Converter={StaticResource FavouriteIconConverter}}" Foreground="Red"/>
                </Button>

                <Button x:Name="FastBackwardButton" Command="{Binding ViewModel.FastBackwardButtonCommand,Mode=OneWay}" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                    Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xeb9e;" FontSize="18"/>
                </Button>

                <Button x:Name="LastMusicButton" Command="{Binding ViewModel.LastMusicButtonChangedCommand,Mode=OneWay}" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xe892;" FontSize="26"/>
                </Button>

                <!-- 播放按钮 -->
                <Button x:Name="PlayPauseButton" Command="{Binding ViewModel.PlayButtonChangedCommand,Mode=OneWay}" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="{Binding ViewModel.IsPlaying,Converter={StaticResource PlayStatusToIconConverter},Mode=OneWay}" Width="50" Height="50" FontSize="36"/>
                </Button>

                <Button x:Name="NextMusicButton" Command="{Binding ViewModel.NextMusicButtonChangedCommand,Mode=OneWay}" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xe893;" FontSize="26"/>
                </Button>

                <Button x:Name="FastForwardButton" Command="{Binding ViewModel.FastForwardButtonCommand,Mode=OneWay}" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                    Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xeb9d;" FontSize="18"/>
                </Button>

                <Button x:Name="StopButton" Command="{Binding ViewModel.StopButtonChangedCommand,Mode=OneWay}" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xe71a;" FontSize="18"/>
                </Button>


            </Grid>
            <StackPanel Grid.Row="1" HorizontalAlignment="Right"  Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 0">
                <Button x:Name="EqualizerButton" Click="EqualizerButton_Click" Margin="10 0 0 0" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <FontIcon x:Name="EqualizerIcon" Glyph="&#xE9E9;"/>
                </Button>
                <Button x:Name="CurrentPlayListButton" Click="CurrentPlayListButton_Click" Margin="10 0 0 0" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                    <FontIcon x:Name="CurrentPlayListIcon" Glyph="&#xE90B;"/>
                </Button>
                <TeachingTip x:Name="CurrentPlayListTeachingTip"                    
                    Target="{x:Bind CurrentPlayListButton}"
                    IsLightDismissEnabled="True"
                     >
                    <TeachingTip.Content>
                        <ListView x:Name="CurrentPlayListView" 
                                    DoubleTapped="CurrentPlayListView_DoubleTapped" 
                                    MaxHeight="400"
                                    ItemsSource="{Binding ViewModel.CurrentPlayingList,Mode=TwoWay}"
                                    Width="290"
                                    >
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:Music">
                                    <TextBlock Text="{x:Bind Title,Mode=OneWay}" Grid.Column="1" Margin="5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </TeachingTip.Content>
                </TeachingTip>
                <!-- 播放模式按钮 -->
                <Button x:Name="PlayModeButton" Command="{Binding ViewModel.PlayModeChangedCommand,Mode=OneWay}" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <FontIcon x:Name="PlayModeIcon" Glyph="{Binding ViewModel.CurrentPlayMode,Converter={StaticResource PlayModeToIconConverter},Mode=TwoWay}"/>
                </Button>
                <Button Command="{Binding ViewModel.VolumeSliderIconButtonChangedCommand,Mode=OneWay}" Margin="0" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <FontIcon x:Name="VolumeSliderIcon"  VerticalAlignment="Center" Glyph="{Binding ViewModel.Volume,Converter={StaticResource VolumeToIconConverter},Mode=OneWay}" Margin="0" Grid.Column="0"/>
                </Button>                
                <Slider
                    x:Name="VolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding ViewModel.Volume,Mode=TwoWay}"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Width="100"
                    PointerEntered="VolumeSlider_PointerEntered"
                    PointerExited="VolumeSlider_PointerExited"
                    PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                    HorizontalAlignment="Right"/>
            </StackPanel>
            
        </Grid>
    </Grid>
</Page>