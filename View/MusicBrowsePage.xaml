<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.MusicBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    IsTabStop="True"
    NavigationCacheMode="Enabled"
    TabIndex="0"
    mc:Ignorable="d">
    <Grid Margin="0">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="100" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.Background>
            <ImageBrush
                x:Name="ContentGridBackground"
                ImageSource="{Binding ViewModel.MusicDetailCover, Mode=OneWay}"
                Opacity="{Binding ViewModel.IsAcrylicBrushOpacity, Converter={StaticResource BoolToBackGroundOpacityConverter}, Mode=OneWay}"
                Stretch="UniformToFill" />
        </Grid.Background>
        <Grid x:Name="AcrylicBrushBackground" Margin="0">
            <Grid Margin="{Binding ViewModel.IsInPlayingDetailMode, Converter={StaticResource BoolToThicknessConverter}, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    x:Name="TopPanel"
                    Grid.Row="0"
                    Margin="5,0,0,0"
                    Visibility="Visible">
                    <StackPanel Orientation="Horizontal">
                        <SelectorBar x:Name="selectPage" SelectionChanged="SelectPage_SelectionChanged">
                            <SelectorBarItem
                                x:Name="Song"
                                x:Uid="SongTab"
                                FontSize="20"
                                Tag="song" />
                            <SelectorBarItem
                                x:Name="Album"
                                x:Uid="AlbumTab"
                                FontSize="20"
                                Tag="album" />
                            <SelectorBarItem
                                x:Name="Artist"
                                x:Uid="ArtistTab"
                                FontSize="20"
                                Tag="artist" />
                            <SelectorBarItem
                                x:Name="Folder"
                                x:Uid="FolderTab"
                                FontSize="20"
                                Tag="folder" />
                            <SelectorBarItem
                                x:Name="Favourite"
                                x:Uid="FavouriteTab"
                                FontSize="20"
                                Tag="favourite" />
                            <SelectorBarItem
                                x:Name="PlayList"
                                x:Uid="PlaylistTab"
                                FontSize="20"
                                Tag="playList" />
                        </SelectorBar>
                        <Button
                            x:Name="PlayListAddButton"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="AddPlayList_Click"
                            FontSize="20"
                            Tag="PlayListAdd">
                            <FontIcon Margin="0,2,0,0" VerticalAlignment="Bottom" Glyph="&#xe948;" />
                        </Button>
                    </StackPanel>


                    <StackPanel
                        Margin="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Uid="Transmitting"
                            Margin="5,0,5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Visibility="Collapsed" />
                        <ProgressRing
                            x:Name="ProcessingRing"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="True"
                            Visibility="{Binding ViewModel.ProcessRingVisibility, Mode=OneWay}" />
                        <ComboBox
                            x:Name="UsbDeviceCombox"
                            x:Uid="USBDevice"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            ItemsSource="{Binding ViewModel.UsbStorageDevices, Mode=OneWay}"
                            SelectedIndex="{Binding ViewModel.UsbSelectedIndex, Mode=TwoWay}"
                            SelectionChanged="UsbDeviceCombox_SelectionChanged"
                            Visibility="{Binding ViewModel.UsbDeviceVisibility, Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="model:UsbStorageDevice">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,5,0" Text="{x:Bind Path}" />
                                        <TextBlock Text="{x:Bind FreeSpaceInGB}" />
                                        <TextBlock Text=" GB" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Margin="0" Orientation="Horizontal" Visibility="{Binding ViewModel.PageType, Converter={StaticResource PageTypeStringToVisibleConverter}, Mode=OneWay}">
                            <TextBlock
                                x:Uid="SortOrder"
                                Margin="10,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="14" />
                            <ComboBox
                                x:Name="SortByComboBox"
                                Width="120"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                SelectedIndex="0"
                                SelectionChanged="SortByComboBox_SelectionChanged">
                                <ComboBoxItem x:Uid="SortOrderDefault" FontSize="12" Tag="DefaultOrder" />
                                <ComboBoxItem x:Uid="SortOrderA_Z" FontSize="12" Tag="A-Z" />
                                <ComboBoxItem x:Uid="SortOrderArtist" FontSize="12" Tag="Artist" />
                                <ComboBoxItem x:Uid="SortOrderAlbum" FontSize="12" Tag="Album" />
                            </ComboBox>
                        </StackPanel>
                        <TextBox
                            x:Name="SearchTextBox"
                            x:Uid="SearchMusic"
                            Width="200"
                            Margin="0,0,10,0"
                            TextChanged="SearchTextBox_TextChanged" />
                    </StackPanel>
                </Grid>
                <InfoBar
                    x:Name="InfoBar"
                    Title="{Binding ViewModel.InfoBarTitle, Mode=OneWay}"
                    Grid.Row="1"
                    IsOpen="{Binding ViewModel.InfoBarIsOpen, Mode=TwoWay}"
                    Message="{Binding ViewModel.InfoBarMessage, Mode=OneWay}"
                    Severity="Informational" />
                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="2"
                    Margin="10"
                    IsNavigationStackEnabled="False"
                    Visibility="Visible" />
                <!--  播放详情  -->
                <Grid
                    x:Name="PlayingDetail"
                    Grid.Row="2"
                    Margin="0,5,0,30"
                    Visibility="Collapsed">
                    <!--  定义列和行  -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                        <Button
                            x:Name="CancelPlayingDetailButton"
                            Margin="20,10,10,10"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="CancelPlayingDetailButton_Click">
                            <FontIcon Glyph="&#xE70D;" />
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Q" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button
                            Margin="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{Binding ViewModel.FullScreenButtonChangedCommand, Mode=OneWay}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F" />
                            </Button.KeyboardAccelerators>
                            <FontIcon
                                x:Name="FullScreenIcon"
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                Glyph="{Binding ViewModel.IsFullScreen, Converter={StaticResource FullScreenIconConverter}, Mode=OneWay}" />
                        </Button>
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  专辑封面  -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Grid.Column="1"
                                Margin="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="300" Height="300">
                                        <Border
                                            x:Name="PlayingDetailAlbumCoverImageGrid"
                                            Grid.Row="0"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="16">
                                            <Grid>
                                                <Image Canvas.ZIndex="1" Source="{Binding ViewModel.MusicDetailCover, Mode=OneWay}" />
                                                <Grid
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                                    Canvas.ZIndex="0"
                                                    Visibility="{Binding ViewModel.MusicDetailCover, Converter={StaticResource IsCoverExistToVisibleConverter}, Mode=OneWay}">
                                                    <Viewbox Stretch="Uniform">
                                                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                                                            <!--  图标层  -->
                                                            <FontIcon
                                                                Width="200"
                                                                Height="200"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Canvas.ZIndex="1"
                                                                FontSize="100"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Glyph="&#xE93C;" />
                                                        </Border>
                                                    </Viewbox>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Viewbox>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="MusicInfoPanel" Grid.Column="0" Margin="5">
                                        <RichTextBlock
                                            x:Name="PlayingDetailTitleTextBlock"
                                            Margin="1"
                                            HorizontalAlignment="Left"
                                            helper:RichTextBlockHelper.Text="{x:Bind ViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                                            FontSize="22"
                                            FontWeight="Bold"
                                            TextAlignment="Left"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <RichTextBlock
                                            x:Name="PlayingDetailAlbumTextBlock"
                                            Margin="1"
                                            HorizontalAlignment="Left"
                                            helper:RichTextBlockHelper.Text="{x:Bind ViewModel.CurrentPlayingMusic.Album, Mode=OneWay}"
                                            FontSize="16"
                                            TextAlignment="Left"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <RichTextBlock
                                            x:Name="PlayingDetailArtistTextBlock"
                                            Margin="1"
                                            HorizontalAlignment="Left"
                                            helper:RichTextBlockHelper.Text="{x:Bind ViewModel.CurrentPlayingMusic.Author, Mode=OneWay}"
                                            FontSize="16"
                                            TextAlignment="Left"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <Grid Margin="1" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="PlayingDetailMusicInfoTextBlock"
                                                Grid.Column="0"
                                                Margin="0,0,10,0"
                                                FontSize="12"
                                                Text="{Binding ViewModel.MusicInfo, Mode=OneWay}" />
                                            <Image
                                                x:Name="PlayingDetailHRImage"
                                                Grid.Column="1"
                                                Height="10"
                                                Source="{Binding ViewModel.CurrentPlayingMusic, Converter={StaticResource MusicStatusToHRimgConverter}, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button
                                            x:Name="PlayBarFavouriteButtonPlayingDetail"
                                            Grid.Row="0"
                                            Margin="0,7,0,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ViewModel.PlayBarFavouriteButtonChangedCommand, Mode=OneWay}">
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="L" />
                                            </Button.KeyboardAccelerators>
                                            <FontIcon Foreground="Red" Glyph="{x:Bind ViewModel.CurrentPlayingMusic.IsFavorite, Mode=TwoWay, Converter={StaticResource FavouriteIconConverter}}" />
                                        </Button>
                                        <TextBlock
                                            x:Name="PlayTimeTextBlockPlayingDetail"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="10,0,0,5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Text="{Binding ViewModel.PlayTimeText, Mode=TwoWay}" />
                                    </Grid>
                                </Grid>
                                <!--  控制面板  -->
                                <Grid x:Name="PlayingDetailControlBar" Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Slider
                                        x:Name="ProgressSliderPlayingDetail"
                                        Grid.Row="0"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Maximum="{Binding ViewModel.ProgressSliderMax, Mode=TwoWay}"
                                        Minimum="0"
                                        Opacity="0.5"
                                        PointerEntered="ProgressSlider_PointerEntered"
                                        PointerExited="ProgressSlider_PointerExited"
                                        Value="{Binding ViewModel.ProgressSlider, Mode=TwoWay}" />
                                    <Grid
                                        Grid.Row="1"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Button
                                            x:Name="EqualizerButtonPlayingDetail"
                                            Grid.Column="0"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Click="EqualizerButton_Click">
                                            <FontIcon x:Name="EqualizerIconPlayingDetail" Glyph="&#xE9E9;" />
                                        </Button>
                                        <Button
                                            x:Name="CurrentPlayListButtonPlayingDetail"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Click="CurrentPlayListButtonPlayingDetail_Click">
                                            <FontIcon x:Name="CurrentPlayListIconPlayingDetail" Glyph="&#xE90B;" />
                                        </Button>
                                        <TeachingTip x:Name="CurrentPlayListTeachingTipPlayingDetail" IsLightDismissEnabled="True" Target="{x:Bind CurrentPlayListButtonPlayingDetail}">
                                            <TeachingTip.Content>
                                                <ListView
                                                    x:Name="CurrentPlayListViewPlayingDetail"
                                                    Width="290"
                                                    MaxHeight="400"
                                                    DoubleTapped="CurrentPlayListViewPlayingDetail_DoubleTapped"
                                                    ItemsSource="{Binding ViewModel.CurrentPlayingList, Mode=OneWay}">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="model:Music">
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Margin="5"
                                                                VerticalAlignment="Center"
                                                                Text="{x:Bind Title, Mode=OneWay}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </TeachingTip.Content>
                                        </TeachingTip>

                                        <Button
                                            x:Name="LastMusicButtonPlayingDetail"
                                            Grid.Column="2"
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ViewModel.LastMusicButtonChangedCommand, Mode=OneWay}">
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="Up" />
                                            </Button.KeyboardAccelerators>
                                            <FontIcon FontSize="22" Glyph="&#xe892;" />
                                        </Button>

                                        <!--  播放按钮  -->
                                        <Button
                                            x:Name="PlayPauseButtonPlayingDetail"
                                            Grid.Column="3"
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ViewModel.PlayButtonChangedCommand, Mode=OneWay}"
                                            Style="{StaticResource CircularHoverButtonStyle}">
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="Space" />
                                            </Button.KeyboardAccelerators>
                                            <FontIcon
                                                Width="50"
                                                Height="50"
                                                FontSize="32"
                                                Glyph="{Binding ViewModel.IsPlaying, Converter={StaticResource PlayStatusToIconConverter}, Mode=OneWay}" />
                                        </Button>

                                        <Button
                                            x:Name="NextMusicButtonPlayingDetail"
                                            Grid.Column="4"
                                            Margin="5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ViewModel.NextMusicButtonChangedCommand, Mode=OneWay}">
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="Down" />
                                            </Button.KeyboardAccelerators>
                                            <FontIcon FontSize="22" Glyph="&#xe893;" />
                                        </Button>

                                        <!--  播放模式按钮  -->
                                        <Button
                                            x:Name="PlayModeButtonPlayingDetail"
                                            Grid.Column="5"
                                            Margin="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ViewModel.PlayModeChangedCommand, Mode=OneWay}">
                                            <FontIcon x:Name="PlayModeIconPlayingDetail" Glyph="{Binding ViewModel.CurrentPlayMode, Converter={StaticResource PlayModeToIconConverter}, Mode=TwoWay}" />
                                        </Button>

                                        <Button
                                            x:Name="VolumePlayingDetailBtn"
                                            Grid.Column="6"
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0">
                                            <FontIcon
                                                x:Name="VolumeSliderIconPlayingDetail"
                                                Grid.Column="0"
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                Glyph="{Binding ViewModel.Volume, Converter={StaticResource VolumeToIconConverter}, Mode=OneWay}" />
                                            <Button.Flyout>
                                                <Flyout x:Name="VolumeFlyout" Placement="Right">
                                                    <Slider
                                                        x:Name="VolumeSliderPlayingDetail"
                                                        Width="100"
                                                        VerticalAlignment="Center"
                                                        Maximum="100"
                                                        Minimum="0"
                                                        Opacity="0.5"
                                                        PointerEntered="VolumeSlider_PointerEntered"
                                                        PointerExited="VolumeSlider_PointerExited"
                                                        PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                                                        Value="{Binding ViewModel.Volume, Mode=TwoWay}" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <Grid
                                        Grid.Row="2"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  添加歌词显示列表  -->
                        <ScrollViewer
                            x:Name="LyricViewer"
                            Grid.Row="1"
                            Margin="10,20,20,30"
                            VerticalScrollBarVisibility="Hidden">
                            <StackPanel>
                                <StackPanel Height="1080" />
                                <ListView
                                    x:Name="LyricsListView"
                                    Margin="0"
                                    VerticalAlignment="Stretch"
                                    IsItemClickEnabled="True"
                                    ItemClick="LyricsListView_ItemClick"
                                    ItemsSource="{Binding ViewModel.UILyrics, Mode=TwoWay}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <ContentPresenter
                                                            x:Name="ContentPresenter"
                                                            Margin="{TemplateBinding Padding}"
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            Background="{TemplateBinding Background}"
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="model:LyricLine">
                                            <TextBlock
                                                x:Name="LyricsTextBlock"
                                                Margin="0,8,0,8"
                                                HorizontalAlignment="Left"
                                                FontSize="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToFontSizeConverter}}"
                                                FontWeight="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                                                Opacity="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
                                                PointerEntered="LyricsTextBlock_PointerEntered"
                                                PointerExited="LyricsTextBlock_PointerExited"
                                                SizeChanged="LyricsTextBlock_SizeChanged"
                                                Text="{x:Bind Text}"
                                                TextAlignment="Left"
                                                TextWrapping="WrapWholeWords" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Height="1080" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
                <!--  底部控制区域  -->
                <Grid
                    x:Name="BottomControlBar"
                    Grid.Row="3"
                    Height="120"
                    Margin="10,0,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  进度条和播放时间  -->
                    <Grid Grid.Row="0" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="ProgressSlider"
                            Grid.Column="0"
                            Margin="0"
                            VerticalAlignment="Center"
                            Maximum="{Binding ViewModel.ProgressSliderMax, Mode=TwoWay}"
                            Minimum="0"
                            Opacity="0.5"
                            PointerEntered="ProgressSlider_PointerEntered"
                            PointerExited="ProgressSlider_PointerExited"
                            Value="{Binding ViewModel.ProgressSlider, Mode=TwoWay}" />
                        <TextBlock
                            x:Name="PlayTimeTextBlock"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding ViewModel.PlayTimeText, Mode=TwoWay}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  封面、标题、作者组件  -->
                        <StackPanel
                            x:Name="AlbumCoverAuthorTitleModel"
                            Grid.Column="0"
                            Margin="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="Visible">
                            <Button
                                x:Name="AlbumCoverImageBtn"
                                Margin="5,0,5,0"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="AlbumCoverImage_Click"
                                CornerRadius="5"
                                Style="{StaticResource SimpleHoverButtonStyle}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Q" />
                                </Button.KeyboardAccelerators>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid x:Name="AlbumCoverImageGrid" Grid.Row="0">
                                        <Grid
                                            x:Name="AlbumCoverImage"
                                            Width="80"
                                            Height="80"
                                            Canvas.ZIndex="1">
                                            <Image
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{Binding ViewModel.MusicDetailCover, Mode=OneWay}"
                                                Stretch="UniformToFill" />
                                        </Grid>
                                        <Grid
                                            Width="80"
                                            Height="80"
                                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                            Canvas.ZIndex="0"
                                            Visibility="{Binding ViewModel.MusicDetailCover, Converter={StaticResource IsCoverExistToVisibleConverter}, Mode=OneWay}">
                                            <FontIcon
                                                Canvas.ZIndex="0"
                                                FontSize="40"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE93C;" />
                                        </Grid>
                                    </Grid>

                                    <FontIcon
                                        x:Name="AlbumCoverImageChevronUp"
                                        Grid.Row="0"
                                        Glyph="&#xE70E;"
                                        Opacity="0" />
                                </Grid>
                            </Button>
                            <Grid Width="Auto" Height="80" MaxWidth="300">
                                <!--  Rest of your grid content remains the same  -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Name="MusicTitleTextBlock"
                                    Grid.Row="0"
                                    Margin="10,0,10,0"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Text="{Binding ViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                                    TextTrimming="WordEllipsis">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="{Binding ViewModel.CurrentPlayingMusic.Title, Mode=OneWay}" VerticalOffset="10" />
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                                <TextBlock
                                    x:Name="MusicAlbumTextBlock"
                                    Grid.Row="1"
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Bottom"
                                    FontSize="12"
                                    Tapped="AlbumTextBlock_Tapped"
                                    Text="{Binding ViewModel.CurrentPlayingMusic.Album, Mode=OneWay}"
                                    TextTrimming="WordEllipsis" />
                                <TextBlock
                                    x:Name="MusicAuthorTextBlock"
                                    Grid.Row="2"
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Tapped="AuthorTextBlock_Tapped"
                                    Text="{Binding ViewModel.CurrentPlayingMusic.Author, Mode=OneWay}"
                                    TextTrimming="WordEllipsis" />
                                <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="MusicInfoTextBlock"
                                        Grid.Column="0"
                                        Margin="10,0,10,0"
                                        FontSize="12"
                                        Text="{Binding ViewModel.MusicInfo, Mode=OneWay}" />
                                    <Image
                                        x:Name="HRImage"
                                        Grid.Column="1"
                                        Height="10"
                                        Source="{Binding ViewModel.CurrentPlayingMusic, Converter={StaticResource MusicStatusToHRimgConverter}, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <!--  播放模式、播放按钮  -->
                        <Grid
                            Grid.Column="1"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button
                                x:Name="PlayBarFavouriteButton"
                                Grid.Column="0"
                                Margin="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{Binding ViewModel.PlayBarFavouriteButtonChangedCommand, Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="L" />
                                </Button.KeyboardAccelerators>
                                <FontIcon Foreground="Red" Glyph="{x:Bind ViewModel.CurrentPlayingMusic.IsFavorite, Mode=TwoWay, Converter={StaticResource FavouriteIconConverter}}" />
                            </Button>

                            <Button
                                x:Name="FastBackwardButton"
                                Grid.Column="1"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{Binding ViewModel.FastBackwardButtonCommand, Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Left" />
                                </Button.KeyboardAccelerators>
                                <FontIcon FontSize="18" Glyph="&#xeb9e;" />
                            </Button>

                            <Button
                                x:Name="LastMusicButton"
                                Grid.Column="2"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{Binding ViewModel.LastMusicButtonChangedCommand, Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Up" />
                                </Button.KeyboardAccelerators>
                                <FontIcon FontSize="22" Glyph="&#xe892;" />
                            </Button>

                            <!--  播放按钮  -->
                            <Button
                                x:Name="PlayPauseButton"
                                Grid.Column="3"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{Binding ViewModel.PlayButtonChangedCommand, Mode=OneWay}"
                                Style="{StaticResource CircularHoverButtonStyle}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Space" />
                                </Button.KeyboardAccelerators>
                                <FontIcon
                                    Width="50"
                                    Height="50"
                                    FontSize="32"
                                    Glyph="{Binding ViewModel.IsPlaying, Converter={StaticResource PlayStatusToIconConverter}, Mode=OneWay}" />
                            </Button>

                            <Button
                                x:Name="NextMusicButton"
                                Grid.Column="4"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{Binding ViewModel.NextMusicButtonChangedCommand, Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Down" />
                                </Button.KeyboardAccelerators>
                                <FontIcon FontSize="22" Glyph="&#xe893;" />
                            </Button>

                            <Button
                                x:Name="FastForwardButton"
                                Grid.Column="5"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{Binding ViewModel.FastForwardButtonCommand, Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Right" />
                                </Button.KeyboardAccelerators>
                                <FontIcon FontSize="18" Glyph="&#xeb9d;" />
                            </Button>

                            <Button
                                x:Name="StopButton"
                                Grid.Column="6"
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{Binding ViewModel.StopButtonChangedCommand, Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="End" />
                                </Button.KeyboardAccelerators>
                                <FontIcon FontSize="18" Glyph="&#xe71a;" />
                            </Button>
                        </Grid>
                        <StackPanel
                            Grid.Column="2"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                x:Name="VolumeUp"
                                Margin="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Command="{Binding ViewModel.VolumeUpChangedCommand, Mode=OneWay}"
                                IsHitTestVisible="False"
                                Opacity="0">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Add" />
                                </Button.KeyboardAccelerators>
                                <FontIcon Glyph="&#xE9E9;" />
                            </Button>
                            <Button
                                x:Name="VolumeDown"
                                Margin="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Command="{Binding ViewModel.VolumeDownChangedCommand, Mode=OneWay}"
                                IsHitTestVisible="False"
                                Opacity="0">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Subtract" />
                                </Button.KeyboardAccelerators>
                                <FontIcon Glyph="&#xE9E9;" />
                            </Button>
                            <Button
                                x:Name="EqualizerButton"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="EqualizerButton_Click">
                                <FontIcon x:Name="EqualizerIcon" Glyph="&#xE9E9;" />
                            </Button>
                            <Button
                                x:Name="CurrentPlayListButton"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="CurrentPlayListButton_Click">
                                <FontIcon x:Name="CurrentPlayListIcon" Glyph="&#xE90B;" />
                            </Button>
                            <TeachingTip x:Name="CurrentPlayListTeachingTip" IsLightDismissEnabled="True" Target="{x:Bind CurrentPlayListButton}">
                                <TeachingTip.Content>
                                    <ListView
                                        x:Name="CurrentPlayListView"
                                        Width="290"
                                        MaxHeight="400"
                                        DoubleTapped="CurrentPlayListView_DoubleTapped"
                                        ItemsSource="{Binding ViewModel.CurrentPlayingList, Mode=OneWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="model:Music">
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="5"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </TeachingTip.Content>
                            </TeachingTip>
                            <!--  播放模式按钮  -->
                            <Button
                                x:Name="PlayModeButton"
                                Margin="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{Binding ViewModel.PlayModeChangedCommand, Mode=OneWay}">
                                <FontIcon x:Name="PlayModeIcon" Glyph="{Binding ViewModel.CurrentPlayMode, Converter={StaticResource PlayModeToIconConverter}, Mode=TwoWay}" />
                            </Button>
                            <Button
                                Margin="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Command="{Binding ViewModel.VolumeSliderIconButtonChangedCommand, Mode=OneWay}">
                                <FontIcon
                                    x:Name="VolumeSliderIcon"
                                    Grid.Column="0"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Glyph="{Binding ViewModel.Volume, Converter={StaticResource VolumeToIconConverter}, Mode=OneWay}" />
                            </Button>
                            <Slider
                                x:Name="VolumeSlider"
                                Grid.Column="1"
                                Width="100"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Maximum="100"
                                Minimum="0"
                                Opacity="0.5"
                                PointerEntered="VolumeSlider_PointerEntered"
                                PointerExited="VolumeSlider_PointerExited"
                                PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                                Value="{Binding ViewModel.Volume, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>