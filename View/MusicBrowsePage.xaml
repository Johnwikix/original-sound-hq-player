<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIMusicPlayer.View.MusicBrowsePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView x:Name="MusicListView" DoubleTapped="MusicListView_DoubleTapped">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="封面" Grid.Column="0" FontWeight="Bold" Margin="10"/>
                        <TextBlock Text="标题" Grid.Column="1" FontWeight="Bold" Margin="10"/>
                        <TextBlock Text="作者" Grid.Column="2" FontWeight="Bold" Margin="10"/>
                        <TextBlock Text="专辑" Grid.Column="3" FontWeight="Bold" Margin="10"/>
                        <TextBlock Text="时长" Grid.Column="4" FontWeight="Bold" Margin="10"/>
                        <TextBlock Text="操作" Grid.Column="5" FontWeight="Bold" Margin="10"/>
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Music">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{x:Bind Cover, Converter={StaticResource ByteArrayToImageConverter}}" Width="50" Height="50" Grid.Column="0" Margin="5"/>
                        <TextBlock Text="{x:Bind Title}" Grid.Column="1" Margin="10" />
                        <TextBlock Text="{x:Bind Author}" Grid.Column="2" Margin="10" />
                        <TextBlock Text="{x:Bind Album}" Grid.Column="3" Margin="10" />
                        <TextBlock Text="{x:Bind Duration, Converter={StaticResource TimeSpanToStringConverter}}" Grid.Column="4" Margin="10"  />
                        <Button x:Name="RemoveMusicButton"  Grid.Column="5" Click="RemoveMusicButton_Click" Tag="{x:Bind Id}" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" >
                            <FontIcon Glyph="&#xecc9;"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <!-- 固定宽度用于专辑封面、歌名、作者 -->
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 专辑封面、歌名、作者组件 -->
            <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center">
                <Image x:Name="AlbumCoverImage" Width="80" Height="80" Margin="10"/>
                <StackPanel Orientation="Vertical">
                    <TextBlock Width="180" TextTrimming="None" x:Name="MusicTitleTextBlock" FontSize="16" Margin="10" TextWrapping="Wrap"/>
                    <TextBlock VerticalAlignment="Bottom" Width="180" TextTrimming="None" x:Name="MusicAuthorTextBlock" FontSize="12" Margin="10" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
            <!-- 播放进度条 -->
            <Grid Grid.Column="1" Grid.Row="0" Margin="10" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="ProgressSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Margin="0"
                        ValueChanged="ProgressSlider_ValueChanged"
                        Grid.Column="0"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="PlayTimeTextBlock" Grid.Column="1" Margin="10 0 0 0" VerticalAlignment="Center"/>
            </Grid>
            <Button x:Name="PlayModeButton" Click="PlayModeButton_Click" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <FontIcon x:Name="PlayModeIcon" Glyph="&#xe8ee;"/>
            </Button>
            <!-- 播放按钮 -->
            <Button x:Name="PlayPauseButton" Click="PlayButton_Click" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
            Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <FontIcon Glyph="&#xE768;"/>
            </Button>
            <!-- 音量组件 -->
            <Grid Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="VolumeSliderIcon" VerticalAlignment="Center" Glyph="&#xe995;" Margin="0,0,10,0" Grid.Column="0"/>
                <Slider
                    x:Name="VolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Width="100"
                    ValueChanged="VolumeSlider_ValueChanged"
                    HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Grid>
</Page>