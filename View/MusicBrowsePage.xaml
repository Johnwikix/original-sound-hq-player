<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIMusicPlayer.View.MusicBrowsePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView x:Name="MusicListView" DoubleTapped="MusicListView_DoubleTapped">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="封面" Grid.Column="0" FontWeight="Bold" Margin="10"/>
                        <TextBlock Text="标题" Grid.Column="1" FontWeight="Bold" Margin="10"/>
                        <TextBlock Text="作者" Grid.Column="2" FontWeight="Bold" Margin="10"/>
                        <TextBlock Text="专辑" Grid.Column="3" FontWeight="Bold" Margin="10"/>
                        <TextBlock Text="时长" Grid.Column="4" FontWeight="Bold" Margin="10"/>
                        <TextBlock Text="操作" Grid.Column="5" FontWeight="Bold" Margin="10"/>
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Music">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{x:Bind Cover, Converter={StaticResource ByteArrayToImageConverter}}" Width="50" Height="50" Grid.Column="0" Margin="5"/>
                        <TextBlock Text="{x:Bind Title}" Grid.Column="1" Margin="10" />
                        <TextBlock Text="{x:Bind Author}" Grid.Column="2" Margin="10" />
                        <TextBlock Text="{x:Bind Album}" Grid.Column="3" Margin="10" />
                        <TextBlock Text="{x:Bind Duration, Converter={StaticResource TimeSpanToStringConverter}}" Grid.Column="4" Margin="10"  />
                        <Button x:Name="RemoveMusicButton"  Grid.Column="5" Click="RemoveMusicButton_Click" Tag="{x:Bind Id}" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" >
                            <FontIcon Glyph="&#xecc9;"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <!-- 底部控制区域 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 进度条和播放时间 -->
                <RowDefinition Height="Auto"/>
                <!-- 封面、标题、作者、播放模式、播放按钮、音量 -->
            </Grid.RowDefinitions>

            <!-- 进度条和播放时间 -->
            <Grid Grid.Row="0" Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="ProgressSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Margin="0"
                        ValueChanged="ProgressSlider_ValueChanged"
                        Grid.Column="0"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="PlayTimeTextBlock" Grid.Column="1" Margin="10 0 0 0" VerticalAlignment="Center"/>
            </Grid>

            <!-- 封面、标题、作者组件 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 10 0 10">
                <Image x:Name="AlbumCoverImage" Width="80" Height="80" Margin="10"/>
                <StackPanel Orientation="Vertical">
                    <TextBlock TextTrimming="None" x:Name="MusicTitleTextBlock" FontSize="16" Margin="10" TextWrapping="Wrap"/>
                    <TextBlock VerticalAlignment="Bottom" TextTrimming="None" x:Name="MusicAuthorTextBlock" FontSize="12" Margin="10" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- 播放模式、播放按钮 -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 10 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>                

                <Button x:Name="LastMusicButton" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xe892;"/>
                </Button>

                <!-- 播放按钮 -->
                <Button x:Name="PlayPauseButton" Click="PlayButton_Click" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE768;" Width="50" Height="50" FontSize="36"/>
                </Button>

                <Button x:Name="NextMusicButton" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xe893;"/>
                </Button>

                
            </Grid>
            <StackPanel Grid.Row="1" HorizontalAlignment="Right"  Orientation="Horizontal" VerticalAlignment="Center" Margin="0 10 0 10">
                <!-- 音量组件 -->
                <!-- 播放模式按钮 -->
                <Button x:Name="PlayModeButton" Click="PlayModeButton_Click" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <FontIcon x:Name="PlayModeIcon" Glyph="&#xe8ee;"/>
                </Button>
                <FontIcon x:Name="VolumeSliderIcon" VerticalAlignment="Center" Glyph="&#xe995;" Margin="0,0,10,0" Grid.Column="0"/>
                    <Slider
                    x:Name="VolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Width="100"
                    ValueChanged="VolumeSlider_ValueChanged"
                    HorizontalAlignment="Right"/>                
            </StackPanel>
        </Grid>
    </Grid>
</Page>