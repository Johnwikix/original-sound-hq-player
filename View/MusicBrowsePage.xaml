<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.MusicBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    IsTabStop="True"
    NavigationCacheMode="Enabled"
    TabIndex="0"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter" />
        <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        <converters:BoolToFontSizeConverter x:Key="BoolToFontSizeConverter" />
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <converters:FavouriteIconConverter x:Key="FavouriteIconConverter" />
        <converters:PlayModeToIconConverter x:Key="PlayModeToIconConverter" />
        <converters:VolumeToIconConverter x:Key="VolumeToIconConverter" />
        <converters:PlayStatusToIconConverter x:Key="PlayStatusToIconConverter" />
        <converters:MusicStatusToHRimgConverter x:Key="MusicStatusToHRimgConverter" />
    </Page.Resources>
    <Grid Margin="0,32,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="TopPanel"
            Grid.Row="0"
            Visibility="Visible">
            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="BackButton"
                    Margin="20,0,5,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="BackButton_Click"
                    FontSize="14"
                    Tag="Back">
                    <FontIcon FontSize="14" Glyph="&#xe830;" />
                </Button>
                <SelectorBar x:Name="selectPage" SelectionChanged="SelectPage_SelectionChanged">
                    <SelectorBarItem
                        x:Name="Song"
                        x:Uid="SongTab"
                        FontSize="20"
                        Tag="song" />
                    <SelectorBarItem
                        x:Name="Album"
                        x:Uid="AlbumTab"
                        FontSize="20"
                        Tag="album" />
                    <SelectorBarItem
                        x:Name="Artist"
                        x:Uid="ArtistTab"
                        FontSize="20"
                        Tag="artist" />
                    <SelectorBarItem
                        x:Name="Folder"
                        x:Uid="FolderTab"
                        FontSize="20"
                        Tag="folder" />
                    <SelectorBarItem
                        x:Name="Favourite"
                        x:Uid="FavouriteTab"
                        FontSize="20"
                        Tag="favourite" />
                    <SelectorBarItem
                        x:Name="PlayList"
                        x:Uid="PlaylistTab"
                        FontSize="20"
                        Tag="playList" />
                </SelectorBar>
                <Button
                    x:Name="PlayListAddButton"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="AddPlayList_Click"
                    FontSize="20"
                    Tag="PlayListAdd">
                    <FontIcon Glyph="&#xe948;" />
                </Button>
            </StackPanel>


            <StackPanel
                Margin="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    x:Uid="Transmitting"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="15"
                    Visibility="Collapsed" />
                <ProgressRing
                    x:Name="ProcessingRing"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="True"
                    Visibility="Collapsed" />
                <ComboBox
                    x:Name="UsbDeviceCombox"
                    x:Uid="USBDevice"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    SelectionChanged="UsbDeviceCombox_SelectionChanged"
                    Visibility="Collapsed">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="model:UsbStorageDevice">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" Text="{x:Bind Path}" />
                                <TextBlock Text="{x:Bind FreeSpaceInGB}" />
                                <TextBlock Text=" GB" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock
                    x:Uid="SortOrder"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="14" />
                <ComboBox
                    x:Name="SortByComboBox"
                    Width="120"
                    Margin="0,0,20,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    SelectedIndex="0"
                    SelectionChanged="SortByComboBox_SelectionChanged">
                    <ComboBoxItem
                        x:Uid="SortOrderDefault"
                        FontSize="12"
                        Tag="DefaultOrder" />
                    <ComboBoxItem
                        x:Uid="SortOrderA_Z"
                        FontSize="12"
                        Tag="A-Z" />
                    <ComboBoxItem
                        x:Uid="SortOrderArtist"
                        FontSize="12"
                        Tag="Artist" />
                    <ComboBoxItem
                        x:Uid="SortOrderAlbum"
                        FontSize="12"
                        Tag="Album" />
                </ComboBox>
                <TextBox
                    x:Name="SearchTextBox"
                    x:Uid="SearchMusic"
                    Width="200"
                    Margin="0,0,10,0"
                    TextChanged="SearchTextBox_TextChanged" />
            </StackPanel>
        </Grid>
        <Frame
            x:Name="ContentFrame"
            Grid.Row="1"
            Margin="10"
            IsNavigationStackEnabled="False"
            Visibility="Visible" />
        <Grid
            x:Name="PlayingDetail"
            Grid.Row="1"
            Visibility="Collapsed">
            <!--  Define transitions  -->
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="50" FromVerticalOffset="0" />
                </TransitionCollection>
            </Grid.Transitions>
            <!--  定义列和行  -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  返回按钮  -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Orientation="Horizontal">
                <Button
                    x:Name="CancelPlayingDetailButton"
                    Margin="20,10,10,10"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="CancelPlayingDetailButton_Click">
                    <FontIcon Glyph="&#xE70D;" />
                    <Button.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="-20" />
                        </TransitionCollection>
                    </Button.Transitions>
                </Button>
                <Button
                    Margin="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="FullScreenButton_Click">
                    <FontIcon
                        x:Name="FullScreenIcon"
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        Glyph="&#xe740;" />
                </Button>
            </StackPanel>
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--  专辑封面  -->
                <Border
                    Grid.Row="0"
                    Margin="50,10,10,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="10">
                    <Image x:Name="PlayingDetailAlbumCoverImage" Source="{Binding ViewModel.MusicDetailCover, Mode=OneWay}" />
                </Border>
                <canvas:CanvasControl
                    x:Name="SpectrumCanvas"
                    Margin="50,10,10,10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  右侧信息面板  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="10,10,50,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Orientation="Vertical">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="50" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </StackPanel.Transitions>
                    <RichTextBlock
                        x:Name="PlayingDetailTitleTextBlock"
                        Margin="5,0,5,5"
                        helper:RichTextBlockHelper.Text="{x:Bind ViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                        FontSize="36"
                        FontWeight="Bold"
                        TextWrapping="WrapWholeWords">
                        <RichTextBlock.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                            </TransitionCollection>
                        </RichTextBlock.Transitions>
                    </RichTextBlock>
                    <RichTextBlock
                        x:Name="PlayingDetailAlbumTextBlock"
                        Margin="5"
                        helper:RichTextBlockHelper.Text="{x:Bind ViewModel.CurrentPlayingMusic.Album, Mode=OneWay}"
                        FontSize="22"
                        TextWrapping="WrapWholeWords">
                        <RichTextBlock.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                            </TransitionCollection>
                        </RichTextBlock.Transitions>
                    </RichTextBlock>
                    <RichTextBlock
                        x:Name="PlayingDetailArtistTextBlock"
                        Margin="5"
                        helper:RichTextBlockHelper.Text="{x:Bind ViewModel.CurrentPlayingMusic.Author, Mode=OneWay}"
                        FontSize="22"
                        TextWrapping="WrapWholeWords">
                        <RichTextBlock.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                            </TransitionCollection>
                        </RichTextBlock.Transitions>
                    </RichTextBlock>
                    <Grid Margin="5,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PlayingDetailMusicInfoTextBlock"
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            FontSize="15"
                            Text="{Binding ViewModel.MusicInfo, Mode=OneWay}">
                            <TextBlock.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                                </TransitionCollection>
                            </TextBlock.Transitions>
                        </TextBlock>
                        <Image
                            x:Name="PlayingDetailHRImage"
                            Grid.Column="1"
                            Height="13"
                            Source="{Binding ViewModel.CurrentPlayingMusic, Converter={StaticResource MusicStatusToHRimgConverter}, Mode=OneWay}">
                            <Image.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                                </TransitionCollection>
                            </Image.Transitions>
                        </Image>
                    </Grid>
                </StackPanel>
                <!--  添加歌词显示列表  -->
                <ListView
                    x:Name="LyricsListView"
                    Grid.Row="1"
                    Margin="15,20,5,10"
                    VerticalAlignment="Stretch"
                    IsItemClickEnabled="False"
                    ItemsSource="{Binding ViewModel.UILyrics, Mode=TwoWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:LyricLine">
                            <TextBlock
                                Margin="0,8,0,8"
                                FontSize="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToFontSizeConverter}}"
                                FontWeight="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                                Opacity="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
                                Text="{x:Bind Text}"
                                TextWrapping="Wrap">
                                <TextBlock.Transitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                                    </TransitionCollection>
                                </TextBlock.Transitions>
                            </TextBlock>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        <!--  底部控制区域  -->
        <Grid
            Grid.Row="2"
            Height="150"
            Margin="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  进度条和播放时间  -->
            <Grid Grid.Row="0" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider
                    x:Name="ProgressSlider"
                    Grid.Column="0"
                    Margin="0"
                    VerticalAlignment="Center"
                    Maximum="{Binding ViewModel.ProgressSliderMax, Mode=TwoWay}"
                    Minimum="0"
                    PointerEntered="ProgressSlider_PointerEntered"
                    PointerExited="ProgressSlider_PointerExited"
                    Value="{Binding ViewModel.ProgressSlider, Mode=TwoWay}" />
                <TextBlock
                    x:Name="PlayTimeTextBlock"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding ViewModel.PlayTimeText, Mode=TwoWay}" />
            </Grid>

            <!--  封面、标题、作者组件  -->
            <StackPanel
                x:Name="AlbumCoverAuthorTitleModel"
                Grid.Row="1"
                Margin="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="Visible">
                <StackPanel.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition />
                    </TransitionCollection>
                </StackPanel.Transitions>
                <Button
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="AlbumCoverImage_Click">
                    <Image
                        x:Name="AlbumCoverImage"
                        Width="100"
                        Height="100"
                        Source="{Binding ViewModel.MusicDetailCover, Mode=OneWay}" />
                </Button>
                <Grid
                    Width="Auto"
                    Height="100"
                    MaxWidth="300">
                    <Grid.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </Grid.Transitions>
                    <!--  Rest of your grid content remains the same  -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="MusicTitleTextBlock"
                        Grid.Row="0"
                        MaxHeight="50"
                        Margin="10,0,10,0"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding ViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                        TextTrimming="WordEllipsis"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="MusicAlbumTextBlock"
                        Grid.Row="1"
                        Margin="10,0,10,0"
                        VerticalAlignment="Bottom"
                        FontSize="12"
                        Tapped="AlbumTextBlock_Tapped"
                        Text="{Binding ViewModel.CurrentPlayingMusic.Album, Mode=OneWay}"
                        TextTrimming="WordEllipsis" />
                    <TextBlock
                        x:Name="MusicAuthorTextBlock"
                        Grid.Row="2"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Tapped="AuthorTextBlock_Tapped"
                        Text="{Binding ViewModel.CurrentPlayingMusic.Author, Mode=OneWay}"
                        TextTrimming="WordEllipsis" />
                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="MusicInfoTextBlock"
                            Grid.Column="0"
                            Margin="10,0,10,0"
                            FontSize="12"
                            Text="{Binding ViewModel.MusicInfo, Mode=OneWay}" />
                        <Image
                            x:Name="HRImage"
                            Grid.Column="1"
                            Height="10"
                            Source="{Binding ViewModel.CurrentPlayingMusic, Converter={StaticResource MusicStatusToHRimgConverter}, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </StackPanel>

            <!--  播放模式、播放按钮  -->
            <Grid
                Grid.Row="1"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button
                    x:Name="PlayBarFavouriteButton"
                    Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{Binding ViewModel.PlayBarFavouriteButtonChangedCommand, Mode=OneWay}">
                    <FontIcon Foreground="Red" Glyph="{x:Bind ViewModel.CurrentPlayingMusic.IsFavorite, Mode=TwoWay, Converter={StaticResource FavouriteIconConverter}}" />
                </Button>

                <Button
                    x:Name="FastBackwardButton"
                    Grid.Column="1"
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{Binding ViewModel.FastBackwardButtonCommand, Mode=OneWay}">
                    <FontIcon FontSize="18" Glyph="&#xeb9e;" />
                </Button>

                <Button
                    x:Name="LastMusicButton"
                    Grid.Column="2"
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{Binding ViewModel.LastMusicButtonChangedCommand, Mode=OneWay}">
                    <FontIcon FontSize="26" Glyph="&#xe892;" />
                </Button>

                <!--  播放按钮  -->
                <Button
                    x:Name="PlayPauseButton"
                    Grid.Column="3"
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{Binding ViewModel.PlayButtonChangedCommand, Mode=OneWay}">
                    <FontIcon
                        Width="50"
                        Height="50"
                        FontSize="36"
                        Glyph="{Binding ViewModel.IsPlaying, Converter={StaticResource PlayStatusToIconConverter}, Mode=OneWay}" />
                </Button>

                <Button
                    x:Name="NextMusicButton"
                    Grid.Column="4"
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{Binding ViewModel.NextMusicButtonChangedCommand, Mode=OneWay}">
                    <FontIcon FontSize="26" Glyph="&#xe893;" />
                </Button>

                <Button
                    x:Name="FastForwardButton"
                    Grid.Column="5"
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{Binding ViewModel.FastForwardButtonCommand, Mode=OneWay}">
                    <FontIcon FontSize="18" Glyph="&#xeb9d;" />
                </Button>

                <Button
                    x:Name="StopButton"
                    Grid.Column="6"
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{Binding ViewModel.StopButtonChangedCommand, Mode=OneWay}">
                    <FontIcon FontSize="18" Glyph="&#xe71a;" />
                </Button>


            </Grid>
            <StackPanel
                Grid.Row="1"
                Margin="0,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="EqualizerButton"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="EqualizerButton_Click">
                    <FontIcon x:Name="EqualizerIcon" Glyph="&#xE9E9;" />
                </Button>
                <Button
                    x:Name="CurrentPlayListButton"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="CurrentPlayListButton_Click">
                    <FontIcon x:Name="CurrentPlayListIcon" Glyph="&#xE90B;" />
                </Button>
                <TeachingTip
                    x:Name="CurrentPlayListTeachingTip"
                    IsLightDismissEnabled="True"
                    Target="{x:Bind CurrentPlayListButton}">
                    <TeachingTip.Content>
                        <ListView
                            x:Name="CurrentPlayListView"
                            Width="290"
                            MaxHeight="400"
                            DoubleTapped="CurrentPlayListView_DoubleTapped"
                            ItemsSource="{Binding ViewModel.CurrentPlayingList, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:Music">
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="5"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </TeachingTip.Content>
                </TeachingTip>
                <!--  播放模式按钮  -->
                <Button
                    x:Name="PlayModeButton"
                    Margin="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{Binding ViewModel.PlayModeChangedCommand, Mode=OneWay}">
                    <FontIcon x:Name="PlayModeIcon" Glyph="{Binding ViewModel.CurrentPlayMode, Converter={StaticResource PlayModeToIconConverter}, Mode=TwoWay}" />
                </Button>
                <Button
                    Margin="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{Binding ViewModel.VolumeSliderIconButtonChangedCommand, Mode=OneWay}">
                    <FontIcon
                        x:Name="VolumeSliderIcon"
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        Glyph="{Binding ViewModel.Volume, Converter={StaticResource VolumeToIconConverter}, Mode=OneWay}" />
                </Button>
                <Slider
                    x:Name="VolumeSlider"
                    Grid.Column="1"
                    Width="100"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Minimum="0"
                    PointerEntered="VolumeSlider_PointerEntered"
                    PointerExited="VolumeSlider_PointerExited"
                    PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                    Value="{Binding ViewModel.Volume, Mode=TwoWay}" />
            </StackPanel>

        </Grid>
    </Grid>
</Page>