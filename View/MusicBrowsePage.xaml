<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIMusicPlayer.View.MusicBrowsePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    TabIndex="0"
    xmlns:converters="using:WinUIMusicPlayer.Converters">
    <Page.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:BoolToFontSizeConverter x:Key="BoolToFontSizeConverter"/>
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
    </Page.Resources>
    <Grid Margin="0 32 0 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TopPanel" Grid.Row="0" Visibility="Visible">            
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" 
                        Tag="Back" 
                        BorderThickness="0" 
                        BorderBrush="Transparent" 
                        FontSize="14"
                        Margin="20 0 5 0"
                        Background="Transparent" 
                        Click="BackButton_Click"
                    >
                    <FontIcon Glyph="&#xe830;" FontSize="14"/>
                </Button>
                <SelectorBar x:Name="selectPage" SelectionChanged="SelectPage_SelectionChanged">
                    <SelectorBarItem x:Name="Song" Tag="song" Text="歌曲" FontSize="20" />
                    <SelectorBarItem x:Name="Album" Tag="album" Text="专辑" FontSize="20"/>
                    <SelectorBarItem x:Name="Artist" Tag="artist" Text="艺术家" FontSize="20"/>
                    <SelectorBarItem x:Name="Folder" Tag="folder" Text="文件夹" FontSize="20"/>
                    <SelectorBarItem x:Name="Favourite" Tag="favourite" Text="最爱" FontSize="20"/>
                    <SelectorBarItem x:Name="PlayList" Tag="playList" Text="播放列表" FontSize="20"/>
                </SelectorBar>
                <Button x:Name="PlayListAddButton" 
                     Click="AddPlayList_Click" 
                     Tag="PlayListAdd"
                     BorderThickness="0" 
                     BorderBrush="Transparent" 
                     FontSize="20"
                     Background="Transparent" >
                    <FontIcon Glyph="&#xe948;"></FontIcon>
                </Button>
            </StackPanel>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
                <TextBlock Text="正在传输" Visibility="Collapsed" HorizontalAlignment="Center" FontSize="15" VerticalAlignment="Center" Margin="5 0 5 0"/>
                <ProgressRing x:Name="ProcessingRing" Visibility="Collapsed" IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20"/>
                <ComboBox x:Name="UsbDeviceCombox"  
                          Visibility="Collapsed"
                          FontSize="12"
                          VerticalAlignment="Center"
                          SelectionChanged="UsbDeviceCombox_SelectionChanged"
                          PlaceholderText ="USB设备"
                          Margin="10 0 10 0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="model:UsbStorageDevice">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Bind Path}" Margin="0,0,5,0"/>
                                <TextBlock Text="{x:Bind FreeSpaceInGB}" />
                                <TextBlock Text=" GB" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="排序方式" FontSize="14" Margin="10 0 10 0" VerticalAlignment="Center"/>
                <ComboBox x:Name="SortByComboBox"  
                        FontSize="12"
                        VerticalAlignment="Center"
                        SelectedIndex="0"
                        SelectionChanged="SortByComboBox_SelectionChanged"
                        Width="120" Margin="0 0 20 0">
                    <ComboBoxItem FontSize="12" Content="默认排序" Tag="DefaultOrder"/>
                    <ComboBoxItem FontSize="12" Content="A-Z" Tag="A-Z"/>
                    <ComboBoxItem FontSize="12" Content="歌手" Tag="Artist"/>
                    <ComboBoxItem FontSize="12" Content="专辑" Tag="Album"/>                    
                </ComboBox>
                <TextBox x:Name="SearchTextBox" PlaceholderText="搜索音乐" Width="200" Margin="0 0 10 0" TextChanged="SearchTextBox_TextChanged"/>
            </StackPanel>
        </Grid>
        <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" Grid.Row="1" Margin="10" Visibility="Visible"/>
        <Grid x:Name="PlayingDetail" Grid.Row="1" Visibility="Collapsed">
            <!-- Define transitions -->
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="50" FromVerticalOffset="0" />
                </TransitionCollection>
            </Grid.Transitions>
            <!-- 定义列和行 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 返回按钮 -->
            <StackPanel  Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="CancelPlayingDetailButton" Click="CancelPlayingDetailButton_Click"  Margin="20 10 10 10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent">
                    <FontIcon Glyph="&#xE70D;" ></FontIcon>
                    <Button.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="-20" />
                        </TransitionCollection>
                    </Button.Transitions>
                </Button>
                <Button Click="FullScreenButton_Click" Margin="0" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                    <FontIcon x:Name="FullScreenIcon"  VerticalAlignment="Center" Glyph="&#xe740;" Margin="0" Grid.Column="0"/>
                </Button>
            </StackPanel>
            <!-- 专辑封面 -->
            <Border Grid.Row="1" Grid.Column="0" CornerRadius="10" Margin="50 10 10 10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="PlayingDetailAlbumCoverImage" />
            </Border>
            <Grid Grid.Row="1" Grid.Column="1" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 右侧信息面板 -->
                <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10 10 50 10" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="50" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </StackPanel.Transitions>
                    <TextBlock x:Name="PlayingDetailTitleTextBlock" Tapped="PlayingDetailTitleTextBlock_Tapped" Margin="5 0 5 5" FontSize="36" FontWeight="Bold" TextWrapping="WrapWholeWords">
                        <TextBlock.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                            </TransitionCollection>
                        </TextBlock.Transitions>
                    </TextBlock>
                    <TextBlock x:Name="PlayingDetailAlbumTextBlock" Tapped="PlayingDetailAlbumTextBlock_Tapped" Margin="5" FontSize="22" TextWrapping="WrapWholeWords">
                        <TextBlock.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                            </TransitionCollection>
                        </TextBlock.Transitions>
                    </TextBlock>
                    <TextBlock x:Name="PlayingDetailArtistTextBlock" Tapped="PlayingDetailArtistTextBlock_Tapped" Margin="5" FontSize="22" TextWrapping="WrapWholeWords">
                        <TextBlock.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                            </TransitionCollection>
                        </TextBlock.Transitions>
                    </TextBlock>
                    <Grid Margin="5,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="PlayingDetailMusicInfoTextBlock" FontSize="15" Margin="0,0,10,0">
                            <TextBlock.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                                </TransitionCollection>
                            </TextBlock.Transitions>
                        </TextBlock>
                        <Image x:Name="PlayingDetailHRImage" Height="13" Grid.Column="1">
                            <Image.Transitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                                </TransitionCollection>
                            </Image.Transitions>
                        </Image>
                    </Grid>
                </StackPanel>
                <!-- 添加歌词显示列表 -->
                <ListView x:Name="LyricsListView" 
                        Grid.Row="1"
                        Margin="15,20,5,10" 
                        VerticalAlignment="Stretch"
                        IsItemClickEnabled="False"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:LyricLine">
                            <TextBlock Text="{x:Bind Text}" 
                                TextWrapping="Wrap"
                                Margin="0,8,0,8"                               
                                FontSize="{x:Bind IsCurrent,Mode=OneWay, Converter={StaticResource BoolToFontSizeConverter}}"
                                FontWeight="{x:Bind IsCurrent, Mode=OneWay,Converter={StaticResource BoolToFontWeightConverter}}"
                                Opacity="{x:Bind IsCurrent,Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                                <TextBlock.Transitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                                    </TransitionCollection>
                                </TextBlock.Transitions>
                            </TextBlock>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        <!-- 底部控制区域 -->
        <Grid Grid.Row="2" Margin="10" Height="150">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 进度条和播放时间 -->
            <Grid Grid.Row="0" Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="ProgressSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Margin="0"
                        PointerEntered="ProgressSlider_PointerEntered"
                        PointerExited="ProgressSlider_PointerExited"
                        ValueChanged="ProgressSlider_ValueChanged"
                        Grid.Column="0"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="PlayTimeTextBlock" Grid.Column="1" Margin="10 0 0 0" VerticalAlignment="Center"/>
            </Grid>

            <!-- 封面、标题、作者组件 -->
            <StackPanel x:Name="AlbumCoverAuthorTitleModel" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0" Visibility="Visible">
                <StackPanel.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition/>
                    </TransitionCollection>
                </StackPanel.Transitions>
                <Image x:Name="AlbumCoverImage" Width="100" Height="100" Margin="10" Tapped="AlbumCoverImage_Tapped"/>
                <Grid Width="Auto" Height="100" MaxWidth="300">
                    <Grid.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="30" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </Grid.Transitions>
                    <!-- Rest of your grid content remains the same -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" 
                   x:Name="MusicTitleTextBlock" 
                   TextWrapping="WrapWholeWords" 
                   TextTrimming="WordEllipsis" 
                   FontWeight="Bold" 
                   MaxHeight="50"
                   FontSize="18" 
                   Margin="10,0,10,0"/>
                    <TextBlock Grid.Row="1" x:Name="MusicAlbumTextBlock" TextTrimming="WordEllipsis" FontSize="12" Tapped="AlbumTextBlock_Tapped" Margin="10,0,10,0" VerticalAlignment="Bottom" />
                    <TextBlock Grid.Row="2" x:Name="MusicAuthorTextBlock" TextTrimming="WordEllipsis" FontSize="12" Tapped="AuthorTextBlock_Tapped" Margin="10,0,10,0" VerticalAlignment="Center" />
                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="MusicInfoTextBlock" FontSize="12" Margin="10,0,10,0"/>
                        <Image x:Name="HRImage" Height="10" Grid.Column="1"></Image>
                    </Grid>
                </Grid>
            </StackPanel>

            <!-- 播放模式、播放按钮 -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="PlayBarFavouriteButton" Click="PlayBarFavouriteButton_Click" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                    Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xeb51;" Foreground="Red"/>
                </Button>

                <Button x:Name="FastBackwardButton" Click="FastBackwardButton_Click" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                    Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xeb9e;" FontSize="18"/>
                </Button>

                <Button x:Name="LastMusicButton" Click="LastMusicButton_Click" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xe892;" FontSize="26"/>
                </Button>

                <!-- 播放按钮 -->
                <Button x:Name="PlayPauseButton" Click="PlayButton_Click" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE768;" Width="50" Height="50" FontSize="36"/>
                </Button>

                <Button x:Name="NextMusicButton" Click="NextMusicButton_Click" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xe893;" FontSize="26"/>
                </Button>

                <Button x:Name="FastForwardButton" Click="FastForwardButton_Click" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                    Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xeb9d;" FontSize="18"/>
                </Button>

                <Button x:Name="StopButton" Click="StopButton_Click" Margin="5" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xe71a;" FontSize="18"/>
                </Button>


            </Grid>
            <StackPanel Grid.Row="1" HorizontalAlignment="Right"  Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 0">
                <Button x:Name="CurrentPlayListButton" Click="CurrentPlayListButton_Click" Margin="10 0 0 0" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                    <FontIcon x:Name="CurrentPlayListIcon" Glyph="&#xE90B;"/>
                </Button>
                <TeachingTip x:Name="CurrentPlayListTeachingTip"                    
                    Target="{x:Bind CurrentPlayListButton}"
                    IsLightDismissEnabled="True"
                     >
                    <TeachingTip.Content>
                        <ListView x:Name="CurrentPlayListView" 
                                    DoubleTapped="CurrentPlayListView_DoubleTapped" 
                                    MaxHeight="400"
                                    Width="290"
                                    >
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:Music">
                                    <TextBlock Text="{x:Bind Title,Mode=OneWay}" Grid.Column="1" Margin="5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </TeachingTip.Content>
                </TeachingTip>
                <!-- 播放模式按钮 -->
                <Button x:Name="PlayModeButton" Click="PlayModeButton_Click" Margin="10" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <FontIcon x:Name="PlayModeIcon" Glyph="&#xe8ee;"/>
                </Button>
                <Button Click="VolumeSliderIconButton_Click" Margin="0" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" 
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <FontIcon x:Name="VolumeSliderIcon"  VerticalAlignment="Center" Glyph="&#xe995;" Margin="0" Grid.Column="0"/>
                </Button>                
                <Slider
                    x:Name="VolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Width="100"
                    ValueChanged="VolumeSlider_ValueChanged"
                    PointerEntered="VolumeSlider_PointerEntered"
                    PointerExited="VolumeSlider_PointerExited"
                    PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                    HorizontalAlignment="Right"/>
            </StackPanel>
            
        </Grid>
    </Grid>
</Page>