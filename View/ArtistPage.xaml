<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">
    <Grid Margin="0">
        <GridView
            x:Name="ArtistsGridView"
            IsItemClickEnabled="True"
            IsRightTapEnabled="True"
            ItemClick="ArtistGridView_ItemClick"
            ItemsSource="{Binding ViewModel.MusicList, Mode=TwoWay}"
            RightTapped="Artist_RightTapped"
            VirtualizingStackPanel.VirtualizationMode="Recycling">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="150" Height="150">
                            <FontIcon
                                Width="150"
                                Height="150"
                                FontSize="80"
                                Glyph="&#xe77b;" />
                            <FontIcon
                                x:Name="IsExistOnDeviceIcon"
                                Margin="0,0,5,5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                FontSize="16"
                                Glyph="{Binding IsExistOnDevice, Mode=OneWay, Converter={StaticResource IsExistOnDeviceConverter}}" />
                        </Grid>
                        <TextBlock
                            Width="150"
                            Height="60"
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding Author, Mode=OneWay}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
