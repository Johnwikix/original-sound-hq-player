<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.MusicBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:customControls="using:WinUIMusicPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    IsTabStop="True"
    TabIndex="0"
    mc:Ignorable="d">
    <Grid Margin="0" RowDefinitions="Auto,Auto,*">
        <Grid
            x:Name="TopPanel"
            Grid.Row="0"
            Margin="5,0,0,0"
            Visibility="Visible">
            <StackPanel Orientation="Horizontal">
                <SelectorBar x:Name="selectPage" SelectedItem="{x:Bind ViewModel.SelectedPage, Mode=OneWay}" SelectionChanged="SelectPage_SelectionChanged">
                    <SelectorBarItem
                        x:Name="Song"
                        x:Uid="SongTab"
                        FontSize="20"
                        Tag="song" />
                    <SelectorBarItem
                        x:Name="Album"
                        x:Uid="AlbumTab"
                        FontSize="20"
                        Tag="album" />
                    <SelectorBarItem
                        x:Name="Artist"
                        x:Uid="ArtistTab"
                        FontSize="20"
                        Tag="artist" />
                    <SelectorBarItem
                        x:Name="Folder"
                        x:Uid="FolderTab"
                        FontSize="20"
                        Tag="folder" />
                    <SelectorBarItem
                        x:Name="Favourite"
                        x:Uid="FavouriteTab"
                        FontSize="20"
                        Tag="favourite" />
                </SelectorBar>
            </StackPanel>


            <StackPanel
                Margin="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    x:Uid="Transmitting"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="15"
                    Visibility="Collapsed" />
                <ProgressRing
                    x:Name="ProcessingRing"
                    Width="20"
                    Height="20"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="True"
                    Visibility="{x:Bind ViewModel.AppViewModel.ProcessRingVisibility, Mode=OneWay}" />
                <ComboBox
                    x:Name="UsbDeviceCombox"
                    x:Uid="USBDevice"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    FontSize="12"
                    ItemsSource="{x:Bind ViewModel.AppViewModel.UsbStorageDevices, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.AppViewModel.UsbSelectedIndex, Mode=TwoWay}"
                    SelectionChanged="UsbDeviceCombox_SelectionChanged"
                    Visibility="{x:Bind ViewModel.AppViewModel.UsbDeviceVisibility, Mode=OneWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="model:UsbStorageDevice">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" Text="{x:Bind Path}" />
                                <TextBlock Text="{x:Bind FreeSpaceInGB}" />
                                <TextBlock Text=" GB" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Margin="0" Orientation="Horizontal">
                    <ComboBox
                        x:Name="SortByComboBox"
                        Width="130"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        FontSize="12"
                        ItemsSource="{x:Bind ViewModel.AppViewModel.SortOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.AppViewModel.SelectedSortOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="model:SortOption">
                                <TextBlock FontSize="12" Text="{x:Bind DisplayText, Mode=OneWay}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>
        <InfoBar
            x:Name="InfoBar"
            Title="{x:Bind ViewModel.AppViewModel.InfoBarTitle, Mode=OneWay}"
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.AppViewModel.InfoBarIsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.AppViewModel.InfoBarMessage, Mode=OneWay}"
            Severity="Informational" />
        <Frame
            x:Name="ContentFrame"
            Grid.Row="2"
            Margin="10"
            IsNavigationStackEnabled="False"
            Visibility="Visible" />
    </Grid>
</Page>