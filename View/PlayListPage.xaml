<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.PlayListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    mc:Ignorable="d">
    <Grid>
        <Grid x:Name="EmptyGrid" Visibility="Collapsed">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Border
                    Width="96"
                    Height="96"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="28">
                    <FontIcon
                        FontSize="44"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE93C;" />
                </Border>
                <TextBlock
                    x:Uid="PlayListPageEmptyTitle"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="PlayListPageEmptySubtitle"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="EmptyAddPlayListButton"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    Click="AddPlayList_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE710;" />
                        <TextBlock
                            x:Uid="AddPlayList"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid
            x:Name="PlayListGrid"
            IsHitTestVisible="{x:Bind ViewModel.IsInDetailMode, Mode=OneWay, Converter={StaticResource BooleanNegationConverter}}"
            Opacity="{x:Bind ViewModel.IsInDetailMode, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}, ConverterParameter=invert}"
            RowDefinitions="Auto,*">
            <Grid
                Grid.Row="0"
                Margin="16,10,16,10"
                ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        x:Uid="PlaylistTitle"
                        VerticalAlignment="Center"
                        FontSize="28" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.AppViewModel.AllPlayList.Count, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="PlayListPageCountSuffix"
                            Margin="4,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button
                    x:Name="AddPlayListButton"
                    Grid.Column="2"
                    Margin="0"
                    VerticalAlignment="Center"
                    Click="AddPlayList_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon
                            Margin="0,2,0,0"
                            VerticalAlignment="Center"
                            Glyph="&#xe948;" />
                        <TextBlock x:Uid="AddPlayList" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="10,0,10,0">
                <GridView
                    x:Name="PlayListGridView"
                    Margin="6,6,0,0"
                    IsItemClickEnabled="True"
                    ItemClick="PlayListGridView_ItemClick"
                    ItemsSource="{x:Bind ViewModel.AppViewModel.AllPlayList, Mode=OneWay}"
                    RightTapped="PlayListGridView_RightTapped"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="model:PlayList">
                            <Grid
                                Width="170"
                                Height="200"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                PointerEntered="OnCoverPointerEntered"
                                PointerExited="OnCoverPointerExited"
                                RowDefinitions="Auto,Auto">
                                <Border
                                    x:Name="CoverBorder"
                                    Grid.Row="0"
                                    Width="158"
                                    Height="158"
                                    Margin="0,6,0,2"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    CornerRadius="10">
                                    <Grid Width="158" Height="158">
                                        <Image
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Canvas.ZIndex="1"
                                            Stretch="UniformToFill">
                                            <interactivity:Interaction.Behaviors>
                                                <behaviors:AlbumCoverBehavior Music="{x:Bind tool:BindUtils.PlayListCoverMusicConverter(Id), Mode=OneWay}" />
                                            </interactivity:Interaction.Behaviors>
                                        </Image>
                                        <Grid
                                            Width="158"
                                            Height="158"
                                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                            Canvas.ZIndex="0">
                                            <FontIcon
                                                Canvas.ZIndex="0"
                                                FontSize="50"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE93C;" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Grid
                                    x:Name="ActionOverlay"
                                    Grid.Row="0"
                                    Width="158"
                                    Height="158"
                                    Margin="0,6,0,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Canvas.ZIndex="2">
                                    <Button
                                        x:Name="PlayBtn"
                                        Width="36"
                                        Height="36"
                                        Margin="4,0,4,4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Click="PlayPlayList_Click"
                                        Style="{StaticResource CircularButtonStyle}"
                                        Tag="{x:Bind}"
                                        Visibility="Collapsed">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                    </Button>
                                    <Button
                                        x:Name="MoreBtn"
                                        Width="36"
                                        Height="36"
                                        Margin="4,0,4,4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource CircularButtonStyle}"
                                        Tag="{x:Bind}"
                                        Visibility="Collapsed">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    x:Uid="Edit"
                                                    Click="EditPlayListNameButton_Click"
                                                    Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    x:Uid="ExportM3u8List"
                                                    Click="ExportPlayList_Click"
                                                    Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xEDE1;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem
                                                    x:Uid="PlayListDeleteMenu"
                                                    Click="RemovePlayListButton_Click"
                                                    Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xecc9;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                                    </Button>
                                </Grid>
                                <Grid
                                    Grid.Row="1"
                                    Width="160"
                                    Margin="0,6,0,6"
                                    HorizontalAlignment="Center"
                                    ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        Text="{x:Bind Name, Mode=OneWay}"
                                        TextAlignment="Left"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind SongCount, Mode=OneWay}"
                                        TextAlignment="Right" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>
        <controls:PlaylistDetailControl
            x:Name="DetailView"
            Margin="0,20,0,10"
            x:FieldModifier="public"
            IsHitTestVisible="{x:Bind ViewModel.IsInDetailMode, Mode=OneWay}"
            Opacity="{x:Bind ViewModel.IsInDetailMode, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
            PlaySourceTag="PlayListSongsView" />
    </Grid>
</Page>
