<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.PlayListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid>
        <Grid x:Name="PlayList" Margin="0">
            <ListView x:Name="PlayListView" ItemsSource="{x:Bind ViewModel.PlayLists, Mode=TwoWay}" SelectionChanged="PlayListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:PlayList">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="EditPlayListNameButton"
                                Grid.Column="0"
                                Margin="10,0,0,0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="EditPlayListNameButton_Click"
                                Tag="{x:Bind}">
                                <FontIcon Glyph="&#xeb7e;" />
                            </Button>
                            <Button
                                x:Name="ExportPlayList"
                                Grid.Column="1"
                                Margin="0,0,10,0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="ExportPlayList_Click"
                                Tag="{x:Bind}">
                                <FontIcon Glyph="&#xEDE1;" />
                                <ToolTipService.ToolTip>
                                    <ToolTip x:Uid="ExportM3u8" />
                                </ToolTipService.ToolTip>
                            </Button>
                            <StackPanel x:Name="OpenPlayListPanel" Grid.Column="2" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontSize="18" Text="{x:Bind Name, Mode=TwoWay}" />
                            </StackPanel>
                            <Button
                                x:Name="RemovePlayListButton"
                                Grid.Column="3"
                                Margin="10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="RemovePlayListButton_Click"
                                Tag="{x:Bind}">
                                <FontIcon Glyph="&#xecc9;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
