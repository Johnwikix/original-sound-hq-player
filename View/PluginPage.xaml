<Page x:Class="WinUIMusicPlayer.View.PluginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns:plugin="using:OriginalSound.Plugin">
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
        <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
            <TextBox Header="{x:Bind tools:ToolUtils.GetString('PluginSongTitle')}" Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="1" Header="{x:Bind tools:ToolUtils.GetString('PluginArtist')}" Text="{x:Bind ViewModel.Artist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="{x:Bind tools:ToolUtils.GetString('PluginSearch')}" Command="{x:Bind ViewModel.SearchCommand}" />
        </Grid>
        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <Grid Grid.Row="3" RowDefinitions="*,*" RowSpacing="12">
            <ListView ItemsSource="{x:Bind ViewModel.Results}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="plugin:LyricsCandidate">
                        <StackPanel Padding="8" Spacing="4">
                            <TextBlock Text="{x:Bind Title}" />
                            <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind Source}" /><TextBlock Text="{x:Bind Format}" /></StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ScrollViewer Grid.Row="1"><TextBlock Text="{x:Bind ViewModel.Preview, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></ScrollViewer>
        </Grid>
        <Button Grid.Row="4" Content="{x:Bind tools:ToolUtils.GetString('PluginApply')}" Command="{x:Bind ViewModel.ApplyCommand}" />
    </Grid>
</Page>
