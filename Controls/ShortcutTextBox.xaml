<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.Controls.ShortcutTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
            x:Name="TextBox"
            Grid.Column="0"
            VerticalAlignment="Center"
            IsReadOnly="True"
            KeyDown="TextBox_KeyDown"
            Loaded="TextBox_Loaded" />
        <Button
            Grid.Column="1"
            Width="32"
            Height="32"
            Margin="3,0,0,0"
            Padding="0"
            VerticalAlignment="Center"
            Click="ClearButton_Click"
            Content="{ui:FontIcon FontSize=12, Glyph=&#xE894;}">
            <ToolTipService.ToolTip>
                <ToolTip x:Uid="ShortcutTextBoxClearToolTip" />
            </ToolTipService.ToolTip>
        </Button>
        <Button
            Grid.Column="2"
            Width="32"
            Height="32"
            Margin="3,0,0,0"
            Padding="0"
            VerticalAlignment="Center"
            Click="CheckButton_Click"
            Content="{ui:FontIcon FontSize=12, Glyph=&#xE721;}">
            <ToolTipService.ToolTip>
                <ToolTip x:Uid="ShortcutTextBoxCheckToolTip" />
            </ToolTipService.ToolTip>
        </Button>
    </Grid>
</UserControl>
