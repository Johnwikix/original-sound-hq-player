<UserControl
    x:Class="WinUIMusicPlayer.Controls.Equalizer.FrequencyResponseControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ResponseInk" Color="{ThemeResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="ResponseSecondary" Color="{ThemeResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="ResponseGrid" Color="{ThemeResource ControlStrongStrokeColorDefault}" />
        <SolidColorBrush x:Key="ResponseNode" Color="{ThemeResource ControlFillColorDefault}" />
    </UserControl.Resources>
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Uid="ResponseTitle" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox x:Name="ChannelPicker" Grid.Column="1" SelectedIndex="0" SelectionChanged="ChannelChanged" MinWidth="90">
                <ComboBoxItem x:Uid="ResponseLeft" />
                <ComboBoxItem x:Uid="ResponseRight" />
            </ComboBox>
        </Grid>
        <Canvas x:Name="Plot" Height="230" Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
            SizeChanged="PlotSizeChanged" PointerPressed="PlotPressed" PointerMoved="PlotMoved"
            PointerReleased="PlotReleased" PointerCanceled="PlotReleased" PointerCaptureLost="PlotReleased"
            AutomationProperties.Name="{x:Bind PlotName}" />
        <Grid ColumnDefinitions="*,Auto">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <CheckBox MinWidth="0" x:Name="ShowCombined" x:Uid="ResponseCombinedToggle" IsChecked="True" Click="LayerChanged"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                <CheckBox Grid.Column="1" MinWidth="0" x:Name="ShowEq" x:Uid="ResponseEqToggle" IsChecked="True" Click="LayerChanged" />
                <CheckBox Grid.Column="2" MinWidth="0" x:Name="ShowFir" x:Uid="ResponseFirToggle" IsChecked="True" Click="LayerChanged" />
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
        <TextBlock x:Uid="ResponseScope" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
    </StackPanel>
</UserControl>
