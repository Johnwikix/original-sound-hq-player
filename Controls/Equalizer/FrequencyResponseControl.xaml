<UserControl
    x:Class="WinUIMusicPlayer.Controls.Equalizer.FrequencyResponseControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ResponseInk" Color="{ThemeResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="ResponseSecondary" Color="{ThemeResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="ResponseGrid" Color="{ThemeResource ControlStrongStrokeColorDefault}" />
        <SolidColorBrush x:Key="ResponseNode" Color="{ThemeResource ControlFillColorDefault}" />
    </UserControl.Resources>
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock
                x:Uid="ResponseTitle"
                VerticalAlignment="Center"
                FontWeight="SemiBold" />
            <ComboBox
                x:Name="ChannelPicker"
                Grid.Column="1"
                MinWidth="90"
                SelectedIndex="0"
                SelectionChanged="ChannelChanged">
                <ComboBoxItem x:Uid="ResponseLeft" />
                <ComboBoxItem x:Uid="ResponseRight" />
            </ComboBox>
        </Grid>
        <Border
            Padding="16"
            Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
            CornerRadius="8">
            <Canvas
                x:Name="Plot"
                Height="230"
                AutomationProperties.Name="{x:Bind PlotName}"
                Background="Transparent"
                PointerCanceled="PlotReleased"
                PointerCaptureLost="PlotReleased"
                PointerMoved="PlotMoved"
                PointerPressed="PlotPressed"
                PointerReleased="PlotReleased"
                SizeChanged="PlotSizeChanged" />
        </Border>
        <Grid ColumnDefinitions="*,Auto">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <CheckBox
                    x:Name="ShowCombined"
                    x:Uid="ResponseCombinedToggle"
                    MinWidth="0"
                    Click="LayerChanged"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    IsChecked="True" />
                <CheckBox
                    x:Name="ShowEq"
                    x:Uid="ResponseEqToggle"
                    Grid.Column="1"
                    MinWidth="0"
                    Click="LayerChanged"
                    IsChecked="True" />
                <CheckBox
                    x:Name="ShowFir"
                    x:Uid="ResponseFirToggle"
                    Grid.Column="2"
                    MinWidth="0"
                    Click="LayerChanged"
                    IsChecked="True" />
            </Grid>
        </Grid>
        <TextBlock
            x:Name="StatusText"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
        <TextBlock
            x:Uid="ResponseScope"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
