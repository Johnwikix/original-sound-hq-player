<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.Controls.Equalizer.EqualizerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="EqSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="200" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="StepFrequency" Value="0.1" />
            <Setter Property="TickPlacement" Value="Outside" />
            <Setter Property="TickFrequency" Value="3" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
        <Style x:Key="EqGainLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EqFreqLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EqScaleLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="14" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style
            x:Key="EqScaleLabelZeroStyle"
            BasedOn="{StaticResource EqScaleLabelStyle}"
            TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid ColumnDefinitions="Auto,*">
        <!--  dB 刻度列：紧贴滑条，与右侧滑条区第 1 行（滑条行程 200px）垂直对齐  -->
        <Grid Grid.Column="0" RowDefinitions="22,200,*">
            <Canvas Grid.Row="1" x:Name="DbScaleCanvas" Width="22" Margin="0,0,2,0" />
        </Grid>

        <!--  频段滑条区  -->
        <ScrollViewer
            Grid.Column="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            ZoomMode="Disabled">
            <StackPanel x:Name="BandsPanel" HorizontalAlignment="Left" Orientation="Horizontal" />
        </ScrollViewer>
    </Grid>
</UserControl>
