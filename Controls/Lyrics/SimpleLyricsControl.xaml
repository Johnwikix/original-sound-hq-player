<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.Controls.Lyrics.SimpleLyricsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer.Controls.Lyrics"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <DataTemplate x:Key="LyricLineTemplate">
            <Border
                x:Name="LineBorder"
                Margin="0,20"
                Padding="20,40"
                HorizontalAlignment="Stretch"
                Background="Transparent">
                <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                    <TextBlock
                        x:Name="LyricTextBlock"
                        HorizontalAlignment="Stretch"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TranslationTextBlock"
                        HorizontalAlignment="Stretch"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="ScrollHost"
        HorizontalScrollBarVisibility="Hidden"
        HorizontalScrollMode="Disabled"
        SizeChanged="ScrollHost_SizeChanged"
        VerticalScrollBarVisibility="Hidden"
        VerticalScrollMode="Enabled"
        ViewChanged="ScrollHost_ViewChanged">
        <StackPanel x:Name="ContentPanel" HorizontalAlignment="Stretch">
            <StackPanel Height="600" Background="Transparent" />
            <ListView
                x:Name="LyricList"
                HorizontalAlignment="Stretch"
                ContainerContentChanging="LyricList_ContainerContentChanging"
                IsItemClickEnabled="True"
                ItemClick="LyricList_ItemClick"
                ItemTemplate="{StaticResource LyricLineTemplate}"
                SelectionMode="None" />
            <StackPanel Height="600" Background="Transparent" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
