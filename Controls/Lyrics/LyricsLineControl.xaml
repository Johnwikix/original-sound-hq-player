<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.Controls.Lyrics.LyricsLineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer.Controls.Lyrics"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20,0,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
        </Grid.RowDefinitions>

        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind LyricWords, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:LyricWord">
                    <TextBlock
                        Margin="2,0"
                        FontSize="36"
                        FontWeight="Bold"
                        Opacity="0.3"
                        Text="{x:Bind Word}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl
            x:Name="LyricsItemsControl"
            Grid.Row="1"
            ItemsSource="{x:Bind LyricWords, Mode=OneWay}"
            Opacity="{x:Bind IsCurrentLine, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:LyricWord">
                    <TextBlock
                        Margin="2,0"
                        FontSize="36"
                        FontWeight="Bold"
                        Text="{x:Bind Word}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--  底层 TextBlock (基础/半透明)  -->
        <!--
        <TextBlock
            x:Name="LyricsTextBlockBase"
            Grid.Row="1"
            Margin="0,3"
            HorizontalAlignment="{x:Bind HorizontalAlignment, Mode=OneWay}"
            FontFamily="{x:Bind FontFamily, Mode=OneWay}"
            FontSize="{x:Bind LyricsFontSize, Mode=OneWay}"
            FontWeight="Bold"
            Opacity="0.5"
            Text="{x:Bind LyricsText, Mode=OneWay}"
            TextAlignment="{x:Bind TextAlignment, Mode=OneWay}"
            TextWrapping="WrapWholeWords" />

        -->
        <!--  顶层 TextBlock (高亮/用于动画裁剪)  -->
        <!--
        <TextBlock
            x:Name="LyricsTextBlock"
            Grid.Row="1"
            Margin="0,3"
            HorizontalAlignment="{x:Bind HorizontalAlignment, Mode=OneWay}"
            FontFamily="{x:Bind FontFamily, Mode=OneWay}"
            FontSize="{x:Bind LyricsFontSize, Mode=OneWay}"
            FontWeight="Bold"
            Opacity="{x:Bind IsCurrentLine, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
            Text="{x:Bind LyricsText, Mode=OneWay}"
            TextAlignment="{x:Bind TextAlignment, Mode=OneWay}"
            TextWrapping="WrapWholeWords" />-->


        <!--  翻译文本  -->
        <TextBlock
            x:Name="LyricsTransTextBlock"
            Grid.Row="2"
            Margin="0,3"
            HorizontalAlignment="{x:Bind HorizontalAlignment, Mode=OneWay}"
            FontFamily="{x:Bind FontFamily, Mode=OneWay}"
            FontSize="{x:Bind TranslateFontSize, Mode=OneWay}"
            FontWeight="Bold"
            Opacity="0.5"
            Text="{x:Bind TranslateText, Mode=OneWay}"
            TextAlignment="{x:Bind TextAlignment, Mode=OneWay}"
            TextWrapping="WrapWholeWords"
            Visibility="{x:Bind TranslateVisibility, Mode=OneWay}" />
    </Grid>
</UserControl>
