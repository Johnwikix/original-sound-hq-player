<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUIMusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUIMusicPlayer"
    xmlns:extensions="using:WinUIMusicPlayer.Extensions"
    xmlns:view="using:WinUIMusicPlayer.View"
    xmlns:controls="using:WinUIMusicPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"     
    >    
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>
    <Grid>
        <controls:NotifyIconControl MinWidth="200" x:Name="AppNotifyIconControl"></controls:NotifyIconControl>
        <Grid
        x:Name="AppTitleBar"
        Height="44"
        Margin="48,0,0,0"
        VerticalAlignment="Top"
        Padding="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
            Margin="18,0,0,0"
            Grid.Column="1"
            FontSize="16"
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}"
            x:Uid="AppTitle"/>
        </Grid>
        <!-- Loading 界面 -->
        <Grid x:Name="LoadingGrid" Visibility="Visible">
            <ProgressRing IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100"/>
            <TextBlock x:Uid="LoadingText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,180,0,0"/>
        </Grid>
        <NavigationView 
            Visibility="Collapsed" 
            PaneDisplayMode="LeftCompact" 
            x:Name="NavigationViewControl" 
            IsBackButtonVisible="Collapsed" 
            ItemInvoked="NavigationView_ItemInvoked"
            >
            <NavigationView.MenuItems >
                <NavigationViewItem Tag="AddFolder" Icon="NewFolder">
                    <NavigationViewItem.Content>
                        <TextBlock  x:Uid="AddFolder"></TextBlock>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem Tag="MusicBrowse" Icon="Audio" >
                    <NavigationViewItem.Content>
                        <TextBlock  x:Uid="MusicBrowse"></TextBlock>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
