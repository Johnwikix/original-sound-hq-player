<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="WinUIMusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="using:WinUIMusicPlayer.View"
    xmlns:winex="using:WinUIEx"
    Title="OriginalSound HQ Player"
    MinWidth="1280"
    MinHeight="720">
    <winex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </winex:WindowEx.SystemBackdrop>
    <Grid>
        <controls:NotifyIconControl x:Name="AppNotifyIconControl" MinWidth="200" />
        <Grid
            x:Name="AppTitleBar"
            Height="44"
            Margin="48,0,0,0"
            Padding="0"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="AppTitle"
                Grid.Column="1"
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <!--  Loading 界面  -->
        <Grid x:Name="LoadingGrid" Visibility="Visible">
            <ProgressRing
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />
            <TextBlock
                x:Uid="LoadingText"
                Margin="0,180,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
        <RelativePanel>
            <!--  Frame 填充整个区域  -->
            <Frame
                x:Name="ContentFrame"
                RelativePanel.AlignBottomWithPanel="True"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignRightWithPanel="True"
                RelativePanel.AlignTopWithPanel="True" />

            <!--  NavigationView 浮在左侧  -->
            <Grid
                x:Name="NavigationViewControlGrid"
                PointerEntered="NavigationViewControl_PointerEntered"
                PointerExited="NavigationViewControl_PointerExited"
                RelativePanel.AlignBottomWithPanel="True"
                RelativePanel.AlignLeftWithPanel="True"
                RelativePanel.AlignTopWithPanel="True">
                <Grid.OpacityTransition>
                    <ScalarTransition />
                </Grid.OpacityTransition>
                <NavigationView
                    x:Name="NavigationViewControl"
                    Width="48"
                    BackRequested="NavigationViewControl_BackRequested"
                    IsBackButtonVisible="Visible"
                    IsBackEnabled="True"
                    IsPaneOpen="False"
                    IsPaneToggleButtonVisible="False"
                    ItemInvoked="NavigationView_ItemInvoked"
                    PaneDisplayMode="LeftCompact"
                    Visibility="Collapsed">
                    <NavigationView.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" Invoked="KeyboardAccelerator_Invoked" />
                    </NavigationView.KeyboardAccelerators>
                    <NavigationView.MenuItems>
                        <NavigationViewItem Icon="NewFolder" Tag="AddFolder">
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="AddFolder" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                        <NavigationViewItem Icon="Audio" Tag="MusicBrowse">
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="MusicBrowse" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                </NavigationView>
            </Grid>
        </RelativePanel>
    </Grid>
</winex:WindowEx>
