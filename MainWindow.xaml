<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="WinUIMusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="using:WinUIMusicPlayer.View"
    xmlns:winex="using:WinUIEx"
    Title="OriginalSound HQ Player"
    MinWidth="1280"
    MinHeight="720">
    <winex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </winex:WindowEx.SystemBackdrop>
    <Grid>
        <controls:NotifyIconControl x:Name="AppNotifyIconControl" MinWidth="200" />
        <Frame x:Name="ShellFrame" />
        <!--  Loading 界面  -->
        <Grid x:Name="LoadingGrid" Visibility="Visible">
            <ProgressRing
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />
            <TextBlock
                x:Uid="LoadingText"
                Margin="0,180,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</winex:WindowEx>
