<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="WinUIMusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="using:WinUIMusicPlayer.View"
    xmlns:winex="using:WinUIEx"
    Title="OriginalSound HQ Player"
    MinWidth="960"
    MinHeight="720">
    <winex:WindowEx.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </winex:WindowEx.SystemBackdrop>
    <Grid>
        <Frame x:Name="ShellFrame" />
        <!-- 托盘随主窗口显式创建；命令可用性由生命周期控制。 -->
        <Grid x:Name="TrayHost" />
    </Grid>
</winex:WindowEx>
