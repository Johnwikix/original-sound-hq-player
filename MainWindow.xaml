<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinUIMusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUIMusicPlayer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="using:WinUIMusicPlayer.View">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <controls:NotifyIconControl x:Name="AppNotifyIconControl" MinWidth="200" />
        <Grid
            x:Name="AppTitleBar"
            Height="44"
            Margin="48,0,0,0"
            Padding="0"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="AppTitle"
                Grid.Column="1"
                Margin="18,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <!--  Loading 界面  -->
        <Grid x:Name="LoadingGrid" Visibility="Visible">
            <ProgressRing
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="True" />
            <TextBlock
                x:Uid="LoadingText"
                Margin="0,180,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NavigationView
                x:Name="NavigationViewControl"
                Grid.Column="0"
                Width="48"
                BackRequested="NavigationViewControl_BackRequested"
                IsBackButtonVisible="Visible"
                IsBackEnabled="True"
                IsPaneOpen="False"
                IsPaneToggleButtonVisible="False"
                ItemInvoked="NavigationView_ItemInvoked"
                PaneDisplayMode="LeftCompact"
                Visibility="Collapsed">
                <NavigationView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" Invoked="KeyboardAccelerator_Invoked" />
                </NavigationView.KeyboardAccelerators>
                <NavigationView.MenuItems>
                    <NavigationViewItem Icon="NewFolder" Tag="AddFolder">
                        <NavigationViewItem.Content>
                            <TextBlock x:Uid="AddFolder" />
                        </NavigationViewItem.Content>
                    </NavigationViewItem>
                    <NavigationViewItem Icon="Audio" Tag="MusicBrowse">
                        <NavigationViewItem.Content>
                            <TextBlock x:Uid="MusicBrowse" />
                        </NavigationViewItem.Content>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
            </NavigationView>

            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
